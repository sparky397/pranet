  "description": {
    "en": {
      "source": "Wikipedia (en): Eugenia pyriformis",
      "source_url": "https://en.wikipedia.org/wiki/Eugenia_pyriformis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1327526528,
      "text": "Eugenia pyriformis is a plant of the family Myrtaceae found primarily in Brazil. It reaches 6 to 13 metres in height and 30 to 50 centimetres in trunk diameter. It is a native species of Brazil, occurring primarily in the states of Paraná, Rio Grande do Sul, Santa Catarina and São Paulo."
    },
    "es": {
      "source": "Wikipedia (es): Eugenia pyriformis",
      "source_url": "https://es.wikipedia.org/wiki/Eugenia_pyriformis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 168281854,
      "text": "La pitanga zapallo, (Eugenia pyriformis) es una planta de la familia de las Myrtaceae que se encuentra principalmente en Brasil, partes de Argentina y el extremo norte de Uruguay. Alcanza de 20 a 45 pies (6 a 13 metros) de altura y de 1 a 1,5 pies (30 a 50 centímetros) de diámetro del tronco. Es una especie nativa de Brasil, donde la podemos encontrar principalmente en los estados de Paraná, Rio Grande do Sul, Santa Catarina y São Paulo, en Uruguay y Argentina se encuentra en las islas del Río Uruguay."
    },
    "id": {
      "source": "Wikipedia (id): Eugenia pyriformis",
      "source_url": "https://id.wikipedia.org/wiki/Eugenia_pyriformis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 26055352,
      "text": "Eugenia pyriformis adalah spesies tumbuhan yang tergolong ke dalam famili Myrtaceae. Spesies ini juga merupakan bagian dari ordo Myrtales. Spesies Eugenia pyriformis sendiri merupakan bagian dari genus Eugenia. Nama ilmiah dari spesies ini pertama kali diterbitkan oleh Cambess.."
    }
  },
  "sections": {
