  "description": {
    "en": {
      "source": "Wikipedia (en): Gomphocarpus fruticosus",
      "source_url": "https://en.wikipedia.org/wiki/Gomphocarpus_fruticosus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1367060900,
      "text": "Gomphocarpus fruticosus is a species of plant native to South Africa. It is also common in Australia and New Zealand where it is a host of the monarch butterfly. The plant's tissues contain sufficient cardenolides that consumption of significant quantities of the plant's leaves, stems, or fruit may lead to death in livestock and humans."
    },
    "es": {
      "source": "Wikipedia (es): Gomphocarpus fruticosus",
      "source_url": "https://es.wikipedia.org/wiki/Gomphocarpus_fruticosus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 174108310,
      "text": "Gomphocarpus fruticosus, conocida habitualmente también como mata de (la) seda y argel de Siria, es una especie angiosperma perteneciente a la familia de las apocináceas."
    },
    "fr": {
      "source": "Wikipedia (fr): Gomphocarpus fruticosus",
      "source_url": "https://fr.wikipedia.org/wiki/Gomphocarpus_fruticosus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 220790797,
      "text": "Gomphocarpus fruticosus est une espèce de plantes à fleurs de la famille Asclepiadaceae, selon la classification classique, des Apocynaceae, selon la classification phylogénétique. C'est un faux cotonnier. Son nom français est Arghel."
    },
    "pt": {
      "source": "Wikipedia (pt): Gomphocarpus fruticosus",
      "source_url": "https://pt.wikipedia.org/wiki/Gomphocarpus_fruticosus",
