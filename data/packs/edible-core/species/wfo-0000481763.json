  "description": {
    "en": {
      "source": "Wikipedia (en): Pinus monophylla",
      "source_url": "https://en.wikipedia.org/wiki/Pinus_monophylla",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1314825798,
      "text": "Pinus monophylla, the single-leaf pinyon, is a pine in the pinyon pine group, native to North America. The range is in southernmost Idaho, western Utah, Arizona, southwest New Mexico, Nevada, eastern and southern California and northern Baja California."
    },
    "es": {
      "source": "Wikipedia (es): Pinus monophylla",
      "source_url": "https://es.wikipedia.org/wiki/Pinus_monophylla",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 172748071,
      "text": "Pinus monophylla, el pino monoaguja, es una especie arbórea de la familia de las Pináceas."
    },
    "fr": {
      "source": "Wikipedia (fr): Pinus monophylla",
      "source_url": "https://fr.wikipedia.org/wiki/Pinus_monophylla",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 174391670,
      "text": "Pinus monophylla, le pin à une feuille, est un arbre appartenant à la famille des Pinacées et au genre Pinus. C'est la seule espèce de pins à n'avoir qu'une feuille par faisceau."
    },
    "pt": {
      "source": "Wikipedia (pt): Pinus monophylla",
      "source_url": "https://pt.wikipedia.org/wiki/Pinus_monophylla",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 70205860,
      "text": "Pinus monophylla é uma espécie de pinheiro originária do Novo Mundo. Faz parte do grupo de espécies de pinheiros com área de distribuição no Canadá e Estados Unidos da América."
    },
    "id": {
      "source": "Wikipedia (id): Pinus monophylla",
      "source_url": "https://id.wikipedia.org/wiki/Pinus_monophylla",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 28512151,
      "text": "Pinus monophylla merupakan salah satu spesies pinus pinyon yang termasuk dalam kelompok pinyon pine, dan merupakan tanaman asli Amerika Utara. Sebaran alaminya meliputi wilayah selatan Idaho, barat Utah, Arizona, barat daya New Mexico, Nevada, bagian timur dan selatan California, serta utara Baja California."
    }
