  "description": {
    "en": {
      "source": "Wikipedia (en): Combretum hereroense",
      "source_url": "https://en.wikipedia.org/wiki/Combretum_hereroense",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1195220423,
      "text": "Combretum hereroense, commonly known as the russet bushwillow and the mouse-eared combretum, is a deciduous shrub or small tree that is found from eastern Africa to northern South Africa. Over its extensive range it is variable with respect to leaf shape, fruit size and indumentum."
    },
    "es": {
      "source": "Wikipedia (es): Combretum hereroense",
      "source_url": "https://es.wikipedia.org/wiki/Combretum_hereroense",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 168012086,
      "text": "Combretum hereroense, comúnmente conocido como el arbusto de Russet o combretum de orejas de ratón, es un arbusto caducifolio o árbol pequeño que se encuentra desde el este de África hasta el norte de Sudáfrica. En ese extenso hábitat, existen variaciones con respecto a la forma de la hoja, el tamaño de la fruta y el indumento."
    }
  },
  "sections": {
    "uses": {
      "en": {
        "source": "Wikipedia (en): Combretum hereroense § Uses",
        "source_url": "https://en.wikipedia.org/wiki/Combretum_hereroense#Uses",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1195220423,
        "heading": "Uses",
        "text": "Dried leaves are used for tea, the gum is eaten, the wood is harvested for fuel, and the roots are used in traditional medicine.",
        "truncated": false
      },
      "es": {
        "source": "Wikipedia (es): Combretum hereroense § Usos",
        "source_url": "https://es.wikipedia.org/wiki/Combretum_hereroense#Usos",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 168012086,
        "heading": "Usos",
        "text": "Las hojas secas se utilizan para té, la goma se come, la madera se cosecha para combustible, y las raíces se utilizan en la medicina tradicional.​",
        "truncated": false
      }
    }
  },
