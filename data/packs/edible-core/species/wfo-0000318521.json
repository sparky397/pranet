  "description": {
    "en": {
      "source": "Wikipedia 英語版「Syzygium cumini」",
      "source_url": "https://en.wikipedia.org/wiki/Syzygium_cumini",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1364446683,
      "text": "Syzygium cumini, also known as Java plum, Malabar plum, jambolan, black plum, jamun, jambul, is an evergreen tropical tree in the flowering plant family Myrtaceae, and favored for its fruit, timber, and ornamental value. It is native to the Indian subcontinent and Southeast Asia. It can reach heights of up to 30 m (100 ft) and can live more than 100 years. A rapidly growing plant, it is considered an invasive species in many world regions."
    }
  },
