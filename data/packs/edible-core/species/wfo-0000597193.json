  "description": {
    "en": {
      "source": "Wikipedia (en): Cereus hildmannianus",
      "source_url": "https://en.wikipedia.org/wiki/Cereus_hildmannianus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1291189424,
      "text": "Cereus hildmannianus is a species of cactus from southern South America. Its distribution is uncertain but probably includes Brazil, Paraguay, Uruguay and Argentina. This cactus thrives in diverse habitats such as forests, savannas, and grasslands, preferring well-draining soils and demonstrating adaptability to both drought and occasional flooding."
    },
    "es": {
      "source": "Wikipedia (es): Cereus hildmannianus",
      "source_url": "https://es.wikipedia.org/wiki/Cereus_hildmannianus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 172182549,
      "text": "Cereus hildmannianus, conocida comúnmente como reina de la noche sudamericana, es una especie de planta suculenta perteneciente al género Cereus, dentro de la familia Cactaceae. Se distribuye desde Bolivia y Brasil hasta el norte de Argentina. Además se ha introducido en otras regiones como España, Francia, Italia o India, donde se la considera una especie invasora."
    },
    "fr": {
      "source": "Wikipedia (fr): Cierge du Pérou",
      "source_url": "https://fr.wikipedia.org/wiki/Cierge_du_P%C3%A9rou",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 227268410,
      "text": "Le Cierge du Pérou est une espèce de cactus colonnaire natif d'Argentine et répandu en Amérique du Sud."
    },
    "pt": {
      "source": "Wikipedia (pt): Cereus hildmannianus",
      "source_url": "https://pt.wikipedia.org/wiki/Cereus_hildmannianus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 65140362,
      "text": "Cereus hildmannianus é uma espécie de planta do gênero Cereus na família dos cactus.Sua distribuição é incerta mas incluí Brasil, Paraguai, Uruguai e Argentina."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia (en): Cereus hildmannianus § Cultivation",
        "source_url": "https://en.wikipedia.org/wiki/Cereus_hildmannianus#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 1291189424,
        "heading": "Cultivation",
        "text": "It is necessary to water abundantly during the period of growth, and very little during the period of rest. The species can tolerate some cold, even a few degrees below zero, if the soil is dry. Young plants need shade, while adults need full sun.",
        "truncated": false
      },
      "fr": {
        "source": "Wikipedia (fr): Cierge du Pérou § Culture",
        "source_url": "https://fr.wikipedia.org/wiki/Cierge_du_P%C3%A9rou#Culture",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 227268410,
        "heading": "Culture",
        "text": "Il faut arroser abondamment au cours de la période de croissance, et très peu au cours de la période de repos. L'espèce peut tolérer un certain froid, même de quelques degrés au-dessous de zéro, si le sol est sec. Les jeunes plantes ont besoin d'ombre, alors que les adultes doivent être en plein soleil.\nSe multiplie par graines ou boutures. La fructification intervient à partir de la 3e année en climat favorable.",
        "truncated": false
      }
    }
  },
