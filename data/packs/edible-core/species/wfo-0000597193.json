        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-12",
        "revision": 1291189424,
        "heading": "Cultivation",
        "text": "It is necessary to water abundantly during the period of growth, and very little during the period of rest. The species can tolerate some cold, even a few degrees below zero, if the soil is dry. Young plants need shade, while adults need full sun.",
        "truncated": false
      }
    }
