  "description": {
    "ja": {
      "source": "Wikipedia (ja): デイゴ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%87%E3%82%A4%E3%82%B4",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 109242826,
      "text": "デイゴ は、マメ科デイゴ属（エリスリーナ属）の落葉高木。デイコやエリスリナともいう。インド、マレー半島などの熱帯アジア、オーストラリアが原産。日本では沖縄県（あるいは奄美大島）が生育の北限とされている。"
    },
    "en": {
      "source": "Wikipedia (en): Erythrina variegata",
      "source_url": "https://en.wikipedia.org/wiki/Erythrina_variegata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1340103712,
      "text": "Erythrina variegata, commonly known as tiger's claw or Indian coral tree, is a species of Erythrina native to the tropical and subtropical regions of eastern Africa, the Indian subcontinent, northern Australia, and the islands of the Indian Ocean and the western Pacific Ocean east to Fiji."
    },
    "es": {
      "source": "Wikipedia (es): Erythrina variegata",
      "source_url": "https://es.wikipedia.org/wiki/Erythrina_variegata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171582074,
      "text": "Erythrina variegata es una especie de planta fanerógama perteneciente a la familia de las fabáceas. Es originaria de la India y se ha cultivado por todo el mundo."
    },
    "fr": {
      "source": "Wikipedia (fr): Erythrina variegata",
      "source_url": "https://fr.wikipedia.org/wiki/Erythrina_variegata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 239208799,
      "text": "Erythrina variegata est une espèce de plantes à fleurs de la famille des Fabacées."
    },
    "pt": {
      "source": "Wikipedia (pt): Erythrina variegata",
      "source_url": "https://pt.wikipedia.org/wiki/Erythrina_variegata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 72949651,
      "text": "Erythrina variegata é uma espécie de Erythrina nativa das regiões tropicais e subtropicais do leste da África, do subcontinente indiano, do norte da Austrália e das ilhas do Oceano Índico e do oeste do Oceano Pacífico, a leste de Fiji."
    },
    "id": {
      "source": "Wikipedia (id): Dadap",
      "source_url": "https://id.wikipedia.org/wiki/Dadap",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29516885,
      "text": "Dadap atau dadap ayam adalah sejenis pohon anggota suku Fabaceae. Pohon yang kerap digunakan sebagai pagar hidup dan peneduh ini memiliki banyak sebutan yang lain. Di antaranya dhadhap ayam, dhadhap laut, Dhadhap asrêp (Jw.), dadap belendung (Sd.), dhâddhâ' (Mdr.), dalungdung (Bl.), deris, galala itam (Mlk.) dan lain-lain."
    }
  },
  "sections": {
    "toxicity": {
      "es": {
        "source": "Wikipedia (es): Erythrina variegata § Toxicidad",
