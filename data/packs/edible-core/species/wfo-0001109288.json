  "description": {
    "ja": {
      "source": "Wikipedia (ja): ホコシダ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%9B%E3%82%B3%E3%82%B7%E3%83%80",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 107515232,
      "text": "ホコシダ は、イノモトソウ科イノモトソウ属のシダ植物。細長い羽片をつけ、イノモトソウなどに似るが、栄養葉の側羽片が裂ける。欧米で古くから栽培され、斑入り品などがある。"
    },
    "en": {
      "source": "Wikipedia (en): Pteris ensiformis",
      "source_url": "https://en.wikipedia.org/wiki/Pteris_ensiformis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1323630080,
      "text": "Pteris ensiformis, the slender brake, silver lace fern, sword brake fern, or slender brake fern, is a plant species of the genus Pteris in the family Pteridaceae. It is found in Asia and the Pacific."
    },
    "es": {
      "source": "Wikipedia (es): Pteris ensiformis",
      "source_url": "https://es.wikipedia.org/wiki/Pteris_ensiformis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 174316890,
      "text": "Pteris ensiformis es una especie de helecho del género Pteris, perteneciente a la familia Pteridaceae. Se encuentra en África tropical, Asia e islas del Océano Pacífico."
    },
    "fr": {
      "source": "Wikipedia (fr): Ptéris à feuilles fines",
      "source_url": "https://fr.wikipedia.org/wiki/Pt%C3%A9ris_%C3%A0_feuilles_fines",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 235695416,
      "text": "Le Ptéris à feuilles fines (Pteris ensiformis) est une fougère de la famille des Pteridaceae et parfois classée parmi la famille des Adiantaceae selon les auteurs."
    }
  },
