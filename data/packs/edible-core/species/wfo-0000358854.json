  "description": {
    "en": {
      "source": "Wikipedia (en): Laguncularia",
      "source_url": "https://en.wikipedia.org/wiki/Laguncularia",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1318243535,
      "text": "Laguncularia is a genus of plants in the family Combretaceae. The only species in the genus is Laguncularia racemosa, the white mangrove."
    },
    "es": {
      "source": "Wikipedia (es): Laguncularia racemosa",
      "source_url": "https://es.wikipedia.org/wiki/Laguncularia_racemosa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 174345179,
      "text": "Laguncularia racemosa, conocido también en Cuba como patabán, y en Colombia, Venezuela y Costa Rica como mangle blanco o mereicillo, es la única especie del género monotípico Laguncularia."
    },
    "fr": {
      "source": "Wikipedia (fr): Laguncularia racemosa",
      "source_url": "https://fr.wikipedia.org/wiki/Laguncularia_racemosa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 233848669,
      "text": "Laguncularia racemosa, le Palétuvier blanc, est une espèce de plantes à fleurs du genre Laguncularia et de la famille des Combretaceae. C'est un palétuvier, un arbre des mangroves, trouvé sur les côtes de l'Afrique de l'Ouest ainsi que sur les côtes atlantiques et pacifiques des Amériques."
    },
    "pt": {
      "source": "Wikipedia (pt): Mangue-branco",
      "source_url": "https://pt.wikipedia.org/wiki/Mangue-branco",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 71046332,
      "text": "O mangue-branco é uma árvore pioneira nativa e típica do manguezal brasileiro, encontrada no interior do mangue e na transição para a floresta de restinga."
    }
  },
  "sections": {
    "uses": {
      "pt": {
        "source": "Wikipedia (pt): Mangue-branco § Usos",
        "source_url": "https://pt.wikipedia.org/wiki/Mangue-branco#Usos",
        "license": "CC BY-SA 4.0",
