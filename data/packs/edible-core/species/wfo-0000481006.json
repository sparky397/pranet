  "description": {
    "ja": {
      "source": "Wikipedia (ja): ヒナゲシ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%92%E3%83%8A%E3%82%B2%E3%82%B7",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 110151026,
      "text": "ヒナゲシ は、ヨーロッパ中南部～西アジアに分布するケシ科の一年草。「虞美人草 」「コクリコ 」「シャーレイポピー 」とも呼ばれる。他のケシ科の植物も含めて単にポピーということもある。フランスやポーランドなどの国花として有名である。"
    },
    "en": {
      "source": "Wikipedia (en): Papaver rhoeas",
      "source_url": "https://en.wikipedia.org/wiki/Papaver_rhoeas",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1375086318,
      "text": "Papaver rhoeas, with common names including common poppy, corn poppy, corn rose, field poppy, Flanders poppy, red poppy, and Odai, is an annual herbaceous species of flowering plant in the poppy family Papaveraceae. It is native to north Africa and temperate Eurasia and is introduced into temperate areas on all other continents except Antarctica."
    },
    "es": {
      "source": "Wikipedia (es): Papaver rhoeas",
      "source_url": "https://es.wikipedia.org/wiki/Papaver_rhoeas",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 175722802,
      "text": "La amapola común o amapola silvestre, es una especie fanerógama del género Papaver."
    },
    "fr": {
      "source": "Wikipedia (fr): Coquelicot",
      "source_url": "https://fr.wikipedia.org/wiki/Coquelicot",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 239746834,
      "text": "Le Coquelicot est une espèce de plantes à fleurs dicotylédones, de la famille des Papaveracées. C'est une plante herbacée originaire du bassin méditerranéen."
    },
    "pt": {
      "source": "Wikipedia (pt): Papoila",
      "source_url": "https://pt.wikipedia.org/wiki/Papoila",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 72995095,
      "text": "Papoila (português europeu) ou papoula (português brasileiro) é o nome popular para flores da família das Papaveraceae, abundantes no hemisfério norte, cultivadas para ornamento, ópio ou comida. Seu cultivo tem se disseminado na América. Algumas das espécies mais conhecidas são: Papaver somniferum (papoula-dormideira), Papaver rhoeas (papoula-comum) e Eschscholzia californica (papoula-da-califórnia)."
    }
  },
  "sections": {
    "cultivation": {
      "ja": {
        "source": "Wikipedia (ja): ヒナゲシ § 栽培",
        "source_url": "https://ja.wikipedia.org/wiki/%E3%83%92%E3%83%8A%E3%82%B2%E3%82%B7#%E6%A0%BD%E5%9F%B9",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 110151026,
        "heading": "栽培",
        "text": "ヒナゲシは、栽培してよい種である。\n土質は選ばないが、排水がよい土地を選ぶ。移植を嫌うので、9月下旬から10月中旬頃に、花壇に直まきする。覆土はタネが見え隠れする程度でよい。かなり細かいタネなので、砂を混ぜて散布し、発芽してきたら間引いて、株間が30 cmくらいになるようにする。",
        "truncated": false
      }
    }
  },
