  "description": {
    "en": {
      "source": "Wikipedia (en): Eugenia reinwardtiana",
      "source_url": "https://en.wikipedia.org/wiki/Eugenia_reinwardtiana",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1359243854,
      "text": "Eugenia reinwardtiana is a shrub to small tree in the family Myrtaceae. Native to tropical forests in Indonesia, the Australian state of Queensland, and many Pacific Islands, its common names include Cedar Bay cherry, beach cherry, Australian beach cherry, mountain stopper, nīoi (Hawaiian), and a'abang (Chamorro). They are typically 2 to 6 m in height."
    },
    "id": {
      "source": "Wikipedia (id): Eugenia reinwardtiana",
      "source_url": "https://id.wikipedia.org/wiki/Eugenia_reinwardtiana",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 30024135,
      "text": "Eugenia reinwardtiana atau Ceri pantai adalah sejenis perdu pohon kecil dalam keluarga Myrtaceae asli pada hutan hujan di Queensland utara, Australia, Indonesia, dan Kepulauan Pasifik. Nama-namanya yang umum termasuk Cedar Bay cherry, mountain stopper, dan nioi (Hawaii). Tumbuhan ini biasanya memiliki ketinggian 2 hingga 6 m."
    }
  },
  "sections": {
    "uses": {
      "en": {
        "source": "Wikipedia (en): Eugenia reinwardtiana § Uses",
        "source_url": "https://en.wikipedia.org/wiki/Eugenia_reinwardtiana#Uses",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1359243854,
        "heading": "Uses",
        "text": "The tree is cultivated to a limited extent for its edible sweetish fruit that is often eaten out-of-hand, used to flavour drinks and candies, or as a preserve. The fruit is a source of antioxidants.\nThe tree is well-suited to amenity horticulture in the tropics, and is grown in the median strips in Cairns. It is readily propagated from fresh seed.\nThis species is susceptible to myrtle rust (Austropuccinia psidii).",
        "truncated": false
      },
      "id": {
        "source": "Wikipedia (id): Eugenia reinwardtiana § Manfaat",
        "source_url": "https://id.wikipedia.org/wiki/Eugenia_reinwardtiana#Manfaat",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 30024135,
        "heading": "Manfaat",
        "text": "Pohon ini dibudidayakan sampai batas tertentu untuk buah manisnya yang dapat dimakan yang sering dimakan tak terkendali, digunakan untuk memberi rasa minuman dan permen, atau sebagai selai. Buahnya merupakan salah satu sumber antioksidan.",
        "truncated": false
      }
    }
  },
