  "description": {
    "en": {
      "source": "Wikipedia (en): Asplenium nidus",
      "source_url": "https://en.wikipedia.org/wiki/Asplenium_nidus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1354922959,
      "text": "Asplenium nidus is an epiphytic species of fern in the family Aspleniaceae, native to tropical southeastern Asia, eastern Australia, Hawaii, Polynesia, Christmas Island, India, and eastern Africa. It is known by the common names bird's-nest fern or simply nest fern."
    },
    "es": {
      "source": "Wikipedia (es): Asplenium nidus",
      "source_url": "https://es.wikipedia.org/wiki/Asplenium_nidus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171582704,
      "text": "Asplenium nidus es una especie de helecho de la familia de las aspleniáceas."
    },
    "fr": {
      "source": "Wikipedia (fr): Asplenium nidus",
      "source_url": "https://fr.wikipedia.org/wiki/Asplenium_nidus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 240017634,
      "text": "Asplenium nidus est une espèce de fougères de la famille des Aspleniaceae. On l'appelle aussi fougère nid d'oiseau."
    },
    "id": {
      "source": "Wikipedia (id): Paku sarang burung",
      "source_url": "https://id.wikipedia.org/wiki/Paku_sarang_burung",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 28516794,
      "text": "Paku sarang burung merupakan jenis tumbuhan paku jamak ditemui di tempat-tempat yang lembap dan ternaung ini juga populer ditanam sebagai tanaman hias. Ia juga memiliki nama lain seperti kadaka (Sd.); kedaka (Jw.,Btw.); lukut (Bjr.), dan lainnya."
    }
