  "description": {
    "ja": {
      "source": "Wikipedia (ja): コケモモ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%B3%E3%82%B1%E3%83%A2%E3%83%A2",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 111239045,
      "text": "コケモモ は、ツツジ科スノキ属の常緑小低木。果実を食用とするが、栽培されることは稀で、野生のものを採取するのが一般的である。"
    },
    "en": {
      "source": "Wikipedia (en): Vaccinium vitis-idaea",
      "source_url": "https://en.wikipedia.org/wiki/Vaccinium_vitis-idaea",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1369232090,
      "text": "Vaccinium vitis-idaea is a small evergreen shrub in the heath family, Ericaceae. It is known colloquially as the lingonberry, partridgeberry, foxberry, mountain cranberry, or cowberry. It is native to the boreal forest and Arctic tundra throughout the Northern Hemisphere."
    },
    "es": {
      "source": "Wikipedia (es): Vaccinium vitis-idaea",
      "source_url": "https://es.wikipedia.org/wiki/Vaccinium_vitis-idaea",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 171666233,
      "text": "El arándano rojo o arándano encarnado es una planta perenne de la familia de las ericáceas, nativa de Eurasia y Norteamérica."
    },
    "fr": {
      "source": "Wikipedia (fr): Vaccinium vitis-idaea",
      "source_url": "https://fr.wikipedia.org/wiki/Vaccinium_vitis-idaea",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 218001957,
      "text": "Vaccinium vitis-idaea est une espèce de plantes à fleurs du genre Vaccinium et de la famille des Ericaceae."
    },
    "pt": {
      "source": "Wikipedia (pt): Vaccinium vitis-idaea",
      "source_url": "https://pt.wikipedia.org/wiki/Vaccinium_vitis-idaea",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 65326286,
      "text": "Vaccinium vitis-idaea (arando-vermelho) é um pequeno arbusto verde da família Ericaceae, de frutos vermelhos comestíveis."
    },
    "id": {
      "source": "Wikipedia (id): Mentigi lembu",
      "source_url": "https://id.wikipedia.org/wiki/Mentigi_lembu",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 29729461,
      "text": "Vaccinium vitis-idaea, lingonberi, mentigi biru, kranberi gunung atau mentigi lembu, adalah semak malar hijau kecil di famili heath Ericaceae, yang menghasilkan buah yang dapat dimakan. Ia berasal dari hutan boreal dan tundra Artik di seluruh Belahan Bumi Utara, dari Eropah dan Asia hingga Amerika Utara. Buah mentigi lembu dipetik di alam liar dan digunakan untuk menemani berbagai hidangan, terutama di negara-negara Nordik. Budidaya komersial dilakukan di Pacific Northwest AS dan di Belanda."
    }
  },
  "sections": {
    "uses": {
      "ja": {
        "source": "Wikipedia (ja): コケモモ § 利用",
        "source_url": "https://ja.wikipedia.org/wiki/%E3%82%B3%E3%82%B1%E3%83%A2%E3%83%A2#%E5%88%A9%E7%94%A8",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 111239045,
        "heading": "利用",
        "text": "赤く熟した果実は生食できるほか、ジャムや果実酒などにする。別名「フレップ」と呼ばれる。フレップはアイヌ語が語源で、樺太アイヌはエノノカ（樺太アイヌ語: enonoka）と呼ぶ。野生のコケモモは北欧で一般的に見られ、とくにスカンディナヴィア諸国では公有地から収穫することが許可されている。果実は甘みとほどよい酸味があり、砂糖などを加えて煮詰めて、ジャムやコンポート（砂糖煮）、ジュース、シロップ、ゼリー、アイスクリームの材料などに加工する。長期保存するときは、砂糖漬けが向いている。コケモモのコンポートは肉料理の添え物とすることがある。\nコケモモは有機酸、ビタミンC、βカロテン、ビタミンB類の他、カリウム、カルシウム、マグネシウム、リンを含む。\n葉には、色素沈着に対する予防効果や、紫外線が原因となるしみ・そばかすの症状の改善に効くアルブチン、メチルアルブチンなどの化学物質を含み、日本や北アメリカにおいてはウワウルシ（日本には自生しない）の代用として薬草として利用される。",
        "truncated": false
      },
      "en": {
        "source": "Wikipedia (en): Vaccinium vitis-idaea § Traditional medicine",
        "source_url": "https://en.wikipedia.org/wiki/Vaccinium_vitis-idaea#Traditional_medicine",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1369232090,
        "heading": "Traditional medicine",
        "text": "In traditional medicine, V. vitis-idaea was used as an apéritif and astringent. The Upper Tanana ate the berries or used their juice to treat minor respiratory disorders.",
        "truncated": false
      },
      "es": {
        "source": "Wikipedia (es): Vaccinium vitis-idaea § Usos",
        "source_url": "https://es.wikipedia.org/wiki/Vaccinium_vitis-idaea#Usos",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 171666233,
        "heading": "Usos",
        "text": "Los arándanos rojos son una fruta del bosque muy popular en Europa Central, Norte y Oriental. Se pueden comer directamente al natural, pero, por su sabor algo agrio, se suelen consumir ya preparados, en dulces, jaleas, mermeladas, etc.​\nLa mermelada de arándano rojo es muy habitual en Escandinavia y Europa del Este. Tanto en mermelada como en salsa o compota, son un elemento tradicional de la cocina escandinava, principalmente como guarnición de carnes de caza.\nEn Rusia se toma agua de arándanos (ruso: брусничная вода [brusnichnaya voda]) como refresco.\nTambién se obtienen bebidas alcohólicas por fermentación, como vodka en países del Este, o licor (Lillehammer) en Noruega.\nLas hojas sirven para hacer una infusión.[cita requerida]",
        "truncated": false
      },
      "fr": {
        "source": "Wikipedia (fr): Vaccinium vitis-idaea § Utilisations",
        "source_url": "https://fr.wikipedia.org/wiki/Vaccinium_vitis-idaea#Utilisations",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 218001957,
        "heading": "Utilisations",
        "text": "Les fruits sont utilisés comme des canneberges.",
        "truncated": false
      }
    },
    "cultivation": {
      "en": {
        "source": "Wikipedia (en): Vaccinium vitis-idaea § Cultivation",
        "source_url": "https://en.wikipedia.org/wiki/Vaccinium_vitis-idaea#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1369232090,
        "heading": "Cultivation",
        "text": "Lingonberry has been commercially cultivated in the Netherlands, Germany, Sweden, Poland, the United States (including the Pacific Northwest) and Latvia since the 1960s.\nSome cultivars are grown for their ornamental rather than culinary value. In the United Kingdom, the Koralle Group has gained the Royal Horticultural Society's Award of Garden Merit.",
        "truncated": false
      },
      "id": {
        "source": "Wikipedia (id): Mentigi lembu § Penanaman",
        "source_url": "https://id.wikipedia.org/wiki/Mentigi_lembu#Penanaman",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 29729461,
        "heading": "Penanaman",
        "text": "Mentigi lembu telah dibudidayakan secara komersial di Belanda dan negara lain sejak tahun 1960an.\nBeberapa kultivar ditanam karena nilai hiasnya, bukan karena nilai kulinernya. Di Inggris, Grup Koralle telah memperoleh Penghargaan Garden Merit dari Royal Horticultural Society .",
        "truncated": false
      }
    }
  },
