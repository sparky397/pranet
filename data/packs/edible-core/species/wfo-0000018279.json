  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ニトベギク」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%8B%E3%83%88%E3%83%99%E3%82%AE%E3%82%AF",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 110301229,
      "text": "ニトベギク は、キク科の植物で、中米、東南アジア、アフリカなど熱帯・亜熱帯の地域に広く分布する。別名コウテイヒマワリ（皇帝向日葵）。"
    },
    "en": {
      "source": "Wikipedia 英語版「Tithonia diversifolia」",
      "source_url": "https://en.wikipedia.org/wiki/Tithonia_diversifolia",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1361225091,
      "text": "Tithonia diversifolia is a species of flowering plant in the family Asteraceae that is commonly known as the tree marigold, Mexican tournesol, Mexican sunflower, Japanese sunflower or Nitobe chrysanthemum. It is native to Mexico and Central America but has a nearly pantropical distribution as an introduced species. Depending on the area they may be either annual or perennial. It has shown great potential in raising the soil fertility in soils depleted in nutrients."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Tithonia diversifolia」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Tithonia_diversifolia#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1361225091,
        "heading": "Cultivation",
        "text": "Tithonia diversifolia can grow in many different environmental conditions. It has a moderate drought tolerance. It is ideally grown in areas with an annual rainfall ranging from 1000–2000 mm and a temperature of 15-31 degrees Celsius.\nThis plant does not require a large amount of nutrients. As a weed it spreads rapidly, which allows its use as a forage crop in grazing or cut-and-carry systems.",
        "truncated": false
      }
    }
  },
