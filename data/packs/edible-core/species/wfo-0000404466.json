  "description": {
    "en": {
      "source": "Wikipedia (en): Rheum rhaponticum",
      "source_url": "https://en.wikipedia.org/wiki/Rheum_rhaponticum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1360246556,
      "text": "Rheum rhaponticum, the false rhubarb, rhapontic rhubarb or rhapontic, is a plant species in the genus Rheum found in the wild. It is the only Rheum species found only in Europe, and is now restricted to the Rila mountain range in south-western Bulgaria. It was introduced to other countries in Europe. It is considered to be one of the parents of the modern culinary rhubarb."
    },
    "es": {
      "source": "Wikipedia (es): Rheum rhaponticum",
      "source_url": "https://es.wikipedia.org/wiki/Rheum_rhaponticum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171580949,
      "text": "El rapóntico o ruipóntico exótico(Rheum rhaponticum) es una especie de planta fanerógama de la familia Polygonaceae."
    },
    "fr": {
      "source": "Wikipedia (fr): Rheum rhaponticum",
      "source_url": "https://fr.wikipedia.org/wiki/Rheum_rhaponticum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 216208203,
      "text": "Rheum rhaponticum, le Rhapontic ou la Rhubarbe sauvage, est une espèce de plantes dicotylédones de la famille des Polygonaceae, sous-famille des Polygonoideae, originaire de Bulgarie."
    }
