  "description": {
    "en": {
      "source": "Wikipedia (en): Tasmannia lanceolata",
      "source_url": "https://en.wikipedia.org/wiki/Tasmannia_lanceolata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1304135886,
      "text": "Tasmannia lanceolata, commonly known as pepper tree, native pepper, mountain pepper or mountain pepperbush, is a species of flowering plant in the family Winteraceae, and is endemic to south-eastern Australia. It is a dioecious bushy shrub to small tree with lance-shaped or narrowly ellipic leaves, male and female flowers on separate plants, the flowers with 3 to 9 petals, and the fruit a deep maroon to glossy black berry."
    },
    "es": {
      "source": "Wikipedia (es): Tasmannia lanceolata",
      "source_url": "https://es.wikipedia.org/wiki/Tasmannia_lanceolata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171348043,
      "text": "Tasmannia lanceolata es una especie de arbusto perteneciente a la familia Winteraceae nativa de Australia."
    },
    "fr": {
      "source": "Wikipedia (fr): Tasmannia lanceolata",
      "source_url": "https://fr.wikipedia.org/wiki/Tasmannia_lanceolata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 219714988,
      "text": "Tasmannia lanceolata, ou poivre de Tasmanie, est une espèce de plantes à fleurs de la famille des Winteraceae. C'est un arbuste à feuillage persistant originaire du sud-est de l'Australie."
    }
  },
