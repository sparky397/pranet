  "description": {
    "en": {
      "source": "Wikipedia (en): Agrimonia eupatoria",
      "source_url": "https://en.wikipedia.org/wiki/Agrimonia_eupatoria",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1376703378,
      "text": "Agrimonia eupatoria is a species of agrimony that is often referred to as common agrimony, church steeples or sticklewort."
    },
    "es": {
      "source": "Wikipedia (es): Agrimonia eupatoria",
      "source_url": "https://es.wikipedia.org/wiki/Agrimonia_eupatoria",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 172267269,
      "text": "Agrimonia eupatoria L. es una planta que habita en terrenos arcillosos, en lugares soleados junto a cultivos, setos o pendientes y árboles como encinas o robles."
    },
    "fr": {
      "source": "Wikipedia (fr): Aigremoine eupatoire",
      "source_url": "https://fr.wikipedia.org/wiki/Aigremoine_eupatoire",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 236031040,
      "text": "L'Aigremoine eupatoire est une espèce de plantes à fleurs de la famille des Rosacées, de moins d'un mètre de hauteur, portant un long épi dressé de petites fleurs jaunes, d'origine eurasiatique, commune dans toute l'Europe et s’étendant jusqu’à l’Afghanistan et au nord-ouest de l’Afrique."
    },
    "pt": {
      "source": "Wikipedia (pt): Agrimonia eupatoria",
      "source_url": "https://pt.wikipedia.org/wiki/Agrimonia_eupatoria",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 63035547,
      "text": "A Agrimonia eupatoria, comummente conhecida como agrimónia, é uma planta herbácea, pertencente à família das Rosáceas e ao tipo fisionómico dos hemicriptófitos, dotada de caule vertical, flores amarelas e frutos ásperos, que tem sido utilizada pelo Homem, ao longo dos tempos, por causa das suas propriedades medicinais."
    }
  },
  "sections": {
    "toxicity": {
      "pt": {
        "source": "Wikipedia (pt): Agrimonia eupatoria § Toxicidade",
        "source_url": "https://pt.wikipedia.org/wiki/Agrimonia_eupatoria#Toxicidade",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 63035547,
        "heading": "Toxicidade",
        "text": "A agrimónia tem uma toxicidade fotossensibilizante.\nEsta planta contém os seguintes compostos químicos: ácido salicilíco, ácido ursólico e quercetina.\nContém um óleo particular volátil, que pode ser obtido através de destilação, e compostos ásperos e amargos, que dão essa propriedade à planta. As folhas e o caule possuem contêm 5% de tanino, ácido salicílico e óleos essenciais.",
        "truncated": false
      }
    }
  },
