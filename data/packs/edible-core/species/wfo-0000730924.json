  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「アダン」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%A2%E3%83%80%E3%83%B3",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 108691459,
      "text": "アダン は、タコノキ科タコノキ属の常緑小高木。亜熱帯から熱帯の海岸近くに生育し、非常に密集した群落を作る。時にマングローブに混生して成育する。"
    },
    "en": {
      "source": "Wikipedia 英語版「Pandanus odorifer」",
      "source_url": "https://en.wikipedia.org/wiki/Pandanus_odorifer",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1373311474,
      "text": "Pandanus odorifer is an aromatic monocot species of plant in the family Pandanaceae, native to South East Asia, the Andaman Islands, the Philippines, and is also found wild in southern India and Burma. It is commonly known as fragrant screw-pine."
    }
