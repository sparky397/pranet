      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 174574083,
      "text": "Solanum scabrum es una especie de planta fanerógama perteneciente a la familia de las solanáceas."
    }
