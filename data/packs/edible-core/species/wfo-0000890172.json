  "description": {
    "ja": {
      "source": "Wikipedia (ja): ヨシ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%A8%E3%82%B7",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 111093135,
      "text": "ヨシ は、イネ科ヨシ属の多年草。河川および湖沼の水際に背の高い群落を形成する。別名、アシ、キタヨシ。日本ではセイタカヨシ およびツルヨシ を別種とする扱いが主流である。"
    },
    "en": {
      "source": "Wikipedia (en): Phragmites australis",
      "source_url": "https://en.wikipedia.org/wiki/Phragmites_australis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1378516105,
      "text": "Phragmites australis, the common reed, is a species of flowering plant in the grass family Poaceae. It is a wetland grass that can grow up to 2–6 metres (7–20 ft) tall and has a cosmopolitan distribution worldwide."
    },
    "es": {
      "source": "Wikipedia (es): Phragmites australis",
      "source_url": "https://es.wikipedia.org/wiki/Phragmites_australis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 174580290,
      "text": "El carrizo es una especie de caña del género Phragmites de la familia Poaceae."
    },
    "fr": {
      "source": "Wikipedia (fr): Roseau commun",
      "source_url": "https://fr.wikipedia.org/wiki/Roseau_commun",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 238964761,
      "text": "Le Roseau commun, Roseau à balais ou Sagne est une espèce cosmopolite de plantes herbacées vivaces de la famille des Poaceae, sous-famille des Arundinoideae."
    },
    "pt": {
      "source": "Wikipedia (pt): Phragmites australis",
      "source_url": "https://pt.wikipedia.org/wiki/Phragmites_australis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 71093107,
      "text": "Phragmites australis é uma espécie de planta com flor pertencente à família Poaceae."
    }
  },
  "sections": {
    "uses": {
      "ja": {
        "source": "Wikipedia (ja): ヨシ § 生薬",
        "source_url": "https://ja.wikipedia.org/wiki/%E3%83%A8%E3%82%B7#%E7%94%9F%E8%96%AC",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 111093135,
        "heading": "生薬",
        "text": "根茎を乾燥したものは生薬になり、蘆根（ろこん）と称して、漢方では利尿、消炎、止渇、鎮吐に処方されている。蘆根は、秋に根茎を掘り採って水洗いし、細根を取り除いて長さ2cmほどに刻み、むしろに広げて天日乾燥させて調製される。民間療法では、むくみ、吐き気止めの薬として利用され、1回量5 - 10gを水200ccで半量になるまで煎じて頓服される。",
        "truncated": false
      },
      "en": {
        "source": "Wikipedia (en): Phragmites australis § Uses",
        "source_url": "https://en.wikipedia.org/wiki/Phragmites_australis#Uses",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1378516105,
        "heading": "Uses",
        "text": "Common reed is the primary source of thatch for traditional roof thatching in Europe and beyond. The plant is extensively used in phytoremediation, or natural water treatment systems, since the root hairs are excellent at filtering out impurities in waste water. It also shows excellent potential as a source of biomass.\nStems can be made into eco-friendly drinking straws. Many parts of the plant can be eaten. The young shoots can be consumed raw or cooked. The hardened sap from damaged stems can be eaten fresh or toasted. The stems can be dried, ground, sifted, hydrated, and toasted like marshmallows. The seeds can be crushed, mixed with berries and water, and cooked to make a gruel. The roots can be prepared similar to those of cattails.",
        "truncated": false
      },
      "es": {
        "source": "Wikipedia (es): Phragmites australis § Usos",
        "source_url": "https://es.wikipedia.org/wiki/Phragmites_australis#Usos",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 174580290,
        "heading": "Usos",
        "text": "Esta caña ha sido utilizada tradicionalmente para techar chozas y preparar cercados en algunos lugares.",
        "truncated": false
      },
      "fr": {
        "source": "Wikipedia (fr): Roseau commun § Utilisations",
        "source_url": "https://fr.wikipedia.org/wiki/Roseau_commun#Utilisations",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 238964761,
        "heading": "Utilisations",
        "text": "Les roseaux étaient et sont toujours utilisés localement, dans la constitution de murs et toitures des maisons (mudhif des Arabes des marais en Mésopotamie), et pour fournir de la litière aux animaux (vache allaitante notamment). \nIls constituent un abri de choix pour des passereaux et pour de petits mammifères. Ils sont aussi largement utilisés dans les stations d'épurations à filtre planté de roseaux (phytoépuration).\nLes patronymes Sagne, Sagnes, Sagnier, etc. sont liés aux anciens métiers d'exploitation de ces roseaux. Le toponyme La Seyne-sur-Mer est lié à la présence de roseaux sur le territoire.\nEn Camargue, le roseau est appelé sagne quand il est assez sec pour être coupé, récolté et devenir matériaux d'isolation et de construction. Il est utilisé dans la construction traditionnelle de la cabane camarguaise dite aussi cabane de gardian.",
        "truncated": false
      }
    },
    "toxicity": {
      "fr": {
        "source": "Wikipedia (fr): Roseau commun § Toxicité",
        "source_url": "https://fr.wikipedia.org/wiki/Roseau_commun#Toxicit%C3%A9",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 238964761,
        "heading": "Toxicité",
        "text": "La sous-espèce P. a. subsp. australis sécréterait de l'acide gallique, dégradé en acide mésogallique sous l'effet des ultraviolets naturels (photodécomposition), ce qui constituerait une explication allélopathique à sa tendance envahissante. Toutefois, on a récemment remis en question la sécrétion d'une telle substance par cette sous-espèce.",
        "truncated": false
      }
    }
  },
