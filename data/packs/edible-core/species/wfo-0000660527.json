  "description": {
    "en": {
      "source": "Wikipedia (en): Echinocactus horizonthalonius",
      "source_url": "https://en.wikipedia.org/wiki/Echinocactus_horizonthalonius",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1372649407,
      "text": "Echinocactus horizonthalonius is a species of cactus known by several common names, including devilshead, turk's head cactus, blue barrel cactus, eagle's claw, horse maimer, horse crippler, and visnaga meloncillo. It is native to the southwestern United States and northern Mexico, where it occurs in Chihuahuan Desert and Sonoran Desert habitats, particularly on limestone substrates. One of its varieties is a federally listed endangered species of the United States."
    },
    "es": {
      "source": "Wikipedia (es): Echinocactus horizonthalonius",
      "source_url": "https://es.wikipedia.org/wiki/Echinocactus_horizonthalonius",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 174457546,
      "text": "Echinocactus horizontalonius, conocida comúnmente como biznaga meloncillo, es una especie de planta suculenta perteneciente al género Echinocactus, dentro de la familia Cactaceae. Se distribuye desde el sur de Estados Unidos hasta México."
    },
    "fr": {
      "source": "Wikipedia (fr): Echinocactus horizonthalonius",
      "source_url": "https://fr.wikipedia.org/wiki/Echinocactus_horizonthalonius",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 213773514,
      "text": "Echinocactus horizonthalonius est une espèce de plantes à fleurs de la famille des cactus originaire des déserts de Sonora et de Chihuahua à cheval sur les États-Unis et le Mexique."
    }
  },
