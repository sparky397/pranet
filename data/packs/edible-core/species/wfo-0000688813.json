  "description": {
    "en": {
      "source": "Wikipedia (en): Ficus ingens",
      "source_url": "https://en.wikipedia.org/wiki/Ficus_ingens",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1373289450,
      "text": "Ficus ingens, the red-leaved fig, is a fig species with an extensive range in the subtropical to dry tropical regions of Africa and southern Arabia. Despite its specific name, which means \"huge\", or \"vast\", it is usually a shrub or tree of modest proportions. It is a fig of variable habit depending on the local climate and substrate, typically a stunted subshrub on elevated rocky ridges, or potentially a large tree on warmer plains and lowlands. In 1829 the missionary Robert Moffat found a rare giant specimen, into which seventeen thatch huts of a native tribe were placed, so as to be out of reach of lions."
    },
    "fr": {
      "source": "Wikipedia (fr): Ficus ingens",
      "source_url": "https://fr.wikipedia.org/wiki/Ficus_ingens",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 214102631,
      "text": "Ficus ingens est une espèce de plantes à fleurs du genre Ficus et de la famille des moracées. C'est un arbre présent en Éthiopie."
    }
  },
