  "description": {
    "en": {
      "source": "Wikipedia (en): Senna spectabilis",
      "source_url": "https://en.wikipedia.org/wiki/Senna_spectabilis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1343394140,
      "text": "Senna spectabilis is a plant species of the legume family (Fabaceae) in the subfamily Caesalpinioideae native to South and Central America. They are often grown as an ornamental in front yards, parks, gardens, buildings etc. due to their bright yellow flowers that bloom during the summer months. They are also known as golden wonder tree, American cassia, popcorn tree, Cassia excelsa, golden shower tree or Archibald's cassia."
    },
    "es": {
      "source": "Wikipedia (es): Senna spectabilis",
      "source_url": "https://es.wikipedia.org/wiki/Senna_spectabilis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171284840,
      "text": "Senna spectabilis, comúnmente llamada candelillo, carnavalito o mucuteno, es una especie de la familia Fabaceae distribuida por América del Sur y Central."
    },
    "fr": {
      "source": "Wikipedia (fr): Senna spectabilis",
      "source_url": "https://fr.wikipedia.org/wiki/Senna_spectabilis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 238758756,
      "text": "Senna spectabilis est une espèce de plantes à fleurs de la famille des Fabaceae. C'est un arbre originaire d'Amérique."
    },
    "pt": {
      "source": "Wikipedia (pt): Cassia spectabilis",
      "source_url": "https://pt.wikipedia.org/wiki/Cassia_spectabilis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 61431934,
      "text": "Cassia spectabilis é uma árvore da família das fabáceas, sub-família Caesalpinioideae, conhecida por diverosos nomes vulgares como Cássia, Cássia-do-nordeste, Cássia-macranta, Cássia-macrantera, Fedegoso, Fedegoso do Rio, Macrantera, Habú, Mwenu, Mhomba, ou Scented Shower."
    }
