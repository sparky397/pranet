  "description": {
    "ja": {
      "source": "Wikipedia (ja): メヒシバ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%A1%E3%83%92%E3%82%B7%E3%83%90",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 111091083,
      "text": "メヒシバ は、イネ科メヒシバ属の植物である。身近にごく普通に見られるイネ科の植物である。細い茎で地表を這い、立ち上がった花茎の先に、数本の細い穂を放射状に伸ばす。勢力の強い雑草としても知られる。メヒジワ、メシバとも呼ばれる。"
    },
    "en": {
      "source": "Wikipedia (en): Digitaria ciliaris",
      "source_url": "https://en.wikipedia.org/wiki/Digitaria_ciliaris",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1307973058,
      "text": "Digitaria ciliaris is a species of grass known by the common names southern crabgrass, tropical finger-grass, tropical crabgrass or summer grass."
    },
    "pt": {
      "source": "Wikipedia (pt): Digitaria ciliaris",
      "source_url": "https://pt.wikipedia.org/wiki/Digitaria_ciliaris",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 40536364,
      "text": "Digitaria ciliaris é uma espécie de planta com flor pertencente à família Poaceae."
    },
    "id": {
      "source": "Wikipedia (id): Rumput ceker ayam",
      "source_url": "https://id.wikipedia.org/wiki/Rumput_ceker_ayam",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29728912,
      "text": "Digitaria ciliaris adalah spesies rumput yang dikenal dengan nama umum rumput ceker ayam, rumput cakar ayam, atau rumput capit kepiting. Rumput ini dikenal sebagai \"ගුරු තණ - guru thana\" di Sri Lanka."
    }
  },
