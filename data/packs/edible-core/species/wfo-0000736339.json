  "description": {
    "ja": {
      "source": "Wikipedia (ja): バビショウ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%90%E3%83%93%E3%82%B7%E3%83%A7%E3%82%A6",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 106371844,
      "text": "バビショウ は、マツ科マツ属の常緑針葉樹である。複維管束亜属（いわゆる二葉松）に分類される。和名はタイワンアカマツ（台湾赤松）。"
    },
    "en": {
      "source": "Wikipedia (en): Pinus massoniana",
      "source_url": "https://en.wikipedia.org/wiki/Pinus_massoniana",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1375581940,
      "text": "Pinus massoniana, commonly known as Masson's pine or Chinese red pine, is a species of conifer in the family Pinaceae. It is a pine native to Taiwan, a wide area of central and southern China, including Hong Kong, and northern Vietnam."
    },
    "es": {
      "source": "Wikipedia (es): Pinus massoniana",
      "source_url": "https://es.wikipedia.org/wiki/Pinus_massoniana",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 167919964,
      "text": "Pinus massoniana es una especie de pino nativa de Taiwán, el centro y sur de China, y el norte de Vietnam; crece en altitudes bajas y moderadas, principalmente por debajo de mil quinientos metros, aunque raramente crece también a dos mil metros de altura."
    },
    "fr": {
      "source": "Wikipedia (fr): Pinus massoniana",
      "source_url": "https://fr.wikipedia.org/wiki/Pinus_massoniana",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 208077964,
      "text": "Pinus massoniana est une espèce de conifères de la famille des Pinaceae."
    },
    "pt": {
      "source": "Wikipedia (pt): Pinus massoniana",
      "source_url": "https://pt.wikipedia.org/wiki/Pinus_massoniana",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 63761293,
      "text": "Pinus massoniana é uma espécie de pinheiro originária do Velho Mundo, mais precisamente da região da Ásia."
    }
  },
  "sections": {
    "uses": {
      "ja": {
        "source": "Wikipedia (ja): バビショウ § 利用",
        "source_url": "https://ja.wikipedia.org/wiki/%E3%83%90%E3%83%93%E3%82%B7%E3%83%A7%E3%82%A6#%E5%88%A9%E7%94%A8",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 106371844,
        "heading": "利用",
        "text": "中国では、松脂を採取する木として重要であり、植林も計画的に行われている。植林後、約15年経つと、幹が松脂の採取が可能な直径に育つ。\n松脂を採取した後の木材は、枕木などの用途に用いられるほか、粉砕して、製紙用のパルプに利用されることが多い。\n葉は、紅茶の一種のラプサンスーチョンの香り付けにも用いられる。",
        "truncated": false
      },
      "en": {
        "source": "Wikipedia (en): Pinus massoniana § Uses",
        "source_url": "https://en.wikipedia.org/wiki/Pinus_massoniana#Uses",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1375581940,
        "heading": "Uses",
        "text": "The species is a common tree used in plantation forestry for replacing or compensating for the loss of the natural forest in southern China, owing to its tolerance of poor soils and drought conditions.  Its rapid growth makes it a valuable source of timber, which is used for furniture, construction, and pulp production for paper.\nPine trees (Pinus) are the primary source of rosin, with P. massoniana being one of the principal species used for rosin production in China.",
        "truncated": false
      },
      "es": {
        "source": "Wikipedia (es): Pinus massoniana § Usos",
        "source_url": "https://es.wikipedia.org/wiki/Pinus_massoniana#Usos",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 167919964,
        "heading": "Usos",
        "text": "En el sur de China es normal que se utilice la especie para reforestar y compensar la pérdida de bosque natural.​ La colofonia china se obtiene principalmente de la trementina del Pinus massoniana y del pino ellioti.\nLos troncos se utilizan principalmente para hacer pulpa para la industria de papel. Las hojas se usan para dar una sabor ahumado a los tes negros locales, tal como el lapsang souchong de Fujian.",
        "truncated": false
      }
    }
  },
