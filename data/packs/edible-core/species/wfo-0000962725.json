  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「チュウテンカク」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%81%E3%83%A5%E3%82%A6%E3%83%86%E3%83%B3%E3%82%AB%E3%82%AF",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 109596655,
      "text": "Euphorbia ingens はトウダイグサ属の植物の一種。園芸名はチュウテンカク（沖天閣）。ツリーユーフォルビア とも呼ばれる。"
    },
    "en": {
      "source": "Wikipedia 英語版「Euphorbia ingens」",
      "source_url": "https://en.wikipedia.org/wiki/Euphorbia_ingens",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1365703868,
      "text": "Euphorbia ingens is a species of flowering plant in the family Euphorbiaceae. It is native to dry areas of southern Africa. It is popularly known as the candelabra tree or naboom. Its milky latex can be extremely poisonous and is a dangerous irritant."
    }
  },
  "sections": {
    "toxicity": {
      "ja": {
        "source": "Wikipedia 日本語版「チュウテンカク」の節「毒性」",
        "source_url": "https://ja.wikipedia.org/wiki/%E3%83%81%E3%83%A5%E3%82%A6%E3%83%86%E3%83%B3%E3%82%AB%E3%82%AF#%E6%AF%92%E6%80%A7",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 109596655,
        "heading": "毒性",
        "text": "多肉質な枝の内側には白い乳液が含まれるが、これには強い刺激性や補発癌性を持つインゲノール（ingenol）ジテルペンエステルが含まれる。この乳液が傷口や目に入ると危険である。ケニアでは本種の乳液を伝統医療に使用しようと試みた結果、死亡事故が起きたという報告が数件存在する。\nまた、本種から得られた蜜にも刺激性があり、口に炎症を起こすため食用とすることはできないとされる。しかしケニアの乾燥地域において、本種は重要な蜜源植物である。",
        "truncated": false
      }
    }
  },
