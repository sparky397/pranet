  "description": {
    "ja": {
      "source": "Wikipedia (ja): フクマンギ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%95%E3%82%AF%E3%83%9E%E3%83%B3%E3%82%AE",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 107224056,
      "text": "フクマンギ は、ムラサキ科の低木。日本では琉球列島にあり、よく栽培される。"
    },
    "en": {
      "source": "Wikipedia (en): Ehretia microphylla",
      "source_url": "https://en.wikipedia.org/wiki/Ehretia_microphylla",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1328583972,
      "text": "Ehretia microphylla is commonly known as the Fukien tea tree or Philippine tea tree, is a species of flowering plant. The genus Ehretia is placed in the family Ehretiaceae."
    },
    "es": {
      "source": "Wikipedia (es): Ehretia microphylla",
      "source_url": "https://es.wikipedia.org/wiki/Ehretia_microphylla",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 175441115,
      "text": "Ehretia microphylla, conocida comúnmente como carmona, té de Filipinas, té de Fukien o arbusto escorpión, es un arbusto perennifolio de la familia Boraginaceae."
    },
    "fr": {
      "source": "Wikipedia (fr): Carmona retusa",
      "source_url": "https://fr.wikipedia.org/wiki/Carmona_retusa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 150931139,
      "text": "Carmona retusa est un arbuste subtropical de la famille des Boraginaceae, connu également sous son ancienne nomination Carmona microphylla ou tout simplement sous son nom de genre Carmona."
    },
    "pt": {
      "source": "Wikipedia (pt): Carmona retusa",
      "source_url": "https://pt.wikipedia.org/wiki/Carmona_retusa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 70156084,
      "text": "Carmona retusa, conhecida vulgarmente como carmona, chá de Filipinas, chá de Fukien ou arbusto escorpião, e em chinês como ji ji shu, é uma espécie de arbusto perenifólio da família Boraginaceae."
    },
    "id": {
      "source": "Wikipedia (id): Hokiantea",
      "source_url": "https://id.wikipedia.org/wiki/Hokiantea",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 27732654,
      "text": "Hokiantea, Hokianti, atau teh fukian adalah tumbuhan semak atau pohon kecil bercabang banyak. Biasanya tumbuh setinggi 1–4 meter, tetapi sesekali spesies ini mencapai tinggi hingga 10 meter."
    }
  },
