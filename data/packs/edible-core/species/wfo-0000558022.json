      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1035573057,
      "text": "Azima tetracantha is an ornamental plant in the Salvadoraceae family. Common Name: Bee Sting Bush. This plant is commonly known as 'Yashankala' in ayurveda. Its foliage is an important medicine for post-pregnancy treatments, the same is also used for 'karkidaka treatments' which is famous in Kerala."
    },
    "es": {
      "source": "Wikipedia (es): Azima tetracantha",
      "source_url": "https://es.wikipedia.org/wiki/Azima_tetracantha",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 153084994,
      "text": "Azima tetracantha es una especie de planta ornamental de la familia Salvadoraceae. Se encuentra en África y Madagascar."
    },
    "fr": {
      "source": "Wikipedia (fr): Azima tetracantha",
      "source_url": "https://fr.wikipedia.org/wiki/Azima_tetracantha",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 215294786,
      "text": "Azima tetracantha est une espèce de plantes à fleurs de la famille des Salvadoraceae. C'est une plante ornementale ayant aussi pour nom commun Bee Sting Bush et connue sous le nom de « Yashankala » en Ayurveda."
    }
