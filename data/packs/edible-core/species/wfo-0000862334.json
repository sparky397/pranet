  "description": {
    "en": {
      "source": "Wikipedia (en): Dendrocalamus hamiltonii",
      "source_url": "https://en.wikipedia.org/wiki/Dendrocalamus_hamiltonii",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1358161341,
      "text": "Dendrocalamus hamiltonii, or Hamilton's bamboo, is a species of bamboo, 12–15 cm in diameter and growing up to 15–18 m in height, found in South Asian countries such as, India, Sri Lanka, Bhutan, Nepal, Pakistan, and far eastern China."
    },
    "id": {
      "source": "Wikipedia (id): Dendrocalamus hamiltonii",
      "source_url": "https://id.wikipedia.org/wiki/Dendrocalamus_hamiltonii",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 29430490,
      "text": "Dendrocalamus hamiltonii, atau bambu Hamilton, adalah spesies bambu dengan diameter 12–15 cm dan tumbuh hingga ketinggian 15–18 m, ditemukan di negara-negara Asia Selatan seperti India, Sri Lanka, Bhutan, Nepal, Pakistan, dan wilayah paling timur Tiongkok."
    }
