  "description": {
    "en": {
      "source": "Wikipedia (en): Piptadeniastrum",
      "source_url": "https://en.wikipedia.org/wiki/Piptadeniastrum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1329482994,
      "text": "Piptadeniastrum africanum is a tall deciduous tree within the legume family, Fabaceae. It is native to the humid tropics of sub-Saharan Africa, ranging from Senegal to Sudan and Angola. It is the sole species in genus Piptadeniastrum. It is also called Piptadenia africana, and its timber is traded under the names Dabema or Dahoma. It commonly occurs in freshwater swamp forests but can also be found further north."
    },
    "fr": {
      "source": "Wikipedia (fr): Piptadeniastrum africanum",
      "source_url": "https://fr.wikipedia.org/wiki/Piptadeniastrum_africanum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 223757640,
      "text": "Piptadeniastrum africanum est une espèce de plantes à fleurs dicotylédones de la famille des Fabaceae, sous-famille des Mimosoideae. C'est un arbre originaire d'Afrique tropicale."
    }
