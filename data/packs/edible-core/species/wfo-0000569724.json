  "description": {
    "en": {
      "source": "Wikipedia (en): Boswellia sacra",
      "source_url": "https://en.wikipedia.org/wiki/Boswellia_sacra",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1362797773,
      "text": "Boswellia sacra, also known as Boswellia carteri and others, and commonly called the frankincense tree or the olibanum tree, is a tree in the genus Boswellia, in the Burseraceae family, from which frankincense, a resinous dried sap, is harvested. The olibanum tree is a plant native to the countries of Oman and Yemen, in the south of the Arabian Peninsula, and to Somalia and Ethiopia, in the Horn of Africa. In 2012, it was replanted in Israel in the Middle East, 1,500 years after dying out there."
    },
    "es": {
      "source": "Wikipedia (es): Boswellia sacra",
      "source_url": "https://es.wikipedia.org/wiki/Boswellia_sacra",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 175376510,
      "text": "Boswellia sacra, el árbol del incienso, es un árbol de la familia Burseraceae."
    },
    "fr": {
      "source": "Wikipedia (fr): Arbre à encens",
      "source_url": "https://fr.wikipedia.org/wiki/Arbre_%C3%A0_encens",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 222361874,
      "text": "L'arbre à encens est un arbre de la famille des Burséracées. Il est le principal représentant du genre Boswellia, d'où est extrait l'encens."
    },
    "pt": {
      "source": "Wikipedia (pt): Boswellia sacra",
      "source_url": "https://pt.wikipedia.org/wiki/Boswellia_sacra",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 72628007,
      "text": "Boswellia sacra, ou árvore do incenso, é uma espécie arbórea da família Burseraceae."
    },
    "id": {
      "source": "Wikipedia (id): Boswellia sacra",
      "source_url": "https://id.wikipedia.org/wiki/Boswellia_sacra",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 28976525,
      "text": "Boswellia sacra, juga dikenal sebagai Boswellia carteri dan lain-lain, dan biasa disebut pohon kemenyan atau pohon olibanum, adalah pohon dalam genus Boswellia, dalam keluarga Burseraceae, dari mana kemenyan, getah kering resin, dipanen. Pohon olibanum adalah tanaman asli negara Oman dan Yaman, di selatan Semenanjung Arab, dan Somalia, di Tanduk Afrika. IUCN mengklasifikasikannya sebagai spesies mendekati terancam."
    }
  },
