      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 28570865,
      "text": "Rumput israel adalah tanaman hias semi liar yang termasuk ke dalam Genus Asystasia. Tumbuhan ini termasuk tumbuhan yang banyak terdapat di tepi-tepi jalan, belukar dan ladang."
    }
