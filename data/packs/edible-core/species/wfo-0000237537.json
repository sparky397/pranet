  "description": {
    "en": {
      "source": "Wikipedia (en): Antidesma montanum",
      "source_url": "https://en.wikipedia.org/wiki/Antidesma_montanum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1379024747,
      "text": "Antidesma montanum is a species of tree in the family Phyllanthaceae, native to Southeast Asia, from India to the Philippines. It can grow up to 10 m (33 ft). The fruits are edible. Four varieties have been accepted, each of which has multiple synonyms, which include Antidesma obliquinervium for A. montanum var. montanum."
    },
    "id": {
      "source": "Wikipedia (id): Matan udang",
      "source_url": "https://id.wikipedia.org/wiki/Matan_udang",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 30025731,
      "text": "Antidesma montanum atau matan udang adalah spesies pohon dalam keluarga Phyllanthaceae, asli Asia Tenggara, dari India hingga Filipina. Itu bisa tumbuh hingga 10 m (33 ft). Buahnya bisa dimakan. Empat varietas telah diterima, masing-masing memiliki banyak sinonim, termasuk Antidesma obliquinervium untuk A. montanum var. montanum."
    }
  },
