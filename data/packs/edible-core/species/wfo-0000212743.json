  "description": {
    "ja": {
      "source": "Wikipedia (ja): スズメノエンドウ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%B9%E3%82%BA%E3%83%A1%E3%83%8E%E3%82%A8%E3%83%B3%E3%83%89%E3%82%A6",
