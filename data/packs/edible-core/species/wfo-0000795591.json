  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「グネモン」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%B0%E3%83%8D%E3%83%A2%E3%83%B3",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 109691649,
      "text": "グネモン はグネツム属の常緑低高木。主として東南アジアに分布する。インドネシアではメリンジョ（Melinjo）とも呼ばれる。"
    },
    "en": {
      "source": "Wikipedia 英語版「Gnetum gnemon」",
      "source_url": "https://en.wikipedia.org/wiki/Gnetum_gnemon",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1371891166,
      "text": "Gnetum gnemon is a gymnosperm species of Gnetum. Its native area spans from Mizoram and Assam in India down south through Malay Peninsula, Malay Archipelago and the Philippines in southeast Asia to the western Pacific islands. Common names include gnetum, joint fir, two leaf, melinjo/belinjo (Indonesian), bago/lumbay (Filipino), hanthu (Karbi) and tulip."
    }
