  "description": {
    "ja": {
      "source": "Wikipedia (ja): ナギナタコウジュ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%8A%E3%82%AE%E3%83%8A%E3%82%BF%E3%82%B3%E3%82%A6%E3%82%B8%E3%83%A5",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 106369229,
      "text": "ナギナタコウジュ は、シソ科ナギナタコウジュ属に分類される一年生草本の植物。"
    },
    "en": {
      "source": "Wikipedia (en): Elsholtzia ciliata",
      "source_url": "https://en.wikipedia.org/wiki/Elsholtzia_ciliata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1331588575,
      "text": "Elsholtzia ciliata, commonly known as Vietnamese balm, comb mint, xiang ru (香薷) or kinh giới in Vietnamese, is a flowering plant in the family Lamiaceae native to Asia. In the US, it is commonly known as crested late summer mint. In US Vietnamese grocery stores, it is called kinh gioi, Vietnamese lemon balm, or Vietnamese lemon mint."
    },
    "es": {
      "source": "Wikipedia (es): Elsholtzia ciliata",
      "source_url": "https://es.wikipedia.org/wiki/Elsholtzia_ciliata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 175452924,
      "text": "Elsholtzia ciliata, conocida comúnmente como bálsamo de limón, bálsamo de Vietnam, menta de limón, menta de Vietnam, en vietnamita: Kinh giới, lá kinh giớirau, rau kinh giới o en chino simplificado, 香薷; pinyin, Xiāngrú, es una especie de planta con flor de la familia Lamiaceae, y es endémica de Asia."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia (en): Elsholtzia ciliata § Cultivation",
        "source_url": "https://en.wikipedia.org/wiki/Elsholtzia_ciliata#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 1331588575,
        "heading": "Cultivation",
        "text": "It is cultivated as an ornamental plant. It prefers moist soil, and grows mostly on exposed rocky slopes and other open, gravelly areas.\nIt is banned in the state of Connecticut and is classified as a noxious weed. It was first reported in the Americas in 1889.",
        "truncated": false
      },
      "es": {
        "source": "Wikipedia (es): Elsholtzia ciliata § Cultivo",
        "source_url": "https://es.wikipedia.org/wiki/Elsholtzia_ciliata#Cultivo",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 175452924,
        "heading": "Cultivo",
        "text": "Se cultiva como planta ornamental. Prefiere suelos húmedos y crece principalmente en laderas rocosas expuestas y otras áreas abiertas con grava.​",
        "truncated": false
      }
    }
  },
