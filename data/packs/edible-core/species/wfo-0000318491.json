  "description": {
    "en": {
      "source": "Wikipedia (en): Syzygium cordatum",
      "source_url": "https://en.wikipedia.org/wiki/Syzygium_cordatum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1180022563,
      "text": "Syzygium cordatum is an evergreen, water-loving tree, which grows to a height of 8–15 m. This tree is often found near streams, on forest margins or in swampy spots. The leaves are elliptic to circular, bluish green on top and a paler green below. Young leaves are reddish. The white to pinkish fragrant flowers are borne in branched terminals and have numerous fluffy stamens and produce abundant nectar. It flowers from August to November. The fruits are oval berries, red to dark-purple when ripe."
    },
    "es": {
      "source": "Wikipedia (es): Syzygium cordatum",
      "source_url": "https://es.wikipedia.org/wiki/Syzygium_cordatum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 173474658,
      "text": "Syzygium cordatum es una especie de planta fanerógama perteneciente a la familia de las mirtáceas."
    },
    "fr": {
      "source": "Wikipedia (fr): Syzygium cordatum",
      "source_url": "https://fr.wikipedia.org/wiki/Syzygium_cordatum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 227662913,
      "text": "Syzygium cordatum est une espèce de plantes à fleurs de la famille des Myrtaceae et du genre Syzygium. C'est un arbre trouvé le long des cours d'eau du KwaZulu-Natal, du Zimbabwe et du Mozambique."
    }
