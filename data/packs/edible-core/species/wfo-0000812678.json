  "description": {
    "en": {
      "source": "Wikipedia (en): Castanopsis acuminatissima",
      "source_url": "https://en.wikipedia.org/wiki/Castanopsis_acuminatissima",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1375710307,
      "text": "Castanopsis acuminatissima is an evergreen tree native to Southeast Asia and New Guinea. It is known by a variety of common names over its range, including white oak, New Guinea oak, Papua New Guinea oak, ki riung, ko-duai, ko-soi, ko-mat, meranak, and riung anak."
    },
    "id": {
      "source": "Wikipedia (id): Berangan pagar anak",
      "source_url": "https://id.wikipedia.org/wiki/Berangan_pagar_anak",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29799041,
      "text": "Berangan pagar anak adalah sejenis pohon hijau abadi yang merupakan tumbuhan asli Asia Tenggara dan Irian. Ia juga dikenal dengan nama-nama lainnya, antara lain ki anak, riung anak (Sunda), meranak (Jawa), cunggalaa (Gorontalo), kaha, haleka, ko-duai, ko-soi, ko-mat (Thai), heye (Dani), dan ek papua."
    }
  },
