  "description": {
    "en": {
      "source": "Wikipedia (en): Baccaurea polyneura",
      "source_url": "https://en.wikipedia.org/wiki/Baccaurea_polyneura",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1360409791,
      "text": "Baccaurea polyneura is a species of plant in the family Phyllanthaceae. It is native to Sumatra, Borneo, Java, Peninsular Malaysia, Singapore and Peninsular Thailand. The fruit, called jentik, is edible, if sour, and is locally harvested and sold."
    },
    "id": {
      "source": "Wikipedia (id): Si jentik",
      "source_url": "https://id.wikipedia.org/wiki/Si_jentik",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29668790,
      "text": "Baccaurea polyneura adalah spesies tumbuhan dalam keluarga Phyllanthaceae. Ia berasal dari Semenanjung Malaysia, dan pulau Sumatra di Indonesia. Buahnya, yang disebut jentik, dapat dimakan, jika asam, dan dipanen serta dijual secara lokal."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia (en): Baccaurea polyneura § Cultivation",
        "source_url": "https://en.wikipedia.org/wiki/Baccaurea_polyneura#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 1360409791,
        "heading": "Cultivation",
        "text": "Baccaurea polyneura grows in the wild on sand, clay, loam and granite soils. It flowers and fruits at a year old. As a dioecious plant, it requires both a male and female counterpart to be grown to cultivate fruit and seed.",
        "truncated": false
      },
      "id": {
        "source": "Wikipedia (id): Si jentik § Penanaman",
        "source_url": "https://id.wikipedia.org/wiki/Si_jentik#Penanaman",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 29668790,
        "heading": "Penanaman",
        "text": "Baccaurea polyneura tumbuh di alam liar di tanah pasir, tanah liat, lempung dan granit. Ia berbunga dan berbuah sepanjang tahun. Sebagai tanaman berumah dua, tanaman ini membutuhkan tanaman jantan dan betina untuk ditanam guna menghasilkan buah dan biji.",
        "truncated": false
      }
    }
  },
