  "description": {
    "en": {
      "source": "Wikipedia (en): Gypsophila vaccaria",
      "source_url": "https://en.wikipedia.org/wiki/Gypsophila_vaccaria",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1297708198,
      "text": "Gypsophila vaccaria is a species of flowering plant in the family Caryophyllaceae. It is native from Portugal and Morocco to the Himalayas, and has been introduced into temperate areas worldwide. Among its many synonyms is Vaccaria hispanica, which was the only species placed in the genus Vaccaria. It is known by several common names including cowherb, cowcockle, cow basil, cow soapwort, and prairie carnation. It is an annual herb with blue-gray, waxy herbage and pale pink flowers."
    },
    "es": {
      "source": "Wikipedia (es): Gypsophila vaccaria",
      "source_url": "https://es.wikipedia.org/wiki/Gypsophila_vaccaria",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 175415961,
      "text": "Gypsophila vaccaria es una especie de planta con flores perteneciente a la familia Caryophyllaceae. Es originaria de Eurasia y Macaronesia."
    },
    "fr": {
      "source": "Wikipedia (fr): Vaccaria hispanica",
      "source_url": "https://fr.wikipedia.org/wiki/Vaccaria_hispanica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 230309765,
      "text": "Vaccaria hispanica est une espèce de plantes à fleurs de la famille des Caryophyllaceae. Elle est appelée saponaire des vaches, vachère d'Espagne, Cow soapwort ou cowcockle au Canada."
    },
    "pt": {
      "source": "Wikipedia (pt): Vaccaria hispanica",
      "source_url": "https://pt.wikipedia.org/wiki/Vaccaria_hispanica",
      "license": "CC BY-SA 4.0",
