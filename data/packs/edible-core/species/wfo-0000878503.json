  "description": {
    "ja": {
      "source": "Wikipedia (ja): ドクムギ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%89%E3%82%AF%E3%83%A0%E3%82%AE",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 107273749,
      "text": "ドクムギ は、イネ科の道端や荒れ地でたまに見られる雑草の一つ。"
    },
    "en": {
      "source": "Wikipedia (en): Lolium temulentum",
      "source_url": "https://en.wikipedia.org/wiki/Lolium_temulentum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1375268642,
      "text": "Lolium temulentum, commonly known as darnel, poison darnel, darnel ryegrass or cockle, is an annual flowering plant in the grass family Poaceae. The plant stem can grow up to one meter tall, with inflorescence in the ears and purple grain. It has a cosmopolitan distribution."
    },
    "es": {
      "source": "Wikipedia (es): Lolium temulentum",
      "source_url": "https://es.wikipedia.org/wiki/Lolium_temulentum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 173480605,
      "text": "Lolium temulentum, conocido comúnmente como cizaña, espantapájaros o, en desuso, lolio es una planta anual perteneciente a la familia de las Gramíneas y al género Lolium."
    },
    "fr": {
      "source": "Wikipedia (fr): Lolium temulentum",
      "source_url": "https://fr.wikipedia.org/wiki/Lolium_temulentum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 227571171,
      "text": "Lolium temulentum est une espèce de plantes monocotylédones de la famille des Poaceae."
    },
    "pt": {
      "source": "Wikipedia (pt): Lolium temulentum",
      "source_url": "https://pt.wikipedia.org/wiki/Lolium_temulentum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 72052326,
      "text": "Lolium temulentum é uma espécie de planta com flor pertencente à família Poaceae."
    },
    "id": {
      "source": "Wikipedia (id): Lolium temulentum",
      "source_url": "https://id.wikipedia.org/wiki/Lolium_temulentum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 28104568,
      "text": "Lolium temulentum, atau \"lalang\", adalah tumbuhan rumput tahunan yang tergolong ke dalam familia Poaceae, genus Lolium. Batang tumbuhan ini dapat mencapai ketinggian satu meter, dengan infloresens pada telinga dan biji berwarna ungu tua. Penyebarannya adalah di seluruh dunia (kosmopolitan)."
    }
