    "cultivation": {
      "id": {
        "source": "Wikipedia (id): Ketepeng kecil § Penanaman",
        "source_url": "https://id.wikipedia.org/wiki/Ketepeng_kecil#Penanaman",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 29706133,
        "heading": "Penanaman",
        "text": "Rendam benih selama 2–3 jam dalam air hangat sebelum disemai dari awal musim semi hingga awal musim panas di rumah kaca atau pot yang hangat di rumah Anda sendiri. Benih biasanya berkecambah dalam 1–12 minggu pada suhu 23 °C. Senna tora dapat ditransplantasikan. </link>",
        "truncated": false
      }
    }
  },
