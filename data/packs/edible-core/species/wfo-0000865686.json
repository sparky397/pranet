  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「シコクビエ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%B7%E3%82%B3%E3%82%AF%E3%83%93%E3%82%A8",
