  "description": {
    "en": {
      "source": "Wikipedia (en): Allium scorodoprasum",
      "source_url": "https://en.wikipedia.org/wiki/Allium_scorodoprasum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1308225960,
      "text": "The sand leek, also known as rocambole and Korean pickled-peel garlic, is a Eurasian species of wild onion with a native range extending across much of Europe, Middle East, and Korea."
    },
    "es": {
      "source": "Wikipedia (es): Allium scorodoprasum",
      "source_url": "https://es.wikipedia.org/wiki/Allium_scorodoprasum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 173486416,
      "text": "Allium scorodoprasum es una especie de planta bulbosa del género Allium, perteneciente a la familia de las amarilidáceas, del orden de las Asparagales.\nSe distribuye por las regiones templadas del Hemisferio Norte."
    },
    "fr": {
      "source": "Wikipedia (fr): Ail rocambole",
      "source_url": "https://fr.wikipedia.org/wiki/Ail_rocambole",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 235340171,
      "text": "L’ail rocambole ou la rocambole est une espèce de plantes herbacées, haute de 20 à 40 cm, vivace par son bulbe et ses bulbilles floraux."
    },
    "pt": {
      "source": "Wikipedia (pt): Alho-de-espanha",
      "source_url": "https://pt.wikipedia.org/wiki/Alho-de-espanha",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 61040813,
      "text": "O alho-de-espanha, alho-espanhol, alho-grosso-de-espanha, alho-mourisco, alho-rocambole ou, simplesmente, rocambole, é uma planta perene da família Alliaceae. É nativa da Europa. O bolbo subterrâneo é composto de bolbilhos de forma ovóide. As flores são vermelho-escuras ou púrpura. Pode ser usada em substituição do alho."
    },
    "id": {
      "source": "Wikipedia (id): Allium scorodoprasum",
      "source_url": "https://id.wikipedia.org/wiki/Allium_scorodoprasum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 26157756,
      "text": "Allium scorodoprasum adalah spesies tumbuhan yang tergolong ke dalam famili Amaryllidaceae. Spesies ini juga merupakan bagian dari ordo Asparagales. Spesies Allium scorodoprasum sendiri merupakan bagian dari genus bawang Allium. Nama ilmiah dari spesies ini pertama kali diterbitkan oleh L.."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia (en): Allium scorodoprasum § Cultivation",
        "source_url": "https://en.wikipedia.org/wiki/Allium_scorodoprasum#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 1308225960,
        "heading": "Cultivation",
        "text": "A. scorodoprasum is edible, but rarely cultivated, and has a shorter flower stalk and fewer and more inconsistently shaped cloves than Rocambole garlic. Sand leek also has a dark violet bulb wrapper.\nElephant garlic (properly A. ampeloprasum var. ampeloprasum) is also sometimes incorrectly sold as A. scorodoprasum.",
        "truncated": false
      }
    }
