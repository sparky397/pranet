  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ニッパヤシ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%8B%E3%83%83%E3%83%91%E3%83%A4%E3%82%B7",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 106369866,
      "text": "ニッパヤシ はヤシ科の植物であり、熱帯から亜熱帯の干潟などの潮間帯に生育するマングローブ植物。根元から分枝し、幹を持たないのが特徴。なおニッパヤシ属で現存するのは本種一種のみの一属一種であるが、近縁種の果実は7000万年前の地層から化石として発見されている。中国名は、水椰。"
    },
    "en": {
      "source": "Wikipedia 英語版「Nypa fruticans」",
      "source_url": "https://en.wikipedia.org/wiki/Nypa_fruticans",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1378394999,
      "text": "Nypa fruticans, commonly known as the nipa palm or mangrove palm, is a species of palm native to the coastlines and estuarine habitats of the Indian and Pacific Oceans. It is the only palm considered adapted to the mangrove biome. The genus Nypa and the subfamily Nypoideae are monotypic taxa because this species is their only member."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Nypa fruticans」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Nypa_fruticans#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1378394999,
        "heading": "Cultivation",
        "text": "Wild stands of N. fruticans can be managed to optimize sap production by thinning to desired densities and through traditional farm management techniques.\nIn cultivation, N. fruticans readily propagates via rhizome divisions.\nPests of young seedlings include grapsid crabs, as well as monkeys and pigs, which have been reported to cause damage to plantations.\nSap is collected from the cut flower stalk, and traditional tapping methods vary by region; harvesters often repeatedly bend or kick the stalk to increase sap yield as part of local practice.",
        "truncated": false
      }
    }
  },
