  "description": {
    "ja": {
      "source": "Wikipedia (ja): リュウキュウトロロアオイ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%AA%E3%83%A5%E3%82%A6%E3%82%AD%E3%83%A5%E3%82%A6%E3%83%88%E3%83%AD%E3%83%AD%E3%82%A2%E3%82%AA%E3%82%A4",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 107039880,
      "text": "リュウキュウトロロアオイ はアオイ科トロロアオイ属の一年生草本。Hibiscus abelmoschusはシノニム。"
    },
    "en": {
      "source": "Wikipedia (en): Abelmoschus moschatus",
      "source_url": "https://en.wikipedia.org/wiki/Abelmoschus_moschatus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1378033270,
      "text": "Abelmoschus moschatus is an aromatic and species of medicinal plant in the family Malvaceae native to Asia and Australia. It has many common names, including Abelmosk, ambrette, annual hibiscus, Bamia Moschata, Galu Gasturi, muskdana, musk mallow, musk okra, ornamental okra, rose mallow, tropical jewel hibiscus, and Yorka okra."
    },
    "es": {
      "source": "Wikipedia (es): Abelmoschus moschatus",
      "source_url": "https://es.wikipedia.org/wiki/Abelmoschus_moschatus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171582817,
      "text": "Abelmoschus moschatus (L.) Medik., el abelmosco, ambreta o hibisco es una planta de la familia de las malváceas, natural de Egipto, India y costa Malabar. Originalmente fue clasificada como parte del género Hibiscus, pero ahora se la clasifica en el género Abelmoschus."
    },
    "fr": {
      "source": "Wikipedia (fr): Ambrette",
      "source_url": "https://fr.wikipedia.org/wiki/Ambrette",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 237327798,
      "text": "L'ambrette est une espèce de plante herbacée du genre Abelmoschus, appartenant à la famille des Malvaceae, originaire de l'Inde et des régions tropicales d'Asie et d'Australasie. Elle est largement cultivée pour ses graines dont on tire une huile essentielle à odeur musquée."
    },
    "pt": {
      "source": "Wikipedia (pt): Abelmosco",
      "source_url": "https://pt.wikipedia.org/wiki/Abelmosco",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 61415891,
      "text": "Abelmosco é uma planta da Ásia e da América do Sul, da família Malvaceae, frequente na antiga África portuguesa, de cujas sementes, de forte cheiro a almíscar, se fabricavam os pós de Chipre."
    },
    "id": {
      "source": "Wikipedia (id): Kapasan",
      "source_url": "https://id.wikipedia.org/wiki/Kapasan",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29670283,
      "text": "Kapasan adalah tumbuhan liar yang tergolong famili malvaceae yang dikenal sebagai penghasil minyak kasturi."
    }
  },
