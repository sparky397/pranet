  "description": {
    "en": {
      "source": "Wikipedia (en): Alocasia macrorrhizos",
      "source_url": "https://en.wikipedia.org/wiki/Alocasia_macrorrhizos",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1365341606,
      "text": "Alocasia macrorrhizos is a species of flowering plant in the arum family (Araceae) that is native to rainforests of Maritime Southeast Asia, New Guinea, and the Murray Islands group in the Torres Strait of Australia. It has long been cultivated in South Asia, the Philippines, many Pacific islands, and elsewhere in the tropics, in the order of tens of thousands of years. Common names include giant taro, giant alocasia, ʻape, biga, and pia. In Australia it is known as the cunjevoi."
    },
    "fr": {
      "source": "Wikipedia (fr): Alocasia macrorrhizos",
      "source_url": "https://fr.wikipedia.org/wiki/Alocasia_macrorrhizos",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 238005689,
      "text": "Le Songe caraïbe, Alocasia macrorrhizos (L.) G. Don, est une espèce de plantes de la famille des Araceae, originaire de l'Asie du Sud-Est. Elle est aussi appelée Alocasie, Alocasie à grandes racines, Alocasie à grosse racine, taro géant ou oreille d'éléphant."
    },
    "pt": {
      "source": "Wikipedia (pt): Alocasia macrorrhizos",
      "source_url": "https://pt.wikipedia.org/wiki/Alocasia_macrorrhizos",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 72671360,
      "text": "A orelha-de-elefante é uma espécie de planta com flor da família Araceae, nativa das florestas tropicais do Sudeste Asiático Marítimo, da Nova Guiné e do grupo das Ilhas Murray, no Estreito de Torres, Austrália. É cultivada há muito tempo no Sul da Ásia, nas Filipinas, em muitas ilhas do Pacífico e em outras regiões tropicais, provavelmente há dezenas de milhares de anos."
    },
    "id": {
      "source": "Wikipedia (id): Birah besar",
      "source_url": "https://id.wikipedia.org/wiki/Birah_besar",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29157211,
      "text": "Birah besar atau Alocasia macrorrhizos merupakan tumbuhan penghasil umbi yang dapat dimakan. Bira dikenal pula dengan nama asal bahasa Jawa, sente."
    }
  },
  "sections": {
    "toxicity": {
      "fr": {
        "source": "Wikipedia (fr): Alocasia macrorrhizos § Toxicité",
        "source_url": "https://fr.wikipedia.org/wiki/Alocasia_macrorrhizos#Toxicit%C3%A9",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 238005689,
        "heading": "Toxicité",
        "text": "L'ensemble de la plante (feuilles, tiges, racines et fruits) contient des cristaux d'oxalate de calcium (raphides) ainsi que des protéines irritantes, la rendant toxique en cas d'ingestion sans préparation appropriée. Consommée crue ou pas assez cuite, la plante peut provoquer des troubles neurologiques, gastro-intestinaux ainsi que de graves brûlures des muqueuses. Paradoxalement, le rhizome est consommé comme aliment de base dans de nombreuses régions du Pacifique et d'Asie du Sud-Est, mais uniquement après une cuisson prolongée qui détruit ces composés irritants. En Nouvelle-Calédonie, la plante pouvait constituer une nourriture de disette, après une cuisson longue sur des pierres chaudes.\nPlusieurs cas d'empoisonnement ont été recensés à la suite de l'ingestion de la racine.",
        "truncated": false
      }
    }
  },
