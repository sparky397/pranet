  "description": {
    "en": {
      "source": "Wikipedia (en): Mussaenda frondosa",
      "source_url": "https://en.wikipedia.org/wiki/Mussaenda_frondosa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1293208762,
      "text": "Mussaenda frondosa, commonly known as the wild mussaenda or dhobi tree, is a plant of family Rubiaceae. It is a shrub that grows to about 1.5–2 m tall. Like most other Mussaenda species, they have a bract beneath their flowers, which in this species is white in colour."
    },
    "es": {
      "source": "Wikipedia (es): Mussaenda frondosa",
      "source_url": "https://es.wikipedia.org/wiki/Mussaenda_frondosa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171581392,
      "text": "Mussaenda frondosa es una especie de plantas con flores perteneciente a la familia de las rubiáceas. Se encuentra en Asia."
    },
    "id": {
      "source": "Wikipedia (id): Kingkilaban",
      "source_url": "https://id.wikipedia.org/wiki/Kingkilaban",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 28701177,
      "text": "Kingkilaban adalah tanaman Indonesia yang dikenal menarik perhatian kupu-kupu karena bentuk bunganya yang seperti terompet. Tanaman ini juga dikenal sebagai makanan tupai. Di Indonesia, tanaman ini selain dikenal sebagai kingkilaban, dikenal juga dengan nama walek adep (Jw.), dan ai kabeaku (Sumb.)."
    }
  },
