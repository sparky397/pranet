        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-12",
        "revision": 1367587113,
        "heading": "Toxicity",
        "text": "All parts of the plant are toxic to human and mammals, with reported poisoning cases. This is due to the presence of saponins and alkaloids (phytolaccatoxin and phytolaccagenin).",
        "truncated": false
      }
    }
