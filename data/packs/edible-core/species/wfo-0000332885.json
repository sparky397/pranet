  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「シアーバターノキ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%B7%E3%82%A2%E3%83%BC%E3%83%90%E3%82%BF%E3%83%BC%E3%83%8E%E3%82%AD",
