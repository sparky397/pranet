  "description": {
    "ja": {
      "source": "Wikipedia (ja): ビリンビ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%93%E3%83%AA%E3%83%B3%E3%83%93",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 110300750,
      "text": "ビリンビ はカタバミ科ゴレンシ属の常緑低木〜高木。"
    },
    "en": {
      "source": "Wikipedia (en): Averrhoa bilimbi",
      "source_url": "https://en.wikipedia.org/wiki/Averrhoa_bilimbi",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1375456625,
      "text": "Averrhoa bilimbi is a fruit-bearing tree in the family Oxalidaceae. It is native to the Maluku Islands and Sulawesi in Indonesia, and has become naturalised and is common throughout Southeast Asia. It is cultivated in parts of tropical South Asia and the Americas. It bears edible but extremely sour fruit. It is a close relative of the carambola tree."
    },
    "es": {
      "source": "Wikipedia (es): Averrhoa bilimbi",
      "source_url": "https://es.wikipedia.org/wiki/Averrhoa_bilimbi",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 174786188,
      "text": "Averrhoa bilimbi es un árbol que produce frutos del género Averrhoa, familia Oxalidaceae. Se encuentra relacionado con el árbol carambola."
    },
    "fr": {
      "source": "Wikipedia (fr): Bilimbi",
      "source_url": "https://fr.wikipedia.org/wiki/Bilimbi",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 237058021,
      "text": "Le bilimbi est un arbre fruitier de la famille des Oxalidacées, aussi appelé arbre à cornichons pour ses fruits comestibles, semblables à des cornichons translucides."
    },
    "pt": {
      "source": "Wikipedia (pt): Bilimbi",
      "source_url": "https://pt.wikipedia.org/wiki/Bilimbi",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 72822016,
      "text": "O bilimbi, c onhecido também como biribiri, bilimbim, bilimbino, biro-biro, piripiri, piri-piri, caramboleira-amarela, limão-de-caiena, limão caiano, groselheira, azedinha,limão-japonês, e limãozinho é uma planta tropical da família Oxalidaceae."
    },
    "id": {
      "source": "Wikipedia (id): Belimbing sayur",
      "source_url": "https://id.wikipedia.org/wiki/Belimbing_sayur",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29798655,
      "text": "Belimbing sayur, atau binang merupakan sejenis pohon kecil yang diperkirakan berasal dari Kepulauan Maluku, dan dikembangbiakkan serta tumbuh bebas di Indonesia, Filipina, India, Sri Lanka, Myanmar, dan Malaysia. Tumbuhan ini biasa ditanam di pekarangan untuk diambil buahnya yang memiliki bentuk lonjong dengan warna hijau muda mengilap dengan rasa asam yang sering digunakan sebagai bumbu masakan, sambal, dan campuran ramuan jamu."
    }
  },
