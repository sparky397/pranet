      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 160507270,
      "text": "El pajo o pao de Filipinas es una especie de mango perteneciente a la familia de las anacardiáceas."
    },
    "pt": {
