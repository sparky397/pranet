  "description": {
    "en": {
      "source": "Wikipedia (en): Ceriops tagal",
      "source_url": "https://en.wikipedia.org/wiki/Ceriops_tagal",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1374204690,
      "text": "Ceriops tagal, commonly known as spurred mangrove or Indian mangrove, is a mangrove tree species in the family Rhizophoraceae. It is a protected tree in South Africa. The specific epithet tagal is a plant name from the Tagalog language."
    },
    "es": {
      "source": "Wikipedia (es): Ceriops tagal",
      "source_url": "https://es.wikipedia.org/wiki/Ceriops_tagal",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 174601877,
      "text": "Ceriops tagal es una especie de plantas en la familia de las Rhizophoraceae. Crece desde África oriental hasta las islas del centro-occidental del Pacífico [Peter K & Sivasothi N. (eds.)]. 2001. Archivado el 5 de octubre de 2009 en Wayback Machine.."
    },
    "fr": {
      "source": "Wikipedia (fr): Ceriops tagal",
      "source_url": "https://fr.wikipedia.org/wiki/Ceriops_tagal",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 229519242,
      "text": "Ceriops tagal est une espèce de plantes à fleurs de la famille des Rhizophoraceae. C'est un palétuvier présent dans les mangroves des rivages de l'océan Indien."
    },
    "id": {
      "source": "Wikipedia (id): Soga tingi",
      "source_url": "https://id.wikipedia.org/wiki/Soga_tingi",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 30062440,
      "text": "Ceriops tagal, umumnya dikenal sebagai soga tingi atau tengar putih adalah spesies pohon bakau dalam famili Rhizophoraceae. Ini adalah pohon yang dilindungi di Afrika Selatan. Julukan khusus tagal adalah nama tumbuhan dari bahasa Tagalog."
    }
