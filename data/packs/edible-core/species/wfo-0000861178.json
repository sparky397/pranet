  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ギョウギシバ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AE%E3%83%A7%E3%82%A6%E3%82%AE%E3%82%B7%E3%83%90",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 111091125,
      "text": "ギョウギシバ は、単子葉植物イネ科ギョウギシバ属の多年草。"
    },
    "en": {
      "source": "Wikipedia 英語版「Cynodon dactylon」",
      "source_url": "https://en.wikipedia.org/wiki/Cynodon_dactylon",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1375092034,
      "text": "Cynodon dactylon, commonly known as Bermuda grass or as couch grass in Australia and New Zealand, is a warm season grass found worldwide in warm and tropical climates. It is native to Europe, Africa, Australia, and much of Asia and has been introduced to the Americas."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Cynodon dactylon」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Cynodon_dactylon#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1375092034,
        "heading": "Cultivation",
        "text": "Cynodon dactylon is widely cultivated in warm climates all over the world between about 30° S and 30° N latitude, and in regions that receive between 625 and 1,750 mm (24.6 and 68.9 in) of rainfall a year, or less, if irrigation is available. For example, in the United States, it is grown mostly in the southern half of the country.\n\n■ Cultivars\nHundreds of cultivars have been created specifically for environmental tolerance and stakeholder requirements. New cultivars are released annually.",
        "truncated": false
      }
    },
    "toxicity": {
      "en": {
        "source": "Wikipedia 英語版「Cynodon dactylon」の節「Toxicity」",
        "source_url": "https://en.wikipedia.org/wiki/Cynodon_dactylon#Toxicity",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1375092034,
        "heading": "Toxicity",
        "text": "The hybrid variety Tifton 85, like some other grasses (e.g. sorghum), produces cyanide under certain conditions, and has been implicated in several livestock deaths.",
        "truncated": false
      }
    }
  },
