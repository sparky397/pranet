  "description": {
    "ja": {
      "source": "Wikipedia (ja): ギョウギシバ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AE%E3%83%A7%E3%82%A6%E3%82%AE%E3%82%B7%E3%83%90",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 111091125,
      "text": "ギョウギシバ は、単子葉植物イネ科ギョウギシバ属の多年草。"
    },
    "en": {
      "source": "Wikipedia (en): Cynodon dactylon",
      "source_url": "https://en.wikipedia.org/wiki/Cynodon_dactylon",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1375092034,
      "text": "Cynodon dactylon, commonly known as Bermuda grass or as couch grass in Australia and New Zealand, is a warm season grass found worldwide in warm and tropical climates. It is native to Europe, Africa, Australia, and much of Asia and has been introduced to the Americas."
    },
    "es": {
      "source": "Wikipedia (es): Cynodon dactylon",
      "source_url": "https://es.wikipedia.org/wiki/Cynodon_dactylon",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 172101104,
      "text": "Cynodon dactylon, la grama común, también conocida como césped, agramen o gramón, entre otros nombres, es una planta de la familia Poaceae nativa del norte de África y sur de Europa. El nombre en inglés de \"Bermuda Grass\" deriva de su abundancia como maleza en Bermudas. También es conocida por ser la más abundante en todo el mundo. Es una de las Diez Flores Sagradas de Kerala. Se utiliza en muchos países como pasto para ganadería, ornamental, en jardines o para controlar la erosión del suelo. Se considera una de las malezas más dañinas para la agricultura y los ecosistemas fuera de su área de distribución natural."
    },
    "fr": {
      "source": "Wikipedia (fr): Chiendent pied-de-poule",
      "source_url": "https://fr.wikipedia.org/wiki/Chiendent_pied-de-poule",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 238513448,
      "text": "Cynodon dactylon ou Chiendent pied-de-poule, également désigné par l'anglicisme Bermuda grass est une espèce de plantes herbacées de la famille des Poaceae (Graminées)."
    },
    "pt": {
      "source": "Wikipedia (pt): Cynodon dactylon",
      "source_url": "https://pt.wikipedia.org/wiki/Cynodon_dactylon",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 72765931,
      "text": "Cynodon dactylon é uma espécie de planta com flor pertencente à família Poaceae."
    },
    "id": {
      "source": "Wikipedia (id): Cynodon dactylon",
      "source_url": "https://id.wikipedia.org/wiki/Cynodon_dactylon",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29675174,
      "text": "Cynodon dactylon, disebut juga rumput bermuda, rumput Bahama, doab, dubo, dhoob, adalah rumput yang tumbuh di belahan bumi Timur. Rumputnya berwarna hijau-kelabu, tumbuh pendek hingga 2–15 cm dengan tepi yang kasar. Batangnya dapat tumbuh sampai 1–30 cm."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia (en): Cynodon dactylon § Cultivation",
        "source_url": "https://en.wikipedia.org/wiki/Cynodon_dactylon#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 1375092034,
        "heading": "Cultivation",
        "text": "Cynodon dactylon is widely cultivated in warm climates all over the world between about 30° S and 30° N latitude, and in regions that receive between 625 and 1,750 mm (24.6 and 68.9 in) of rainfall a year, or less, if irrigation is available. For example, in the United States, it is grown mostly in the southern half of the country.\n\n■ Cultivars\nHundreds of cultivars have been created specifically for environmental tolerance and stakeholder requirements. New cultivars are released annually.",
        "truncated": false
      }
    },
    "toxicity": {
      "en": {
        "source": "Wikipedia (en): Cynodon dactylon § Toxicity",
        "source_url": "https://en.wikipedia.org/wiki/Cynodon_dactylon#Toxicity",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 1375092034,
        "heading": "Toxicity",
        "text": "The hybrid variety Tifton 85, like some other grasses (e.g. sorghum), produces cyanide under certain conditions, and has been implicated in several livestock deaths.",
        "truncated": false
      }
    }
  },
