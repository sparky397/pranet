  "description": {
    "ja": {
      "source": "Wikipedia (ja): ヒメフヨウ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%92%E3%83%A1%E3%83%95%E3%83%A8%E3%82%A6",
      "license": "CC BY-SA 4.0",
