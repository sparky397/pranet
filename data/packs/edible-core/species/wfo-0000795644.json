  "sections": {
    "uses": {
      "en": {
        "source": "Wikipedia (en): Gnetum montanum § Traditional medicine",
        "source_url": "https://en.wikipedia.org/wiki/Gnetum_montanum#Traditional_medicine",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1373511863,
        "heading": "Traditional medicine",
        "text": "Gnetum montanum is a medicinal plant rich in stilbenes, traditionally used in Vietnam, China, and other Asian countries to treat inflammatory disorders. It is used to treat gouty arthritis in some parts of Asia. It is also used as a folk medicine in China for treatment of bronchitis. The plant is used in Vietnamese folk medicine to treat conditions such as gout and joint pain as well, which are associated with xanthine oxidase activity.",
        "truncated": false
      }
