  "description": {
    "en": {
      "source": "Wikipedia 英語版「Dalbergia sissoo」",
      "source_url": "https://en.wikipedia.org/wiki/Dalbergia_sissoo",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1369344605,
      "text": "Dalbergia sissoo, known commonly as North Indian rosewood or shisham, is a fast-growing, hardy, deciduous rosewood tree native to the Indian subcontinent and southern Iran. D. sissoo is a large, crooked tree with long, leathery leaves and whitish or pink flowers."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Dalbergia sissoo」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Dalbergia_sissoo#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1369344605,
        "heading": "Cultivation",
        "text": "Propagation takes place most commonly by root suckers, but also by seeds. When exposed to air, the seeds remain viable for only a few months, but if stored in secured vessels can last for as long as four years. Seeds should be soaked in water for 48 hours before sowing; 60% – 80% germination can be expected in 1–3 weeks. Seedlings require partial sun or full \nsun. In India, shisham wood trading and its uses are under government restrictions.",
        "truncated": false
      }
    }
  },
