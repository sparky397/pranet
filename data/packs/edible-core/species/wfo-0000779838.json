  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「タチノウゼン」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%BF%E3%83%81%E3%83%8E%E3%82%A6%E3%82%BC%E3%83%B3",
