  "description": {
    "en": {
      "source": "Wikipedia (en): Moricandia arvensis",
      "source_url": "https://en.wikipedia.org/wiki/Moricandia_arvensis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1329743240,
      "text": "Moricandia arvensis, the purple mistress, is a species of flowering plant in the family Brassicaceae. It has a broadly western Mediterranean distribution, from the Canary Islands to northern Africa including Mauritania and Chad, the Iberian Peninsula, Italy and as far as Greece, and has been introduced to France, Corsica, and Sardinia. It has an intermediate C3–C4 carbon fixation system, known as C2 photosynthesis."
    },
    "es": {
      "source": "Wikipedia (es): Moricandia arvensis",
      "source_url": "https://es.wikipedia.org/wiki/Moricandia_arvensis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171202683,
      "text": "Moricandia arvensis, la berza arvense o collejón, es una especie de planta anual o perenne, con tallos erectos, pero muy flexibles, de hasta 75 cm de altura que florece entre los meses de septiembre y junio. Es un vegetal oportunista, adaptado a la degradación y nitrificación de suelo."
    },
    "fr": {
      "source": "Wikipedia (fr): Moricandia arvensis",
      "source_url": "https://fr.wikipedia.org/wiki/Moricandia_arvensis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 228092299,
      "text": "Moricandia arvensis, qui a pour nom commun Moricandie des champs, Moricandie ou Chou des champs, est une espèce européenne et africaine de plante à fleurs de la famille des Brassicaceae et du genre Moricandia."
    },
    "pt": {
      "source": "Wikipedia (pt): Moricandia arvensis",
