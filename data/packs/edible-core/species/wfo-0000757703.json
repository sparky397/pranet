  "description": {
    "en": {
      "source": "Wikipedia (en): Allium victorialis",
      "source_url": "https://en.wikipedia.org/wiki/Allium_victorialis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1306189769,
      "text": "Allium victorialis, commonly known as victory onion, Alpine leek, and Alpine broad-leaf allium is a broad-leaved Eurasian species of wild onion. It is a perennial of the Amaryllis family that occurs widely in mountainous regions of Europe and parts of Asia (Himalayas)."
    },
    "es": {
      "source": "Wikipedia (es): Allium victorialis",
      "source_url": "https://es.wikipedia.org/wiki/Allium_victorialis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 172740609,
      "text": "La victorial larga es una especie de planta bulbosa del género Allium, perteneciente a la familia de las amarilidáceas, del orden de las Asparagales.\nSe distribuye por el Hemisferio Norte."
    },
    "fr": {
      "source": "Wikipedia (fr): Ail de la Sainte-Victoire",
      "source_url": "https://fr.wikipedia.org/wiki/Ail_de_la_Sainte-Victoire",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 209135400,
      "text": "L'Ail victorial ou Ail de la Sainte-Victoire est une espèce de plantes herbacées. Elle appartient à la famille des Liliaceae selon la classification classique, à celle des Alliaceae puis à celle des Amaryllidaceae selon la classification phylogénétique APG III (2009)."
    },
    "id": {
      "source": "Wikipedia (id): Allium victorialis",
      "source_url": "https://id.wikipedia.org/wiki/Allium_victorialis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 26158062,
      "text": "Allium victorialis adalah spesies tumbuhan yang tergolong ke dalam famili Amaryllidaceae. Spesies ini juga merupakan bagian dari ordo Asparagales. Spesies Allium victorialis sendiri merupakan bagian dari genus bawang Allium. Nama ilmiah dari spesies ini pertama kali diterbitkan oleh L.."
    }
