      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1377210294,
      "text": "Piper umbellatum, commonly known as cow-foot leaf, is a species of pepper plant native to the Americas, including Mexico, Central America, the Caribbean, and tropical regions of South America. It has been widely naturalized in other tropical regions of the world."
    },
    "es": {
      "source": "Wikipedia (es): Piper umbellatum",
      "source_url": "https://es.wikipedia.org/wiki/Piper_umbellatum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 168087784,
      "text": "Piper umbellatum es una planta herbácea perteneciente a la familia de las piperáceas."
    },
    "fr": {
      "source": "Wikipedia (fr): Piper umbellatum",
      "source_url": "https://fr.wikipedia.org/wiki/Piper_umbellatum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 239881948,
      "text": "Piper umbellatum est une espèce de plantes à fleurs de la famille des Piperaceae"
    },
    "pt": {
      "source": "Wikipedia (pt): Piper umbellatum",
      "source_url": "https://pt.wikipedia.org/wiki/Piper_umbellatum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 73051069,
      "text": "Piper umbellatum é uma espécie de Piper nativa das Américas. É conhecida no Brasil por muitos nomes populares como pariparoba, capeba, caapeba, caapeba-do-nordeste, guaxima, caafeba, caa-pena, caá-peuá, caena, capeba, catajé, jaguarandi, malvarisco, oguaxima. É amplamente distribuída no México, América Central, América do Sul e várias ilhas do Caribe; foi introduzida na África e no sudeste asiático, onde atualmente é naturalizada."
    }
