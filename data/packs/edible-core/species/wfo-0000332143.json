  "description": {
    "ja": {
      "source": "Wikipedia (ja): クマツヅラ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AF%E3%83%9E%E3%83%84%E3%83%85%E3%83%A9",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 106359549,
      "text": "クマツヅラ はクマツヅラ科クマツヅラ属の多年草。鳩がこの草を好むことから「pigeon grass」(鳩の草)、「pigeon meat」(鳩の餌) と言う呼び名も持つ。"
    },
    "en": {
      "source": "Wikipedia (en): Verbena officinalis",
      "source_url": "https://en.wikipedia.org/wiki/Verbena_officinalis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1375920982,
      "text": "Verbena officinalis, the common vervain or common verbena, is a perennial herb native to Europe. It grows up to 70 cm (28 in) high, with an upright habitus. The lobed leaves are toothed, and the delicate spikes hold clusters of two-lipped mauve flowers."
    },
    "es": {
      "source": "Wikipedia (es): Verbena officinalis",
      "source_url": "https://es.wikipedia.org/wiki/Verbena_officinalis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 173465005,
      "text": "Verbena officinalis es una hierba perenne nativa del sudeste de Europa."
    },
    "fr": {
      "source": "Wikipedia (fr): Verveine officinale",
      "source_url": "https://fr.wikipedia.org/wiki/Verveine_officinale",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 230654799,
      "text": "La Verveine officinale ou Verveine sauvage est une espèce de plantes à fleurs de la famille des Verbénacées. est une plante herbacée annuelle ou vivace. Elle est parfois appelée Herbe sacrée, Veine de Vénus, Herbe aux sorcières ou Herbe à pigeon (péristéréos)."
    },
    "pt": {
      "source": "Wikipedia (pt): Verbena officinalis",
      "source_url": "https://pt.wikipedia.org/wiki/Verbena_officinalis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 40231790,
      "text": "Verbena officinalis é uma espécie de planta com flor pertencente à família Verbenaceae."
    }
  },
  "sections": {
    "toxicity": {
      "es": {
        "source": "Wikipedia (es): Verbena officinalis § Toxicidad",
        "source_url": "https://es.wikipedia.org/wiki/Verbena_officinalis#Toxicidad",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 173465005,
        "heading": "Toxicidad",
        "text": "Los extractos de verbena pueden presentar una cierta acción hipotiroidea (disminuyen la actividad del tiroides) por lo que pueden bloquear la acción de determinadas hormonas. Está prohibido su uso en mujeres embarazadas porque el verbenalósido (heterósido irioideo que se hidroliza en verbenalol) puede causar un efecto uterotónico y dificultar las contracciones características del parto. \nDosis elevadas de verbenalina provocan la parálisis del sistema nervioso central, lo que causa la aparición de estupor y convulsiones.",
        "truncated": false
      }
    },
    "cultivation": {
      "fr": {
        "source": "Wikipedia (fr): Verveine officinale § Culture",
        "source_url": "https://fr.wikipedia.org/wiki/Verveine_officinale#Culture",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 230654799,
        "heading": "Culture",
        "text": "La verveine officinale indigène se trouve dans les prairies et au bord des chemins.\nSa culture est facile, par semis au printemps ou par bouturage.",
        "truncated": false
      }
    }
  },
