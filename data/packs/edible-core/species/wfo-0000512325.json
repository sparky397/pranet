  "description": {
    "ja": {
      "source": "Wikipedia (ja): イチビ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%A4%E3%83%81%E3%83%93",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 108672588,
      "text": "イチビ は、アオイ科イチビ属（アブチロン属）の一年草。インド、西アジア原産。別名にキリアサ（桐麻）、ハクマ（白麻）ボウマ（莔麻）など。かつては繊維植物などの用途で広く栽培されたが、現在では利用法の多くが廃れ、もっぱら畑地に害を与える雑草として知られる。"
    },
    "en": {
      "source": "Wikipedia (en): Abutilon theophrasti",
      "source_url": "https://en.wikipedia.org/wiki/Abutilon_theophrasti",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1372030106,
      "text": "Abutilon theophrasti, also known as velvetleaf, velvet plant, velvetweed and the Chinese jute, is an annual plant in the family Malvaceae that is native to Central and East Asia. It is the type species of the genus Abutilon. Its specific epithet, theophrasti, commemorates the ancient Greek botanist-philosopher Theophrastus."
    },
    "es": {
      "source": "Wikipedia (es): Abutilon theophrasti",
      "source_url": "https://es.wikipedia.org/wiki/Abutilon_theophrasti",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 174135730,
      "text": "Abutilon theophrasti es una especie de planta caducifolia perteneciente a la familia Malvaceae, es originaria del sur de Asia."
    },
    "fr": {
      "source": "Wikipedia (fr): Abutilon theophrasti",
      "source_url": "https://fr.wikipedia.org/wiki/Abutilon_theophrasti",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 215375454,
      "text": "Abutilon theophrasti, appelé abutilon d'Avicenne, abutilon de Théophraste ou abutilon à fleurs jaunes, est une espèce de plantes dicotylédones de la famille des Malvaceae, originaire d'Asie."
    },
    "pt": {
      "source": "Wikipedia (pt): Abutilon theophrasti",
      "source_url": "https://pt.wikipedia.org/wiki/Abutilon_theophrasti",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 65178887,
      "text": "Abutilon theophrasti é uma espécie de planta do gênero Abutilon."
    }
