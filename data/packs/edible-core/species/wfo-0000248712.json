  "description": {
    "ja": {
      "source": "Wikipedia (ja): ギンバイカ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AE%E3%83%B3%E3%83%90%E3%82%A4%E3%82%AB",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 108335657,
      "text": "ギンバイカ は、フトモモ科の単型の属ギンバイカ属の常緑低木。地中海沿岸原産。イタリア語でミルト。英語でマートル。ドイツ語ではミュルテ（Myrte）。属名からミルトス とも呼ぶ。花が結婚式などの飾りによく使われるので「祝いの木」ともいう。"
    },
    "en": {
      "source": "Wikipedia (en): Myrtus communis",
      "source_url": "https://en.wikipedia.org/wiki/Myrtus_communis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1369952906,
      "text": "Myrtus communis, the common myrtle or true myrtle, is an Old World species of flowering plant in the myrtle family, Myrtaceae. It forms an evergreen shrub."
    },
    "es": {
      "source": "Wikipedia (es): Myrtus communis",
      "source_url": "https://es.wikipedia.org/wiki/Myrtus_communis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 171666125,
      "text": "El mirto o arrayán europeo es una planta de la familia de las Myrtaceae, nativa del sudeste de Europa y del norte de África."
    },
    "fr": {
      "source": "Wikipedia (fr): Myrtus communis",
      "source_url": "https://fr.wikipedia.org/wiki/Myrtus_communis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 240097660,
      "text": "Le Myrte commun, parfois appelé Myrte juif ou Herbe du lagui, est une espèce de plantes à fleurs de la famille des Myrtaceae. C'est un arbuste originaire de la région méditerranéenne."
    },
    "pt": {
      "source": "Wikipedia (pt): Murta (género)",
      "source_url": "https://pt.wikipedia.org/wiki/Murta_(g%C3%A9nero)",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 71003752,
      "text": "Por Myrtus L. entende-se um género botânico que compreende uma ou duas espécies de plantas com flor, da família das Myrtaceae, nativo da região mediterrânica e do Norte de África."
    }
  },
  "sections": {
    "uses": {
      "ja": {
        "source": "Wikipedia (ja): ギンバイカ § 利用",
        "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AE%E3%83%B3%E3%83%90%E3%82%A4%E3%82%AB#%E5%88%A9%E7%94%A8",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 108335657,
        "heading": "利用",
        "text": "サルデーニャとコルシカ島では、果実や葉を用いてミルト（Mirto）というリキュールを作る。\n古代ローマにおいてはコショウが発見される以前はコショウの地位を占めており、油と酒の両方が作られていたと言われる。",
        "truncated": false
      },
      "en": {
        "source": "Wikipedia (en): Myrtus communis § Uses",
        "source_url": "https://en.wikipedia.org/wiki/Myrtus_communis#Uses",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1369952906,
        "heading": "Uses",
        "text": "The essential oils derived from this plant have anti-proliferative and anti-quorum sensing properties, helping against food spoilage. The berries are also macerated in alcohol to make Mirto liqueur.",
        "truncated": false
      },
      "fr": {
        "source": "Wikipedia (fr): Myrtus communis § Utilisation",
        "source_url": "https://fr.wikipedia.org/wiki/Myrtus_communis#Utilisation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 240097660,
        "heading": "Utilisation",
        "text": "Dans l'Antiquité, ses fleurs blanches symbolisaient la grâce virginale et à Rome des couronnes ornaient les jeunes filles ou les mariés.  \nIl était apprécié dans les temps bibliques pour son parfum.\nLes baies sont stomachiques, stimulantes et astringentes et ont été très utilisées en tant qu'épice avant l'arrivée du poivre. Elles servaient à aromatiser les saucisses. Le diminutif italien «mortadella» en provient. En Corse, des saucissons sont parfumés au myrte.\nLes baies sont aussi utilisées en Corse et en Sardaigne pour produire une liqueur digestive régionale, la liqueur de myrte.\nUne infusion de feuilles sert, en usage externe, à guérir les blessures et les ulcères ou, en usage interne, à soigner les troubles digestifs et urinaires[réf. nécessaire]. \nL'huile essentielle, antiseptique et expectorante contient du cinéol et du myrténol. Elle est utilisée en cas d'affections respiratoires.\nUne eau de toilette a été utilisée sous les noms de Eau d'ange ou Eau de myrte.\nIl est aussi utilisé comme arbuste d'ornement.",
        "truncated": false
      }
    },
    "cultivation": {
      "en": {
        "source": "Wikipedia (en): Myrtus communis § Cultivation",
        "source_url": "https://en.wikipedia.org/wiki/Myrtus_communis#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1369952906,
        "heading": "Cultivation",
        "text": "This species and the more compact M. communis subsp. tarentina have won the Royal Horticultural Society's Award of Garden Merit. They are hardy but prefer a sheltered position in full sun.\nThe plant can be propagated with seeds stratified for 3 months. Also, one can use a cutting with a short heel (small part of the bark), keeping it in moistened rooting mix.",
        "truncated": false
      }
    }
  },
