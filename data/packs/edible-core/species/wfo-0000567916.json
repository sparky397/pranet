  "description": {
    "en": {
      "source": "Wikipedia (en): Boerhavia diffusa",
      "source_url": "https://en.wikipedia.org/wiki/Boerhavia_diffusa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1374221093,
      "text": "Boerhavia diffusa is a species of flowering plant in the four o'clock family, called red spiderling, spreading hogweed, or tarvine. It is taken in herbal medicine for pain relief and other uses. The leaves of Boerhavia diffusa are often used as a green vegetable in many parts of India."
    },
    "es": {
      "source": "Wikipedia (es): Boerhavia diffusa",
      "source_url": "https://es.wikipedia.org/wiki/Boerhavia_diffusa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 174956548,
      "text": "Boerhavia diffusa es una especie de arbusto perteneciente a la familia Nyctaginaceae. Esta planta tiene una amplia distribución, desde la India, el Pacífico al sur de Estados Unidos. Esta amplia distribución se explica por su fruto pequeño, muy pegajoso y que crece a unos centímetros del suelo, en una posición ideal para aferrarse a las pequeñas aves migratorias que pasan por allí."
    },
    "fr": {
      "source": "Wikipedia (fr): Boerhavia diffusa",
      "source_url": "https://fr.wikipedia.org/wiki/Boerhavia_diffusa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 227008715,
      "text": "Boerhavia diffusa est une espèce de plante à fleurs de la famille du bougainvillée."
    },
    "id": {
      "source": "Wikipedia (id): Daun cakaran",
      "source_url": "https://id.wikipedia.org/wiki/Daun_cakaran",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29731127,
      "text": "Boerhaavia diffusa atau daun cakaran dalah spesies tumbuhan berbunga dalam famili pukul empat yang umumnya dikenal sebagai punarnava. Itu diambil dalam pengobatan herbal untuk menghilangkan rasa sakit dan kegunaan lain. Daun Boerhaavia diffusa sering digunakan sebagai sayuran hijau di banyak bagian India."
    }
  },
