      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 174152601,
      "text": "Burkea africana es una especie de leguminosa de la subfamilia Caesalpinioideae."
    },
    "fr": {
      "source": "Wikipedia (fr): Burkea africana",
      "source_url": "https://fr.wikipedia.org/wiki/Burkea_africana",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 220534846,
      "text": "Burkea africana est une espèce de plantes à fleurs de la famille des Fabaceae et du genre Burkea. C'est un arbre tropical très répandu en Afrique subsaharienne."
    }
