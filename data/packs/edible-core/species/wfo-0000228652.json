  "description": {
    "en": {
      "source": "Wikipedia (en): Lippia abyssinica",
      "source_url": "https://en.wikipedia.org/wiki/Lippia_abyssinica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1256306554,
      "text": "Lippia abyssinica, or koseret, is a species of flowering plant in the verbena family, Verbenaceae. It is endemic to Ethiopia but cultivated throughout tropical African countries. The specific epithet abyssinica derives from Latin and means 'of or from Ethiopia (Abyssinia)'."
    },
    "es": {
      "source": "Wikipedia (es): Lippia abyssinica",
      "source_url": "https://es.wikipedia.org/wiki/Lippia_abyssinica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 174665821,
      "text": "El koseret o kese es una especie de planta con flor de la familia Verbenaceae, y es endémica de Etiopía."
    },
    "id": {
      "source": "Wikipedia (id): Lippia abyssinica",
      "source_url": "https://id.wikipedia.org/wiki/Lippia_abyssinica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 28509207,
      "text": "Lippia abyssinica, atau koseret, adalah spesies tanaman berbunga dari famili Verbenaceae. Tanaman ini endemik di Etiopia tetapi dibudidayakan di berbagai negara tropis di Afrika. Julukan spesifik abyssinica berasal dari bahasa Latin yang berarti \"dari atau berasal dari Etiopia (Abyssinia)\"."
    }
