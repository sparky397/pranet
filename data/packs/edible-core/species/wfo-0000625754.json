  "description": {
    "en": {
      "source": "Wikipedia (en): Cratoxylum cochinchinense",
      "source_url": "https://en.wikipedia.org/wiki/Cratoxylum_cochinchinense",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1323839129,
      "text": "Cratoxylum cochinchinense is a species of flowering plant in the family Hypericaceae. It is sometimes referred to using an orthographic variant Cratoxylon cochinsinensis (Lour.) Blume in Vietnam, where the species was described. The specific epithet cochinchinense is from the Latin meaning \"of Cochinchina\". In Vietnamese, C. cochinchinense is usually called thành ngạch nam or lành ngạnh nam, other names include: hoàng ngưu mộc, hoàng ngưu trà and đỏ ngọn."
    }
  },
