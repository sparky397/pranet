  "description": {
    "en": {
      "source": "Wikipedia (en): Afzelia africana",
      "source_url": "https://en.wikipedia.org/wiki/Afzelia_africana",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1344111428,
      "text": "Afzelia africana, the African mahogany, afzelia, lenke, lengue, apa, or doussi, is a Myrmecophyte tree species in the family Fabaceae."
    },
    "es": {
      "source": "Wikipedia (es): Afzelia africana",
      "source_url": "https://es.wikipedia.org/wiki/Afzelia_africana",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 154857173,
      "text": "Afzelia africana es una especie de árbol de la familia de las fabáceas. Se encuentran en Benín, Burkina Faso, Camerún, República Centroafricana, Chad, la República Democrática del Congo, Costa de Marfil, Ghana, Guinea, Guinea-Bisáu, Malí, Níger, Nigeria, Senegal, Sierra Leona, Sudán, Togo y Uganda. Su nombre comercial más usado es Doussie, el nombre procede de Camerún y abarca a varias Afzelias madereras."
    },
    "fr": {
      "source": "Wikipedia (fr): Afzelia africana",
      "source_url": "https://fr.wikipedia.org/wiki/Afzelia_africana",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 223352845,
      "text": "Afzelia africana est une espèce de plantes à fleurs de la famille des Fabaceae. C'est un arbre originaire d'Afrique."
    }
