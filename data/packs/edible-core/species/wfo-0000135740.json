  "description": {
    "en": {
      "source": "Wikipedia (en): Galinsoga parviflora",
      "source_url": "https://en.wikipedia.org/wiki/Galinsoga_parviflora",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1376104256,
      "text": "Galinsoga parviflora is a species of herbaceous plant in the daisy family Asteraceae. It has several common names including guasca (Colombia), pacpa yuyo, paco yuyo, and waskha (Peru), burrionera (Ecuador), albahaca silvestre and saetilla (Argentina), mielcilla, piojito, galinsoga, gallant soldier, quickweed, and potato weed."
    },
    "es": {
      "source": "Wikipedia (es): Galinsoga parviflora",
      "source_url": "https://es.wikipedia.org/wiki/Galinsoga_parviflora",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171723598,
      "text": "Galinsoga parviflora es una especie de hierba de la familia Asteraceae originaria del oeste de América del Sur."
    },
    "fr": {
      "source": "Wikipedia (fr): Galinsoga parviflora",
      "source_url": "https://fr.wikipedia.org/wiki/Galinsoga_parviflora",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 238045800,
      "text": "Galinsoga parviflora, le Galinsoge à petites fleurs, est une espèce de plante à fleurs de la famille des Asteraceae, originaire d'Amérique du Sud. On la connait aussi sous les noms « herbe piment » ou « sournette blanche »."
    },
    "pt": {
      "source": "Wikipedia (pt): Galinsoga parviflora",
      "source_url": "https://pt.wikipedia.org/wiki/Galinsoga_parviflora",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 67048894,
      "text": "Galinsoga parviflora é uma espécie de erva da família Asteraceae."
    },
    "id": {
      "source": "Wikipedia (id): Loseh",
      "source_url": "https://id.wikipedia.org/wiki/Loseh",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29706513,
      "text": "Galinsoga parviflora merupakan tumbuhan terna dalam famili Asteraceae yang sering ditemukan di pekarangan kebun dan rumah.. Ia memiliki beberapa nama umum termasuk Balinggang, Rumput kuning, Balaketut, Joletos, loseh (Sunda), Bribil, Kuningan, Mondreng, Pakelele, Jangkung, Rumput Belanda (Sulawesi)."
    }
  },
