  "description": {
    "en": {
      "source": "Wikipedia (en): Alkekengi",
      "source_url": "https://en.wikipedia.org/wiki/Alkekengi",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1363164797,
      "text": "Alkekengi is a monotypic genus of flowering plants in the nightshade family Solanaceae with a single species Alkekengi officinarum. This species is native to the regions covering Southern Europe to South Asia and Northeast Asia."
    },
    "es": {
      "source": "Wikipedia (es): Physalis alkekengi",
      "source_url": "https://es.wikipedia.org/wiki/Physalis_alkekengi",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171666224,
      "text": "Physalis alkekengi, conocida comúnmente como alquequenje, linterna china o vejiga de perro es una especie de planta herbácea perteneciente a la familia Solanaceae."
    },
    "fr": {
      "source": "Wikipedia (fr): Alkekengi officinarum",
      "source_url": "https://fr.wikipedia.org/wiki/Alkekengi_officinarum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 240332249,
      "text": "Alkekengi officinarum est une espèce de plantes à fleurs de la famille des Solanaceae. L'aire de répartition naturelle de cette espèce s'étend du sud-est de l'Europe à la Chine. C'est une plante vivace ou géophyte rhizomateuse et elle pousse principalement dans le biome tempéré."
    },
    "pt": {
      "source": "Wikipedia (pt): Alquequenque",
      "source_url": "https://pt.wikipedia.org/wiki/Alquequenque",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 71681909,
      "text": "Physalis Alkekengi, comummente conhecida como alquequenge, é uma espécie de planta com flor da família das solanáceas, cujo fruto é comestível."
    },
    "id": {
      "source": "Wikipedia (id): Physalis alkekengi",
      "source_url": "https://id.wikipedia.org/wiki/Physalis_alkekengi",
      "license": "CC BY-SA 4.0",
