  "description": {
    "en": {
      "source": "Wikipedia (en): Khaya senegalensis",
      "source_url": "https://en.wikipedia.org/wiki/Khaya_senegalensis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1369480328,
      "text": "Khaya senegalensis is a species of tree in the Meliaceae family that is native to Africa. Common names include African mahogany, dry zone mahogany, Gambia mahogany, khaya wood, Senegal mahogany, cailcedra, acajou, djalla, and bois rouge."
    },
    "es": {
      "source": "Wikipedia (es): Khaya senegalensis",
      "source_url": "https://es.wikipedia.org/wiki/Khaya_senegalensis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171238892,
      "text": "Khaya senegalensis es una especie botánica de árboles perteneciente a la familia Meliaceae."
    },
    "fr": {
      "source": "Wikipedia (fr): Khaya senegalensis",
      "source_url": "https://fr.wikipedia.org/wiki/Khaya_senegalensis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 220606593,
      "text": "Khaya senegalensis, dénommé couramment caïlcédrat est une espèce de plantes à fleurs de la famille des Meliaceae. C'est un arbre qui est également appelé « acajou du Sénégal » ou « caïlcédrat »."
    }
