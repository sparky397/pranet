      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 155928248,
      "text": "Rumex vesicarius es una planta de la familia de las poligonáceas originaria del África sahariana y de Oriente Medio."
    },
    "fr": {
      "source": "Wikipedia (fr): Rumex vesicarius",
