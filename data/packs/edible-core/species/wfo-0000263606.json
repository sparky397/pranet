  "description": {
    "ja": {
      "source": "Wikipedia (ja): オタネニンジン",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AA%E3%82%BF%E3%83%8D%E3%83%8B%E3%83%B3%E3%82%B8%E3%83%B3",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 111095244,
      "text": "オタネニンジン（御種人蔘）は、ウコギ科の多年草である。原産地は中華人民共和国の遼東半島から朝鮮半島の地域で、中国東北部やロシア沿海州で自生する。"
    },
    "en": {
      "source": "Wikipedia (en): Panax ginseng",
      "source_url": "https://en.wikipedia.org/wiki/Panax_ginseng",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1369794386,
      "text": "Panax ginseng, ginseng, also known as Asian ginseng, Chinese ginseng or Korean ginseng, is a species of plant whose root is the original source of ginseng. It is a perennial plant that grows in the mountains of East Asia. It is mainly cultivated in China, Korea, Russia, and Japan."
    },
    "es": {
      "source": "Wikipedia (es): Panax ginseng",
      "source_url": "https://es.wikipedia.org/wiki/Panax_ginseng",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 174330508,
      "text": "El término ginseng se usa para denominar a numerosas especies de plantas del género Panax, en latín, panacea, y a otras que no son del género Panax, pero tienen propiedades muy similares. La que en medicina tradicional china se conoce normalmente como ginseng es la especie Panax ginseng C.A.Mey. 1843."
    },
    "fr": {
      "source": "Wikipedia (fr): Ginseng",
      "source_url": "https://fr.wikipedia.org/wiki/Ginseng",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 226820653,
      "text": "Le ginseng est une espèce de plantes à fleurs de la famille des Araliaceae et du genre Panax. C'est une plante vivace originaire d'Asie."
    },
    "pt": {
      "source": "Wikipedia (pt): Panax ginseng",
      "source_url": "https://pt.wikipedia.org/wiki/Panax_ginseng",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 67466350,
      "text": "Panax ginseng é uma espécie vegetal do gênero Panax."
    },
    "id": {
      "source": "Wikipedia (id): Ginseng Korea",
      "source_url": "https://id.wikipedia.org/wiki/Ginseng_Korea",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 29234404,
      "text": "Ginseng Korea atau kolesom Korea adalah salah satu spesies tumbuhan yang akarnya merupakan sumber asli ginseng. Tumbuhan ini merupakan tumbuhan tahunan yang tumbuh di pegunungan Asia Timur. Tumbuhan ini merupakan salah satu spesies ginseng yang paling umum dibudidayakan bersamaan dengan Spesies Panax notoginseng dan Panax quinquefolius."
    }
  },
  "sections": {
    "uses": {
      "ja": {
        "source": "Wikipedia (ja): オタネニンジン § 民間療法",
        "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AA%E3%82%BF%E3%83%8D%E3%83%8B%E3%83%B3%E3%82%B8%E3%83%B3#%E6%B0%91%E9%96%93%E7%99%82%E6%B3%95",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 111095244,
        "heading": "民間療法",
        "text": "生薬の「人参」として古くから利用され、主要な薬用部位は根茎で、有用成分にオタネニンジンの学名 Panax ginseng から採名されたジンセノサイド (ginsenoside) などの化合物群が挙げられる。\n民間療法は、1日量 1 - 3 グラム (g) の人参を400 ミリリットル (mL) の熱湯で30分煎じ、3回に分けて服用する。人参酒は、紅参か白参 20 - 100 gまたは生のオタネニンジン 80 - 90 gを、35 摂氏 (℃) の焼酎 1 リットル (L) に浸漬したのちに冷暗所で 1 - 3 か月間保存し、1日に約 20 mLを目安に飲用する。1回浸漬した人参を再度6か月間浸漬して2回目を作ることもある。\n高麗人参を浸漬した酒類は薬機法で「薬味酒」に分類され、薬効のある草根木皮などを浸漬した酒または混成酒類（アルコール飲料）として酒販店などで販売する。薬局が販売する「薬用酒」は薬機法が規定する厚生大臣認可製品で、「薬味酒」と異なる。",
        "truncated": false
      },
      "en": {
        "source": "Wikipedia (en): Panax ginseng § Folk medicine",
        "source_url": "https://en.wikipedia.org/wiki/Panax_ginseng#Folk_medicine",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1369794386,
        "heading": "Folk medicine",
        "text": "Ginseng is used as an herb in folk medicine.",
        "truncated": false
      },
      "es": {
        "source": "Wikipedia (es): Panax ginseng § Uso medicinal",
        "source_url": "https://es.wikipedia.org/wiki/Panax_ginseng#Uso_medicinal",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 174330508,
        "heading": "Uso medicinal",
        "text": "La parte empleada de la planta es la raíz. Popularmente, se utiliza para tratar diversos trastornos de salud (tales como problemas cardíacos, la diabetes, el trastorno por déficit de atención con hiperactividad, etc.), fortalecer la memoria y el sistema inmunitario, mejorar el rendimiento, prevención del cáncer y principalmente da poderes sexuales a los usuarios. No obstante, no existe evidencia científica sólida de su efectividad en ninguno de ellos, por lo que no se puede hacer ninguna recomendación firme sobre su empleo.​",
        "truncated": false
      },
      "id": {
        "source": "Wikipedia (id): Ginseng Korea § Kegunaan",
        "source_url": "https://id.wikipedia.org/wiki/Ginseng_Korea#Kegunaan",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 29234404,
        "heading": "Kegunaan",
        "text": "Ginseng digunakan sebagai ramuan dalam pengobatan tradisional. Tumbuhan ini dikonsumsi karena diyakini dapat meningkatkan daya ingatan dan kognisi pada orang dewasa yang sehat, dan dapat meningkatkan fungsi seksual pada orang dewasa dengan disfungsi ereksi.",
        "truncated": false
      }
    },
    "cultivation": {
      "en": {
        "source": "Wikipedia (en): Panax ginseng § Cultivation",
        "source_url": "https://en.wikipedia.org/wiki/Panax_ginseng#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1369794386,
        "heading": "Cultivation",
        "text": "Panax ginseng is one of the most commonly cultivated ginseng species, along with P. notoginseng (found naturally in China) and P. quinquefolius.",
        "truncated": false
      }
    }
  },
