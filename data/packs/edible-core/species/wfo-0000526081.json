  "description": {
    "en": {
      "source": "Wikipedia 英語版「Alliaria petiolata」",
      "source_url": "https://en.wikipedia.org/wiki/Alliaria_petiolata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1375930171,
      "text": "Alliaria petiolata, or garlic mustard, is a biennial flowering plant in the mustard family (Brassicaceae). It is native to Europe, western and central Asia, north-western Africa, Morocco, Iberia and the British Isles, north to northern Scandinavia, and east to northern Pakistan and Xinjiang in western China. It has now become a tenacious invasive plant across the northern U.S., in particular because of its earlier springtime emergence than many native species, often in the forest understory."
    }
  },
  "sections": {
    "toxicity": {
      "en": {
        "source": "Wikipedia 英語版「Alliaria petiolata」の節「Toxicity」",
        "source_url": "https://en.wikipedia.org/wiki/Alliaria_petiolata#Toxicity",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1375930171,
        "heading": "Toxicity",
        "text": "Young first-year garlic mustard plants contain up to 100 ppm cyanide, a level which is toxic to many vertebrates. Once the plant is chopped up, the cyanide gas is eliminated.",
        "truncated": false
      }
    }
  },
