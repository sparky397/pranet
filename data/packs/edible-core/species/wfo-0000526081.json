  "description": {
    "en": {
      "source": "Wikipedia (en): Alliaria petiolata",
      "source_url": "https://en.wikipedia.org/wiki/Alliaria_petiolata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1375930171,
      "text": "Alliaria petiolata, or garlic mustard, is a biennial flowering plant in the mustard family (Brassicaceae). It is native to Europe, western and central Asia, north-western Africa, Morocco, Iberia and the British Isles, north to northern Scandinavia, and east to northern Pakistan and Xinjiang in western China. It has now become a tenacious invasive plant across the northern U.S., in particular because of its earlier springtime emergence than many native species, often in the forest understory."
    },
    "es": {
      "source": "Wikipedia (es): Alliaria petiolata",
      "source_url": "https://es.wikipedia.org/wiki/Alliaria_petiolata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 156323531,
      "text": "La aliaria, hierba del ajo o ajera es una especie de planta fanerógamas perteneciente a la familia Brassicaceae. Es natural de toda Europa y Asia occidental hasta la India donde crece en terrenos frescos y umbríos."
    },
    "fr": {
      "source": "Wikipedia (fr): Alliaire officinale",
      "source_url": "https://fr.wikipedia.org/wiki/Alliaire_officinale",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 240004547,
      "text": "L'Alliaire officinale ou Herbe à ail est une espèce de plantes à fleurs de la famille des Brassicacées. C'est une plante herbacée bisannuelle originaire d'Eurasie, invasive au Canada et aux États-Unis."
    },
    "pt": {
      "source": "Wikipedia (pt): Erva-alheira",
      "source_url": "https://pt.wikipedia.org/wiki/Erva-alheira",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 70152654,
      "text": "A erva-alheira é uma planta herbácea bienal, glabra, da família das Brassicaceae, nativa da Europa, Ásia ocidental e central e noroeste África, do Marrocos, Iberia e Ilhas Britânicas, norte a norte Escandinávia."
    }
  },
  "sections": {
    "toxicity": {
      "en": {
        "source": "Wikipedia (en): Alliaria petiolata § Toxicity",
        "source_url": "https://en.wikipedia.org/wiki/Alliaria_petiolata#Toxicity",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 1375930171,
        "heading": "Toxicity",
        "text": "Young first-year garlic mustard plants contain up to 100 ppm cyanide, a level which is toxic to many vertebrates. Once the plant is chopped up, the cyanide gas is eliminated.",
        "truncated": false
      }
    }
  },
