    "ja": {
      "source": "Wikipedia (ja): キミノヒマラヤキイチゴ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AD%E3%83%9F%E3%83%8E%E3%83%92%E3%83%9E%E3%83%A9%E3%83%A4%E3%82%AD%E3%82%A4%E3%83%81%E3%82%B4",
