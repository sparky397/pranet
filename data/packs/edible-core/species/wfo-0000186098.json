  "description": {
    "en": {
      "source": "Wikipedia (en): Albizia procera",
      "source_url": "https://en.wikipedia.org/wiki/Albizia_procera",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1361308722,
      "text": "Albizia procera, commonly known as white siris or karoi tree, is a species of large tree found natively in southeast Asia and India. It is most commonly found in open forests, but may also be found on the margins of rain forests and in monsoon and gallery forests. It is considered an invasive species in South Africa."
    },
    "es": {
      "source": "Wikipedia (es): Albizia procera",
      "source_url": "https://es.wikipedia.org/wiki/Albizia_procera",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171193308,
      "text": "Albizia procera es una especie botánica de árbol leguminosa en la familia de las Fabaceae."
    },
    "fr": {
      "source": "Wikipedia (fr): Albizia procera",
      "source_url": "https://fr.wikipedia.org/wiki/Albizia_procera",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 224829290,
      "text": "Albizia procera ou Siris blanc est une espèce de plantes à fleurs de la famille des Mimosaceae selon classification classique, ou à celle des Fabaceae, sous-famille des Mimosoideae selon la classification phylogénétique. C'est un arbre tropical originaire d'Asie et d'Océanie. On le trouve en Chine, sur l'Île de Taïwan, au Bhoutan, en Inde, au Népal, au Cambodge, au Laos, en Birmanie, en Thaïlande, au Viêt Nam, en Indonésie, en Papouasie-Nouvelle-Guinée, aux Philippines et en Australie."
    },
    "id": {
      "source": "Wikipedia (id): Weru",
      "source_url": "https://id.wikipedia.org/wiki/Weru",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29970287,
      "text": "Weru adalah sejenis pohon anggota famili Fabaceae. Pohon dengan banyak kegunaan ini menyebar luas mulai dari India di barat, Asia Tenggara, Tiongkok selatan, Nusantara, hingga Australia utara."
    }
