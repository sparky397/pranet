  "description": {
    "ja": {
      "source": "Wikipedia (ja): ワシントンヤシ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%AF%E3%82%B7%E3%83%B3%E3%83%88%E3%83%B3%E3%83%A4%E3%82%B7",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 111316241,
      "text": "ワシントンヤシ は、ヤシ科ワシントンヤシ属の1種である。別名、オキナヤシ、シラガヤシ、ロウジンヤシ、アメリカビロウともよばれる。"
    },
    "en": {
      "source": "Wikipedia (en): Washingtonia filifera",
      "source_url": "https://en.wikipedia.org/wiki/Washingtonia_filifera",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1358133216,
      "text": "Washingtonia filifera, commonly known as the California fan palm, cotton palm or desert fan palm, is a flowering plant in the family Arecaceae, native to the far southwestern United States and northwestern Mexico. It typically grows 30–50 feet (9–15 m) tall and 1–2 feet (0.3–0.6 m) wide, with a sturdy, columnar trunk and waxy, fan-shaped (palmate) leaves. As a monocot, it is evergreen and exhibits a tree-like growth habit."
    },
    "es": {
      "source": "Wikipedia (es): Washingtonia filifera",
      "source_url": "https://es.wikipedia.org/wiki/Washingtonia_filifera",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 174388955,
      "text": "La Washingtonia de California,, es una especie arbórea de la familia de las Arecáceas. Es, junto con Phoenix canariensis, Phoenix dactylifera y Chamaerops humilis, una de las principales especies de palmera que se utilizan para la jardinería en climas mediterráneos y templados suaves."
    },
    "fr": {
      "source": "Wikipedia (fr): Washingtonia filifera",
      "source_url": "https://fr.wikipedia.org/wiki/Washingtonia_filifera",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 232876218,
      "text": "Washingtonia filifera, le palmier à jupon, palmier de Californie ou même palmier jupon de Californie, est une espèce de palmiers appartenant au genre Washingtonia."
    },
    "pt": {
      "source": "Wikipedia (pt): Washingtonia filifera",
      "source_url": "https://pt.wikipedia.org/wiki/Washingtonia_filifera",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 70205872,
      "text": "Washingtonia filifera, popularmente chamada palmeira-de-saia, palmeira-de-saia-da-califórnia, palmeira-da-califórnia ou washingtônia-de-saia, é uma espécie arbórea da família das Arecaceae. Juntamente com a Phoenix canariensis e a Phoenix dactylifera, é uma das principais espécies de palmeira utilizadas para jardinagem em climas mediterrâneos."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia (en): Washingtonia filifera § Cultivation",
        "source_url": "https://en.wikipedia.org/wiki/Washingtonia_filifera#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 1358133216,
        "heading": "Cultivation",
        "text": "Washingtonia filifera is widely cultivated as an ornamental tree. It is one of the hardiest coryphoid palms, rated as hardy to USDA hardiness zone 8. It can survive brief temperatures of −10 °C (14 °F) with minor damage, and established plants have survived, with severe leaf damage, brief periods as low as −17 °C (1 °F). The plants grow best in arid or Mediterranean climates, but can be found in humid subtropical climates such as eastern Australia and the southeastern USA. It has gained the Royal Horticultural Society's Award of Garden Merit.",
        "truncated": false
      }
    }
  },
