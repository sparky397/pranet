  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ワシントンヤシ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%AF%E3%82%B7%E3%83%B3%E3%83%88%E3%83%B3%E3%83%A4%E3%82%B7",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 111316241,
      "text": "ワシントンヤシ は、ヤシ科ワシントンヤシ属の1種である。別名、オキナヤシ、シラガヤシ、ロウジンヤシ、アメリカビロウともよばれる。"
    },
    "en": {
      "source": "Wikipedia 英語版「Washingtonia filifera」",
      "source_url": "https://en.wikipedia.org/wiki/Washingtonia_filifera",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1358133216,
      "text": "Washingtonia filifera, commonly known as the California fan palm, cotton palm or desert fan palm, is a flowering plant in the family Arecaceae, native to the far southwestern United States and northwestern Mexico. It typically grows 30–50 feet (9–15 m) tall and 1–2 feet (0.3–0.6 m) wide, with a sturdy, columnar trunk and waxy, fan-shaped (palmate) leaves. As a monocot, it is evergreen and exhibits a tree-like growth habit."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Washingtonia filifera」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Washingtonia_filifera#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1358133216,
        "heading": "Cultivation",
        "text": "Washingtonia filifera is widely cultivated as an ornamental tree. It is one of the hardiest coryphoid palms, rated as hardy to USDA hardiness zone 8. It can survive brief temperatures of −10 °C (14 °F) with minor damage, and established plants have survived, with severe leaf damage, brief periods as low as −17 °C (1 °F). The plants grow best in arid or Mediterranean climates, but can be found in humid subtropical climates such as eastern Australia and the southeastern USA. It has gained the Royal Horticultural Society's Award of Garden Merit.",
        "truncated": false
      }
    }
  },
