  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ホウキギ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%9B%E3%82%A6%E3%82%AD%E3%82%AE",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 109894708,
      "text": "ホウキギ は、ヒユ科バッシア属の一年草。別名、ホウキグサ（箒草）。"
    },
    "en": {
      "source": "Wikipedia 英語版「Bassia scoparia」",
      "source_url": "https://en.wikipedia.org/wiki/Bassia_scoparia",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1355656845,
      "text": "Bassia scoparia is a large annual herb in the family Amaranthaceae native to Eurasia. It has been introduced to many parts of North America, where it is found in grassland, prairie, and desert shrub ecosystems. Its common names include summer cypress, mock-cypress, kochia, belvedere, World's Fair plant, burningbush, Mexican firebrush, and Mexican fireweed, with the latter three names referring to the herb's red autumn foliage."
    }
  },
  "sections": {
    "cultivation": {
      "ja": {
        "source": "Wikipedia 日本語版「ホウキギ」の節「栽培」",
        "source_url": "https://ja.wikipedia.org/wiki/%E3%83%9B%E3%82%A6%E3%82%AD%E3%82%AE#%E6%A0%BD%E5%9F%B9",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 109894708,
        "heading": "栽培",
        "text": "種子は極めて小さくて軽いため、前年に植えた周辺から生えた苗を移植する方法も採られている。日本での栽培地は、秋田県・山形県が主な産地である。ツツミノガ類が主な害虫である。",
        "truncated": false
      }
    }
  },
