  "description": {
    "en": {
      "source": "Wikipedia (en): Oenocarpus bataua",
      "source_url": "https://en.wikipedia.org/wiki/Oenocarpus_bataua",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1373087586,
      "text": "Oenocarpus bataua, the patawa, sehe, hungurahua (Ecuador) or mingucha, is a palm tree native to the Amazon rainforest. The tree produces edible fruits rich in high-quality oil."
    },
    "es": {
      "source": "Wikipedia (es): Oenocarpus bataua var. bataua",
      "source_url": "https://es.wikipedia.org/wiki/Oenocarpus_bataua_var._bataua",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 174176545,
      "text": "Oenocarpus bataua var. bataua (Mart. 1823) Burret 1929 o Jessenia bataua, \nmajo la palma de seje, milpesos, unamo, ungurahua o patabá es una planta de la familia de las palmeras."
    },
    "fr": {
      "source": "Wikipedia (fr): Oenocarpus bataua",
      "source_url": "https://fr.wikipedia.org/wiki/Oenocarpus_bataua",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 237455795,
      "text": "Oenocarpus bataua ou Jessenia bataua, appelé aussi patawa, sehe, hungurahua en Équateur ou mingucha, est une espèce de palmier originaire d'Amazonie qui produit des fruits comestibles riches en huile."
    },
    "pt": {
      "source": "Wikipedia (pt): Patauá",
      "source_url": "https://pt.wikipedia.org/wiki/Patau%C3%A1",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 72533142,
      "text": "O patauá, batauá ou putauá é uma palmeira originária da Amazônia. Ela tem um fruto comestível rico em óleo de alta qualidade."
    }
