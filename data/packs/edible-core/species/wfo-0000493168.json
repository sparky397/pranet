  "description": {
    "en": {
      "source": "Wikipedia 英語版「Sapindus saponaria」",
      "source_url": "https://en.wikipedia.org/wiki/Sapindus_saponaria",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-12",
      "revision": 1372524839,
      "text": "Sapindus saponaria is a small to medium-sized deciduous tree native to the Americas. Common names include rocky mountain maple, wingleaf soapberry, western soapberry, jaboncillo, sulluku and manele and a'e (Hawaiian). Its genus name, Sapindus, comes from the Latin, meaning Indian soap, and its specific epithet means \"soapy\"."
    }
  },
  "sections": {
    "toxicity": {
      "en": {
        "source": "Wikipedia 英語版「Sapindus saponaria」の節「Toxicity」",
        "source_url": "https://en.wikipedia.org/wiki/Sapindus_saponaria#Toxicity",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-12",
        "revision": 1372524839,
        "heading": "Toxicity",
        "text": "The fruit of Sapindus saponaria var. drummondii are poisonous and can cause skin rashes; they have been used to stupefy fish. The foliage may also be toxic to livestock.",
        "truncated": false
      }
    }
  },
