  "description": {
    "en": {
      "source": "Wikipedia (en): Phoenix reclinata",
      "source_url": "https://en.wikipedia.org/wiki/Phoenix_reclinata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1350417442,
      "text": "Phoenix reclinata, the wild date palm or Senegal date palm, is a species of flowering plant in the palm family native to tropical Africa, the Arabian Peninsula and Madagascar. It is introduced in Florida, Puerto Rico, Bermuda, Trinidad and Tobago, the Leeward Islands, Tunisia and Vietnam. The plants are found from sea level to 3000 m, in rain forest clearings, monsoonal forests and rocky mountainsides."
    },
    "es": {
      "source": "Wikipedia (es): Phoenix reclinata",
      "source_url": "https://es.wikipedia.org/wiki/Phoenix_reclinata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 172083697,
      "text": "La palmera de Senegal es una especie de palmera natural de los trópicos de África, la Península arábiga, Madagascar y las Islas Comores. También se informa naturalizado en Florida, Puerto Rico, Bermudas y las Islas de Sotavento. Las plantas se encuentran desde el nivel del mar hasta los 3.000 metros, en claros de bosques húmedos, bosques monzónicos y laderas de las montañas rocosas."
    },
    "fr": {
      "source": "Wikipedia (fr): Phoenix reclinata",
      "source_url": "https://fr.wikipedia.org/wiki/Phoenix_reclinata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 233346995,
      "text": "Phoenix reclinata, en français Dattier du Sénégal, est une espèce de plantes à fleurs de la famille des Arecaceae (palmiers)."
    },
    "pt": {
      "source": "Wikipedia (pt): Tamareira-do-senegal",
      "source_url": "https://pt.wikipedia.org/wiki/Tamareira-do-senegal",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 71741886,
      "text": "A Tamareira-do-senegal é uma palmeira do norte da África, Madagascar e Ilhas Comores."
    }
