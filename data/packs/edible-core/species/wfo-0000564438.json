      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1371358250,
      "text": "Bersama abyssinica is a species of medium-sized evergreen tree in the family Francoaceae. The leaves are pinnately divided with a strongly winged rachis. The inflorescence is a spike."
    },
    "es": {
      "source": "Wikipedia (es): Bersama abyssinica",
      "source_url": "https://es.wikipedia.org/wiki/Bersama_abyssinica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 167642260,
      "text": "Bersama abyssinica es una especie de árbol perenne de tamaño mediano de la familia Francoaceae. Las hojas están divididas pinnadamente con un raquis fuertemente alado. La inflorescencia es una espiga."
    },
    "id": {
      "source": "Wikipedia (id): Bersama abyssinica",
      "source_url": "https://id.wikipedia.org/wiki/Bersama_abyssinica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 30009179,
      "text": "Bersama abyssinica adalah spesies pohon hijau abadi berukuran sedang dalam famili Francoaceae. Daunnya terbagi menyirip dengan rakhis yang sangat bersayap. Infloresensinya berupa bulir."
    }
