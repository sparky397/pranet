  "description": {
    "en": {
      "source": "Wikipedia (en): Solidago virgaurea",
      "source_url": "https://en.wikipedia.org/wiki/Solidago_virgaurea",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1367646117,
      "text": "Solidago virgaurea, the European goldenrod or woundwort, is an herbaceous perennial plant of the family Asteraceae. It is widespread across most of Europe as well as North Africa and northern, central, and southwestern Asia. It is grown as a garden flower with many different cultivars. It flowers profusely in late summer."
    },
    "es": {
      "source": "Wikipedia (es): Solidago virgaurea",
      "source_url": "https://es.wikipedia.org/wiki/Solidago_virgaurea",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 173888286,
      "text": "Solidago virgaurea es una herbácea perenne de la familia de las Asteraceae. Crece para flores de jardín con muchos cultivares diferentes. Florece profusamente a fines del verano."
    },
    "fr": {
      "source": "Wikipedia (fr): Solidago virgaurea",
      "source_url": "https://fr.wikipedia.org/wiki/Solidago_virgaurea",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 239965097,
      "text": "Solidago virgaurea, la Solidage verge d'or ou Baguette d'Aaron ou encore Herbe des Juifs, est une espèce de plantes à fleurs du genre des Solidages et de la famille des Astéracées. Il existe de nombreuses sous-espèces et variétés différentes. Cette plante pousse à profusion à la fin de l'été. Son nom viendrait de ses propriétés thérapeutiques, en effet solidor signifie consolider en latin."
    },
    "pt": {
      "source": "Wikipedia (pt): Solidago virgaurea",
      "source_url": "https://pt.wikipedia.org/wiki/Solidago_virgaurea",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 59329095,
      "text": "Solidago virgaurea é uma espécie de planta com flor pertencente à família Asteraceae."
    }
  },
