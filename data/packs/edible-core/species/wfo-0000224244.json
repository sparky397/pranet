  "description": {
    "en": {
      "source": "Wikipedia (en): Lavandula stoechas",
      "source_url": "https://en.wikipedia.org/wiki/Lavandula_stoechas",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1371302177,
      "text": "Lavandula stoechas, the Spanish lavender or topped lavender (U.S.) or French lavender (U.K.), is a species of lavender native to the Mediterranean Basin."
    },
    "es": {
      "source": "Wikipedia (es): Lavandula stoechas",
      "source_url": "https://es.wikipedia.org/wiki/Lavandula_stoechas",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 175400485,
      "text": "Lavandula stoechas, llamado comúnmente cantueso o tomillo borriquero, es un arbusto ramoso, muy aromático, de hasta un metro de altura de la familia de las lamiáceas. Es una especie nativa de la cuenca mediterránea y Macaronesia y está naturalizada en Australasia."
    },
    "fr": {
      "source": "Wikipedia (fr): Lavandula stoechas",
      "source_url": "https://fr.wikipedia.org/wiki/Lavandula_stoechas",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 227192990,
      "text": "Lavandula stoechas, la Lavande papillon, Lavande stéchade, Lavande à toupet, Lavande maritime, Lavande espagnole ou Lavande des îles d'Hyères, est une espèce de plantes à fleurs de la famille des Lamiaceae. C'est une lavande très florifère."
    },
    "pt": {
      "source": "Wikipedia (pt): Lavandula stoechas",
      "source_url": "https://pt.wikipedia.org/wiki/Lavandula_stoechas",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 69023389,
      "text": "Lavandula stoechas, de nome comum alfazema, também chamada rosmaninho, é uma planta típica da região mediterrânica."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia (en): Lavandula stoechas § Cultivation",
        "source_url": "https://en.wikipedia.org/wiki/Lavandula_stoechas#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 1371302177,
        "heading": "Cultivation",
        "text": "This species is more tender than common lavender (Lavandula angustifolia), being less frost-resistant, but harsher and more resinous in its oils. Like other lavenders, it is associated with hot, dry, sunny conditions in alkaline soils.  However, it tolerates a range of situations, though it may be short-lived. Hardy down to −10 °C (14 °F) (USDA zones 8–10).\nThe following cultivars have won the Royal Horticultural Society's Award of Garden Merit:-\n\n'Ballerina'\n'Pretty Polly' \n'Willow Vale'",
        "truncated": false
      },
      "fr": {
        "source": "Wikipedia (fr): Lavandula stoechas § Culture",
        "source_url": "https://fr.wikipedia.org/wiki/Lavandula_stoechas#Culture",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 227192990,
        "heading": "Culture",
        "text": "Utilisation : pots ou massifs.\nEntretien : taille après floraison.\nSol : drainant, acide.\nFloraison : violet-bleu, d'avril à juin.\nRusticité : -3 à −7 °C.\nArrosage et fertilisation : arroser le moins possible, même si l'été est chaud ; craint l'humidité ; l'engrais est inutile.",
        "truncated": false
      }
    }
  },
