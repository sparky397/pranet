  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia (en): Amelanchier arborea § Cultivation",
        "source_url": "https://en.wikipedia.org/wiki/Amelanchier_arborea#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 1340827359,
        "heading": "Cultivation",
        "text": "This species tolerates varying light levels, but is at its best in full sun. It requires good drainage and air circulation and should be watered during drought. It is often confused with other species in the nursery trade. Propagation is by seed, divisions and grafting.\nThe edible fruit is drier than some other serviceberries, and it is harvested locally for pies and jams, and has been known to be used for wine; they were also used by Native Americans to make bread.\nSome report that the sweetened juice tastes like Dr. Pepper and some nurseries sell them as \"The Dr. Pepper Tree\", but the fruit is not used in the soft drink.",
        "truncated": false
      },
      "es": {
        "source": "Wikipedia (es): Amelanchier arborea § Cultivo",
        "source_url": "https://es.wikipedia.org/wiki/Amelanchier_arborea#Cultivo",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 151775092,
        "heading": "Cultivo",
        "text": "Esta especie tolera diferentes niveles de luz, pero está mejor a pleno sol. Requiere un buen drenaje y circulación de aire y deben ser regadas durante la sequía. Se confunde a menudo con otras especies en el comercio de viveros. La propagación es por semillas, por divisiones y de injerto.",
        "truncated": false
      }
    }
  },
