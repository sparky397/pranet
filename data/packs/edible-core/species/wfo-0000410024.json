  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ベンガルヤハズカズラ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%99%E3%83%B3%E3%82%AC%E3%83%AB%E3%83%A4%E3%83%8F%E3%82%BA%E3%82%AB%E3%82%BA%E3%83%A9",
