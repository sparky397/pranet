  "description": {
    "ja": {
      "source": "Wikipedia (ja): オオバンガジュツ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AA%E3%82%AA%E3%83%90%E3%83%B3%E3%82%AC%E3%82%B8%E3%83%A5%E3%83%84",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 103109269,
      "text": "オオバンガジュツ は、中国及び東南アジアが原産の医薬品や料理に使われるハーブである。地下茎の形が指の形に似ているため、英語では、伝統的に根の部分はfingerrootと呼ばれる。"
    },
    "en": {
      "source": "Wikipedia (en): Boesenbergia rotunda",
      "source_url": "https://en.wikipedia.org/wiki/Boesenbergia_rotunda",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1376753917,
      "text": "Boesenbergia rotunda, commonly known as Chinese keys, fingerroot, lesser galangal or Chinese ginger, is a medicinal and culinary herb from China and Southeast Asia. In English, the root has traditionally been called fingerroot, because the shape of the rhizome resembles that of fingers growing out of a central piece."
    },
    "es": {
      "source": "Wikipedia (es): Boesenbergia rotunda",
      "source_url": "https://es.wikipedia.org/wiki/Boesenbergia_rotunda",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171582389,
      "text": "Boesenbergia rotunda, conocida como jengibre chino, es una planta medicinal y culinaria de China y sudeste de Asia. En inglés, la raíz se ha llamado tradicionalmente Fingerroot, porque el rizoma se asemeja a los dedos que crecen fuera de una pieza central."
    },
    "fr": {
      "source": "Wikipedia (fr): Boesenbergia rotunda",
      "source_url": "https://fr.wikipedia.org/wiki/Boesenbergia_rotunda",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 211848635,
      "text": "Boesenbergia rotunda, le Curcuma rond ou Clés chinoises, est une espèce de plantes du genre Boesenbergia et de la famille des Zingiberaceae."
    },
    "id": {
      "source": "Wikipedia (id): Temu kunci",
      "source_url": "https://id.wikipedia.org/wiki/Temu_kunci",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 28517734,
      "text": "Temu kunci adalah sejenis rempah-rempah yang rimpangnya dipakai sebagai bumbu dalam masakan Asia Tenggara."
    }
