  "description": {
    "ja": {
      "source": "Wikipedia (ja): セイヨウスノキ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%BB%E3%82%A4%E3%83%A8%E3%82%A6%E3%82%B9%E3%83%8E%E3%82%AD",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 110020370,
      "text": "セイヨウスノキ は、青色の食用果実を付ける低木の一種の一つである。一般的にビルベリー、ハイデルベリー、ワートルベリーと呼ばれる。ブルーベリー と多くの共通点を持つ。その他のスノキ属の近縁種と区別するために、英語ではCommon BilberryあるいはBlue Whortleberryとも呼ばれる。"
    },
    "en": {
      "source": "Wikipedia (en): Vaccinium myrtillus",
      "source_url": "https://en.wikipedia.org/wiki/Vaccinium_myrtillus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1377480885,
      "text": "Vaccinium myrtillus is a holarctic species of shrub with edible fruit of blue color, known by the common names bilberry, blaeberry, and whortleberry. It is more precisely called common bilberry or blue whortleberry to distinguish it from other Vaccinium relatives."
    },
    "es": {
      "source": "Wikipedia (es): Vaccinium myrtillus",
      "source_url": "https://es.wikipedia.org/wiki/Vaccinium_myrtillus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 174285725,
      "text": "Vaccinium myrtillus, llamado comúnmente arándano silvestre europeo o mirtilo, es una planta de la familia de las Ericáceas que da unas pequeñas bayas comestibles."
    },
    "fr": {
      "source": "Wikipedia (fr): Vaccinium myrtillus",
      "source_url": "https://fr.wikipedia.org/wiki/Vaccinium_myrtillus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 227624904,
      "text": "La Myrtille (Vaccinium myrtillus) est une espèce de sous-arbrisseaux de la famille des Éricacées qui produit des fruits également appelés myrtilles, appartenant au groupe des airelles."
    },
    "pt": {
      "source": "Wikipedia (pt): Vaccinium myrtillus",
      "source_url": "https://pt.wikipedia.org/wiki/Vaccinium_myrtillus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 71226668,
      "text": "O Vaccinium myrtillus, comummente conhecido como mirtilo, é uma espécie de planta arbustiva, pertencente à família das Ericáceas, e ao tipo fisionómico dos fanerófitos."
    }
  },
