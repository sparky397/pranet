  "description": {
    "en": {
      "source": "Wikipedia (en): Veronica beccabunga",
      "source_url": "https://en.wikipedia.org/wiki/Veronica_beccabunga",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1376540424,
      "text": "Veronica beccabunga, the European speedwell or brooklime, is a succulent herbaceous perennial plant belonging to the flowering plant family Plantaginaceae. It grows on the margins of brooks and ditches in Europe, North Africa, and north and western Asia. It can be found on other continents as an introduced species. It has smooth spreading succulent branches that are often reddish, blunt oblong finely serrate leaves in opposite pairs close to the stem, and small bright blue or pink flowers with four petals."
    },
    "es": {
      "source": "Wikipedia (es): Veronica beccabunga",
      "source_url": "https://es.wikipedia.org/wiki/Veronica_beccabunga",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 172617521,
      "text": "La verónica acuática o bacabunga es una planta de la familia de las plantagináceas. Es originaria de Europa y el norte de África. Se utiliza como planta medicinal como depurativa y diurética."
    },
    "fr": {
      "source": "Wikipedia (fr): Veronica beccabunga",
      "source_url": "https://fr.wikipedia.org/wiki/Veronica_beccabunga",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 208173117,
      "text": "La Véronique des ruisseaux, parfois appelée aussi Cresson de cheval ou Salade de chouette, est une espèce de plantes vivaces du genre Veronica des lieux humides."
    },
    "pt": {
      "source": "Wikipedia (pt): Veronica beccabunga",
      "source_url": "https://pt.wikipedia.org/wiki/Veronica_beccabunga",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 42789269,
      "text": "Veronica beccabunga é uma espécie de planta com flor pertencente à família Scrophulariaceae."
    }
