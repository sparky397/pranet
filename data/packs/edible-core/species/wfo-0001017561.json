    "en": {
      "source": "Wikipedia (en): Rubus arcticus",
      "source_url": "https://en.wikipedia.org/wiki/Rubus_arcticus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1337176238,
      "text": "Rubus arcticus, the Arctic bramble or Arctic raspberry, Nagoonberry, or nectarberry is a species of slow-growing bramble belonging to the rose family, found in Arctic and alpine regions in the Northern Hemisphere. It has been used to create hybrid cultivated raspberries, the so-called nectar raspberries."
    },
    "es": {
      "source": "Wikipedia (es): Rubus arcticus",
      "source_url": "https://es.wikipedia.org/wiki/Rubus_arcticus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171580984,
      "text": "El té noruego es una especie de plantas del género Rubus."
    },
    "fr": {
      "source": "Wikipedia (fr): Rubus arcticus",
      "source_url": "https://fr.wikipedia.org/wiki/Rubus_arcticus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 219240234,
      "text": "Rubus arcticus, la Ronce arctique, Framboise arctique ou Framboisier nain, est une espèce de plantes à fleurs de la famille des Rosacées."
    },
    "id": {
      "source": "Wikipedia (id): Rubus arcticus",
      "source_url": "https://id.wikipedia.org/wiki/Rubus_arcticus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29080022,
      "text": "Rubus arcticus adalah spesies kesusur berpertumbuhan lambat dari famili mawar yang hidup di wilayah Arktik dan Pegunungan Alpin di Belahan Bumi Utara. Tanaman ini digunakan untuk menghasilkan lembutung hibrida yang dikenal sebagai nectar raspberries. Selain itu, Rubus arcticus menjadi tanaman simbolik provinsi Norrbotten di Swedia bagian utara."
    }
