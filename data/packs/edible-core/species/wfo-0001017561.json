    "ja": {
      "source": "Wikipedia (ja): チシマイチゴ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%81%E3%82%B7%E3%83%9E%E3%82%A4%E3%83%81%E3%82%B4",
