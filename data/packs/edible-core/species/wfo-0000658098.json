  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ドリアン」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%89%E3%83%AA%E3%82%A2%E3%83%B3",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 109894179,
      "text": "ドリアン は、アオイ科ドリアン属に属する樹木である。ドリアンと呼ばれるドリアン属の種の中で最も一般的な種であり、その食べられる果実もドリアンと呼ばれる。"
    },
    "en": {
      "source": "Wikipedia 英語版「Durio zibethinus」",
      "source_url": "https://en.wikipedia.org/wiki/Durio_zibethinus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1368025803,
      "text": "Durio zibethinus is the most common tree species in the genus Durio, commonly known as durian, and has edible fruits by the same name."
    }
  },
  "sections": {
    "cultivation": {
      "ja": {
        "source": "Wikipedia 日本語版「ドリアン」の節「栽培」",
        "source_url": "https://ja.wikipedia.org/wiki/%E3%83%89%E3%83%AA%E3%82%A2%E3%83%B3#%E6%A0%BD%E5%9F%B9",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 109894179,
        "heading": "栽培",
        "text": "原産地はマレーシアとインドネシアであるが、果実に人気があり、タイ王国、インド南部、オーストラリア北西部でも栽培されている。\n\n■ 日本での栽培\n沖縄県にドリアンの木が植栽されている。開花することはあるものの、結実にまで至ることは非常に稀である。\n京都府の京都府立植物園にもドリアンの木が植栽されている。",
        "truncated": false
      }
    }
