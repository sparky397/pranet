  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ライマメ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%A9%E3%82%A4%E3%83%9E%E3%83%A1",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 108685759,
      "text": "ライマメ は、インゲンマメ属の植物。アオイマメ、リママメ、リマビーン、バタービーンともいう。名称は本種がペルーのリマから海外に輸出されていたことにちなむ。"
    },
    "en": {
      "source": "Wikipedia 英語版「Lima bean」",
      "source_url": "https://en.wikipedia.org/wiki/Lima_bean",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1374962900,
      "text": "A lima bean, also commonly known as butter bean, sieva bean, double bean or Madagascar bean, is a legume grown for its edible seeds or beans."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Lima bean」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Lima_bean#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1378382659,
        "heading": "Cultivation",
        "text": "In Oaxaca, Mexico, the main rainy season lasts from June to August, and most of the above-ground parts die during the dry season. Germination or budding occurs in June or July. The first inflorescence is in October or November. The production of flowers and fruits usually ends between February and April.",
        "truncated": false
      }
    },
    "toxicity": {
      "en": {
        "source": "Wikipedia 英語版「Lima bean」の節「Toxicity」",
        "source_url": "https://en.wikipedia.org/wiki/Lima_bean#Toxicity",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1378382659,
        "heading": "Toxicity",
        "text": "Like many beans, raw lima beans are toxic (containing e.g. phytohaemagglutinin) if not boiled for at least ten minutes. Canned beans can be eaten without having to be boiled first, as they are pre-cooked.\nThe lima bean can contain anti-nutrients like phytic acids, saponin, oxalate, tannin and trypsin inhibitors. These inhibit the absorption of nutrients in animals and can cause damage to some organs. In addition to boiling, methods of roasting, pressure cooking, soaking, and germination can also reduce the antinutrients significantly.",
        "truncated": false
      }
    }
  },
