  "description": {
    "en": {
      "source": "Wikipedia (en): Symphytum asperum",
      "source_url": "https://en.wikipedia.org/wiki/Symphytum_asperum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1189088481,
      "text": "Symphytum asperum is a flowering plant of the genus Symphytum in the family Boraginaceae. Common names include rough comfrey and prickly comfrey. It is the tallest Symphytum species. It is native to Asia, and it is known in Europe and North America as an introduced species and sometimes a weed. Symphytum × uplandicum, the naturally occurring hybrid with the common comfrey, is the economically most important kind of comfrey."
    },
    "fr": {
