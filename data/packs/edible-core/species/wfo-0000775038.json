  "description": {
    "en": {
      "source": "Wikipedia 英語版「Careya arborea」",
      "source_url": "https://en.wikipedia.org/wiki/Careya_arborea",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-12",
      "revision": 1325488588,
      "text": "Careya arborea is a species of tree in the Lecythidaceae family, native to the Indian subcontinent, Afghanistan, and Indochina. Its common English names include wild guava, Ceylon oak, patana oak. Careya arborea is a deciduous tree that grows up to 15 metres (49 ft) high. Its leaves turn red in the cold season. Flowers are yellow or white in colour that become large green berries. The tree grows throughout India in forests and grasslands."
    }
