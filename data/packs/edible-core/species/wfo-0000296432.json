  "description": {
    "en": {
      "source": "Wikipedia (en): Attalea phalerata",
      "source_url": "https://en.wikipedia.org/wiki/Attalea_phalerata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1335066788,
      "text": "Attalea phalerata is a species of palm tree known by the English common name urucuri palm, the Portuguese common name urucurizeiro, and the Spanish common name shapaja. Other common names include motacu and bacuri. It is native to Brazil, Bolivia, Paraguay, and Peru, where it grows along southern and western Amazonia. It is the most common palm tree on the Pantanal."
    },
    "es": {
      "source": "Wikipedia (es): Attalea phalerata",
      "source_url": "https://es.wikipedia.org/wiki/Attalea_phalerata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 139992545,
      "text": "Attalea phalerata es una especie de palmera conocida con el nombre común de shapaja. y bacuri."
    },
    "pt": {
      "source": "Wikipedia (pt): Attalea phalerata",
      "source_url": "https://pt.wikipedia.org/wiki/Attalea_phalerata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 67845251,
      "text": "Attalea phalerata, conhecido popularmente como urucuri, ouricuri, aricuri, alicuri, aricuí, iricuri, uricuri, licuri, urucuriiba, licurizeiro e nicuri, é uma palmeira que atinge mais de trinta metros de altura. É encontrada no Brasil, Bolívia, Paraguai e Peru."
    }
  },
  "sections": {
    "uses": {
      "en": {
        "source": "Wikipedia (en): Attalea phalerata § Uses",
        "source_url": "https://en.wikipedia.org/wiki/Attalea_phalerata#Uses",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1335066788,
        "heading": "Uses",
        "text": "The tree has human uses. The leaves are used to thatch rooftops and the fruits are fed to pigs and other livestock. It is a source of vegetable oil. It is one of the most economically important palm species in Bolivia, where it is known as motacú.",
        "truncated": false
      },
      "es": {
        "source": "Wikipedia (es): Attalea phalerata § Usos",
        "source_url": "https://es.wikipedia.org/wiki/Attalea_phalerata#Usos",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 139992545,
        "heading": "Usos",
        "text": "El árbol tiene usos humanos. Las hojas se utilizan para techar tejados y los frutos para alimentar a los cerdos(nadia) y otros animales.​ Se trata de una fuente de aceite vegetal.​ Es, económicamente, la especie de palma más importante de Bolivia.​\nRhodinus stali, un insecto que es un vector de la enfermedad de Chagas, puede infestar este árbol.​",
        "truncated": false
      },
      "pt": {
        "source": "Wikipedia (pt): Attalea phalerata § Utilização",
        "source_url": "https://pt.wikipedia.org/wiki/Attalea_phalerata#Utiliza%C3%A7%C3%A3o",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 67845251,
        "heading": "Utilização",
        "text": "As folhas são usadas para cobrir telhados. Os frutos são usados para alimentar porcos e outros animais. Fornece óleo vegetal.",
        "truncated": false
      }
    }
