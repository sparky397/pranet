  "description": {
    "en": {
      "source": "Wikipedia (en): Polyscias fruticosa",
      "source_url": "https://en.wikipedia.org/wiki/Polyscias_fruticosa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1323770179,
      "text": "Polyscias fruticosa, or Ming aralia, is a perennial dicot evergreen shrub or dwarf tree in the ivy family Araliaceae, found in tropical and subtropical regions. The plant grows fairly slowly, up to 3–5 metres (9.8–16.4 ft) in height. The leaves are tripinnate, with a glossy surface. Ming aralia is commonly grown as an ornamental and a potherb, valued for its culinary and medicinal uses."
    },
    "fr": {
      "source": "Wikipedia (fr): Polyscias fruticosa",
      "source_url": "https://fr.wikipedia.org/wiki/Polyscias_fruticosa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 240116732,
      "text": "Polyscias fruticosa ou aralia de Ming est une espèce d'arbuste à feuillage persistant de la famille des Araliaceae."
    },
    "id": {
      "source": "Wikipedia (id): Daun berlangkas",
      "source_url": "https://id.wikipedia.org/wiki/Daun_berlangkas",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29670298,
      "text": "Daun berlangkas adalah tumbuhan sayur-sayuran yang dimanfaatkan sebagai lalapan. Ia berbentuk perdu, dan daunnya menyerupai kedondong. Oleh sebab itu, tumbuhan ini juga disebut dengan kedondong laut. Daun berlangkas dikenal dengan nama-nama seperti daun papéda papua (Amb.), kadondong laut, kadondong cina (Sund.), kědondong laut (Jw.), kadundung patedhan (Mad.), bombu, puding, keudem rintèk (Minh.), gurabati, tampusong (Tern.), dan déwu papua."
    }
  },
  "sections": {
    "toxicity": {
      "en": {
        "source": "Wikipedia (en): Polyscias fruticosa § Toxicity",
        "source_url": "https://en.wikipedia.org/wiki/Polyscias_fruticosa#Toxicity",
        "license": "CC BY-SA 4.0",
