  "description": {
    "en": {
      "source": "Wikipedia (en): Peltophorum pterocarpum",
      "source_url": "https://en.wikipedia.org/wiki/Peltophorum_pterocarpum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1358130841,
      "text": "Peltophorum pterocarpum is a species of tree in the family Fabaceae, native to tropical areas from Indo-China to northern Australia. It produces masses of golden flowers in the summer, making it a popular ornamental tree around the world. It was first described in 1825."
    },
    "es": {
      "source": "Wikipedia (es): Peltophorum pterocarpum",
      "source_url": "https://es.wikipedia.org/wiki/Peltophorum_pterocarpum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 172868705,
      "text": "Peltophorum pterocarpum es una especie nativa del sudeste tropical de Asia, norte de Australasia, Sri Lanka, Tailandia, Vietnam, Indonesia, Malasia, Papúa Nueva Guinea, Filipinas, e islas de Territorio del Norte, Australia."
    },
    "fr": {
      "source": "Wikipedia (fr): Peltophorum pterocarpum",
      "source_url": "https://fr.wikipedia.org/wiki/Peltophorum_pterocarpum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 222978172,
      "text": "Peltophorum pterocarpum est une espèce de plantes à fleurs du genre Peltophorum et de la famille des fabaceae. C'est un arbre originaire du sud-est de l'Asie tropicale et du nord de l'Australasie au Sri Lanka, Thaïlande, Vietnam, Indonésie, Malaisie, Papouasie-Nouvelle-Guinée, Philippines et des îles au large des côtes du Territoire du Nord, en Australie."
    },
    "id": {
      "source": "Wikipedia (id): Soga",
      "source_url": "https://id.wikipedia.org/wiki/Soga",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29957843,
      "text": "Soga adalah nama pohon penghasil bahan pewarna batik yang penting. Tumbuhan ini termasuk ke dalam famili polong-polongan dan secara alami menyebar luas mulai dari Srilanka, Asia Tenggara, Kepulauan Nusantara, hingga ke Papua Nugini."
    }
  },
