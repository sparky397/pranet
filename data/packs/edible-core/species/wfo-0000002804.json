  "description": {
    "en": {
      "source": "Wikipedia (en): Blumea balsamifera",
      "source_url": "https://en.wikipedia.org/wiki/Blumea_balsamifera",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1344379405,
      "text": "Blumea balsamifera is a flowering plant belonging to the genus Blumea of the family Asteraceae. It is also known as Ngai camphor and sambong."
    },
    "es": {
      "source": "Wikipedia (es): Blumea balsamifera",
      "source_url": "https://es.wikipedia.org/wiki/Blumea_balsamifera",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 174680717,
      "text": "Blumea balsamifera o sambong, es una especie de planta medicinal perteneciente a la familia de las asteráceas.Se encuentra en el trópico y subtrópico de Asia, incluyendo el subcontinente indio y el sudeste de Asia. Se trata de una hierba que crece a lo largo de las carreteras y en prados."
    },
    "fr": {
      "source": "Wikipedia (fr): Sambong",
      "source_url": "https://fr.wikipedia.org/wiki/Sambong",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 207812994,
      "text": "Le sambong est une espèce de plante à fleurs de la famille des Asteraceae utilisée en médecine traditionnelle."
    },
    "id": {
      "source": "Wikipedia (id): Sembung",
      "source_url": "https://id.wikipedia.org/wiki/Sembung",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 29670340,
      "text": "Sembung adalah tanaman perdu yang biasa dipakai untuk mengobati penyakit pilek, reumatik, kembung, diare, sakit tulang dsb. Di Filipina juga dipakai sebagai obat peluruh (diuretik). Kegunaan lainnya adalah untuk mengobati luka yang terinfeksi, infeksi pernafasan, dan sakit perut di Thailand dan Tiongkok sebagai obat rakyat."
    }
  },
