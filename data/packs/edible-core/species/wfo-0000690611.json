  "description": {
    "en": {
      "source": "Wikipedia (en): Ficus tinctoria",
      "source_url": "https://en.wikipedia.org/wiki/Ficus_tinctoria",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1373785535,
      "text": "Ficus tinctoria, also known as dye fig, or humped fig is a hemiepiphytic tree in the genus Ficus. It is also one of the species known as a strangler fig."
    },
    "fr": {
      "source": "Wikipedia (fr): Ficus tinctoria",
      "source_url": "https://fr.wikipedia.org/wiki/Ficus_tinctoria",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 234320931,
      "text": "Ficus tinctoria est une espèce d'arbres hémiépiphytes de la famille des Moraceae. C'est l'une des espèces connues sous le nom de figuier étrangleur."
    },
    "id": {
      "source": "Wikipedia (id): Ara bereteh",
      "source_url": "https://id.wikipedia.org/wiki/Ara_bereteh",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 29728858,
      "text": "Ficus tinctoria, juga dikenal sebagai ara batik, atau ara bereteh adalah pohon hemiepifitik dari genus Ficus. Ia juga merupakan salah satu spesies yang dikenal sebagai ara pencekik."
    }
