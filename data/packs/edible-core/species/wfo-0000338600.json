  "description": {
    "en": {
      "source": "Wikipedia (en): Alpinia malaccensis",
      "source_url": "https://en.wikipedia.org/wiki/Alpinia_malaccensis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1313900426,
      "text": "Alpinia malaccensis is a plant in the family Zingiberaceae cultivated for ornamental and medicinal purposes. It is a native of Indonesia and Malaysia. An oil is obtained from its leaves and rhizomes. It has many medicinal properties."
    },
    "id": {
      "source": "Wikipedia (id): Lengkuas melaka",
      "source_url": "https://id.wikipedia.org/wiki/Lengkuas_melaka",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 28503424,
      "text": "Lengkuas melaka atau bangle melaka adalah tumbuhan sejenis lengkuas dari suku Zingiberaceae. Terna berkhasiat obat ini menyebar luas mulai dari India timur laut, ke timur hingga Indocina, Indonesia dan Filipina."
    }
  },
  "sections": {
    "uses": {
      "id": {
        "source": "Wikipedia (id): Lengkuas melaka § Manfaat",
        "source_url": "https://id.wikipedia.org/wiki/Lengkuas_melaka#Manfaat",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 28503424,
        "heading": "Manfaat",
        "text": "Semua bagian tumbuhan berbau keras, mengandung semacam minyak terbang. Di Jawa, rimpangnya dipakai untuk mengobati bisul dan luka-luka. Di Ambon, rimpang ini dicampur dengan buah pinang dan dikunyah, untuk membaguskan dan menyaringkan suara dalam bernyanyi. Kulit buah yang diremas dalam air dipakai untuk membersihkan dan mengharumkan pakaian dan rambut.\nDi India, rimpangnya dimakan sebagai sayuran atau dipakai sebagai bumbu masakan.",
        "truncated": false
      }
    }
