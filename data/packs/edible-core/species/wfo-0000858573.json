  "description": {
    "en": {
      "source": "Wikipedia (en): Cenchrus ciliaris",
      "source_url": "https://en.wikipedia.org/wiki/Cenchrus_ciliaris",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1369113207,
      "text": "Cenchrus ciliaris is a species of grass native to most of Africa, southern Asia, southern Iran, and the extreme south of Europe (Sicily). Other names by which this grass is known include dhaman grass, anjan grass and koluk katai."
    },
    "es": {
      "source": "Wikipedia (es): Cenchrus ciliaris",
      "source_url": "https://es.wikipedia.org/wiki/Cenchrus_ciliaris",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171582537,
      "text": "Cenchrus ciliaris es una especie de hierba nativa de la mayor parte de África, el sur de Asia, sur de Irán, y el extremo sur de Europa (Sicilia)."
    },
    "fr": {
      "source": "Wikipedia (fr): Cenchrus ciliaris",
      "source_url": "https://fr.wikipedia.org/wiki/Cenchrus_ciliaris",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 202423677,
      "text": "Cenchrus ciliaris est une espèce de la famille des Poaceae (Graminées). Elle vit dans la majeure partie de l'Afrique, le sud de l'Asie, au sud de l'Iran, et l'extrême sud de l'Europe (Sicile). Elle est parfois appelée « Cenchrus cilié »."
    },
    "pt": {
      "source": "Wikipedia (pt): Cenchrus ciliaris",
      "source_url": "https://pt.wikipedia.org/wiki/Cenchrus_ciliaris",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 71487548,
      "text": "Cenchrus ciliaris é uma espécie de planta com flor pertencente à família Poaceae. A autoridade científica da espécie é L., tendo sido publicada em Mantissa Plantarum 2: 302. 1771."
    }
