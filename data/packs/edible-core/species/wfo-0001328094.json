  "description": {
    "en": {
      "source": "Wikipedia (en): Commiphora africana",
      "source_url": "https://en.wikipedia.org/wiki/Commiphora_africana",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1190559279,
      "text": "Commiphora africana, commonly called African myrrh, is a small deciduous tree belonging to the Burseraceae, a family akin to the Anacardiaceae, occurring widely over sub-Saharan Africa in Angola, Botswana, Burkina Faso, Chad, Eswatini, Eritrea, Ethiopia, Kenya, Mali, Mauritania, Mozambique, Namibia, Niger, Senegal, Somalia, South Africa, Sudan, Tanzania, Uganda, Zambia and Zimbabwe. On sandy soils this species sometimes forms pure stands, deserving consideration as a plant community or association."
    },
    "es": {
      "source": "Wikipedia (es): Commiphora africana",
      "source_url": "https://es.wikipedia.org/wiki/Commiphora_africana",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 174498398,
      "text": "El bedelio de África es una especie de pequeño árbol caducifolio perteneciente a la familia Burseraceae, una familia afín a Anacardiaceae."
    },
    "fr": {
      "source": "Wikipedia (fr): Commiphora africana",
      "source_url": "https://fr.wikipedia.org/wiki/Commiphora_africana",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 233141857,
      "text": "Commiphora africana est un arbre de la famille des Burseraceae largement répandu en Afrique."
    }
  },
