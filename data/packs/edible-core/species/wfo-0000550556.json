  "description": {
    "en": {
      "source": "Wikipedia 英語版「Artocarpus odoratissimus」",
      "source_url": "https://en.wikipedia.org/wiki/Artocarpus_odoratissimus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-12",
      "revision": 1374432281,
      "text": "Artocarpus odoratissimus, commonly known as marang, tarap, terap or less common, johey oak, is a species of flowering plant in the Moraceae family. It is native to Borneo from where has been introduced to the Philippines. It is closely related to the jackfruit, cempedak, and breadfruit trees which all belong to the same genus, Artocarpus."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Artocarpus odoratissimus」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Artocarpus_odoratissimus#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-12",
        "revision": 1374432281,
        "heading": "Cultivation",
        "text": "Artocarpus odoratissimus is cultivated for its fruit in Brunei, Indonesia, Malaysia, the Philippines, southern Thailand and India (Tripura). The species is largely grown for local consumption; the short shelf-life of the fruit limits its wider use.\nThe tree is not cold tolerant (as is the breadfruit). It can grow between latitude 15° north and south, and in coastal regions where temperatures never stay under 7 °C (45 °F).",
        "truncated": false
      }
    }
