  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ケツルアズキ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%B1%E3%83%84%E3%83%AB%E3%82%A2%E3%82%BA%E3%82%AD",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 108079352,
      "text": "ケツルアズキ はササゲ属アズキ亜属に所属する、つる性草本。日本では主に『もやし豆』として知られている。"
    },
    "en": {
      "source": "Wikipedia 英語版「Vigna mungo」",
      "source_url": "https://en.wikipedia.org/wiki/Vigna_mungo",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1361413668,
      "text": "The black gram is a bean grown in South Asia. Like its relative the mung bean, it has been reclassified from the genus Phaseolus to Vigna. The product sold as black gram is usually the whole bean, whereas the split bean is called white lentil. It should not be confused with the much smaller true black lentil."
    }
