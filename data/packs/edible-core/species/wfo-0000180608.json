  "description": {
    "en": {
      "source": "Wikipedia (en): Erythrina afra",
      "source_url": "https://en.wikipedia.org/wiki/Erythrina_afra",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1356602549,
      "text": "Erythrina afra, the coast coral tree or African coral tree, is a tree native to southeastern Africa, which is often cultivated and has introduced populations in California and India. All the 17 species of coral tree in the genus Erythrina are collectively considered the official tree of Los Angeles, California in the United States."
    },
    "es": {
      "source": "Wikipedia (es): Erythrina caffra",
      "source_url": "https://es.wikipedia.org/wiki/Erythrina_caffra",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 169108282,
      "text": "Erythrina afra, es un árbol nativo del sudeste de África, el cual es cultivado y ha sido introducido en la India. Es el árbol oficial de Los Ángeles, California, Estados Unidos."
    }
