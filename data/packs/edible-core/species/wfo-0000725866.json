  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ホップ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%9B%E3%83%83%E3%83%97",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 111289394,
      "text": "ホップ は、アサ科の蔓（つる）性多年草。雌雄異株。和名はセイヨウカラハナソウ（西洋唐花草）。"
    },
    "en": {
      "source": "Wikipedia 英語版「Humulus lupulus」",
      "source_url": "https://en.wikipedia.org/wiki/Humulus_lupulus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1368881366,
      "text": "Humulus lupulus, the common hop or hops, is a species of flowering plant in the hemp family, Cannabaceae. It is a perennial, herbaceous climbing plant which sends up new shoots in early spring and dies back to a cold-hardy rhizome in autumn. It is dioecious and native to West Asia, Europe and North America."
    }
  },
  "sections": {
    "toxicity": {
      "en": {
        "source": "Wikipedia 英語版「Humulus lupulus」の節「Toxicity」",
