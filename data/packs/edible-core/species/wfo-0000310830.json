  "description": {
    "en": {
      "source": "Wikipedia (en): Baeckea frutescens",
      "source_url": "https://en.wikipedia.org/wiki/Baeckea_frutescens",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1379193445,
      "text": "Baeckea frutescens is a species of flowering plant in the family Myrtaceae and is native to eastern southeastern China, Indochina, Malesia, New Guinea, and eastern Australia. It is a shrub with arching branches, linear leaves and white flowers with seven to thirteen stamens."
    },
    "id": {
      "source": "Wikipedia (id): Ujung atap",
      "source_url": "https://id.wikipedia.org/wiki/Ujung_atap",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29891028,
      "text": "Ujung atap adalah pohon kecil, kayunya kuat, kokoh, berwarna merah tua, daunnya dapat direbus untuk obat demam dan lelah. Kayunya dipakai untuk membuat pagar dan serbuk untuk obat gosok pada perut yang sakit. Sebagai bahan obat dan jamu, tanaman ini dikenal dengan nama jungrahab."
    }
