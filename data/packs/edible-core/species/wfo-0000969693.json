  "description": {
    "ja": {
      "source": "Wikipedia (ja): クルマバソウ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AF%E3%83%AB%E3%83%9E%E3%83%90%E3%82%BD%E3%82%A6",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 106359830,
      "text": "クルマバソウ は、アカネ科アカネ亜科ヤエムグラ属の多年草。以前は同科同亜科の近縁の属である Asperula 属の種とされていたが、現在はヤエムグラ属に移されている。"
    },
    "en": {
      "source": "Wikipedia (en): Galium odoratum",
      "source_url": "https://en.wikipedia.org/wiki/Galium_odoratum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1374671823,
      "text": "Galium odoratum, the sweet woodruff or sweetscented bedstraw, is a flowering perennial plant in the family Rubiaceae, native to much of Europe. It is widely cultivated for its flowers and its sweet-smelling foliage."
    },
    "es": {
      "source": "Wikipedia (es): Galium odoratum",
      "source_url": "https://es.wikipedia.org/wiki/Galium_odoratum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171581777,
      "text": "Galium odoratum es una especie fanerógama perteneciente a la familia Rubiaceae. Crece en toda Europa, Asia septentrional, norte de África y en España en los Pirineos."
    },
    "fr": {
      "source": "Wikipedia (fr): Galium odoratum",
      "source_url": "https://fr.wikipedia.org/wiki/Galium_odoratum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 239717007,
      "text": "Le Gaillet odorant ou Aspérule odorante est une espèce de plantes herbacées de la famille des Rubiacées."
    },
    "pt": {
      "source": "Wikipedia (pt): Aspérula-odorífera",
      "source_url": "https://pt.wikipedia.org/wiki/Asp%C3%A9rula-odor%C3%ADfera",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 63953660,
      "text": "A aspérula-odorífera é uma plantas com sementes da família das rubiáceas, nativa da grande parte da Europa, sudoeste da Ásia, Japão e Argélia."
    }
