  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ルイボス」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%AB%E3%82%A4%E3%83%9C%E3%82%B9",
      "license": "CC BY-SA 4.0",
