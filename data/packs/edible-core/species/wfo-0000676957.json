      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 71385566,
      "text": "Erodium malacoides é uma planta com flor pertencente à família Geraniaceae. É nativa da Eurásia e norte da África mas é cultivada em quase todos os continentes na atualidade."
    }
