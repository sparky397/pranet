  "description": {
    "en": {
      "source": "Wikipedia (en): Phyllanthus amarus",
      "source_url": "https://en.wikipedia.org/wiki/Phyllanthus_amarus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1371462296,
      "text": "Phyllanthus amarus is a leafy herbal plant found in tropical regions in the Americas, Africa, India, China, Sri Lanka, and Southeast Asia. Common names for this plant include gale of the wind, carry me seed, seed on the leaf, pick-a-back, stonebreaker, and dukung anak (Malay)."
    },
    "id": {
      "source": "Wikipedia (id): Phyllanthus amarus",
      "source_url": "https://id.wikipedia.org/wiki/Phyllanthus_amarus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 29019020,
      "text": "Phyllanthus amarus adalah sebuah tumbuhan herbal dedaunan yang ditemukan di wilayah tropis di Amerika, Afrika, India, Tiongkok, Sri Lanka, dan Asia Tenggara. Nama umum untuk tumbuhan tersebut meliputi gale of the wind, carry me seed, seed on the leaf, pick-a-back, stonebreaker, dan dukung anak (Melayu)."
    }
  },
  "sections": {
    "uses": {
