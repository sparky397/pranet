  "description": {
    "en": {
      "source": "Wikipedia (en): Solanum capsicoides",
      "source_url": "https://en.wikipedia.org/wiki/Solanum_capsicoides",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1370290246,
      "text": "Solanum capsicoides, the cockroach berry, is a species of flowering plant in the family Solanaceae. It is native to eastern Brazil but naturalized in other tropical regions, where it sometimes becomes an invasive weed."
    },
    "fr": {
      "source": "Wikipedia (fr): Solanum capsicoides",
      "source_url": "https://fr.wikipedia.org/wiki/Solanum_capsicoides",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 221962486,
      "text": "Solanum capsicoides est une espèce de plantes à fleurs de la famille des Solanaceae. Elle est dénommée pomme d'amour, cockroach berry, berengena de gallina. Elle est originaire de l'est du Brésil mais s'est naturalisée dans d'autres régions tropicales, où elle devient parfois envahissante."
    },
    "pt": {
      "source": "Wikipedia (pt): Juá-vermelho",
      "source_url": "https://pt.wikipedia.org/wiki/Ju%C3%A1-vermelho",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 72841572,
      "text": "Solanum capsicoides, o Juá-vermelho ou Melancia-da-praia, conhecido como polohauai'i na Polinésia, é uma planta da família Solanaceae. É nativa do leste do Brasil, mas naturalizada em outras regiões tropicais, onde às vezes se torna uma erva invasora."
    }
  },
  "sections": {
    "toxicity": {
      "fr": {
        "source": "Wikipedia (fr): Solanum capsicoides § Toxicité",
        "source_url": "https://fr.wikipedia.org/wiki/Solanum_capsicoides#Toxicit%C3%A9",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 221962486,
        "heading": "Toxicité",
        "text": "Toutes les parties de la plante sont toxiques, les fruits verts surtout. Elles contiennent des glucoalcaloides. Les symptômes sont des troubles digestifs, des nausées, des vomissements des douleurs abdominales et des diarrhées.",
        "truncated": false
      }
    },
    "uses": {
      "fr": {
        "source": "Wikipedia (fr): Solanum capsicoides § Utilisation",
        "source_url": "https://fr.wikipedia.org/wiki/Solanum_capsicoides#Utilisation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 221962486,
        "heading": "Utilisation",
        "text": "Elle est utilisée comme poison et comme médicament, pour l'environnement et pour l'alimentation.\nÀ Trinidad l'infusion de feuilles est utilisée contre le zona. En Tunisie la plante entière est appliquée en cataplasme sur les parties brulées et contre les dermatoses.\n\n■ Toxicité\nToutes les parties de la plante sont toxiques, les fruits verts surtout. Elles contiennent des glucoalcaloides. Les symptômes sont des troubles digestifs, des nausées, des vomissements des douleurs abdominales et des diarrhées.",
        "truncated": false
      }
    }
  },
