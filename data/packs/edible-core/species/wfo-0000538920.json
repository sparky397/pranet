  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ニトベカズラ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%8B%E3%83%88%E3%83%99%E3%82%AB%E3%82%BA%E3%83%A9",
      "license": "CC BY-SA 4.0",
