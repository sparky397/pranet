  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「アシュワガンダ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%A2%E3%82%B7%E3%83%A5%E3%83%AF%E3%82%AC%E3%83%B3%E3%83%80",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 107442166,
      "text": "アシュワガンダ(ashwagandha　学名Withania somnifera)は、ナス科の常緑低木。インドでは、古くからアーユルヴェーダにて利用されている。"
    },
    "en": {
      "source": "Wikipedia 英語版「Withania somnifera」",
      "source_url": "https://en.wikipedia.org/wiki/Withania_somnifera",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1374683837,
      "text": "Withania somnifera, known commonly as ashwagandha, is an evergreen shrub in the Solanaceae family that is native to the Middle East and North Africa, other African regions, southern Europe, Indian subcontinent, and Southeast Asia. Several other species in the genus Withania are morphologically similar. Other common names include Indian ginseng and winter cherry."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Withania somnifera」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Withania_somnifera#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1374683837,
        "heading": "Cultivation",
        "text": "Withania somnifera is cultivated in many of the drier regions of India. It is also found in Nepal, Sri Lanka, China, and Yemen. It prefers dry, stony soil with sun to partial shade. It can be propagated from seeds in the early spring or from greenwood cuttings in the later spring.",
        "truncated": false
      }
    }
  },
