  "description": {
    "en": {
      "source": "Wikipedia (en): Carissa macrocarpa",
      "source_url": "https://en.wikipedia.org/wiki/Carissa_macrocarpa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1373620020,
      "text": "Carissa macrocarpa is a shrub native to tropical and southern Africa. It is commonly known as the Natal plum, amathungulu, big num-num or large num-num."
    },
    "es": {
      "source": "Wikipedia (es): Carissa macrocarpa",
      "source_url": "https://es.wikipedia.org/wiki/Carissa_macrocarpa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 158811211,
      "text": "Carissa macrocarpa es una especie de arbusto perteneciente a la familia de las apocináceas. Es originaria del sur de África. Produce frutos comestibles."
    },
    "fr": {
      "source": "Wikipedia (fr): Carissa macrocarpa",
      "source_url": "https://fr.wikipedia.org/wiki/Carissa_macrocarpa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 231989417,
      "text": "Carissa macrocarpa, ou prunier du Natal ou carissa, est une espèce de plantes eudicotylédones, de la famille des Apocynaceae. Cette espèce est originaire d'Afrique du Sud, plus précisément de la région Natal."
    },
    "pt": {
      "source": "Wikipedia (pt): Carissa macrocarpa",
      "source_url": "https://pt.wikipedia.org/wiki/Carissa_macrocarpa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 71977128,
      "text": "Carissa macrocarpa é um arbusto nativo da África do Sul. É comumente conhecida como ameixa de Natal e, na África do Sul, o grande num-num. No Zulu, assim como nas tribos Bantu de Uganda, é chamado Amathungulu ou um Thungulu oBomvu. No africâner, a fruta é chamada noem-noem."
    },
    "id": {
      "source": "Wikipedia (id): Karendang",
      "source_url": "https://id.wikipedia.org/wiki/Karendang",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 29705807,
      "text": "Carissa macrocarpa adalah semak asli Afrika tropis dan selatan. Ini umumnya dikenal sebagai kerandang dan, di Afrika Selatan, num-num besar. Di Zulu, juga di suku Bantu di Uganda, disebut Amathungulu atau umThungulu oBomvu. Dalam bahasa Afrikaans buah ini disebut noem-noem."
    }
  },
  "sections": {
    "uses": {
      "es": {
