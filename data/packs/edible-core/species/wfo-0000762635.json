  "description": {
    "ja": {
      "source": "Wikipedia (ja): マルバオモダカ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%9E%E3%83%AB%E3%83%90%E3%82%AA%E3%83%A2%E3%83%80%E3%82%AB",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 106376548,
      "text": "マルバオモダカ は、オモダカ科マルバオモダカ属に属する植物。湖沼やため池などに生息する抽水植物である。種小名のparnassifoliaは、ラテン語で「parnassi（パルナッス山）+folia（葉）」という意味であり、パルナッス山のように丸い葉を持ったオモダカ、を意味している。"
    },
    "en": {
      "source": "Wikipedia (en): Caldesia parnassifolia",
      "source_url": "https://en.wikipedia.org/wiki/Caldesia_parnassifolia",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1358531954,
      "text": "Caldesia parnassifolia, is an aquatic species in the Alismataceae. It is found in slow-moving fresh water."
    },
    "es": {
      "source": "Wikipedia (es): Caldesia parnassifolia",
      "source_url": "https://es.wikipedia.org/wiki/Caldesia_parnassifolia",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 171582453,
      "text": "Caldesia parnassifolia es una especie de planta acuáticade la familia Alismataceae. Se encuentra en Eurasia, África, Australia y Europa."
    },
    "fr": {
      "source": "Wikipedia (fr): Caldesia parnassifolia",
      "source_url": "https://fr.wikipedia.org/wiki/Caldesia_parnassifolia",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 209624467,
      "text": "La caldésie à feuilles de parnassie, également flûteau à feuilles de parnassie, est une espèce de plante à fleurs aquatique ou amphibie de la famille des Alismataceae, que l'on trouve principalement dans les eaux stagnantes."
    },
    "id": {
      "source": "Wikipedia (id): Caldesia parnassifolia",
      "source_url": "https://id.wikipedia.org/wiki/Caldesia_parnassifolia",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 29558652,
      "text": "Caldesia parnassifolia adalah spesies tumbuhan air dalam famili Alismataceae. Tumbuhan ini ditemukan di air tawar yang mengalir lambat."
    }
