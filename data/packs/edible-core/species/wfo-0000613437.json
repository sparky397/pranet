  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ハマベブドウ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%8F%E3%83%9E%E3%83%99%E3%83%96%E3%83%89%E3%82%A6",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 109834409,
      "text": "ハマベブドウ はタデ科ハマベブドウ属の常緑の低木〜小高木。別名ウミブドウ、シーグレープ。種形容語uvifera はブドウ状を意味する。"
    },
    "en": {
      "source": "Wikipedia 英語版「Coccoloba uvifera」",
      "source_url": "https://en.wikipedia.org/wiki/Coccoloba_uvifera",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1359352434,
      "text": "Coccoloba uvifera is a species of tree and flowering plant in the buckwheat family, Polygonaceae. Its common names include seagrape and baygrape. It is native to coastal beaches throughout tropical America and the Caribbean. It has edible fruit, among other uses."
    }
