  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ナンヨウザクラ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%8A%E3%83%B3%E3%83%A8%E3%82%A6%E3%82%B6%E3%82%AF%E3%83%A9",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 106369561,
      "text": "ナンヨウザクラ は、熱帯アメリカ（カリブ海沿岸からペルー）原産の常緑高木。クロンキスト体系ではシナノキ科であったが、APG植物分類体系ではナンヨウザクラ科とされた。世界の熱帯各地で観賞用や食用に栽培される。"
    },
    "en": {
      "source": "Wikipedia 英語版「Muntingia」",
      "source_url": "https://en.wikipedia.org/wiki/Muntingia",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1368878272,
      "text": "Muntingia is a genus of plants in the family Muntingiaceae, comprising only one species, Muntingia calabura, named in honour of Abraham Munting. It is native from southern Mexico to Bolivia and Argentina. Its fruit is edible, and it has been widely introduced in other tropical areas."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Muntingia」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Muntingia#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1368878272,
        "heading": "Cultivation",
        "text": "M. calabura can be propagated from seeds, seedlings, or cuttings. In Costa Rica, seeds set in the wet season, but require conditions of light and temperature found in forest gaps. In a test in which seeds were placed in wet paper towel at 25 °C in different lighting conditions, 44% of seeds germinated under white light, while none germinated in the dark.",
        "truncated": false
      }
    }
