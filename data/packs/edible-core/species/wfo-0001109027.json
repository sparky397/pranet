  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「デンジソウ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%87%E3%83%B3%E3%82%B8%E3%82%BD%E3%82%A6",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 106368289,
      "text": "デンジソウ は、クローバーに似た形の水草で、特異な形態のシダ植物である。"
    },
    "en": {
      "source": "Wikipedia 英語版「Marsilea quadrifolia」",
      "source_url": "https://en.wikipedia.org/wiki/Marsilea_quadrifolia",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1314836820,
      "text": "Marsilea quadrifolia is a herbaceous plant found naturally in central and southern Europe, Caucasia, western Siberia, Afghanistan, south-west India, China, Japan, and Vietnam, though it is considered a weed in some parts of the United States, where it has been well established in the northeast for over 100 years. Its common names include four leaf clover and European waterclover (USA), even though it is not a species of clover."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Marsilea quadrifolia」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Marsilea_quadrifolia#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1314836820,
        "heading": "Cultivation",
        "text": "The plant prefers light (sandy) and medium (loamy) soils. It can grow in semi-shade (light woodland) or no shade. It requires moist or wet soil and can grow in water.\nMarsilea quadrifolia can be grown as a potted plant, either just with soil kept wet, or semi-submerged, with fronds emergent from the water, or fully submerged, with the fronds floating on the surface of the water.\nIn the aquarium, water clover is grown fully submerged, usually in the foreground where it spreads by means of runners. It normally seems to be unfussy as to light and water conditions, and doesn't need a rich substrate.\nMarsilea are very easy to germinate from their sporocarps.  However, the sporocarps must be abraded, cracked, or have an edge sliced off before submerging them in water so that the water can penetrate to swell the tissues, and germination is infrared-light dependent.  Full sunlight is fine for this purpose.",
        "truncated": false
      }
    }
  },
