  "description": {
    "en": {
      "source": "Wikipedia (en): Pleiogynium timoriense",
      "source_url": "https://en.wikipedia.org/wiki/Pleiogynium_timoriense",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1341054825,
      "text": "Pleiogynium timoriense, commonly known as the Burdekin plum, sweet plum, tulip plum, or in the Djabugay language guybalum, is a medium-sized fruit-bearing tree in the cashew and mango family Anacardiaceae native to Malesia, Australia and the Pacific Islands."
    },
    "fr": {
      "source": "Wikipedia (fr): Pleiogynium timorense",
      "source_url": "https://fr.wikipedia.org/wiki/Pleiogynium_timorense",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 199007804,
      "text": "Pleiogynium timorense est un petit arbre de la famille des Anacardiaceae originaire d'Australie (Queensland) et de Papouasie-Nouvelle-Guinée."
    },
    "id": {
      "source": "Wikipedia (id): Injuwatu",
      "source_url": "https://id.wikipedia.org/wiki/Injuwatu",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 28875236,
      "text": "Injuwatu atau Injuatu, adalah sejenis pohon penghasil buah berukuran sedang yang berkerabat dengan jambu mete dan mangga (Anacardiaceae). Tumbuhan ini dapat ditemukan di wilayah Malesia, Australia dan Kepulauan Pasifik."
    }
  },
