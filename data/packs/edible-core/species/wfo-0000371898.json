  "description": {
    "ja": {
      "source": "Wikipedia (ja): スイートシスリー",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%B9%E3%82%A4%E3%83%BC%E3%83%88%E3%82%B7%E3%82%B9%E3%83%AA%E3%83%BC",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 106364541,
      "text": "スイートシスリー は、セリ科多年生草本でハーブの一種。スイートチャービル、グレートチャービル、ガーデンミルラなどの別名がある。この1種でMyrrhis属を作る。"
    },
    "en": {
      "source": "Wikipedia (en): Cicely",
      "source_url": "https://en.wikipedia.org/wiki/Cicely",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1366793266,
      "text": "Myrrhis odorata, with common names cicely, sweet cicely, myrrh, garden myrrh, and sweet chervil, is a herbaceous perennial plant belonging to the celery family Apiaceae. It is the only species in the genus Myrrhis."
    },
    "es": {
      "source": "Wikipedia (es): Myrrhis odorata",
      "source_url": "https://es.wikipedia.org/wiki/Myrrhis_odorata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 174574073,
      "text": "Myrrhis odorata, llamada comúnmente perifollo oloroso, mirra o cerifolio, es la única especie del género Myrrhis, perteneciente a la familia de las apiáceas. Es nativa de Europa Central."
    },
    "fr": {
      "source": "Wikipedia (fr): Myrrhis odorata",
      "source_url": "https://fr.wikipedia.org/wiki/Myrrhis_odorata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 232618710,
      "text": "Myrrhis odorata, le Cerfeuil musqué, Cerfeuil anisé ou Cerfeuil d'Espagne, est une espèce de plantes à fleurs de la famille des Apiacées. C'est une plante herbacée, vivace originaire d'Europe. Elle est cultivée pour ses feuilles et ses graines au goût sucré et anisé, utilisées comme condiments alimentaires."
    },
    "id": {
      "source": "Wikipedia (id): Seledri melur",
      "source_url": "https://id.wikipedia.org/wiki/Seledri_melur",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29729707,
      "text": "Seledri melur atau seledri manis, mur kebun, dan servil manis adalah tanaman tahunan herba dari famili Apiaceae. Dalam genus Myrrhis, Myrrhis odorata merupakan satu-satunya anggota spesies."
    }
  },
  "sections": {
    "cultivation": {
      "fr": {
        "source": "Wikipedia (fr): Myrrhis odorata § Culture",
