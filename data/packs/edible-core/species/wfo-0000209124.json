  "sections": {
    "uses": {
      "en": {
        "source": "Wikipedia (en): Crotalaria pallida § Uses",
        "source_url": "https://en.wikipedia.org/wiki/Crotalaria_pallida#Uses",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1266988788,
        "heading": "Uses",
        "text": "The plant is grown as a ground cover and a green manure crop, especially in the inter-rows of rubber trees and coconut palms. Flowers are eaten as a vegetable in Cambodia, where the seeds are roasted and grounded for use as a sort of coffee beverage. The roots are sometimes chewed with betel nuts in Vietnam. In traditional medicine, the plant is used to treat urinary problems and fever, a poultice of the roots is applied to swelling of joints and an extract of the leaves is taken to expel intestinal worms.\nCrotalaria mucronata Desv was reported to be widely used in the southern part of the US as a green manure crop under the name “giant striata”.",
        "truncated": false
      }
    }
  },
