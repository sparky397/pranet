  "description": {
    "en": {
      "source": "Wikipedia 英語版「Garcinia indica」",
      "source_url": "https://en.wikipedia.org/wiki/Garcinia_indica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-12",
      "revision": 1350386391,
      "text": "Garcinia indica, a plant in the mangosteen family (Clusiaceae), commonly known as kokum, is a fruit-bearing tree that has culinary, pharmaceutical, and industrial uses. It grows primarily in India's Western Ghats: in the states of Maharashtra, Goa, Karnataka and Kerala. It is considered as an endemic species to the Western Ghats and forests in India. It grows in coastal and foothill moist forests up to 1,000 metres elevation with more than 2,500 mm of average annual rainfall. It favors lateritic alluvial soils with a depth of one or more metres and pH of 6.7."
    }
