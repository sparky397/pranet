  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「オオミドリボウキ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AA%E3%82%AA%E3%83%9F%E3%83%89%E3%83%AA%E3%83%9C%E3%82%A6%E3%82%AD",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 109055179,
      "text": "オオミドリボウキ は、クサスギカズラ属の1種。観賞用のアスパラガスの代表的なものである。日本の園芸関連ではアスパラガス・プルモーサスの名で流通しているが、これはかつての学名を仮名読みしたものである。"
    },
    "en": {
      "source": "Wikipedia 英語版「Asparagus setaceus」",
      "source_url": "https://en.wikipedia.org/wiki/Asparagus_setaceus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1363825047,
      "text": "Asparagus setaceus, with the common names of common asparagus fern, asparagus grass, lace fern, climbing asparagus, or ferny asparagus, is a plant in the family Asparagaceae native to southern Africa. Despite its common name, the plant is not a true fern, but has leaves that resemble one."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Asparagus setaceus」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Asparagus_setaceus#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1363825047,
        "heading": "Cultivation",
        "text": "Asparagus setaceus is cultivated as an ornamental plant, for planting in garden and containers, and as a house plant. The attractive foliage is also used in floral arrangements. It is hardy to 1 °C (34 °F), but does not tolerate being frozen. Therefore in temperate zones it is normally cultivated indoors in bright, indirect light.\nThis plant has gained the Royal Horticultural Society's Award of Garden Merit.",
        "truncated": false
      }
    },
    "toxicity": {
      "en": {
        "source": "Wikipedia 英語版「Asparagus setaceus」の節「Toxicity」",
        "source_url": "https://en.wikipedia.org/wiki/Asparagus_setaceus#Toxicity",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1363825047,
        "heading": "Toxicity",
        "text": "Asparagus setaceus is toxic to many domestic animals, including dogs and cats, and if they ingest the berries, vomiting, diarrhea, abdominal pain and allergic dermatitis may result. The toxic agent within the plant is sapogenin, a naturally occurring steroid.",
        "truncated": false
      }
    }
  },
