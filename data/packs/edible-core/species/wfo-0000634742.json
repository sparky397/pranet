  "description": {
    "ja": {
      "source": "Wikipedia (ja): オオミドリボウキ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AA%E3%82%AA%E3%83%9F%E3%83%89%E3%83%AA%E3%83%9C%E3%82%A6%E3%82%AD",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 109055179,
      "text": "オオミドリボウキ は、クサスギカズラ属の1種。観賞用のアスパラガスの代表的なものである。日本の園芸関連ではアスパラガス・プルモーサスの名で流通しているが、これはかつての学名を仮名読みしたものである。"
    },
    "en": {
      "source": "Wikipedia (en): Asparagus setaceus",
      "source_url": "https://en.wikipedia.org/wiki/Asparagus_setaceus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1363825047,
      "text": "Asparagus setaceus, with the common names of common asparagus fern, asparagus grass, lace fern, climbing asparagus, or ferny asparagus, is a plant in the family Asparagaceae native to southern Africa. Despite its common name, the plant is not a true fern, but has leaves that resemble one."
    },
    "es": {
      "source": "Wikipedia (es): Asparagus setaceus",
      "source_url": "https://es.wikipedia.org/wiki/Asparagus_setaceus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 174388019,
      "text": "Asparagus setaceus conocido como \"helecho plumoso\", \"espuma de mar\" o \"brisa\" es una planta de la familia Asparagaceae, originaria de África del sur; a pesar de su nombre común, no se trata de un helecho verdadero sino de una planta con flores (angiosperma) emparentada con el espárrago."
    },
    "fr": {
      "source": "Wikipedia (fr): Asparagus setaceus",
      "source_url": "https://fr.wikipedia.org/wiki/Asparagus_setaceus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 200822461,
      "text": "L'Asperge sétacée est une espèce de plantes de la famille des Asparagacées."
    },
    "id": {
      "source": "Wikipedia (id): Asparagus hias",
      "source_url": "https://id.wikipedia.org/wiki/Asparagus_hias",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 29794985,
      "text": "Asparagus hias, asparaga, sepraga, hasparahas, atau hartek adalah tumbuhan merambat dari genus Asparagus yang biasa ditanam orang sebagai tanaman hias. Karena daunnya yang elok, ia juga kadang dipakai sebagai penghias pada papan bunga."
    }
  },
  "sections": {
    "uses": {
      "ja": {
        "source": "Wikipedia (ja): オオミドリボウキ § 利用",
        "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AA%E3%82%AA%E3%83%9F%E3%83%89%E3%83%AA%E3%83%9C%E3%82%A6%E3%82%AD#%E5%88%A9%E7%94%A8",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 109055179,
        "heading": "利用",
        "text": "観賞用に栽培し、鉢物や切り花としても使う。特にカーネーションやスイートピーの花に合わせる添え葉として用いられる。八丈島や伊豆大島では半日陰の露地で栽培が行われる。\n特に変種のシノブボウキ A. plumosus var. nanus （アスパラガス・プルモーサス・ナヌス）は全体に矮性で、仮葉は基本変種より細かく密に着き、葉全体も短くまとまるものである。これは切り葉、及び鉢物のアスパラガスとして最も多く栽培されている。ただしこの変種も長く栽培すると蔓を伸ばすので、普通は5年目くらいまでが鉢物として扱いやすい。他にピラミダリス Pyramidalis はナヌスが立ち葉になったような姿をしているものである。ミドリボウキ（テヌイッシムス） Tenuissimus は仮葉が平面に広がらないもので、葉色が粉白を帯びる。また偽葉がより細長い。",
        "truncated": false
      }
    },
    "cultivation": {
      "en": {
        "source": "Wikipedia (en): Asparagus setaceus § Cultivation",
        "source_url": "https://en.wikipedia.org/wiki/Asparagus_setaceus#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1363825047,
        "heading": "Cultivation",
        "text": "Asparagus setaceus is cultivated as an ornamental plant, for planting in garden and containers, and as a house plant. The attractive foliage is also used in floral arrangements. It is hardy to 1 °C (34 °F), but does not tolerate being frozen. Therefore in temperate zones it is normally cultivated indoors in bright, indirect light.\nThis plant has gained the Royal Horticultural Society's Award of Garden Merit.",
        "truncated": false
      }
    },
    "toxicity": {
      "en": {
        "source": "Wikipedia (en): Asparagus setaceus § Toxicity",
        "source_url": "https://en.wikipedia.org/wiki/Asparagus_setaceus#Toxicity",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1363825047,
        "heading": "Toxicity",
        "text": "Asparagus setaceus is toxic to many domestic animals, including dogs and cats, and if they ingest the berries, vomiting, diarrhea, abdominal pain and allergic dermatitis may result. The toxic agent within the plant is sapogenin, a naturally occurring steroid.",
        "truncated": false
      }
    }
  },
