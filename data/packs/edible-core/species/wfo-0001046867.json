      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1365252204,
      "text": "Vaccinium myrtilloides is a North American species of blueberry with common names including common blueberry, velvetleaf huckleberry, velvetleaf blueberry, Canadian blueberry, and sourtop blueberry."
    },
    "es": {
      "source": "Wikipedia (es): Vaccinium myrtilloides",
      "source_url": "https://es.wikipedia.org/wiki/Vaccinium_myrtilloides",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 174047419,
      "text": "Vaccinium myrtilloides es una especie norteamericana de arándano cuyos nombres comunes incluyen arándano común, arándano de hoja de terciopelo, arándano canadiense y arándano agrio."
    },
    "fr": {
      "source": "Wikipedia (fr): Vaccinium myrtilloides",
      "source_url": "https://fr.wikipedia.org/wiki/Vaccinium_myrtilloides",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 237484072,
      "text": "Vaccinium myrtilloides est une espèce de plantes à fleurs de la famille des Ericaceae, appelée au Canada Bleuet sauvage, mais également appelée Airelle fausse-myrtille. C'est une espèce que l'on trouve au Canada, ainsi qu'au nord-est et au nord-ouest des États-Unis, ainsi que dans la région des Grands Lacs."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia (en): Vaccinium myrtilloides § Cultivation",
        "source_url": "https://en.wikipedia.org/wiki/Vaccinium_myrtilloides#Cultivation",
        "license": "CC BY-SA 4.0",
