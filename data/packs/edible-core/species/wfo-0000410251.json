  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ヤハズカズラ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%A4%E3%83%8F%E3%82%BA%E3%82%AB%E3%82%BA%E3%83%A9",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 110621713,
      "text": "ヤハズカズラ は、キツネノマゴ科ヤハズカズラ属のつる性植物で、家庭園芸で観賞用に栽培されている。属名よりツンベルギアとも呼ばれる。"
    },
    "en": {
      "source": "Wikipedia 英語版「Thunbergia alata」",
      "source_url": "https://en.wikipedia.org/wiki/Thunbergia_alata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1369042687,
      "text": "Thunbergia alata, commonly called black-eyed Susan vine, is a herbaceous perennial climbing plant species in the family Acanthaceae. It is native to Eastern Africa, and has been naturalized in other parts of the world."
    }
  },
  "sections": {
    "cultivation": {
      "ja": {
        "source": "Wikipedia 日本語版「ヤハズカズラ」の節「栽培」",
        "source_url": "https://ja.wikipedia.org/wiki/%E3%83%A4%E3%83%8F%E3%82%BA%E3%82%AB%E3%82%BA%E3%83%A9#%E6%A0%BD%E5%9F%B9",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 110621713,
        "heading": "栽培",
        "text": "発芽適温が高いので、屋外で蒔く場合は、東京付近なら5月上旬くらいにする。ぬるま湯に一晩つけてから蒔くと発芽しやすい。覆土は、1cm位する。日当たりと排水の良いところなら比較的よく育つ。\n花壇、特に垣根に沿って植えるとよい。また、朝顔のように行燈作りにして鉢植えで愉しむのも良い。",
        "truncated": false
      },
      "en": {
        "source": "Wikipedia 英語版「Thunbergia alata」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Thunbergia_alata#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1369042687,
        "heading": "Cultivation",
        "text": "Thunbergia alata seed is easy to germinate in humus-rich soil with some sand and it can be grown from cuttings. Soaking the seeds in a dish of warm water over night will help improve seed germination when planted. It is a fast grower, blooming quickly, with light trimming encouraging more blossoms.  There are cultivars with red, orange, red-orange, white, pale yellow, or bright yellow flowers, with or without the characteristic chocolate-purple centre which inspires the common name.",
        "truncated": false
      }
    }
  },
