  "description": {
    "en": {
      "source": "Wikipedia 英語版「Pangium」",
      "source_url": "https://en.wikipedia.org/wiki/Pangium",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-12",
      "revision": 1358864538,
      "text": "Pangium is a genus in the family Achariaceae containing the sole species Pangium edule, a tall tree native to the mangrove swamps of Southeast Asia. It produces a large poisonous fruit which can be made edible by fermentation. It is dioecious, with male and female flowers produced on separate individuals."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Pangium」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Pangium#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-12",
        "revision": 1358864538,
        "heading": "Cultivation",
        "text": "The tree requires many years to mature, and the seeds are therefore most frequently harvested from wild trees, as it is not economically feasible to cultivate. Although poisonous to humans, the seeds of the tree form part of the natural diet of the babirusa (Babyroussa babyrussa).",
        "truncated": false
      }
    }
