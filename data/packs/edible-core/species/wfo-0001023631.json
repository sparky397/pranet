  "description": {
    "en": {
      "source": "Wikipedia (en): Nicandra physalodes",
      "source_url": "https://en.wikipedia.org/wiki/Nicandra_physalodes",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1345049907,
      "text": "Nicandra physalodes is a species of flowering plant in subfamily Solanoideae of the nightshade family. It is known by the common names apple-of-Peru and shoo-fly plant. It is thought originally to have been native to western South America, including Peru, and is known elsewhere as an introduced and ruderal species – sometimes as a weed – in tropical, subtropical and, to a lesser extent, temperate areas all over the world. It has also long been cultivated as an ornamental plant for its attractive flowers and curious fruits and has been adopted into the traditional medicine of countries far-removed from its original home."
    },
    "es": {
      "source": "Wikipedia (es): Nicandra physaloides",
      "source_url": "https://es.wikipedia.org/wiki/Nicandra_physaloides",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 172732610,
      "text": "Nicandra physaloides es la única especie del género monotípico Nicandra de la familia Solanaceae, conocida como manzana del Perú, capulí cimarrón o chamico por su parecido con las especies de Datura. Es nativa del Perú y conocida en otras partes del mundo como especie introducida, en ocasiones como invasora, aunque también es utilizada como ornamental."
    },
    "fr": {
      "source": "Wikipedia (fr): Nicandra physalodes",
      "source_url": "https://fr.wikipedia.org/wiki/Nicandra_physalodes",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 209712617,
      "text": "Nicandra physalodes (L.) Gaertn., aussi appelé pomme du Pérou, est une plante annuelle de la famille des Solanaceae originaire de la cordillère des Andes."
    },
    "pt": {
      "source": "Wikipedia (pt): Nicandra physalodes",
      "source_url": "https://pt.wikipedia.org/wiki/Nicandra_physalodes",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 72002078,
      "text": "Nicandra physalodes é uma espécie de planta com flor, pertencente à família das solanáceas e ao tipo fisionómicos dos hemicriptófitos."
    }
  },
  "sections": {
    "cultivation": {
      "fr": {
        "source": "Wikipedia (fr): Nicandra physalodes § Culture",
        "source_url": "https://fr.wikipedia.org/wiki/Nicandra_physalodes#Culture",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 209712617,
        "heading": "Culture",
        "text": "Nicandra physalodes apprécie les sols riches et frais mais ne se plait pas en terrain trop humide. Il aime le plein soleil. \nIl se sème de mars à mai. Les graines germent facilement en 1 à 2 semaines à 20 °C. Nicandra physalodes se ressème parfois spontanément, c’est pourquoi il est devenu invasif dans de nombreuses régions.\nNon rustique, il ne survit pas à moins de 5 °C.",
        "truncated": false
      },
      "pt": {
        "source": "Wikipedia (pt): Nicandra physalodes § Cultivo",
        "source_url": "https://pt.wikipedia.org/wiki/Nicandra_physalodes#Cultivo",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 72002078,
        "heading": "Cultivo",
        "text": "Esta espécie desenvolve-se em solo de jardim comum, mas prefere solos ricos, bem drenados e em posição soalheira. As plantas são de crescimento rápido e frequentemente semeiam-se sozinhas com facilidade.\nResistem bem a condições meteorológicas desfavoráveis. \nAs flores individuais têm a duração de apenas um dia, mas a planta produz uma sucessão contínua de flores desde o Verão até ao início do Outono.",
        "truncated": false
      }
    }
  },
