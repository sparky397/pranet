  "description": {
    "ja": {
      "source": "Wikipedia (ja): カタバミ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AB%E3%82%BF%E3%83%90%E3%83%9F",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 110593756,
      "text": "カタバミ はカタバミ科カタバミ属の多年草。日本の地方名には「かがみぐさ」「すいば」「しょっぱぐさ」「すずめぐさ」「ねこあし」「もんかたばみ」などがあり、『日本方言大辞典』には180種以上が記録されている。中国名は酢漿草。中国では「三葉酸草」「老鴨嘴」「酸味草」「満天星」などの別名がある。"
    },
    "en": {
      "source": "Wikipedia (en): Oxalis corniculata",
      "source_url": "https://en.wikipedia.org/wiki/Oxalis_corniculata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1368886676,
      "text": "Oxalis corniculata, the creeping woodsorrel, procumbent yellow sorrel or sleeping beauty, is a somewhat delicate-appearing, low-growing herbaceous plant in the family Oxalidaceae."
    },
    "es": {
      "source": "Wikipedia (es): Oxalis corniculata",
      "source_url": "https://es.wikipedia.org/wiki/Oxalis_corniculata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 154351304,
      "text": "Oxalis corniculata, la acedera, también llamada acederita o chulco. Es una planta herbácea de apariencia delicada, de bajo crecimiento, de la familia Oxalidaceae."
    },
    "fr": {
      "source": "Wikipedia (fr): Oxalis corniculata",
      "source_url": "https://fr.wikipedia.org/wiki/Oxalis_corniculata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 224036686,
      "text": "L'Oxalide corniculée ou Oxalis corniculé est une espèce de plantes à fleurs du genre des Oxalis de la famille des Oxalidacées. C'est une petite plante vivace adventice des jardins, comestible et utilisée dans les médecines traditionnelles."
    },
    "pt": {
      "source": "Wikipedia (pt): Oxalis corniculata",
      "source_url": "https://pt.wikipedia.org/wiki/Oxalis_corniculata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 70660400,
      "text": "Oxalis corniculata é uma espécie de planta com flor pertencente à família Oxalidaceae."
    },
    "id": {
      "source": "Wikipedia (id): Daun asam kecil",
      "source_url": "https://id.wikipedia.org/wiki/Daun_asam_kecil",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29810552,
      "text": "Daun asam kecil atau biasa disebut juga calincing (Sd), lela (Ac), daun asam kecil, semanggen (Jw), semanggi (Pb), cembicenan (Md), dan mala-mala (Tn) adalah tumbuhan obat liar yang dapat tumbuh di tempat terbuka maupun agak terlidung seperti di tepi jalan maupun lapangan rumput."
    }
  },
