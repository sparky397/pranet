  "description": {
    "en": {
      "source": "Wikipedia (en): Alnus nepalensis",
      "source_url": "https://en.wikipedia.org/wiki/Alnus_nepalensis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1369165023,
      "text": "Alnus nepalensis is a large alder tree found in the subtropical highlands of the Himalayas. The tree is called Utis in Nepali and Nepalese alder in English. It is used in land reclamation, as firewood and for making charcoal."
    },
    "es": {
      "source": "Wikipedia (es): Alnus nepalensis",
      "source_url": "https://es.wikipedia.org/wiki/Alnus_nepalensis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 175802448,
      "text": "Alnus nepalensis D.Don, es una especie de árbol perteneciente a la familia de las betuláceas."
    },
    "fr": {
      "source": "Wikipedia (fr): Alnus nepalensis",
      "source_url": "https://fr.wikipedia.org/wiki/Alnus_nepalensis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 227558601,
      "text": "Alnus nepalensis est une espèce de plantes à fleurs de la famille des Betulaceae. C'est un arbre originaire d'Asie. Il a été importé pour être cultivé dans d'autres pays d'Asie, mais aussi en Afrique et en Amérique."
    }
