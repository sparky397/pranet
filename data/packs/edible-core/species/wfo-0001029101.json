  "description": {
    "en": {
      "source": "Wikipedia (en): Solanum linnaeanum",
      "source_url": "https://en.wikipedia.org/wiki/Solanum_linnaeanum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1177000536,
      "text": "Solanum linnaeanum is a nightshade species known as devil's apple and, in some places where it is introduced, apple of Sodom. The latter name is also used for other nightshades and entirely different plants elsewhere, in particular the poisonous milkweed Calotropis procera."
    },
    "es": {
      "source": "Wikipedia (es): Solanum linnaeanum",
      "source_url": "https://es.wikipedia.org/wiki/Solanum_linnaeanum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 168024808,
      "text": "Solanum linnaeanum es una planta venenosa parecida al tomate siendo natural de Sudáfrica y considerada una planta invasora en Australia y Nueva Zelanda. Ampliamente naturalizada en el Mediterráneo y en la península ibérica."
    },
    "fr": {
      "source": "Wikipedia (fr): Morelle de Linné",
      "source_url": "https://fr.wikipedia.org/wiki/Morelle_de_Linn%C3%A9",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 217469589,
      "text": "La morelle de Linné est une plante de la famille des Solanacées et du genre Solanum. Synonyme : Solanum sodomaeum. Originaire d'Afrique, elle est naturalisée sur le pourtour méditerranéen, où elle pousse au bord des chemins, dans les friches et les lieux caillouteux, notamment au bord de la mer. Floraison de mai à septembre."
    },
    "pt": {
      "source": "Wikipedia (pt): Solanum linnaeanum",
      "source_url": "https://pt.wikipedia.org/wiki/Solanum_linnaeanum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 71187098,
      "text": "Solanum linnaeanum, conhecido pelos nomes comuns tomate-de-sodoma ou tomateiro-do-diabo, é uma espécie de planta com flor pertencente à família Solanaceae."
    }
  },
