  "description": {
    "en": {
      "source": "Wikipedia 英語版「Rhus coriaria」",
      "source_url": "https://en.wikipedia.org/wiki/Rhus_coriaria",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1373685973,
      "text": "Rhus coriaria, commonly called Sicilian sumac, tanner's sumach, or elm-leaved sumach, is a deciduous shrub to small tree in the cashew family Anacardiaceae. It is native to southern Europe and western Asia. The dried fruits are used as a spice, particularly in combination with other spices in the mixture called za'atar."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Rhus coriaria」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Rhus_coriaria#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1373685973,
        "heading": "Cultivation",
        "text": "Rhus coriaria is a hardy, drought-tolerant, deciduous shrub growing to 3 metres (10 ft) at a medium rate or to a small tree up to 5 m (16 ft) high. It prefers full sun. It is frost-sensitive and can be grown in USDA hardiness zones 8-11 and UK zone 9. The plant will grow in any type of soil that is deep and well-drained, including poor, rocky, alkaline or slightly acidic soils.",
        "truncated": false
      }
    }
