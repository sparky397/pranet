      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1372342385,
      "text": "Bitterroot is a small perennial herb in the family Montiaceae. Its specific epithet rediviva refers to its ability to regenerate from dry and seemingly dead roots."
    },
    "es": {
      "source": "Wikipedia (es): Lewisia rediviva",
      "source_url": "https://es.wikipedia.org/wiki/Lewisia_rediviva",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 157029725,
      "text": "Lewisia rediviva es una especie de plantas de la familia Montiaceae. Es pequeña con flores de tonos rosados y un centro amarillo que crece cercana al suelo. Es la flor estatal de Montana en EE. UU."
    },
    "fr": {
      "source": "Wikipedia (fr): Lewisia rediviva",
      "source_url": "https://fr.wikipedia.org/wiki/Lewisia_rediviva",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 235335948,
      "text": "Lewisia rediviva est une espèce de plantes de la famille des Montiacées originaire d'Amérique du Nord."
    }
  },
