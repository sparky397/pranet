  "description": {
    "en": {
      "source": "Wikipedia (en): Falcaria vulgaris",
      "source_url": "https://en.wikipedia.org/wiki/Falcaria_vulgaris",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1245498854,
      "text": "Falcaria vulgaris, the sickleweed or longleaf, is the sole species in the genus Falcaria. It is a biennial herb of the spherical shape. Blossoms in June–July. Grows in Europe, Siberia, Middle East, Northern Africa, North and South Americas. Contains alkaloids, carotene, vitamin C, proteins."
    },
    "es": {
      "source": "Wikipedia (es): Falcaria vulgaris",
      "source_url": "https://es.wikipedia.org/wiki/Falcaria_vulgaris",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171710115,
      "text": "Falcaria es un género monotípico de planta herbácea perteneciente a la familia Apiaceae. Su única especie: Falcaria vulgaris, es originaria de Eurasia."
    },
    "fr": {
      "source": "Wikipedia (fr): Falcaria vulgaris",
      "source_url": "https://fr.wikipedia.org/wiki/Falcaria_vulgaris",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 226206534,
      "text": "Falcaria vulgaris, la falcaire commune, est une espèce de plantes à fleurs de la famille des Apiaceae. C'est une plante herbacée originaire d'Europe, d'Asie et d'Afrique du Nord"
    }
