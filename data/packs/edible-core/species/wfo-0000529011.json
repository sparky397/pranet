  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ウスベニタチアオイ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%A6%E3%82%B9%E3%83%99%E3%83%8B%E3%82%BF%E3%83%81%E3%82%A2%E3%82%AA%E3%82%A4",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 106349997,
      "text": "ウスベニタチアオイ Althaea officinalis は、アオイ科の多年草であり、別名ビロードアオイ。ヨーロッパ、西アジアから北アフリカにかけてが原産で、薬用植物としてや観賞用に用いられる。"
    },
    "en": {
      "source": "Wikipedia 英語版「Althaea officinalis」",
      "source_url": "https://en.wikipedia.org/wiki/Althaea_officinalis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1335930474,
      "text": "Althaea officinalis, the marsh mallow or marshmallow, is a species of flowering plant indigenous to Europe, Western Asia and North Africa, which is used in herbalism and as an ornamental plant."
    }
  },
  "sections": {
    "cultivation": {
      "ja": {
        "source": "Wikipedia 日本語版「ウスベニタチアオイ」の節「栽培」",
        "source_url": "https://ja.wikipedia.org/wiki/%E3%82%A6%E3%82%B9%E3%83%99%E3%83%8B%E3%82%BF%E3%83%81%E3%82%A2%E3%82%AA%E3%82%A4#%E6%A0%BD%E5%9F%B9",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 106349997,
        "heading": "栽培",
        "text": "苗は4月～6月、9月～10月頃市場に出回る。\n良く日のあたる場所で管理し、栄養豊富な水持ちの良い土に植えるとよい。\n夏場は乾燥しやすいので、水切れが起こらないように注意が必要であるが、寒さに強いので冬はさほど手間がかからない。\n9月～10月にかけて種が取れる。\n株分けは4月～6月、9月～10月に行うことが多い。\n花期は一般的には7月～8月である。",
        "truncated": false
      }
    }
  },
