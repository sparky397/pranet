  "description": {
    "ja": {
      "source": "Wikipedia (ja): ウスベニタチアオイ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%A6%E3%82%B9%E3%83%99%E3%83%8B%E3%82%BF%E3%83%81%E3%82%A2%E3%82%AA%E3%82%A4",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 106349997,
      "text": "ウスベニタチアオイ Althaea officinalis は、アオイ科の多年草であり、別名ビロードアオイ。ヨーロッパ、西アジアから北アフリカにかけてが原産で、薬用植物としてや観賞用に用いられる。"
    },
    "en": {
      "source": "Wikipedia (en): Althaea officinalis",
      "source_url": "https://en.wikipedia.org/wiki/Althaea_officinalis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1335930474,
      "text": "Althaea officinalis, the marsh mallow or marshmallow, is a species of flowering plant indigenous to Europe, Western Asia and North Africa, which is used in herbalism and as an ornamental plant."
    },
    "es": {
      "source": "Wikipedia (es): Althaea officinalis",
      "source_url": "https://es.wikipedia.org/wiki/Althaea_officinalis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 175369518,
      "text": "El malvavisco, altea, bismalva o hierba cañamera es una planta herbácea eurasiática, cultivada desde la antigüedad por sus propiedades medicinales."
    },
    "fr": {
      "source": "Wikipedia (fr): Guimauve officinale",
      "source_url": "https://fr.wikipedia.org/wiki/Guimauve_officinale",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 237009606,
      "text": "La Guimauve officinale, aussi appelée Guimauve sauvage ou Mauve blanche, est une plante herbacée vivace de la famille des Malvacées, commune en Europe. C’est une grande plante herbacée aux feuilles tomenteuses d’un vert grisâtre, blanchâtre, fleurissant en juillet, qui poussent surtout dans les milieux humides."
    },
    "pt": {
      "source": "Wikipedia (pt): Althaea officinalis",
      "source_url": "https://pt.wikipedia.org/wiki/Althaea_officinalis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 71434315,
      "text": "Althaea officinalis é uma espécie de planta com flor, pertencente à família das malváceas e ao tipo fisionómico dos nanofanerófitos, comumente conhecida como malvaísco."
    },
    "id": {
      "source": "Wikipedia (id): Panirak paya",
      "source_url": "https://id.wikipedia.org/wiki/Panirak_paya",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 30059968,
      "text": "Althaea officinalis atau panirak paya adalah spesies tanaman berbunga asli Eropa, Asia Barat dan Afrika Utara, yang digunakan dalam obat tradisional dan sebagai tanaman hias. Penganan yang terbuat dari akar panirak paya sejak zaman Mesir kuno berevolusi menjadi makanan manisan kenyal saat ini, tetapi sebagian besar makanan manisan kenyal modern tidak lagi mengandung akar panirak paya."
    }
  },
  "sections": {
    "cultivation": {
      "ja": {
        "source": "Wikipedia (ja): ウスベニタチアオイ § 栽培",
        "source_url": "https://ja.wikipedia.org/wiki/%E3%82%A6%E3%82%B9%E3%83%99%E3%83%8B%E3%82%BF%E3%83%81%E3%82%A2%E3%82%AA%E3%82%A4#%E6%A0%BD%E5%9F%B9",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 106349997,
        "heading": "栽培",
        "text": "苗は4月～6月、9月～10月頃市場に出回る。\n良く日のあたる場所で管理し、栄養豊富な水持ちの良い土に植えるとよい。\n夏場は乾燥しやすいので、水切れが起こらないように注意が必要であるが、寒さに強いので冬はさほど手間がかからない。\n9月～10月にかけて種が取れる。\n株分けは4月～6月、9月～10月に行うことが多い。\n花期は一般的には7月～8月である。",
        "truncated": false
      }
    }
  },
