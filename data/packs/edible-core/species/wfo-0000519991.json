  "description": {
    "en": {
      "source": "Wikipedia (en): Adenia heterophylla",
      "source_url": "https://en.wikipedia.org/wiki/Adenia_heterophylla",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1299756747,
      "text": "Adenia heterophylla, commonly known in Australia as the lacewing vine, is a climbing plant in the family Passifloraceae. It has a broad distribution spanning the equator, from the south eastern corner of China, through Indochina and Malesia, to northern Australia. In Australia it serves as a food plant for larvae of the glasswing, red lacewing and cruiser butterflies."
    },
    "es": {
      "source": "Wikipedia (es): Adenia heterophylla",
      "source_url": "https://es.wikipedia.org/wiki/Adenia_heterophylla",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 122641255,
      "text": "Adenia heterophylla es una especie de arbusto perteneciente a la familia Passifloraceae. Es originaria de Asia."
    },
    "id": {
      "source": "Wikipedia (id): Atarila",
      "source_url": "https://id.wikipedia.org/wiki/Atarila",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 28110282,
      "text": "Atarila adalah jenis tumbuhan merambat dari famili Passifloraceae. Agihan tumbuhan ini cukup luas merandai daerah khatulistiwa, dari sudut tenggara Tiongkok, memintasi Indochina dan Malesia, hingga ke benua Australia bagian utara. Di Australia spesies ini menjadi tumbuhan inang bagi larva berbagai jenis kupu-kupu, antara lain; glaswing, eastern red lacewing, dan cruiser."
    }
