  "description": {
    "ja": {
      "source": "Wikipedia (ja): オオケタデ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AA%E3%82%AA%E3%82%B1%E3%82%BF%E3%83%87",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 106351287,
      "text": "オオケタデ は、ナデシコ目タデ科イヌタデ属の一年生草本。別名でオオベニタデ（大紅蓼）、ベニバナオオケタデ（紅花大毛蓼）ともよばれている。同じタデ属のイヌタデやオオイヌタデに似ているが、本種はそれらよりも大型で葉幅も広く、花の紅色が鮮やかである。"
    },
    "en": {
      "source": "Wikipedia (en): Persicaria orientalis",
      "source_url": "https://en.wikipedia.org/wiki/Persicaria_orientalis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1306454297,
      "text": "Persicaria orientalis is a species of flowering plant in the family Polygonaceae, known as kiss-me-over-the-garden-gate and princess-feather. It was first described, as Polygonum orientale, by Carl Linnaeus in 1753. It was transferred to the genus Persicaria by Édouard Spach in 1841. Its native distribution is unclear. As of April 2023, Kew's Plants of The World Online lists its native distribution as ranging from the Russian far east to Indochina, Malesia and Australia. It is widely cultivated and naturalized."
    },
    "es": {
      "source": "Wikipedia (es): Polygonum orientale",
      "source_url": "https://es.wikipedia.org/wiki/Polygonum_orientale",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171581242,
      "text": "Polygonum orientale es una especie de planta fanerógama de la familia de las poligonáceas."
    },
    "fr": {
      "source": "Wikipedia (fr): Persicaria orientalis",
      "source_url": "https://fr.wikipedia.org/wiki/Persicaria_orientalis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 235646014,
      "text": "Persicaria orientalis, la Renouée orientale, est une espèce de plantes herbacées de la famille des Polygonaceae."
    },
    "pt": {
      "source": "Wikipedia (pt): Polygonum orientale",
