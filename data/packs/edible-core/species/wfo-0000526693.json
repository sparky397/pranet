  "description": {
    "en": {
      "source": "Wikipedia (en): Schoenoplectus americanus",
      "source_url": "https://en.wikipedia.org/wiki/Schoenoplectus_americanus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1255253248,
      "text": "Schoenoplectus americanus is an American species of flowering plant in the sedge family known by the common names chairmaker's bulrush and Olney's three-square bulrush."
    },
    "es": {
      "source": "Wikipedia (es): Scirpus americanus",
      "source_url": "https://es.wikipedia.org/wiki/Scirpus_americanus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 174618024,
      "text": "La totora, Scirpus americanus es una planta herbácea perenne acuática, de la familia de las Ciperáceas, común en esteros y pantanos de América del Sur."
    },
    "pt": {
      "source": "Wikipedia (pt): Schoenoplectus americanus",
      "source_url": "https://pt.wikipedia.org/wiki/Schoenoplectus_americanus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 47638761,
      "text": "Schoenoplectus americanus é uma espécie de planta da família Cyperaceae É nativa nos Estados Unidos e no Canadá. É extremamente importante para o Sapo-de-wyoming, pois este deposita seus ovos nessa planta."
    },
    "id": {
      "source": "Wikipedia (id): Schoenoplectus americanus",
      "source_url": "https://id.wikipedia.org/wiki/Schoenoplectus_americanus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 29549346,
      "text": "Schoenoplectus americanus adalah spesies tumbuhan berbunga asal Amerika dari suku teki-tekian yang dikenal dengan nama umum chairmaker's bulrush dan Olney's three-square bulrush."
    }
  },
  "sections": {
    "uses": {
      "en": {
        "source": "Wikipedia (en): Schoenoplectus americanus § Uses",
        "source_url": "https://en.wikipedia.org/wiki/Schoenoplectus_americanus#Uses",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1255253248,
        "heading": "Uses",
        "text": "Native American groups used this plant for many purposes, including food, basketry, and hatmaking. It is used for revegetation projects in salt marsh habitat in its native range. It is a model organism in the study of salt marsh ecology and its response to climate change (currently global warming).",
        "truncated": false
      },
      "id": {
        "source": "Wikipedia (id): Schoenoplectus americanus § Kegunaan",
        "source_url": "https://id.wikipedia.org/wiki/Schoenoplectus_americanus#Kegunaan",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 29549346,
        "heading": "Kegunaan",
        "text": "Kelompok Penduduk Asli Amerika menggunakan tumbuhan ini untuk berbagai keperluan, termasuk sebagai makanan, kerajinan keranjang, dan pembuatan topi. Tumbuhan ini digunakan untuk proyek revegetasi di habitat rawa asin di wilayah asalnya. Tumbuhan ini merupakan organisme model dalam studi ekologi rawa asin dan responsnya terhadap perubahan iklim (saat ini pemanasan global).",
        "truncated": false
      }
    }
  },
