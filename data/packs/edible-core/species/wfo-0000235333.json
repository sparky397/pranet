  "description": {
    "en": {
      "source": "Wikipedia 英語版「Antidesma bunius」",
      "source_url": "https://en.wikipedia.org/wiki/Antidesma_bunius",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1301268572,
      "text": "Antidesma bunius is a species of fruit tree in the family Phyllanthaceae. It is native to South Asia, Southeast Asia, Melanesia, and northern Australia. It is commonly known as bignay, after its native name in the Philippines, where the fruits are commonly used for making bignay wine and jams. It is also known more ambiguously as Chinese laurel, Queensland cherry, salamander tree, wild cherry, and currant tree."
    }
