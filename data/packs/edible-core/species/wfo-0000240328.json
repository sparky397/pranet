  "description": {
    "en": {
      "source": "Wikipedia (en): Mentha aquatica",
      "source_url": "https://en.wikipedia.org/wiki/Mentha_aquatica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1351317351,
      "text": "Mentha aquatica is a perennial flowering plant in the mint family, Lamiaceae. It grows in moist places and is native to much of Europe, northwest Africa and southwest Asia."
    },
    "es": {
      "source": "Wikipedia (es): Mentha aquatica",
      "source_url": "https://es.wikipedia.org/wiki/Mentha_aquatica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171671908,
      "text": "La menta acuática es una planta perenne del género Mentha, común por toda Europa, excepto en el extremo norte."
    },
    "fr": {
      "source": "Wikipedia (fr): Menthe aquatique",
      "source_url": "https://fr.wikipedia.org/wiki/Menthe_aquatique",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 236256950,
      "text": "La Menthe aquatique est une espèce de plantes à fleurs de la famille des Lamiacées. C'est une plante herbacée vivace de berge ou semi-aquatique, originaire d'Europe, d'Afrique du Nord, du Proche-Orient et du Caucase."
    },
    "pt": {
      "source": "Wikipedia (pt): Mentha aquatica",
      "source_url": "https://pt.wikipedia.org/wiki/Mentha_aquatica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 64440131,
      "text": "Mentha aquatica é uma espécie de planta com flor pertencente à família Lamiaceae. Conhecida como planta milagrosa."
    },
    "id": {
      "source": "Wikipedia (id): Bijanggut air",
      "source_url": "https://id.wikipedia.org/wiki/Bijanggut_air",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 28102641,
      "text": "Mentha aquatica atau bijanggut air adalah tumbuhan tahunan dari genus Mentha asli di seluruh Eropa kecuali di bagian utara, dan juga di Afrika barat laut dan Asia barat daya."
    }
