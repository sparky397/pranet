  "description": {
    "en": {
      "source": "Wikipedia (en): Sapindus rarak",
      "source_url": "https://en.wikipedia.org/wiki/Sapindus_rarak",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1308769724,
      "text": "Sapindus rarak is a species of soapberry. It is a deciduous tree up to 42 metres (138 ft) tall native to south and east Asia. Its species name is derived from the Malaysian name rerak or rerek. In Indonesia it is commonly known as lerak or klerek."
    },
    "id": {
      "source": "Wikipedia (id): Lerak",
      "source_url": "https://id.wikipedia.org/wiki/Lerak",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29644162,
      "text": "Lerak atau dikenal juga sebagai rerek, kanikia, atau lamuran adalah tumbuhan yang dikenal karena kegunaan bijinya yang dipakai sebagai detergen tradisional. Batik biasanya dianjurkan untuk dicuci dengan lerak karena dianggap sebagai bahan pencuci paling sesuai untuk menjaga kualitasnya."
    }
  },
