  "description": {
    "en": {
      "source": "Wikipedia (en): Prunus nigra",
      "source_url": "https://en.wikipedia.org/wiki/Prunus_nigra",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1372977731,
      "text": "Prunus nigra, the Canada plum, Canadian plum, or black plum, is a species of Prunus native to eastern North America."
    },
    "es": {
      "source": "Wikipedia (es): Prunus nigra",
      "source_url": "https://es.wikipedia.org/wiki/Prunus_nigra",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 173212473,
      "text": "Prunus nigra es una especie de arbusto perteneciente a la familia de las rosáceas, nativa del este de Norteamérica desde Nuevo Brunswick y Manitoba, al sur hasta Connecticut a través de Iowa. Anteriormente se encontraba en Ohio pero se cree que se ha extinguido en este estado."
    },
    "fr": {
      "source": "Wikipedia (fr): Prunus nigra",
      "source_url": "https://fr.wikipedia.org/wiki/Prunus_nigra",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 235072478,
      "text": "Prunus nigra, communément appelé le Prunier noir, est une espèce de plantes à fleurs de la famille des Rosaceae. C'est un arbuste fruitier que l'on trouve en Amérique du Nord."
    }
