  "description": {
    "en": {
      "source": "Wikipedia (en): Archidendron pauciflorum",
      "source_url": "https://en.wikipedia.org/wiki/Archidendron_pauciflorum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1366190647,
      "text": "Archidendron pauciflorum is a species of flowering plant in the family Fabaceae. It is native to Sulawesi, the Philippines, and the Lesser Sunda Islands."
    },
    "fr": {
      "source": "Wikipedia (fr): Archidendron pauciflorum",
      "source_url": "https://fr.wikipedia.org/wiki/Archidendron_pauciflorum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 224712388,
      "text": "Archidendron pauciflorum, appelé localement jengkol ou jering, est une espèce de plantes à fleurs dicotylédones de la famille des Fabaceae, sous-famille des Mimosoideae, originaire d'Asie du Sud-Est."
    },
    "id": {
      "source": "Wikipedia (id): Jengkol",
      "source_url": "https://id.wikipedia.org/wiki/Jengkol",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29397891,
      "text": "Jengkol atau jering adalah tumbuhan khas di wilayah Asia Tenggara. Bijinya digemari di Malaysia, Myanmar, dan Thailand. Masyarakat Indonesia mengenalnya sebagai bahan pangan."
    }
