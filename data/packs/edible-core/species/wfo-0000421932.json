  "description": {
    "ja": {
      "source": "Wikipedia (ja): ツルコケモモ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%84%E3%83%AB%E3%82%B3%E3%82%B1%E3%83%A2%E3%83%A2",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 111252728,
      "text": "ツルコケモモ はツツジ科スノキ属ツルコケモモ亜属の常緑小低木。"
    },
    "en": {
      "source": "Wikipedia (en): Vaccinium oxycoccos",
      "source_url": "https://en.wikipedia.org/wiki/Vaccinium_oxycoccos",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1365322145,
      "text": "Vaccinium oxycoccos is a species of cranberry in the heath family. It is known as small cranberry, marshberry, bog cranberry, swamp cranberry, or just cranberry. It occurs broadly across cooler climates in the temperate Northern Hemisphere."
    },
    "es": {
      "source": "Wikipedia (es): Vaccinium oxycoccos",
      "source_url": "https://es.wikipedia.org/wiki/Vaccinium_oxycoccos",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 171580820,
      "text": "El arándano palustre es una especie de planta fanerógama perteneciente a la familia Ericaceae."
    },
    "fr": {
      "source": "Wikipedia (fr): Vaccinium oxycoccos",
      "source_url": "https://fr.wikipedia.org/wiki/Vaccinium_oxycoccos",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 236123504,
      "text": "Vaccinium oxycoccos, de noms communs Canneberge ou Myrtille des marais, est une espèce de plantes de la famille des Ericaceae, du genre Vaccinium et du sous-genre Oxycoccos (Canneberges)."
    }
  },
  "sections": {
    "cultivation": {
      "ja": {
        "source": "Wikipedia (ja): ツルコケモモ § 栽培",
        "source_url": "https://ja.wikipedia.org/wiki/%E3%83%84%E3%83%AB%E3%82%B3%E3%82%B1%E3%83%A2%E3%83%A2#%E6%A0%BD%E5%9F%B9",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 111252728,
        "heading": "栽培",
        "text": "植えつけ場所は、午前中は日当たりがよく、午後は明るい木陰になるような場所がよい。水やりは、庭植えの場合でも土を乾かさないように随時行う必要がある。\n植え付けの適期は2月中旬から3月中旬頃。植え替えは、根詰まりを防ぎ、通気をよくするのが目的で、生育具合にもよるが、通常2年に1回は必要になる。\n増やしたい場合、2月中旬から下旬に株分けをするか、3月、あるいは梅雨の時期に挿し芽をして増やす。\n株が混んだら随時、間引いたり、切り詰めを行う。",
        "truncated": false
      }
    },
    "uses": {
      "en": {
        "source": "Wikipedia (en): Vaccinium oxycoccos § Uses",
        "source_url": "https://en.wikipedia.org/wiki/Vaccinium_oxycoccos#Uses",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1365322145,
        "heading": "Uses",
        "text": "The berries are edible and have been used both as a medicine and as a food by various Native American communities. Some Iñupiat cook the cranberry with fish eggs and blubber.",
        "truncated": false
      }
    }
  },
