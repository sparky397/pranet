  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ツルコケモモ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%84%E3%83%AB%E3%82%B3%E3%82%B1%E3%83%A2%E3%83%A2",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 111252728,
      "text": "ツルコケモモ はツツジ科スノキ属ツルコケモモ亜属の常緑小低木。"
    },
    "en": {
      "source": "Wikipedia 英語版「Vaccinium oxycoccos」",
      "source_url": "https://en.wikipedia.org/wiki/Vaccinium_oxycoccos",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1365322145,
      "text": "Vaccinium oxycoccos is a species of cranberry in the heath family. It is known as small cranberry, marshberry, bog cranberry, swamp cranberry, or just cranberry. It occurs broadly across cooler climates in the temperate Northern Hemisphere."
    }
  },
  "sections": {
    "cultivation": {
      "ja": {
        "source": "Wikipedia 日本語版「ツルコケモモ」の節「栽培」",
        "source_url": "https://ja.wikipedia.org/wiki/%E3%83%84%E3%83%AB%E3%82%B3%E3%82%B1%E3%83%A2%E3%83%A2#%E6%A0%BD%E5%9F%B9",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 111252728,
        "heading": "栽培",
        "text": "植えつけ場所は、午前中は日当たりがよく、午後は明るい木陰になるような場所がよい。水やりは、庭植えの場合でも土を乾かさないように随時行う必要がある。\n植え付けの適期は2月中旬から3月中旬頃。植え替えは、根詰まりを防ぎ、通気をよくするのが目的で、生育具合にもよるが、通常2年に1回は必要になる。\n増やしたい場合、2月中旬から下旬に株分けをするか、3月、あるいは梅雨の時期に挿し芽をして増やす。\n株が混んだら随時、間引いたり、切り詰めを行う。",
        "truncated": false
      }
    }
  },
