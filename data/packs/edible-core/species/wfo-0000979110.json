    "ja": {
      "source": "Wikipedia (ja): ハメリア・パテンス",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%8F%E3%83%A1%E3%83%AA%E3%82%A2%E3%83%BB%E3%83%91%E3%83%86%E3%83%B3%E3%82%B9",
