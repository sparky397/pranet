  "description": {
    "en": {
      "source": "Wikipedia (en): Semecarpus anacardium",
      "source_url": "https://en.wikipedia.org/wiki/Semecarpus_anacardium",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1315285208,
      "text": "Semecarpus anacardium, commonly known as the marking nut tree, Malacca bean tree, marany nut, oriental cashew, dhobi nut tree and varnish tree, is a native of India, found in the outer Himalayas to the Coromandel Coast. It is closely related to the cashew."
    },
    "es": {
      "source": "Wikipedia (es): Semecarpus anacardium",
      "source_url": "https://es.wikipedia.org/wiki/Semecarpus_anacardium",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 123257999,
      "text": "El anacardo asiático es una planta nativa de la India, propia de la región que abarca desde los Himalayas exteriores hasta la Costa de Coromandel. Posee varias similitudes con la nuéz de cajú."
    },
    "fr": {
      "source": "Wikipedia (fr): Semecarpus anacardium",
      "source_url": "https://fr.wikipedia.org/wiki/Semecarpus_anacardium",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 222341050,
      "text": "Semecarpus anacardium ou Anacardium orientale, en anglais marking-nut tree, est un arbre de la famille des Anacardiacées. Il est proche de l'anacardier, qui donne la noix de cajou."
    },
    "pt": {
      "source": "Wikipedia (pt): Semecarpus anacardium",
      "source_url": "https://pt.wikipedia.org/wiki/Semecarpus_anacardium",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 71230417,
      "text": "O anacárdio-oriental, também conhecido como bibó, balador e fava-de-malaca, é uma árvore nativa da Índia, e está intimamente relacionado com o caju."
    }
  },
