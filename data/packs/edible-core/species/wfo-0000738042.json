  "description": {
    "ja": {
      "source": "Wikipedia (ja): オモダカ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AA%E3%83%A2%E3%83%80%E3%82%AB",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 108302199,
      "text": "オモダカ は、オモダカ科オモダカ属の水生植物である。ハナグワイ、サンカクグサ、イモグサ、オトゲナシなど多くの別名がある。オモダカの語源ははっきりとはしておらず、人の顔に似た葉を高く伸ばしている様子を指して「面高」とされたとも、中国語で湿地を意味する涵澤（オムダク）からとられたとも言われる。"
    },
    "en": {
      "source": "Wikipedia (en): Sagittaria trifolia",
      "source_url": "https://en.wikipedia.org/wiki/Sagittaria_trifolia",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1371202772,
      "text": "Sagittaria trifolia, the threeleaf arrowhead or Chinese arrowhead, is a plant species widespread across the wet areas in Europe and in much of Asia."
    },
    "fr": {
      "source": "Wikipedia (fr): Sagittaire trifoliée",
      "source_url": "https://fr.wikipedia.org/wiki/Sagittaire_trifoli%C3%A9e",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 215540029,
      "text": "La Sagittaire trifoliée, est une espèce de plantes aquatiques de la famille des Alismataceae."
    },
    "id": {
      "source": "Wikipedia (id): Sagittaria trifolia",
      "source_url": "https://id.wikipedia.org/wiki/Sagittaria_trifolia",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29564259,
      "text": "Sagittaria trifolia, atau yang dikenal sebagai threeleaf arrowhead atau Chinese arrowhead, adalah spesies tumbuhan yang tersebar luas di wilayah basah di Eropa dan sebagian besar Asia."
    }
