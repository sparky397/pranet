  "description": {
    "en": {
      "source": "Wikipedia (en): Claytonia perfoliata",
      "source_url": "https://en.wikipedia.org/wiki/Claytonia_perfoliata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1379235690,
      "text": "Claytonia perfoliata, commonly known as miner's lettuce or winter purslane, is a flowering plant in the family Montiaceae. It is an edible, fleshy, herbaceous, annual plant native to the western mountain and coastal regions of North America."
    },
    "es": {
      "source": "Wikipedia (es): Claytonia perfoliata",
      "source_url": "https://es.wikipedia.org/wiki/Claytonia_perfoliata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 175376536,
      "text": "La verdolaga de Cuba es una especie de planta anual carnosa nativa de las regiones montañosas y costeras del oeste de América del Norte desde el sur de Alaska y la zona central de la Columbia Británica hasta América Central, es muy común en California en el valle de Sacramento y la zona norte del valle de San Joaquín."
    },
    "fr": {
      "source": "Wikipedia (fr): Claytonia perfoliata",
      "source_url": "https://fr.wikipedia.org/wiki/Claytonia_perfoliata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 240048337,
      "text": "La claytonie perfoliée, claytone de Cuba, ou encore le pourpier d'hiver (Claytonia perfoliata) est une espèce de plantes annuelles du genre Claytonia relevant de la famille des Portulacacées selon la classification de Cronquist ou de la famille des Montiacées, suivant la classification APG III."
    },
    "pt": {
      "source": "Wikipedia (pt): Montia perfoliata",
      "source_url": "https://pt.wikipedia.org/wiki/Montia_perfoliata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 60069784,
      "text": "Montia perfoliata é uma espécie de planta com flor pertencente à família Portulacaeae."
    },
    "id": {
      "source": "Wikipedia (id): Krokot musim dingin",
      "source_url": "https://id.wikipedia.org/wiki/Krokot_musim_dingin",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 30025288,
      "text": "Claytonia perfoliata, umumnya dikenal sebagai selada penambang, selada India, atau krokot musim dingin, merupakan tanaman berbunga dalam keluarga Montiaceae. Ini adalah tanaman tahunan yang dapat dimakan, berdaging, herba, asli pegunungan barat dan wilayah pesisir Amerika Utara."
    }
