  "description": {
    "en": {
      "source": "Wikipedia (en): Heliotropium indicum",
      "source_url": "https://en.wikipedia.org/wiki/Heliotropium_indicum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1368463486,
      "text": "Heliotropium indicum, commonly known as Indian heliotrope or Indian turnsole, is an annual, hirsute plant. It has a curved arrangement of small flowers and velvety broad green leaves."
    },
    "es": {
      "source": "Wikipedia (es): Heliotropium indicum",
      "source_url": "https://es.wikipedia.org/wiki/Heliotropium_indicum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 173793952,
      "text": "Heliotropium indicum, comúnmente conocido como el heliotropo indio, es una planta anual, hirsuta que es una maleza común en lugares de desecho y las zonas pobladas. Es originaria de Asia."
    },
    "fr": {
      "source": "Wikipedia (fr): Heliotropium indicum",
      "source_url": "https://fr.wikipedia.org/wiki/Heliotropium_indicum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 192507955,
      "text": "Heliotropium indicum est une espèce de plantes annuelles de la famille des Boraginaceae."
    },
    "pt": {
      "source": "Wikipedia (pt): Heliotropium indicum",
      "source_url": "https://pt.wikipedia.org/wiki/Heliotropium_indicum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 63311377,
      "text": "Heliotropium indicum, conhecida como cravo de anum ou cravo de urubu, é uma planta anual da família Boraginaceae, nativa de Asia."
    },
    "id": {
      "source": "Wikipedia (id): Sangketan",
      "source_url": "https://id.wikipedia.org/wiki/Sangketan",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29875635,
      "text": "Sangketan  atau  buntut tikus adalah spesies tanaman berbunga dari genus Heliotropium. Tanaman ini termasuk ke dalam gulma yang tumbuh secara liar dan dapat ditemukan di ladang, pinggir sawah, pekarangan rumah dan tanah kosong. Meskipun demikian, tanaman ini juga bisa dijadikan obat tradisional."
    }
  },
