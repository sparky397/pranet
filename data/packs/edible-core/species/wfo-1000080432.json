  "description": {
    "ja": {
      "source": "Wikipedia (ja): ウッドアップル",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%A6%E3%83%83%E3%83%89%E3%82%A2%E3%83%83%E3%83%97%E3%83%AB",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 111185308,
      "text": "ウッドアップル はミカン科の高木。ゾウノリンゴと呼ばれることもある。本稿では、一属一種のLimonia属についても述べる。"
    },
    "en": {
      "source": "Wikipedia (en): Limonia acidissima",
      "source_url": "https://en.wikipedia.org/wiki/Limonia_acidissima",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1357051022,
      "text": "Limonia acidissima is the only species within the monotypic genus Limonia. Common names for this South Asian species in English include wood-apple and elephant-apple. It is sometimes also called monkey fruit."
    },
    "es": {
      "source": "Wikipedia (es): Limonia acidissima",
      "source_url": "https://es.wikipedia.org/wiki/Limonia_acidissima",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171584103,
      "text": "Limonia acidissima, o kawista es la única especie del género monotípico Limonia; es una planta fanerógama de la familia Rutaceae, emparentada con los citrus. Su única especie es originaria de Asia."
    },
    "fr": {
      "source": "Wikipedia (fr): Limonia acidissima",
      "source_url": "https://fr.wikipedia.org/wiki/Limonia_acidissima",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 222204962,
      "text": "Limonia acidissima Kawista,surnommé également Pomme à coque, il est la seule espèce du genre Limonia de la famille des Rutacées. C'est un parent proche des agrumes."
    },
    "pt": {
      "source": "Wikipedia (pt): Limonia",
      "source_url": "https://pt.wikipedia.org/wiki/Limonia",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 66049845,
      "text": "Limonia é um género botânico pertencente à família Rutaceae."
    },
    "id": {
      "source": "Wikipedia (id): Kawista",
      "source_url": "https://id.wikipedia.org/wiki/Kawista",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29984752,
      "text": "Kawista adalah kerabat dekat maja dan masih termasuk dalam suku jeruk-jerukan (Rutaceae). Tumbuhan yang dimanfaatkan buahnya ini sudah jarang dijumpai meskipun sekarang beberapa daerah mulai mengembangkannya. Kawista relatif tahan kondisi buruk dan tahan penyakit. Asalnya adalah dari India selatan hingga ke Asia Tenggara dan Jawa."
    }
  },
  "sections": {
    "cultivation": {
      "fr": {
        "source": "Wikipedia (fr): Limonia acidissima § Culture",
        "source_url": "https://fr.wikipedia.org/wiki/Limonia_acidissima#Culture",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 222204962,
        "heading": "Culture",
        "text": "L'arbre est généralement propagé par les graines mais le bouturage de racines, le marcottage aérien et le greffage sur francs sont également pratiqués.\nLe semis donne des fruits à l'âge de 15 ans.\nIl peut pousser jusqu'à une altitude de 460 m dans l'Himalaya occidental.\nUne période sèche et une période de mousson lui sont nécessaires pour fructifier.\nIl supporte tous types de sol avec une préférence pour les sols légers.\nAprès la cueillette, le fruit est gardé une quinzaine de jours pour finir sa maturation.\nLe Limonia est utilisé avec succès comme porte-greffe de Citrus. Cette greffe provoque une mise à fruit extrêmement précoce ce qui le fait utiliser pour provoquer une mise à fruits forcée pour accélérer la mise au point de nouveaux hybrides de Citrus.",
        "truncated": false
      }
    }
  },
