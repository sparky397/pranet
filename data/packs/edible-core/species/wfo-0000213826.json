  "description": {
    "en": {
      "source": "Wikipedia 英語版「Lathyrus tuberosus」",
      "source_url": "https://en.wikipedia.org/wiki/Lathyrus_tuberosus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1377008752,
      "text": "Lathyrus tuberosus is a small, climbing perennial plant, native in moist temperate parts of Europe and Western Asia. The plant is a trailer or weak climber, supported by tendrils, growing to 1.2 m tall. The leaves are pinnate, with two leaflets and a branched twining tendril at the apex of the petiole. Its flowers are hermaphroditic, pollinated by bees. The plants can also spread vegetatively from the root system."
    }
  },
