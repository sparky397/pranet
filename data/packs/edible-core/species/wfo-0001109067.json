  "description": {
    "en": {
      "source": "Wikipedia 英語版「Osmunda regalis」",
      "source_url": "https://en.wikipedia.org/wiki/Osmunda_regalis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1335652384,
      "text": "Osmunda regalis, or royal fern, is a species of deciduous fern, native to Europe, North Africa and West Asia, growing in woodland bogs and on the banks of streams. The species is sometimes known as flowering fern due to the appearance of its fertile fronds."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Osmunda regalis」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Osmunda_regalis#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1335652384,
        "heading": "Cultivation",
        "text": "Osmunda regalis is widely cultivated in temperate regions. The species and the cultivar 'Cristata' have both gained the Royal Horticultural Society's Award of Garden Merit. Osmunda plants should be planted in preferably acidic, moist soil, associating well with other large moisture-loving plants such as Rodgersia and Gunnera. However, it tolerates a range of soil and climatic conditions.",
        "truncated": false
      }
    }
  },
