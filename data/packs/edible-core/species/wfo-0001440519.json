  "description": {
    "en": {
      "source": "Wikipedia (en): Chenopodiastrum murale",
      "source_url": "https://en.wikipedia.org/wiki/Chenopodiastrum_murale",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1340851122,
      "text": "Chenopodiastrum murale is a species of plant in the family Amaranthaceae known by the common names nettle-leaved goosefoot, Australian-spinach, salt-green, and sowbane. This plant is native to Europe and parts of Asia and northern Africa, but it is widespread worldwide, particularly in tropical and subtropical areas due to the ease of it being introduced. It is a common weed of fields and roadsides."
    },
    "es": {
      "source": "Wikipedia (es): Chenopodiastrum murale",
      "source_url": "https://es.wikipedia.org/wiki/Chenopodiastrum_murale",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 173929458,
      "text": "Chenopodiastrum murale es una especie de planta fanerógama herbácea de la familia Amaranthaceae."
    },
    "fr": {
      "source": "Wikipedia (fr): Chenopodiastrum murale",
      "source_url": "https://fr.wikipedia.org/wiki/Chenopodiastrum_murale",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 201084973,
      "text": "Le Chénopode des murs est une plante herbacée, de la famille des Amaranthaceae, ayant une vaste répartition dans le monde. C'est une plante rudérale, qui se rencontre dans les friches, les cultures et même dans les villes sur les trottoirs au pied des murs ou des arbres."
    },
    "pt": {
      "source": "Wikipedia (pt): Chenopodium murale",
      "source_url": "https://pt.wikipedia.org/wiki/Chenopodium_murale",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 64612010,
      "text": "Chenopodium murale é uma espécie de planta com flor pertencente à família Chenopodiaceae."
    },
    "id": {
      "source": "Wikipedia (id): Chenopodiastrum murale",
      "source_url": "https://id.wikipedia.org/wiki/Chenopodiastrum_murale",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29437397,
      "text": "Chenopodiastrum murale adalah spesies tumbuhan dalam keluarga Amaranthaceae yang dikenal dengan nama umum dalam bahasa Inggris nettle-leaved goosefoot, Australian-spinach, salt-green, dan sowbane. Tumbuhan ini berasal dari Eropa serta sebagian Asia dan Afrika Utara, namun telah tersebar luas di seluruh dunia, terutama di daerah tropis dan subtropis karena kemudahannya menjadi spesies introduksi. Tumbuhan ini merupakan gulma umum di ladang dan pinggir jalan."
    }
  },
