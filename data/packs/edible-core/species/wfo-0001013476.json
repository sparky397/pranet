  "description": {
    "en": {
      "source": "Wikipedia (en): Geum urbanum",
      "source_url": "https://en.wikipedia.org/wiki/Geum_urbanum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1367046657,
      "text": "Geum urbanum, also known as wood avens, herb Bennet, colewort, clove root and St. Benedict's herb, is a perennial plant in the rose family (Rosaceae), which grows in shady places in the temperate regions of Eurasia and North America."
    },
    "es": {
      "source": "Wikipedia (es): Geum urbanum",
      "source_url": "https://es.wikipedia.org/wiki/Geum_urbanum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 155316285,
      "text": "Geum urbanum es una planta perenne, también conocida como hierba de San Benito de la familia Rosaceae."
    },
    "fr": {
      "source": "Wikipedia (fr): Benoîte commune",
      "source_url": "https://fr.wikipedia.org/wiki/Beno%C3%AEte_commune",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 226995385,
      "text": "La benoîte commune ou benoîte urbaine, également appelée herbe de saint Benoît ou herbe du bon soldat, est une espèce de plantes à fleurs de la famille des Rosaceae."
    },
    "pt": {
      "source": "Wikipedia (pt): Geum urbanum",
      "source_url": "https://pt.wikipedia.org/wiki/Geum_urbanum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 64612068,
      "text": "Geum urbanum é uma espécie de planta com flor pertencente à família Rosaceae. O seu nome comum é erva-benta ou sanamunda"
    }
  },
  "sections": {
    "uses": {
      "en": {
        "source": "Wikipedia (en): Geum urbanum § Uses",
        "source_url": "https://en.wikipedia.org/wiki/Geum_urbanum#Uses",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1367046657,
        "heading": "Uses",
        "text": "The leaves can be cooked like spinach.\nThe roots contain the compound eugenol (which is also present in cloves),  and are used as a spice in soups and also for flavouring ale. For example, the Augsburg Ale is said to owe its peculiar flavour to the addition of a small bag of avens inside each cask. The fresh root imparts a pleasant clove-like flavour to the liquor, preserves it from turning sour, and adds to its wholesome properties.\nHerbalists use wood avens to treat various diseases, but there is no evidence that it makes any difference.\nA cordial against the plague was made by boiling the roots in wine. English botanist John Gerard recommended a \"decoction made in wine against stomach ills and bites of venomous beasts\". Because of its digestive tonic properties, chewing of the root was also recommended for foul breath.",
        "truncated": false
      },
      "fr": {
        "source": "Wikipedia (fr): Benoîte commune § Propriétés médicinales",
        "source_url": "https://fr.wikipedia.org/wiki/Beno%C3%AEte_commune#Propri%C3%A9t%C3%A9s_m%C3%A9dicinales",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 226995385,
        "heading": "Propriétés médicinales",
        "text": "Ses feuilles et son rhizome sont astringents et vulnéraires du fait de l'huile essentielle et du tanin qu'ils contiennent, d'où ses usages traditionnels comme antihémorragique, antidiarrhéique, fébrifuge, styptique, pour soulager les maux de gorge ou les maux d'estomac.",
        "truncated": false
      }
    }
  },
