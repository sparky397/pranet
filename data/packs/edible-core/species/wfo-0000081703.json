  "description": {
    "ja": {
      "source": "Wikipedia (ja): アメリカオニアザミ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%A2%E3%83%A1%E3%83%AA%E3%82%AB%E3%82%AA%E3%83%8B%E3%82%A2%E3%82%B6%E3%83%9F",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 110552094,
      "text": "アメリカオニアザミ はキク科アザミ属の多年草。日本には本来分布していない外来種。和名に「アメリカ」とあるがヨーロッパ原産のアザミであり、誤解をさけるためセイヨウオニアザミと呼ばれることがある。中国名は、翼薊。"
    },
    "en": {
      "source": "Wikipedia (en): Cirsium vulgare",
      "source_url": "https://en.wikipedia.org/wiki/Cirsium_vulgare",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1366977840,
      "text": "Cirsium vulgare, commonly known as spear thistle, bull thistle, or common thistle, is a species of the Asteraceae genus Cirsium, native throughout most of Europe, Western Asia, and northwestern Africa. It is also naturalised in North America, Africa, and Australia and is an invasive weed in several regions. It is the national flower of Scotland."
    },
    "es": {
      "source": "Wikipedia (es): Cirsium vulgare",
      "source_url": "https://es.wikipedia.org/wiki/Cirsium_vulgare",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 174357642,
      "text": "Cirsium vulgare es una especie de cardo del género Cirsium en la familia Asteraceae. Es nativa de Europa, Asia, norte de África, y está introducida en América, donde se comporta como una maleza."
    },
    "fr": {
      "source": "Wikipedia (fr): Cirse commun",
      "source_url": "https://fr.wikipedia.org/wiki/Cirse_commun",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 240015819,
      "text": "Le Cirse commun, ou Cirse à feuilles lancéolées, est une espèce de plantes à fleurs de la famille des Astéracées et du genre Cirsium."
    },
    "pt": {
      "source": "Wikipedia (pt): Cirsium vulgare",
      "source_url": "https://pt.wikipedia.org/wiki/Cirsium_vulgare",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 72015861,
      "text": "Cirsium vulgare é uma espécie de planta com flor pertencente à família Asteraceae."
    },
    "id": {
      "source": "Wikipedia (id): Waga-waga",
      "source_url": "https://id.wikipedia.org/wiki/Waga-waga",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29706142,
      "text": "Cirsium vulgare, waga-waga, adalah spesies dari genus Asteraceae Cirsium, asli di sebagian besar Eropa, Asia Barat, dan Afrika barat laut. Itu juga dinaturalisasi di Amerika Utara, Afrika, dan Australia dan merupakan gulma invasif di beberapa daerah. Ini adalah bunga nasional Skotlandia."
    }
  },
