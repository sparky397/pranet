  "description": {
    "en": {
      "source": "Wikipedia (en): Pinus oocarpa",
      "source_url": "https://en.wikipedia.org/wiki/Pinus_oocarpa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1375588258,
      "text": "Pinus oocarpa is a species of conifer in the family Pinaceae, a pine tree native to Mexico and Central America. It is the national tree of Honduras, where it is known as ocote. Common names include ocote chino, pino amarillo, pino avellano, Mexican yellow pine, egg-cone pine and hazelnut pine. It appears that it was the progenitor (original) species that served as the ancestor for some of the other pines of Mexico."
    },
    "es": {
      "source": "Wikipedia (es): Pinus oocarpa",
      "source_url": "https://es.wikipedia.org/wiki/Pinus_oocarpa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 166843137,
      "text": "Pinus oocarpa , conocido como pino amarillo o pino avellano, es una especie de pino nativo de Centroamérica. Representa el árbol nacional de Honduras."
    },
    "fr": {
      "source": "Wikipedia (fr): Pinus oocarpa",
      "source_url": "https://fr.wikipedia.org/wiki/Pinus_oocarpa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 208077969,
      "text": "Pinus oocarpa est une espèce de conifères de la famille des Pinaceae."
    },
    "pt": {
      "source": "Wikipedia (pt): Pinus oocarpa",
      "source_url": "https://pt.wikipedia.org/wiki/Pinus_oocarpa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 70205934,
      "text": "Pinus oocarpa é uma espécie de pinheiro originária do Novo Mundo. Faz parte do grupo de espécies de pinheiros com área de distribuição na América Central, Caraíbas, México, sul do Arizona e Novo México."
    }
