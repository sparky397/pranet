  "description": {
    "ja": {
      "source": "Wikipedia (ja): ホウライシダ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%9B%E3%82%A6%E3%83%A9%E3%82%A4%E3%82%B7%E3%83%80",
      "license": "CC BY-SA 4.0",
