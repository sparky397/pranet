  "description": {
    "ja": {
      "source": "Wikipedia (ja): ハママツナ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%8F%E3%83%9E%E3%83%9E%E3%83%84%E3%83%8A",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 111236939,
      "text": "ハママツナ はナデシコ目ヒユ科の一年草。海岸の砂地によく自生し、茎の高さは20cm-60cm程度。線状の長さ2,3cm程度のマツに似た葉を持ち、花弁を持たず、背面には稜がある。9-10月が花の時期。"
    },
    "en": {
      "source": "Wikipedia (en): Suaeda maritima",
      "source_url": "https://en.wikipedia.org/wiki/Suaeda_maritima",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1334341963,
      "text": "Suaeda maritima is a species of flowering plant in the family Amaranthaceae known by the common names herbaceous seepweed and annual seablite."
    },
    "es": {
      "source": "Wikipedia (es): Suaeda maritima",
      "source_url": "https://es.wikipedia.org/wiki/Suaeda_maritima",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 174141186,
      "text": "Suaeda maritima es una especie de fanerógama, halófita perteneciente a la familia Chenopodiaceae."
    },
    "fr": {
      "source": "Wikipedia (fr): Suaeda maritima",
      "source_url": "https://fr.wikipedia.org/wiki/Suaeda_maritima",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 200726088,
      "text": "La soude maritime est une petite plante comestible de Méditerranée, Atlantique et Manche.\nElle vit uniquement sur des sols salés du littoral."
    },
    "id": {
      "source": "Wikipedia (id): Suaeda maritima",
      "source_url": "https://id.wikipedia.org/wiki/Suaeda_maritima",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29277119,
      "text": "Suaeda maritima adalah spesies tumbuhan berbunga dalam keluarga Amaranthaceae yang dikenal dengan nama umum herbaceous seepweed dan annual seablite."
    }
