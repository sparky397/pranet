  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ハママツナ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%8F%E3%83%9E%E3%83%9E%E3%83%84%E3%83%8A",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 111236939,
      "text": "ハママツナ はナデシコ目ヒユ科の一年草。海岸の砂地によく自生し、茎の高さは20cm-60cm程度。線状の長さ2,3cm程度のマツに似た葉を持ち、花弁を持たず、背面には稜がある。9-10月が花の時期。"
    },
    "en": {
      "source": "Wikipedia 英語版「Suaeda maritima」",
      "source_url": "https://en.wikipedia.org/wiki/Suaeda_maritima",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1334341963,
      "text": "Suaeda maritima is a species of flowering plant in the family Amaranthaceae known by the common names herbaceous seepweed and annual seablite."
    }
  },
