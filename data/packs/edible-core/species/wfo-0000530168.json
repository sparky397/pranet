  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「スギモリゲイトウ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%B9%E3%82%AE%E3%83%A2%E3%83%AA%E3%82%B2%E3%82%A4%E3%83%88%E3%82%A6",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 107501050,
      "text": "スギモリゲイトウ は、メキシコやニカラグアなどの中南米に自生している被子植物である。"
    },
    "en": {
      "source": "Wikipedia 英語版「Amaranthus cruentus」",
      "source_url": "https://en.wikipedia.org/wiki/Amaranthus_cruentus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1340526355,
      "text": "Amaranthus cruentus is a flowering plant species that is native from Central Mexico to Nicaragua. It yields a nutritious staple amaranth grain, being one of three Amaranthus species cultivated as a grain source, the other two being Amaranthus hypochondriacus and Amaranthus caudatus. It has several common names, including blood amaranth, red amaranth, purple amaranth, prince's feather, and Mexican grain amaranth."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Amaranthus cruentus」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Amaranthus_cruentus#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1340526355,
        "heading": "Cultivation",
        "text": "A. cruentus is cultivated as an ornamental plant, valued for its feather-like flowering plumes. It is usually grown from seed as a half-hardy annual, that is sown under glass in early spring and planted out in summer. Numerous cultivars have been developed, of which the following have gained the Royal Horticultural Society's Award of Garden Merit:\n\n'Autumn Palette Group' (earth colours – rust, cream, brown)\n'Oeschberg' (crimson flowers)\n'Velvet Curtains' (deep red/crimson)",
        "truncated": false
      }
    }
  },
