  "description": {
    "ja": {
      "source": "Wikipedia (ja): ヒマワリヒヨドリ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%92%E3%83%9E%E3%83%AF%E3%83%AA%E3%83%92%E3%83%A8%E3%83%89%E3%83%AA",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 106372658,
      "text": "ヒマワリヒヨドリ は、キク科の植物である。熱帯アメリカ原産で、日本では外来種として定着している。"
    },
    "en": {
      "source": "Wikipedia (en): Chromolaena odorata",
      "source_url": "https://en.wikipedia.org/wiki/Chromolaena_odorata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1374059998,
      "text": "Chromolaena odorata is also known as jack in the bush. It is a tropical and subtropical species of flowering shrub in the family Asteraceae. It is native to the Americas, from Florida and Texas in the United States south through Mexico and the Caribbean to South America. It has been introduced to tropical Asia, West Africa, and parts of Australia."
    },
    "es": {
      "source": "Wikipedia (es): Chromolaena odorata",
      "source_url": "https://es.wikipedia.org/wiki/Chromolaena_odorata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 175313092,
      "text": "La albahaquilla de Cuba, también conocida como rompe saragüey, es un arbusto de la familia del girasol nativo de Norteamérica, desde Florida y Texas a México, Centroamérica, Sudamérica y en las islas de las Antillas, con una distribución amplia fuera de su rango nativo. Está incluido en la lista 100 de las especies exóticas invasoras más dañinas del mundo de la Unión Internacional para la Conservación de la Naturaleza."
    },
    "fr": {
      "source": "Wikipedia (fr): Chromolaena odorata",
      "source_url": "https://fr.wikipedia.org/wiki/Chromolaena_odorata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 236223457,
      "text": "Chromolaena odorata, l’herbe du Laos, est une espèce de plantes à fleurs dicotylédones de la famille des Asteraceae, originaire d'Amérique du Sud."
    },
    "pt": {
      "source": "Wikipedia (pt): Chromolaena odorata",
      "source_url": "https://pt.wikipedia.org/wiki/Chromolaena_odorata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 65684176,
      "text": "Chromolaena odorata é uma espécie tropical e subtropical de arbusto florido da família das asteráceas (Asteraceae). É nativo das Américas, desde a Flórida e Texas nos Estados Unidos ao sul, passando pelo México e Caribe até a América do Sul. Foi introduzido na Ásia tropical, África Ocidental e partes da Austrália. Consta na vigésima terceiro lugar na lista de 100 das espécies exóticas invasoras mais daninhas do mundo."
    }
  },
  "sections": {
    "toxicity": {
      "en": {
        "source": "Wikipedia (en): Chromolaena odorata § Toxicity",
        "source_url": "https://en.wikipedia.org/wiki/Chromolaena_odorata#Toxicity",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 1374059998,
        "heading": "Toxicity",
        "text": "Chromolaena odorata is toxic to cattle and is larvicidal against all major mosquito vectors. It can also cause allergic reactions.",
        "truncated": false
      },
      "es": {
        "source": "Wikipedia (es): Chromolaena odorata § Toxicidad",
        "source_url": "https://es.wikipedia.org/wiki/Chromolaena_odorata#Toxicidad",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 175313092,
        "heading": "Toxicidad",
        "text": "Chromolaena odorata contiene alcaloides pirrolizidínicos como 7- y 9-angeloilretronecina, intermedina, rinderina y 3′-acetilrinderina, y otros compuestos carcinógenos.​",
        "truncated": false
      },
      "pt": {
        "source": "Wikipedia (pt): Chromolaena odorata § Toxicidade",
        "source_url": "https://pt.wikipedia.org/wiki/Chromolaena_odorata#Toxicidade",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 65684176,
        "heading": "Toxicidade",
        "text": "A Chromolaena odorata contém alcaloides pirrolizidínicos cancerígenos. É tóxica para o gado. Também pode causar reações alérgicas. Pesquisas recentes mostraram que a planta é larvicida contra todos os principais mosquitos vetores.",
        "truncated": false
      }
    },
    "cultivation": {
      "fr": {
        "source": "Wikipedia (fr): Chromolaena odorata § Horticulture",
        "source_url": "https://fr.wikipedia.org/wiki/Chromolaena_odorata#Horticulture",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 236223457,
        "heading": "Horticulture",
        "text": "Au Ghana, le produit d'extraction des feuilles de cette espèce est ou a été utilisé en horticulture traditionnelle pour protéger les sections des boutures d'arbres.",
        "truncated": false
      }
    }
  },
