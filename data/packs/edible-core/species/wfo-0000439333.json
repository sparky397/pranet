  "description": {
    "en": {
      "source": "Wikipedia 英語版「Sambucus racemosa」",
      "source_url": "https://en.wikipedia.org/wiki/Sambucus_racemosa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1369596979,
      "text": "Sambucus racemosa is a species of elder known by the common names red-berried elder and red elderberry. It produces a red drupe."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Sambucus racemosa」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Sambucus_racemosa#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1369596979,
        "heading": "Cultivation",
        "text": "Sambucus racemosa is cultivated as an ornamental plant, for use as a shrub or small tree in traditional and wildlife gardens, and natural landscape design projects. The yellow-foliaged cultivars 'Plumosa Aurea' and 'Sutherland Gold' are widely grown in Britain.\n\n■ Cultivars\nCultivars in the nursery trade include:\n\nSambucus racemosa 'SMNSRD4' Lemony Lace®  — golden green foliage, with red new growth\nSambucus racemosa 'Sutherland Gold' — green foliage, with bronze new growth: it has received the Royal Horticultural Society's Award of Garden Merit.",
        "truncated": false
      }
    },
    "toxicity": {
      "en": {
        "source": "Wikipedia 英語版「Sambucus racemosa」の節「Toxicity」",
        "source_url": "https://en.wikipedia.org/wiki/Sambucus_racemosa#Toxicity",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1369596979,
        "heading": "Toxicity",
        "text": "The stems, roots and foliage are poisonous, and the fruit can be toxic or cause nausea if eaten raw.",
        "truncated": false
      }
    }
  },
