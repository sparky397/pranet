  "description": {
    "ja": {
      "source": "Wikipedia (ja): ミチヤナギ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%9F%E3%83%81%E3%83%A4%E3%83%8A%E3%82%AE",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 106385291,
      "text": "ミチヤナギ は、タデ科の一年草。別名ニワヤナギ（庭柳）。北半球の温帯から亜熱帯に広く分布する。"
    },
    "en": {
      "source": "Wikipedia (en): Polygonum aviculare",
      "source_url": "https://en.wikipedia.org/wiki/Polygonum_aviculare",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1370476327,
      "text": "Polygonum aviculare or common knotgrass is a plant related to buckwheat and dock. It is also called prostrate knotweed, birdweed, pigweed and lowgrass. It is an annual found in fields and wasteland, with white flowers from June to October. It is widespread across many countries in temperate regions, apparently native to Eurasia, naturalized in temperate parts of the Southern Hemisphere."
    },
    "es": {
      "source": "Wikipedia (es): Polygonum aviculare",
      "source_url": "https://es.wikipedia.org/wiki/Polygonum_aviculare",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 171581239,
      "text": "La centinodia, Polygonum aviculare, es una especie de planta fanerógama de la familia de las poligonáceas. Es una planta anual que crece en todo tipo de suelos, aunque prefiere húmedos, que germina hacia finales de invierno o principios de primavera."
    },
    "fr": {
      "source": "Wikipedia (fr): Renouée des oiseaux",
      "source_url": "https://fr.wikipedia.org/wiki/Renou%C3%A9e_des_oiseaux",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 233228919,
      "text": "La Renouée des oiseaux est une espèce de plantes à fleurs herbacées annuelles de la famille des Polygonaceae. Elle développe de nombreuses tiges qui très souvent forment un tapis sur le sol. Son aire d’origine couvre l’hémisphère Nord tempéré."
    },
    "pt": {
      "source": "Wikipedia (pt): Polygonum aviculare",
      "source_url": "https://pt.wikipedia.org/wiki/Polygonum_aviculare",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 69145768,
      "text": "Polygonum aviculare é uma espécie de planta com flor pertencente à família Polygonaceae."
    }
  },
  "sections": {
    "uses": {
      "ja": {
        "source": "Wikipedia (ja): ミチヤナギ § 利用",
        "source_url": "https://ja.wikipedia.org/wiki/%E3%83%9F%E3%83%81%E3%83%A4%E3%83%8A%E3%82%AE#%E5%88%A9%E7%94%A8",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 106385291,
        "heading": "利用",
        "text": "生薬名はヘンチク（扁蓄）。漢方では利尿などの効能があるとして用いられる。また西洋などでも収斂効果を利用した民間薬として使われる。\nベトナムでは野菜として食用にされる。",
        "truncated": false
      },
      "es": {
        "source": "Wikipedia (es): Polygonum aviculare § Usos",
        "source_url": "https://es.wikipedia.org/wiki/Polygonum_aviculare#Usos",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 171581239,
        "heading": "Usos",
        "text": "Es una planta melífera y medicinal: se utiliza contra la diarrea, las hemorroides, el reumatismo, trastornos inmunitarios, problemas cardiovasculares, gingivitis e infecciones; es astringente, calmante de la piel, vermífugo y diurético. Es apetecible para el ganado vacuno y los equinos.​​\n\nAun con sus muchos beneficios, el constante roce de la planta con la piel puede causar dermatitis.​",
        "truncated": false
      },
      "fr": {
        "source": "Wikipedia (fr): Renouée des oiseaux § Utilisations",
        "source_url": "https://fr.wikipedia.org/wiki/Renou%C3%A9e_des_oiseaux#Utilisations",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 233228919,
        "heading": "Utilisations",
        "text": "C'est une plante mellifère et médicinale : utilisée contre diarrhée, goutte, hémorroïdes et rhumatismes, elle est astringente, apaisant cutané, vermifuge et diurétique[source insuffisante].\nElle est appétente pour les bovins et les équidés.",
        "truncated": false
      },
      "pt": {
        "source": "Wikipedia (pt): Polygonum aviculare § Usos medicinais",
        "source_url": "https://pt.wikipedia.org/wiki/Polygonum_aviculare#Usos_medicinais",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 69145768,
        "heading": "Usos medicinais",
        "text": "Esta planta é recomendada para curar a injeção de sangue. Hoje em dia é utilizada pelos diabéticos para tratar disenteria, fluxo menstrual excessivos, distúrbios pulmonares, bronquite e icterícia, e problemas de vesícula, ou pedras nos rins. Nem todas estas utilizações são apoiadas por provas científicas. É também um coagulante, diurético e expectorante.",
        "truncated": false
      }
    }
  },
