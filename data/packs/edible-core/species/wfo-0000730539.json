  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ニューギニアインパチェンス」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%8B%E3%83%A5%E3%83%BC%E3%82%AE%E3%83%8B%E3%82%A2%E3%82%A4%E3%83%B3%E3%83%91%E3%83%81%E3%82%A7%E3%83%B3%E3%82%B9",
