  "description": {
    "en": {
      "source": "Wikipedia (en): Combretum apiculatum",
      "source_url": "https://en.wikipedia.org/wiki/Combretum_apiculatum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1316993528,
      "text": "Combretum apiculatum is a species of tree in the family Combretaceae known by the common name red bushwillow. It is native to the mesic to semi-arid savanna regions of Africa, southwards of the equator."
    },
    "fr": {
      "source": "Wikipedia (fr): Combretum apiculatum",
      "source_url": "https://fr.wikipedia.org/wiki/Combretum_apiculatum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 217251676,
      "text": "Combretum apiculatum est une espèce de plantes à fleurs de la famille des Combretaceae. C'est un arbre des régions semi arides au sud de l'Équateur en Afrique."
    },
    "id": {
      "source": "Wikipedia (id): Combretum apiculatum",
      "source_url": "https://id.wikipedia.org/wiki/Combretum_apiculatum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29984833,
      "text": "Combretum apiculatum adalah spesies pohon dalam keluarga Combretaceae yang dikenal dengan nama umum widani merah. Tanaman ini berasal dari wilayah sabana mesik hingga semi-kering di Afrika bagian selatan khatulistiwa. Spesies ini memiliki dua subspesies, yaitu ssp. apiculatum yang terdapat di bagian selatan, dan ssp. leutweinii yang menyebar dari Namibia hingga Malawi ke arah utara, dengan perbedaan utama pada daun yang lebih berbulu."
    }
