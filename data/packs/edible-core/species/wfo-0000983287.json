  "description": {
    "ja": {
      "source": "Wikipedia (ja): ワレモコウ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%AF%E3%83%AC%E3%83%A2%E3%82%B3%E3%82%A6",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 111226993,
      "text": "ワレモコウ（吾亦紅、吾木香、我毛香）は、バラ科・ワレモコウ属の多年草。日当たりのよい草原などに生える高さ1メートルほどの草で、秋に枝分かれした先に穂をつけたような赤褐色や暗紅紫色の花をつける。若葉は食用に、根は生薬になる。"
    },
    "en": {
      "source": "Wikipedia (en): Sanguisorba officinalis",
      "source_url": "https://en.wikipedia.org/wiki/Sanguisorba_officinalis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1370281927,
      "text": "Sanguisorba officinalis, commonly known as great burnet, is a plant in the family Rosaceae, subfamily Rosoideae. It is native throughout the cooler regions of the Northern Hemisphere in Europe, northern Asia, and northern North America."
    },
    "es": {
      "source": "Wikipedia (es): Sanguisorba officinalis",
      "source_url": "https://es.wikipedia.org/wiki/Sanguisorba_officinalis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 175260657,
      "text": "Sanguisorba officinalis es una especie de planta perenne perteneciente a la familia de las rosáceas."
    },
    "fr": {
      "source": "Wikipedia (fr): Sanguisorba officinalis",
      "source_url": "https://fr.wikipedia.org/wiki/Sanguisorba_officinalis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 234266406,
      "text": "Sanguisorba officinalis, la grande pimprenelle ou sanguisorbe officinale, est une espèce de plantes à fleurs de la famille des Rosacées."
    }
  },
