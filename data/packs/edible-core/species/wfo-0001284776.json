  "description": {
    "en": {
      "source": "Wikipedia (en): Vachellia nilotica",
      "source_url": "https://en.wikipedia.org/wiki/Vachellia_nilotica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1378680101,
      "text": "Vachellia nilotica, more commonly known as Acacia nilotica, and by the vernacular names of gum arabic tree, babul, thorn mimosa, Egyptian acacia or thorny acacia, is a flowering tree in the family Fabaceae. It is native to Africa, the Middle East and the Indian subcontinent."
    },
    "es": {
      "source": "Wikipedia (es): Acacia nilotica",
      "source_url": "https://es.wikipedia.org/wiki/Acacia_nilotica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171582818,
      "text": "La goma arábiga es una especie de Acacia nativa de África y del subcontinente indio. Actualmente también se ha convertido en una especie invasora que causa problemas en Australia."
    },
    "fr": {
      "source": "Wikipedia (fr): Vachellia nilotica",
      "source_url": "https://fr.wikipedia.org/wiki/Vachellia_nilotica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 223031085,
      "text": "Vachellia nilotica, le gommier rouge, est une espèce de plantes dicotylédones de la famille des Fabaceae, sous-famille des Mimosoideae, originaire d'Afrique de l'Est et d'Asie de l'Ouest.\nCe sont des arbustes ou petits arbres, qui croissent préférentiellement dans les zones désertiques, dans des terrains sableux et secs, sous un climat aride."
    },
    "pt": {
      "source": "Wikipedia (pt): Vachellia nilotica",
      "source_url": "https://pt.wikipedia.org/wiki/Vachellia_nilotica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 71548007,
      "text": "Vachellia nilotica é uma espécie de leguminosa do gênero Vachellia, pertencente à família Fabaceae."
    },
    "id": {
      "source": "Wikipedia (id): Vachellia nilotica",
      "source_url": "https://id.wikipedia.org/wiki/Vachellia_nilotica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 28666337,
      "text": "Vachellia nilotica atau yang lebih dikenal sebagai Acacia nilotica dan juga disebut pohon gom arab atau akasia berduri, adalah pohon berbunga yang termasuk dalam famili Fabaceae. Spesies ini berasal dari wilayah Afrika, Timur Tengah, serta anak benua India."
    }
  },
  "sections": {
    "toxicity": {
      "es": {
        "source": "Wikipedia (es): Acacia nilotica § Toxicidad",
        "source_url": "https://es.wikipedia.org/wiki/Acacia_nilotica#Toxicidad",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 171582818,
        "heading": "Toxicidad",
        "text": "Las especies del género Acacia pueden contener derivados de la dimetiltriptamina y glucósidos cianogénicos en las hojas, las semillas y la corteza, cuya ingestión puede suponer un riesgo para la salud.​",
        "truncated": false
      }
    },
    "cultivation": {
      "fr": {
        "source": "Wikipedia (fr): Vachellia nilotica § Culture",
        "source_url": "https://fr.wikipedia.org/wiki/Vachellia_nilotica#Culture",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 223031085,
        "heading": "Culture",
        "text": "Le gommier rouge est un arbre de croissance lente supportant tous les types de sols (acide ou calcaire, sols lourds ou légers). Ses profondes racines lui confèrent une grande résistance à la sécheresse.\nIl a besoin du plein soleil et ne peut pousser qu'en Zone USDA 10[réf. nécessaire].",
        "truncated": false
      }
    }
  },
