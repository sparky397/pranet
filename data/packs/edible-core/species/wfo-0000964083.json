      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 158172574,
      "text": "Euphorbia poissonii es una especie fanerógama perteneciente a la familia de las euforbiáceas. Es endémica de Nigeria."
    }
