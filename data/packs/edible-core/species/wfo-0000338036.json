  "description": {
    "en": {
      "source": "Wikipedia (en): Aframomum alboviolaceum",
      "source_url": "https://en.wikipedia.org/wiki/Aframomum_alboviolaceum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1313041540,
      "text": "Aframomum alboviolaceum is a monocotyledonous plant species that was first described by Henry Nicholas Ridley, and got its current name from Karl Moritz Schumann. Aframomum alboviolaceum is part of the genus Aframomum and the family Zingiberaceae. No subspecies are listed in the Catalog of Life."
    },
    "fr": {
      "source": "Wikipedia (fr): Aframomum alboviolaceum",
      "source_url": "https://fr.wikipedia.org/wiki/Aframomum_alboviolaceum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 217912162,
      "text": "Aframomum alboviolaceum, connue en anglais sous le nom de large amomum, Aframomum africanum fruit ou encore grape-seeded amomum, ou encore Masusu, \nTondolo en République Démocratique du Congo et en République du Congo est une espèce de plantes dicotylédones de la famille des Zingiberaceae, originaire d'Afrique tropicale."
    },
    "pt": {
      "source": "Wikipedia (pt): Aframomum alboviolaceum",
      "source_url": "https://pt.wikipedia.org/wiki/Aframomum_alboviolaceum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 68167635,
      "text": "Aframomum alboviolaceum, conhecida como Ginguenga, jinguenga, tondolo ou feijão do paraíso, é uma espécie de monocotiledônea originalmente descrita por Henry Nicholas Ridley e que obteve seu nome atual de Karl Moritz Schumann. É parte do gênero Aframomum, da família Zingiberaceae."
    },
    "id": {
      "source": "Wikipedia (id): Aframomum alboviolaceum",
      "source_url": "https://id.wikipedia.org/wiki/Aframomum_alboviolaceum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 30046238,
      "text": "Aframomum alboviolaceum adalah spesies tumbuhan monokotil yang pertama kali dideskripsikan oleh Henry Nicholas Ridley, dan mendapatkan nama saat ini dari Karl Moritz Schumann. Aframomum alboviolaceum termasuk dalam genus Aframomum dan famili Zingiberaceae. Tidak ada subspesies yang terdaftar dalam Catalog of Life."
    }
