  "description": {
    "ja": {
      "source": "Wikipedia (ja): イノコヅチ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%A4%E3%83%8E%E3%82%B3%E3%83%85%E3%83%81",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 108106109,
      "text": "イノコヅチ は、ヒユ科イノコヅチ属の多年草。日のあまり当たらない場所に生える雑草。ヒナタイノコヅチに対してヒカゲイノコヅチ（日陰猪子槌）ともいう。"
    },
    "en": {
      "source": "Wikipedia (en): Achyranthes bidentata",
      "source_url": "https://en.wikipedia.org/wiki/Achyranthes_bidentata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1364692682,
      "text": "Achyranthes bidentata Blume is a species of flowering plant in the amaranth family, Amaranthaceae. It occurs in India, Nepal, Korea, China, and Japan. It is the source of the Chinese herbal medicine Huai'niuxi. In Nepal its root juice is used for toothache. Its seeds have been used as a substitute for cereal grains in famine years. The plant is used externally in the treatment of leech bites in Mizoram, India and a decoction as a diuretic."
    },
    "es": {
      "source": "Wikipedia (es): Achyranthes bidentata",
      "source_url": "https://es.wikipedia.org/wiki/Achyranthes_bidentata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 175439589,
      "text": "Achyranthes bidentata es una especie de planta herbácea perteneciente a la familia Achyranthes. Se distribuye por Asia, en India, Nepal, China y Japón."
    },
    "fr": {
      "source": "Wikipedia (fr): Achyranthes bidentata",
      "source_url": "https://fr.wikipedia.org/wiki/Achyranthes_bidentata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 230938228,
      "text": "Achyranthes bidentata est une espèce de plante à fleur de la famille des Amaranthaceae, originaire d'une large partie de l'Asie."
    },
    "id": {
      "source": "Wikipedia (id): Achyranthes bidentata",
      "source_url": "https://id.wikipedia.org/wiki/Achyranthes_bidentata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 29276577,
      "text": "Achyranthes bidentata Blume adalah spesies tumbuhan berbunga dalam keluarga bayam-bayaman, Amaranthaceae. Tumbuhan ini ditemukan di India, Nepal, Korea, Tiongkok, dan Jepang. Tumbuhan ini merupakan sumber dari obat tradisional Tionghoa Huai'niuxi. Di Nepal, sari akarnya digunakan untuk mengobati sakit gigi. Bijinya telah digunakan sebagai pengganti biji-bijian sereal pada masa kelaparan. Tanaman ini digunakan secara eksternal dalam pengobatan gigitan lintah di Mizoram, India, dan rebusannya digunakan sebagai diuretik."
    }
  },
  "sections": {
    "uses": {
      "ja": {
        "source": "Wikipedia (ja): イノコヅチ § 薬用",
        "source_url": "https://ja.wikipedia.org/wiki/%E3%82%A4%E3%83%8E%E3%82%B3%E3%83%85%E3%83%81#%E8%96%AC%E7%94%A8",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 108106109,
        "heading": "薬用",
        "text": "イノコヅチの根を乾燥させて作った漢方薬（生薬）を牛膝（ごしつ）といい、利尿、強精、通精、通経薬とする。また俗間では堕胎薬としても使われたこともあったと見られているが、これら有効成分はよくわかっていない。牛膝は、秋に根を掘り採って天日乾燥して調製される。民間療法では、生理痛や関節痛に、牛膝1日量5グラムを400 ccの水で煎じて3回に分けて服用する用法が知られている。ただし、妊婦への服用は禁忌とされている。",
        "truncated": false
      }
    }
  },
