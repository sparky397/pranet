  "description": {
    "en": {
      "source": "Wikipedia (en): Peucedanum ostruthium",
      "source_url": "https://en.wikipedia.org/wiki/Peucedanum_ostruthium",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1368840188,
      "text": "Peucedanum ostruthium or Imperatoria ostruthium, masterwort, is a species of flowering plant in the family Apiaceae. It is native to the mountains of Central and Southern Europe, but has been widely introduced outside its native range."
    },
    "es": {
      "source": "Wikipedia (es): Peucedanum ostruthium",
      "source_url": "https://es.wikipedia.org/wiki/Peucedanum_ostruthium",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 135212259,
      "text": "Peucedanum ostruthium o Imperatoria ostruthium W.D.J.Koch es una especie fanerógama perteneciente a la familia Apiaceae. Es nativa de Europa central donde crece en prados húmedos de montaña."
    },
    "fr": {
      "source": "Wikipedia (fr): Impératoire",
      "source_url": "https://fr.wikipedia.org/wiki/Imp%C3%A9ratoire",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 226016644,
      "text": "L’Impératoire ou le Benjoin est une espèce de plantes à fleurs de la famille des Apiaceae (Ombellifères)."
    }
  },
  "sections": {
    "uses": {
      "en": {
        "source": "Wikipedia (en): Peucedanum ostruthium § Use",
        "source_url": "https://en.wikipedia.org/wiki/Peucedanum_ostruthium#Use",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1368840188,
        "heading": "Use",
        "text": "Masterwort is used as a flavouring for various liqueurs and bitters. Its roots and leaves have been used in traditional Austrian medicine internally (as tea, liqueurs and wine) and externally (as fumigation, tincture or incense) for treatment of disorders of the gastrointestinal tract, skin, respiratory tract, cardiovascular system, infections, fever, flu and colds.",
        "truncated": false
      },
      "fr": {
        "source": "Wikipedia (fr): Impératoire § Utilisations",
        "source_url": "https://fr.wikipedia.org/wiki/Imp%C3%A9ratoire#Utilisations",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 226016644,
        "heading": "Utilisations",
        "text": "L'impératoire possède diverses propriétés : homéopathiques, vétérinaires (on en faisait autrefois des tisanes destinées à mettre les vaches en chaleur), gynécologiques (décontracturantes).\nAu XVIIe siècle, l'impératoire, alors au sommet de sa réputation, entrait dans la composition d'une des drogues les plus en vogue en Europe, l'orviétan.\nL'impératoire a aussi un usage aromatique pour les boissons et les fromages, alimentaire (racine, feuilles), condimentaire dans les salades ou les soupes.\nOn extrait de la plante une huile essentielle nommée « huile de benjoin français ».\nL'infusion d'impératoire est apéritive.\nDans plusieurs régions des Alpes, sa racine est distillée pour en tirer une eau-de-vie",
        "truncated": false
      }
    }
  },
