  "description": {
    "ja": {
      "source": "Wikipedia (ja): モクセイ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%A2%E3%82%AF%E3%82%BB%E3%82%A4",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 108309744,
      "text": "モクセイ は、モクセイ科モクセイ属の常緑小高木。中国名は桂花（けいか）。"
    },
    "en": {
      "source": "Wikipedia (en): Osmanthus fragrans",
      "source_url": "https://en.wikipedia.org/wiki/Osmanthus_fragrans",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1349795160,
      "text": "Osmanthus fragrans is a species of flowering plant in the family Oleaceae. In English, it is sometimes referred to by the common names sweet osmanthus, sweet olive, tea olive, and fragrant olive. It is native to Assam, Cambodia, China, the Himalayas, Hainan, Japan, Myanmar, Taiwan, Nepal, Thailand, and Vietnam. In China it grows in the provinces of Guizhou, Sichuan, Hainan, and Yunnan."
    },
    "es": {
      "source": "Wikipedia (es): Osmanthus fragrans",
      "source_url": "https://es.wikipedia.org/wiki/Osmanthus_fragrans",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 173997171,
      "text": "El olivo fragante, olivo dulce u osmanto oloroso es una especie de arbusto de la familia Oleaceae nativo de Asia, que se encuentra desde el Himalaya hasta China, Taiwán y el sur del Japón."
    },
    "fr": {
      "source": "Wikipedia (fr): Olivier odorant",
      "source_url": "https://fr.wikipedia.org/wiki/Olivier_odorant",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 234012912,
      "text": "L'olivier odorant ou osmanthe parfumé, encore appelé olivier de Chine ou olivier à thé, est une espèce de plantes à fleurs de la famille des Oleaceae. C'est un arbuste à feuillage persistant de 3 à 10 m de haut, aux fleurs très parfumées, originaire d’Asie orientale."
    },
    "id": {
      "source": "Wikipedia (id): Osmanthus fragrans",
      "source_url": "https://id.wikipedia.org/wiki/Osmanthus_fragrans",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29690788,
      "text": "Osmanthus fragrans, sering juga disebut dengan nama yang bervariasi seperti osmanthus manis, zaitun manis, zaitun teh, dan zaitun harum, adalah spesies asli Asia dari Himalaya melalui Tiongkok Selatan menyebar hingga ke Taiwan, selatan Jepang dan Asia Tenggara."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia (en): Osmanthus fragrans § Cultivation",
        "source_url": "https://en.wikipedia.org/wiki/Osmanthus_fragrans#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 1349795160,
        "heading": "Cultivation",
        "text": "It is cultivated as an ornamental plant in East Asian gardens, and gardens in Europe, North America, Australia and elsewhere in the world for its deliciously fragrant flowers which carry the scent of ripe peaches or apricots. A number of cultivars have been selected for garden use, with varying flower colors, such as Osmanthus fragrans 'Yanhua' with its variegated foliage and orange blooms. Within Japan, the white- and orange-blossoming subspecies are distinguished as ginmokusei (lit. \"silver osmanthus\") and kinmokusei (lit. \"gold osmanthus\"), respectively.",
        "truncated": false
      }
    }
  },
