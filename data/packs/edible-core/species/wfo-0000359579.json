  "description": {
    "ja": {
      "source": "Wikipedia (ja): スイカズラ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%B9%E3%82%A4%E3%82%AB%E3%82%BA%E3%83%A9",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 110947089,
      "text": "スイカズラ はスイカズラ科スイカズラ属の常緑つる性木本。別名、ニンドウ（忍冬）やキンギンカ（金銀花）。"
    },
    "en": {
      "source": "Wikipedia (en): Lonicera japonica",
      "source_url": "https://en.wikipedia.org/wiki/Lonicera_japonica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1370006502,
      "text": "Lonicera japonica, known as Japanese honeysuckle and golden-and-silver honeysuckle, is a species of honeysuckle native to East Asia, including many parts of China. It is often grown as an ornamental plant, but has become an invasive species in a number of countries. It is used in traditional Chinese medicine."
    },
    "es": {
      "source": "Wikipedia (es): Lonicera japonica",
      "source_url": "https://es.wikipedia.org/wiki/Lonicera_japonica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 173613078,
      "text": "La madreselva japonesa o Suikazura  en japonés es una especie botánica perteneciente a la familia de las Caprifoliáceas."
    },
    "fr": {
      "source": "Wikipedia (fr): Chèvrefeuille du Japon",
      "source_url": "https://fr.wikipedia.org/wiki/Ch%C3%A8vrefeuille_du_Japon",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 227887339,
      "text": "Le chèvrefeuille du Japon est une espèce de plantes à fleurs de la famille des Caprifoliacées. C'est une liane arbustive originaire de Chine, de Corée et du Japon. La variété 'Chinensis' dont les boutons floraux et le revers de la corolle sont pourpres, est vendue en jardinerie sous le nom de chèvrefeuille de Chine."
    },
    "pt": {
      "source": "Wikipedia (pt): Lonicera japonica",
      "source_url": "https://pt.wikipedia.org/wiki/Lonicera_japonica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 62049736,
      "text": "Lonicera japonica é uma espécie do gênero botânico Lonicera, da família das Caprifoliaceae."
    },
    "id": {
      "source": "Wikipedia (id): Ranggis",
      "source_url": "https://id.wikipedia.org/wiki/Ranggis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 30061266,
      "text": "Ranggis, atau dikenal dengan nama Melati putri, atau Kamperfuli Jepang adalah spesies tumbuhan yang termasuk genus Lonicera. Tumbuhan ini asli Asia Timur. Tumbuhan ini sering ditanam sebagai tanaman hias, juga karena bunganya yang sangat harum mirip Melati. Kamperfuli Jepang juga dipakai dipengobatan tradisional Tiongkok."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia (en): Lonicera japonica § Cultivation",
        "source_url": "https://en.wikipedia.org/wiki/Lonicera_japonica#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 1370006502,
        "heading": "Cultivation",
        "text": "Even though it is a highly invasive and destructive plant, this species is often sold by American nurseries as the cultivar 'Hall's Prolific' (Lonicera japonica var. halliana), and in the UK as the cultivar 'Halliana'. The cultivar is also known as Hall's Japanese honeysuckle. It is an effective groundcover and has strong-smelling flowers. It can be cultivated by seed, cuttings, or layering. In addition, it will spread itself via shoots if given enough space to grow. The variety L. japonica var. repens has gained the Royal Horticultural Society's Award of Garden Merit.",
        "truncated": false
      }
    },
    "toxicity": {
      "en": {
        "source": "Wikipedia (en): Lonicera japonica § Toxicity",
        "source_url": "https://en.wikipedia.org/wiki/Lonicera_japonica#Toxicity",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 1370006502,
        "heading": "Toxicity",
        "text": "All parts of the plant other than the flower nectar have the potential to be toxic if consumed in a very large quantity for its saponin.",
        "truncated": false
      }
    }
  },
