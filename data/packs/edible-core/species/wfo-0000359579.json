  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「スイカズラ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%B9%E3%82%A4%E3%82%AB%E3%82%BA%E3%83%A9",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 110947089,
      "text": "スイカズラ はスイカズラ科スイカズラ属の常緑つる性木本。別名、ニンドウ（忍冬）やキンギンカ（金銀花）。"
    },
    "en": {
      "source": "Wikipedia 英語版「Lonicera japonica」",
      "source_url": "https://en.wikipedia.org/wiki/Lonicera_japonica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1370006502,
      "text": "Lonicera japonica, known as Japanese honeysuckle and golden-and-silver honeysuckle, is a species of honeysuckle native to East Asia, including many parts of China. It is often grown as an ornamental plant, but has become an invasive species in a number of countries. It is used in traditional Chinese medicine."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Lonicera japonica」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Lonicera_japonica#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1370006502,
        "heading": "Cultivation",
        "text": "Even though it is a highly invasive and destructive plant, this species is often sold by American nurseries as the cultivar 'Hall's Prolific' (Lonicera japonica var. halliana), and in the UK as the cultivar 'Halliana'. The cultivar is also known as Hall's Japanese honeysuckle. It is an effective groundcover and has strong-smelling flowers. It can be cultivated by seed, cuttings, or layering. In addition, it will spread itself via shoots if given enough space to grow. The variety L. japonica var. repens has gained the Royal Horticultural Society's Award of Garden Merit.",
        "truncated": false
      }
    },
    "toxicity": {
      "en": {
        "source": "Wikipedia 英語版「Lonicera japonica」の節「Toxicity」",
        "source_url": "https://en.wikipedia.org/wiki/Lonicera_japonica#Toxicity",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1370006502,
        "heading": "Toxicity",
        "text": "All parts of the plant other than the flower nectar have the potential to be toxic if consumed in a very large quantity for its saponin.",
        "truncated": false
      }
    }
  },
