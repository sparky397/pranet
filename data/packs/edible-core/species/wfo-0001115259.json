    "ja": {
      "source": "Wikipedia 日本語版「ヤブレガサウラボシ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%A4%E3%83%96%E3%83%AC%E3%82%AC%E3%82%B5%E3%82%A6%E3%83%A9%E3%83%9C%E3%82%B7",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 106387176,
      "text": "ヤブレガサウラボシは、熱帯系の特異な形のシダ植物の一つ。左右対称に広がる葉の形は独特である。"
    },
    "en": {
      "source": "Wikipedia 英語版「Dipteris conjugata」",
      "source_url": "https://en.wikipedia.org/wiki/Dipteris_conjugata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1367125687,
      "text": "Dipteris conjugata is a species of fern in the family Dipteridaceae. It has a rhizome, and 2-3 tall stems with mid green or dark green fronds, which have several divisions to toothed lobes. It is grows in clearings, mountain ridges and in forest margins, from tropical and temperate Asia, northern Queensland in Australia and some islands in the Pacific Ocean. It has limited native medicinal uses."
    }
  },
  "sections": {
