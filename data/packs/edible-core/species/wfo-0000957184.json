  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia (en): Eugenia dysenterica § Cultivation",
        "source_url": "https://en.wikipedia.org/wiki/Eugenia_dysenterica#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 1354743696,
        "heading": "Cultivation",
        "text": "The plant can be easily reproduced from seeds (which contain about 50% water and cannot withstand drying). Planted 2 cm (0.79 in) deep, they germinate in 40 to 60 days. It can also be reproduced in vitro from gems. The plant is adapted to the poor soils of the Cerrado but benefits from fertilizers containing calcium and phosphorus as well as organic fertilizers. Agricultural pests include the brown spot disease, caused by a fungus (Phleosporella sp.), leaf-cutting ants, and fruit flies such as Anastrepha obliqua.",
        "truncated": false
      }
