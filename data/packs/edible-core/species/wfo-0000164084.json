  "description": {
    "ja": {
      "source": "Wikipedia (ja): ギンネム",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AE%E3%83%B3%E3%83%8D%E3%83%A0",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 109787715,
      "text": "ギンネムまたはギンゴウカン はオジギソウ連の落葉低木。和名はネムノキに似て、白い花を咲かす様子を雅語的に表現したところから。"
    },
    "en": {
      "source": "Wikipedia (en): Leucaena leucocephala",
      "source_url": "https://en.wikipedia.org/wiki/Leucaena_leucocephala",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1359728201,
      "text": "Leucaena leucocephala is a small fast-growing mimosoid tree native to southern Mexico and northern Central America. It is now naturalized throughout the tropics including parts of Asia."
    },
    "es": {
      "source": "Wikipedia (es): Leucaena leucocephala",
      "source_url": "https://es.wikipedia.org/wiki/Leucaena_leucocephala",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 175370871,
      "text": "Leucaena leucocephala es una especie arbórea del género Leucaena de la familia de las leguminosas o fabáceas. El topónimo “Oaxaca” proviene del náhuatl Huāxyacac, que puede traducirse como “en la punta/nariz del huaje”, en alusión a la presencia de estos árboles en la zona donde se asentó la ciudad."
    },
    "fr": {
      "source": "Wikipedia (fr): Leucaena leucocephala",
      "source_url": "https://fr.wikipedia.org/wiki/Leucaena_leucocephala",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 238209334,
      "text": "Leucaena leucocephala est une espèce de plantes à fleurs dicotylédones de la famille des Fabaceae, sous-famille des Mimosoideae. C'est un arbre originaire du Mexique et d'Amérique centrale."
    },
    "pt": {
      "source": "Wikipedia (pt): Leucena",
      "source_url": "https://pt.wikipedia.org/wiki/Leucena",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 72119926,
      "text": "Leucena, é uma planta nativa da America Central. É uma leguminosa perene, palatável com grande utilidade na alimentação de suínos, bovinos e caprinos, e sua resitência à seca foi de grande importância para sua utilização nos sistemas de alimentação de animais no Brasil Central em décadas."
    },
    "id": {
      "source": "Wikipedia (id): Lamtoro",
      "source_url": "https://id.wikipedia.org/wiki/Lamtoro",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29932294,
      "text": "Lamtoro, kemlandingan, petai selong atau petai cina adalah sejenis perdu dari famili Fabaceae, yang kerap digunakan dalam penghijauan lahan atau pencegahan erosi. Berasal dari Amerika tropis, tumbuhan ini sudah ratusan tahun diperkenalkan ke Jawa untuk kepentingan pertanian dan kehutanan, dan kemudian menyebar pula ke pulau-pulau yang lain di Indonesia. Tanaman ini di Malaysia dinamai petai belalang."
    }
  },
  "sections": {
    "toxicity": {
      "en": {
        "source": "Wikipedia (en): Leucaena leucocephala § Toxicity",
        "source_url": "https://en.wikipedia.org/wiki/Leucaena_leucocephala#Toxicity",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 1359728201,
        "heading": "Toxicity",
        "text": "The seeds of Leucaena leucocephala contain mimosine, an amino acid known to be toxic to nonruminant vertebrates.",
        "truncated": false
      }
    },
    "cultivation": {
      "fr": {
        "source": "Wikipedia (fr): Leucaena leucocephala § Culture",
        "source_url": "https://fr.wikipedia.org/wiki/Leucaena_leucocephala#Culture",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 238209334,
        "heading": "Culture",
        "text": "Cette espèce supporte tout type de sol, apprécie le soleil et est parfaitement adapté à la sécheresse.\nLeucaena leucocephala est une plante tropicale et subtropicale. Elle peut tolérer des températures assez basses, mais ne supporte pas le gel prolongé[source insuffisante].\nEn général, la température minimale supportée par Leucaena leucocephala est d'environ 0°C. Des températures en dessous de ce seuil peuvent endommager les feuilles et les parties aériennes de la plante, mais elle peut parfois repousser à partir de ses racines si les dégâts ne sont pas trop sévères[source insuffisante].",
        "truncated": false
      }
    }
  },
