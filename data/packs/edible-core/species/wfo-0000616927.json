  "description": {
    "en": {
      "source": "Wikipedia (en): Combretum zeyheri",
      "source_url": "https://en.wikipedia.org/wiki/Combretum_zeyheri",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1331631573,
      "text": "Combretum zeyheri, the large-fruited bushwillow or Zeyher's bushwillow, is a species of flowering plant in the family Combretaceae, usually found growing on acidic or sandy soils in tropical African savannas. A small to medium-sized tree, its roots are used as a source of material for making baskets and as a traditional medicine for haemorrhoids."
    },
    "fr": {
      "source": "Wikipedia (fr): Combretum zeyheri",
      "source_url": "https://fr.wikipedia.org/wiki/Combretum_zeyheri",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 217279292,
      "text": "Combretum zeyheri, le saule buisson à gros fruits, ou saule buisson de Zeyher, est une espèce de plantes à fleurs de la famille des Combretaceae. C'est un arbre trouvé en Afrique tropicale."
    }
  },
  "sections": {
    "uses": {
