  "description": {
    "en": {
      "source": "Wikipedia (en): Vitis aestivalis",
      "source_url": "https://en.wikipedia.org/wiki/Vitis_aestivalis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1378339083,
      "text": "Vitis aestivalis, the summer grape, or pigeon grape is a species of grape native to eastern North America from southern Ontario east to Maine, west to Oklahoma, and south to Florida and Texas. It is a vigorous vine, growing to 10 m (33 ft) or more high on trees. The leaves are 7–20 cm (2.8–7.9 in) long, suborbicular, and usually a little broader than long; they are variable in shape, from unlobed to deeply three- or five-lobed, green above, and densely hairy below. The flowers are produced at every third node in a dense panicle 5–15 cm long. The fruit is a small grape 5–14 mm (0.20–0.55 in) diameter, dark purple or black in colour. It is the official state grape of Missouri. Summer grape prefers a drier upland habitat."
    },
    "es": {
      "source": "Wikipedia (es): Vitis aestivalis",
      "source_url": "https://es.wikipedia.org/wiki/Vitis_aestivalis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 159882628,
      "text": "Vitis aestivalis es una especie de vid autóctona del este de América del Norte en la zona comprendida desde el sur de Ontario al este de Vermont, al oeste de Oklahoma, y el sur de Florida y Texas."
    },
    "fr": {
      "source": "Wikipedia (fr): Vitis aestivalis",
      "source_url": "https://fr.wikipedia.org/wiki/Vitis_aestivalis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 150959805,
      "text": "Vitis aestivalis est une espèce d'arbrisseaux sarmenteux de la famille des Vitaceae. Elle est cultivée pour ses fruits en grappes. Ses raisins possèdent un goût foxé. Elle est originaire d'Amérique du Nord."
    },
    "pt": {
      "source": "Wikipedia (pt): Vitis aestivalis",
      "source_url": "https://pt.wikipedia.org/wiki/Vitis_aestivalis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 60751727,
      "text": "A Vitis aestivalis é uma espécie de videira de origem americana, que produz excelentes frutos para consumo in natura e para a produção de sucos. Porém, os seus frutos não são indicados para fazer vinhos de qualidade devido ao aroma desagradável e o baixo teor alcoólico alcançado na sua fermentação."
    }
