  "description": {
    "ja": {
      "source": "Wikipedia (ja): ミヤコジマハナワラビ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%9F%E3%83%A4%E3%82%B3%E3%82%B8%E3%83%9E%E3%83%8F%E3%83%8A%E3%83%AF%E3%83%A9%E3%83%93",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 108284036,
      "text": "ミヤコジマハナワラビ は、ハナヤスリ科に属する真嚢シダ類の一種で、それ一種でミヤコジマハナワラビ属 Helminthostachys を構成する。"
    },
    "en": {
      "source": "Wikipedia (en): Helminthostachys zeylanica",
      "source_url": "https://en.wikipedia.org/wiki/Helminthostachys_zeylanica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1368373284,
      "text": "Helminthostachys zeylanica is a terrestrial, herbaceous fern of southeastern Asia and Australia, commonly known as kamraj and tunjuk-langit. The species is like the other members of its family, it has clusters of sporangia on stems of fertile, spike-like fronds."
    },
    "id": {
      "source": "Wikipedia (id): Jajalakan",
      "source_url": "https://id.wikipedia.org/wiki/Jajalakan",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 25624753,
      "text": "Jajalakan adalah sejenis tumbuhan paku yang merupakan penghuni asli Asia dan Australia tropik dan dipergunakan sebagai tumbuhan obat. Jajalakan punya beberapa nama daerah seperti rawu běkubang, ribu-ribu dan sayor manis (Mal.), pancar bumi, tapak jalak, manon, pakis hurang, pakis kalèr, cèkèr ayam (Sund.), dan buté-buté (Mak)."
    }
  },
  "sections": {
    "uses": {
      "ja": {
        "source": "Wikipedia (ja): ミヤコジマハナワラビ § 利用",
        "source_url": "https://ja.wikipedia.org/wiki/%E3%83%9F%E3%83%A4%E3%82%B3%E3%82%B8%E3%83%9E%E3%83%8F%E3%83%8A%E3%83%AF%E3%83%A9%E3%83%93#%E5%88%A9%E7%94%A8",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 108284036,
        "heading": "利用",
        "text": "中国南部では若葉を食用とするとか、薬用に利用するというが、日本では数そのものが少ないので、全く利用されていない。",
        "truncated": false
      },
      "en": {
        "source": "Wikipedia (en): Helminthostachys zeylanica § Uses",
        "source_url": "https://en.wikipedia.org/wiki/Helminthostachys_zeylanica#Uses",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1368373284,
        "heading": "Uses",
        "text": "The roots of this plant are a popular medicine in China, where they are known as \"Di wu gong\". The roots are harvested during the wet season in July–August. Only wild plants are harvested. In Malaysia, the leaves are dried and smoked to treat bleeding nose. The plant is eaten as a vegetable and used medicinally for impotence in India. It is known in the Philippines as túkod-langit.\nAlthough the basic pharmacology of some of its components suggests it may possess certain antiinflammatory actions, the available scientific literature does not document clinical efficacy.",
        "truncated": false
      }
    }
  },
