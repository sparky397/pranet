  "description": {
    "en": {
      "source": "Wikipedia (en): Prunus mahaleb",
      "source_url": "https://en.wikipedia.org/wiki/Prunus_mahaleb",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1336953762,
      "text": "Prunus mahaleb, the St Lucie cherry or mahaleb cherry, is a species of cherry, native to central and southern Europe, northwest Africa, southwest Asia, and parts of central Asia. The tree is cultivated for a spice obtained from the seeds inside the cherry stones. The seeds have a fragrant scent and have a taste comparable to bitter almonds with cherry notes."
    },
    "es": {
      "source": "Wikipedia (es): Prunus mahaleb",
      "source_url": "https://es.wikipedia.org/wiki/Prunus_mahaleb",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 173249117,
      "text": "El cerezo de Santa Lucía es un arbusto de la familia de las rosáceas."
    },
    "fr": {
      "source": "Wikipedia (fr): Prunus mahaleb",
      "source_url": "https://fr.wikipedia.org/wiki/Prunus_mahaleb",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 238551703,
      "text": "Prunus mahaleb, le Cerisier de Sainte-Lucie, Bois de Sainte-Lucie ou Faux merisier, est une espèce de plantes à fleurs de la famille des Rosaceae et du genre Prunus. C'est un arbuste assez commun dans toute l'Europe occidentale, autour de la Méditerranée, au Maroc, au Moyen-Orient et en Asie centrale. Il pousse dans les fourrés arbustifs, les bois clairs ou les garrigues, de préférence sur les sols calcaires. Parmi ses noms vulgaires, on rencontre également quénot, canot, canonier, boutiga, Moussis, amarel et prunier odorant. Il est appelé negreput en occitan."
    },
    "pt": {
      "source": "Wikipedia (pt): Prunus mahaleb",
      "source_url": "https://pt.wikipedia.org/wiki/Prunus_mahaleb",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 64612213,
      "text": "Prunus mahaleb é uma espécie de planta com flor pertencente à família Rosaceae."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia (en): Prunus mahaleb § Cultivation",
        "source_url": "https://en.wikipedia.org/wiki/Prunus_mahaleb#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 1336953762,
        "heading": "Cultivation",
        "text": "Away from its native range, the species is grown as an ornamental tree for its strongly fragrant flowers, throughout temperate regions of the world. A number of cultivars have been selected for their ornamental value, including 'Albomarginata', with variegated foliage, 'Bommii', a dwarf with strongly pendulous branches, 'Globosa', a compact dwarf clone, 'Pendula', with drooping branching, and 'Xanthocarpa' with yellow fruit. It has also been used as a rootstock for grafting other cherries on.",
        "truncated": false
      }
    }
  },
