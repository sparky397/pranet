  "description": {
    "ja": {
      "source": "Wikipedia (ja): リュウキンカ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%AA%E3%83%A5%E3%82%A6%E3%82%AD%E3%83%B3%E3%82%AB",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 109972579,
      "text": "リュウキンカ は、キンポウゲ科リュウキンカ属の多年草。鮮やかなみずみずしさで、「沼のマリーゴールド」とも呼ばれる。"
    },
    "en": {
      "source": "Wikipedia (en): Caltha palustris",
      "source_url": "https://en.wikipedia.org/wiki/Caltha_palustris",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1346030121,
      "text": "Caltha palustris, known as marsh-marigold and kingcup, is a small to medium sized perennial herbaceous plant of the buttercup family, native to marshes, fens, ditches and wet woodland in temperate regions of the Northern Hemisphere. It flowers between April and August, dependent on altitude and latitude, but occasional flowers may occur at other times."
    },
    "es": {
      "source": "Wikipedia (es): Caltha palustris",
      "source_url": "https://es.wikipedia.org/wiki/Caltha_palustris",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171671743,
      "text": "La calta palustre, caléndula acuática o verruguera es una planta nativa de Europa que crece en lugares húmedos, pantanosos, cerca de zonas encharcadas."
    },
    "fr": {
      "source": "Wikipedia (fr): Populage des marais",
      "source_url": "https://fr.wikipedia.org/wiki/Populage_des_marais",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 224499691,
      "text": "Le Populage des marais, Caltha des marais ou encore Souci d'eau, est une espèce de plantes à fleurs de la famille des Renonculacées. C'est l'espèce type du genre Caltha."
    },
    "pt": {
      "source": "Wikipedia (pt): Caltha palustris",
      "source_url": "https://pt.wikipedia.org/wiki/Caltha_palustris",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 64611986,
      "text": "O malmequer-dos-brejos (Caltha palustris) é uma espécie de planta com flor pertencente à família Ranunculaceae."
    },
    "id": {
      "source": "Wikipedia (id): Caltha palustris",
      "source_url": "https://id.wikipedia.org/wiki/Caltha_palustris",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 28684356,
      "text": "Caltha palustris yang biasa disebut marigold rawa, adalah tanaman herba abadi berukuran kecil hingga sedang dari famili Ranunculaceae. Spesies ini berasal dari lingkungan tergenang seperti rawa, paya, parit, dan hutan basah di wilayah beriklim sedang di Belahan Bumi Utara. Periode berbunga utamanya berlangsung dari April hingga Agustus, tergantung pada ketinggian dan garis lintang, meskipun bunga dapat muncul secara sporadis di luar musim tersebut."
    }
  },
  "sections": {
    "toxicity": {
      "en": {
        "source": "Wikipedia (en): Caltha palustris § Toxicity",
        "source_url": "https://en.wikipedia.org/wiki/Caltha_palustris#Toxicity",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 1346030121,
        "heading": "Toxicity",
        "text": "Caltha contains several active substances of which the most important from a toxicological point of view is protoanemonin. Consumption of larger  quantities of the plant may cause convulsions, burning of the throat, vomiting, bloody diarrhea, dizziness and fainting. Contact of the skin or mucous membranes with the juices can cause blistering or inflammation, and gastric illness if ingested. Younger parts seem to contain less toxics and heating breaks these substances down. Small amounts of Caltha in hay do not cause problems when fed to husbandry, but larger quantities lead to gastric illness.\nAdditionally, plants that live in raw water may carry toxic organisms which can be neutralized by cooking.",
        "truncated": false
      },
      "fr": {
        "source": "Wikipedia (fr): Populage des marais § Toxicité",
        "source_url": "https://fr.wikipedia.org/wiki/Populage_des_marais#Toxicit%C3%A9",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 224499691,
        "heading": "Toxicité",
        "text": "Toutes les parties de la plante mature sont toxiques. Elles contiennent de la proto-anémonine. Avant la floraison, la plante immature peut être consommée après ébullition.",
        "truncated": false
      }
    }
  },
