      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 166624252,
      "text": "Zornia latifolia Sm., es una especie fanerógama perteneciente a la familia de las fabáceas."
    },
