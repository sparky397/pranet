  "sections": {
    "uses": {
      "en": {
        "source": "Wikipedia (en): Amaranthus graecizans § Uses",
        "source_url": "https://en.wikipedia.org/wiki/Amaranthus_graecizans#Uses",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1332431144,
        "heading": "Uses",
        "text": "The edible leaves are used as a vegetable throughout Africa and the Middle East.  It can be eaten raw, but was more often cooked, or added to sauces and stews.  A common way to cook Amaranthus graecizans was to cook it in buttermilk, or to squeeze fresh lime-juice over it.  The seeds are starchy and can also be eaten\nLeaves, stems and seeds may be eaten raw and cooked, the leaves have a high nutritional value.\nWhen grown on nitrogen-rich soils they are known to concentrate nitrates in the leaves,\nespecially noticeable on land where nitrate fertilizer is used.",
        "truncated": false
      }
    }
  },
