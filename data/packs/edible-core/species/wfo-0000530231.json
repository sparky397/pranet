      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 174419867,
      "text": "Amaranthus graecizans es una especie herbácea perteneciente a la familia Amaranthaceae."
    },
    "pt": {
      "source": "Wikipedia (pt): Amaranthus graecizans",
