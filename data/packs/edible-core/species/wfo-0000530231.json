  "description": {
    "en": {
      "source": "Wikipedia 英語版「Amaranthus graecizans」",
      "source_url": "https://en.wikipedia.org/wiki/Amaranthus_graecizans",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-12",
      "revision": 1332431144,
      "text": "Amaranthus graecizans, the Mediterranean amaranth or short-tepalled pigweed, is an annual species in the botanical family Amaranthaceae. It is native to Africa, southern Europe, East Asia to India and Central Asia. It is naturalized in North America. More general common names include tumbleweed and pigweed."
    }
