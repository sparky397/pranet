        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 29730965,
        "heading": "Kegunaan",
        "text": "Kayu berangan jawa dimanfaatkan secara lokal sebagai bahan konstruksi. Kulit kayunya dapat digunakan dalam proses penyamakan. Sementara bijinya dianggap layak untuk dikonsumsi.",
        "truncated": false
      }
