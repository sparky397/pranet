    "ja": {
      "source": "Wikipedia 日本語版「コウスイガヤ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%B3%E3%82%A6%E3%82%B9%E3%82%A4%E3%82%AC%E3%83%A4",
