  "description": {
    "en": {
      "source": "Wikipedia (en): Stereospermum kunthianum",
      "source_url": "https://en.wikipedia.org/wiki/Stereospermum_kunthianum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1182673400,
      "text": "Stereospermum kunthianum is an African deciduous shrub or small tree occurring in the Democratic Republic of Congo, Djibouti, Eritrea, Ethiopia, Kenya, Malawi, Senegal, Somalia, Sudan, Tanzania and Uganda. It is widespread across Africa to the Red Sea, and reaches as far south as Angola, Mozambique, Zambia and Zimbabwe. There are some 30 species with a Central African and Asian distribution."
    },
    "fr": {
      "source": "Wikipedia (fr): Stereospermum kunthianum",
      "source_url": "https://fr.wikipedia.org/wiki/Stereospermum_kunthianum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 226752827,
      "text": "Stereospermum kunthianum est une espèce de plantes à fleurs de la famille des Bignoniaceae, originaire d’Afrique tropicale. C'est un arbre ou un arbuste aux fleurs roses groupées en panicule lâche."
    }
  },
