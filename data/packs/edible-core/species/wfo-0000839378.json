  "description": {
    "en": {
      "source": "Wikipedia (en): Chamaedorea tepejilote",
      "source_url": "https://en.wikipedia.org/wiki/Chamaedorea_tepejilote",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1339666181,
      "text": "Chamaedorea tepejilote, also known as the pacaya palm, is a species of Chamaedorea palm tree found in the understory of the forests of southern Mexico, Central America, and northern Colombia."
    },
    "es": {
      "source": "Wikipedia (es): Chamaedorea tepejilote",
      "source_url": "https://es.wikipedia.org/wiki/Chamaedorea_tepejilote",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 175711511,
      "text": "Chamaedorea tepejilote, también conocida como pacaya, es una especie de palmera perteneciente al género Chamaedorea que se encuentra en el sotobosque de los bosques del sur de México, América Central y el norte de Colombia. Es una planta comestible, principalmente por su inflorescencia en Guatemala y El Salvador."
    },
    "fr": {
      "source": "Wikipedia (fr): Chamaedorea tepejilote",
      "source_url": "https://fr.wikipedia.org/wiki/Chamaedorea_tepejilote",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 233257504,
      "text": "Chamaedorea tepejilote, également connu sous le nom de palmier pacaya, est une espèce de palmier du genre Chamaedorea que l'on trouve dans le sous-bois des forêts tropicales du sud du Mexique, de l'Amérique centrale et du nord de la Colombie."
    },
    "id": {
      "source": "Wikipedia (id): Chamaedorea tepejilote",
      "source_url": "https://id.wikipedia.org/wiki/Chamaedorea_tepejilote",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29964324,
      "text": "Chamaedorea tepejilote, juga dikenal sebagai palem pacaya, adalah spesies pohon palem Chamaedorea yang ditemukan di tumbuhan bawah hutan di Meksiko selatan, Amerika Tengah, dan Kolombia utara."
    }
  },
  "sections": {
    "cultivation": {
      "fr": {
        "source": "Wikipedia (fr): Chamaedorea tepejilote § Culture",
