  "description": {
    "ja": {
      "source": "Wikipedia (ja): オオアワガエリ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AA%E3%82%AA%E3%82%A2%E3%83%AF%E3%82%AC%E3%82%A8%E3%83%AA",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 109769058,
      "text": "オオアワガエリ は、イネ科の多年草。チモシー・グラス、あるいは単にチモシーとも呼ばれる。"
    },
    "en": {
      "source": "Wikipedia (en): Timothy (grass)",
      "source_url": "https://en.wikipedia.org/wiki/Timothy_(grass)",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1368001420,
      "text": "Timothy is a species of perennial grass native to most of Europe and northern and western Asia. It is also known as timothy-grass, meadow cat's-tail or common cat's-tail. It is a member of the genus Phleum, which consists of 17 species of annual and perennial grasses."
    },
    "es": {
      "source": "Wikipedia (es): Phleum pratense",
      "source_url": "https://es.wikipedia.org/wiki/Phleum_pratense",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 174638654,
      "text": "Phleum pratense es una especie de planta herbácea perenne, muy abundante, de la familia Poaceae, nativa de la Europa templada."
    },
    "fr": {
      "source": "Wikipedia (fr): Fléole des prés",
      "source_url": "https://fr.wikipedia.org/wiki/Fl%C3%A9ole_des_pr%C3%A9s",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 237476995,
      "text": "La fléole des prés ou phléole est une espèce de plantes herbacées vivaces de la famille des Poaceae. On l'appelle aussi \"queue de rat\" ou herbe de Timothy."
    },
    "pt": {
      "source": "Wikipedia (pt): Phleum pratense",
      "source_url": "https://pt.wikipedia.org/wiki/Phleum_pratense",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 60731993,
      "text": "Phleum pratense é uma espécie de planta com flor pertencente à família Poaceae."
    },
    "id": {
      "source": "Wikipedia (id): Phleum pratense",
      "source_url": "https://id.wikipedia.org/wiki/Phleum_pratense",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29675357,
      "text": "Phleum pratense adalah sebuah rumput menahun berlimpah yang berasal dari sebagian besar Eropa kecuali untuk wilayah Mediterania. Rumput tersebut juga dikenal sebagai timothy, ekor kucing padang rumput atau ekor kucing biasa."
    }
