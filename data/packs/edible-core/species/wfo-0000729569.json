  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「パンクラチウム」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%91%E3%83%B3%E3%82%AF%E3%83%A9%E3%83%81%E3%82%A6%E3%83%A0",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 110758007,
      "text": "パンクラチウム はヒガンバナ科に含まれる球根植物の一つ。またはパンクラチウム属に含まれる植物の総称。パンクラティウム、パンクラチュームとも呼ばれる。"
    },
    "en": {
      "source": "Wikipedia 英語版「Pancratium maritimum」",
      "source_url": "https://en.wikipedia.org/wiki/Pancratium_maritimum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1370492898,
      "text": "Pancratium maritimum, or sea daffodil, is a species of bulbous plant native to both sides of the Mediterranean region and the Black Sea, from the Canary Islands, Portugal, Morocco, and Cyprus, and east to Turkey, Syria, Israel and the Caucasus. Its range on the coasts of the Black Sea includes southern Bulgaria, northern Turkey and Georgia. The species is naturalized in Southern California."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Pancratium maritimum」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Pancratium_maritimum#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1370492898,
        "heading": "Cultivation",
        "text": "Easily grown but requires a very sunny position and a very well drained, sandy soil. Needs hot summers to induce flowering and is often a shy bloomer in cooler climates. Hardy to USDA zone 8. Tolerates temperatures down to about −5 °C (23 °F). Propagation by seeds or division after flowering. Seedlings may flower in their third or fourth year.",
        "truncated": false
      }
    }
