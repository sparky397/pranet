  "description": {
    "ja": {
      "source": "Wikipedia (ja): マメガキ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%9E%E3%83%A1%E3%82%AC%E3%82%AD",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 109977415,
      "text": "マメガキ は、東北アジア原産のツツジ目カキノキ科カキノキ属の植物。種小名はオデュッセイアに登場するロートスの木に由来する。英名の「date plum」はデーツとプラムを合わせたような味がすることに由来する。別名は小柿。"
    },
    "en": {
      "source": "Wikipedia (en): Date-plum",
      "source_url": "https://en.wikipedia.org/wiki/Date-plum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1373857534,
      "text": "The date-plum, also known by the common names Caucasian persimmon and lilac persimmon, is a widely cultivated species of the genus Diospyros, native to Eurasia. The ripe fruit is edible."
    },
    "es": {
      "source": "Wikipedia (es): Diospyros lotus",
      "source_url": "https://es.wikipedia.org/wiki/Diospyros_lotus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171582007,
      "text": "Diospyros lotus es una especie silvestre del género Diospyros ampliamente cultivada. Es originaria del sureste de Europa y hasta la zona subtropical del suroeste de Asia. Es una de las plantas cultivadas desde más antiguo."
    },
    "fr": {
      "source": "Wikipedia (fr): Diospyros lotus",
      "source_url": "https://fr.wikipedia.org/wiki/Diospyros_lotus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 208836567,
      "text": "Diospyros lotus, le plaqueminier lotier, plaqueminier d'Italie, plaqueminier du Levant ou prunier-dattier, est une espèce de plante à fleurs de la famille des Ebenaceae."
    }
