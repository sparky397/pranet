  "description": {
    "en": {
      "source": "Wikipedia (en): Araucaria cunninghamii",
      "source_url": "https://en.wikipedia.org/wiki/Araucaria_cunninghamii",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1372030980,
      "text": "Araucaria cunninghamii is a species of conifer in the family Araucariaceae, known as hoop pine. Other less commonly used names include colonial pine, Queensland pine, Dorrigo pine, Moreton Bay pine and Richmond River pine. The scientific name honours the botanist and explorer Allan Cunningham, who collected the first specimens in the 1820s. It is the earliest-diverging extant lineage within the genus Araucaria, and the only species within section Eutacta native to continental mainland areas; all other species in the section are naturally confined to islands."
    },
    "es": {
      "source": "Wikipedia (es): Araucaria cunninghamii",
      "source_url": "https://es.wikipedia.org/wiki/Araucaria_cunninghamii",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 174777574,
      "text": "Araucaria cunninghamii, llamada comúnmente araucaria de Australia, es una especie del género Araucaria que se encuentra en las costas de bosques lluviosos del este de Australia y de Nueva Guinea."
    },
    "fr": {
      "source": "Wikipedia (fr): Araucaria cunninghamii",
      "source_url": "https://fr.wikipedia.org/wiki/Araucaria_cunninghamii",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 224828615,
      "text": "Araucaria cunninghamii est un arbre conifère de la famille des Araucariaceae. On le trouve en Australie et en Asie tropicale."
    },
    "pt": {
      "source": "Wikipedia (pt): Araucaria cunninghamii",
      "source_url": "https://pt.wikipedia.org/wiki/Araucaria_cunninghamii",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 64322894,
      "text": "Araucaria cunninghamii é uma espécie de planta da família Araucariaceae pertencente ao gênero Araucaria."
    },
    "id": {
      "source": "Wikipedia (id): Sien",
      "source_url": "https://id.wikipedia.org/wiki/Sien",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29729592,
      "text": "Sien, adalah tumbuhan bergenus Araucaria. Nama ilmiahnya diberikan untuk menghormati ahli botani dan penjelajah Allan Cunningham, yang mengumpulkan spesimen pertama pada tahun 1820-an."
