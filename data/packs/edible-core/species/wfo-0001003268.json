  "description": {
    "en": {
      "source": "Wikipedia (en): Amelanchier ovalis",
      "source_url": "https://en.wikipedia.org/wiki/Amelanchier_ovalis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1355311163,
      "text": "Amelanchier ovalis, commonly known as snowy mespilus or serviceberry, is a deciduous shrub in the family Rosaceae. Its pome fruits are edible and can be eaten raw or cooked. The species is native to central and southern Europe, as well as North Africa and the Middle East."
    },
    "es": {
      "source": "Wikipedia (es): Amelanchier ovalis",
      "source_url": "https://es.wikipedia.org/wiki/Amelanchier_ovalis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 158198692,
      "text": "Amelanchier ovalis Medik. 1793 es una especie de plantas de los llamados guillomos de la familia de las rosáceas."
    },
    "fr": {
      "source": "Wikipedia (fr): Amélanchier à feuilles ovales",
      "source_url": "https://fr.wikipedia.org/wiki/Am%C3%A9lanchier_%C3%A0_feuilles_ovales",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 238393335,
      "text": "L'Amélanchier à feuilles ovales, Amelanchier ovalis, est une espèce de plante à fleurs de la famille des Rosacées appartenant au genre Amelanchier."
    },
    "pt": {
      "source": "Wikipedia (pt): Amelanchier ovalis",
      "source_url": "https://pt.wikipedia.org/wiki/Amelanchier_ovalis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 64613463,
      "text": "Amelanchier ovalis, comummente conhecida como nespereira-das-rochas, é uma espécie de plantas com flor, pertencente à família das rosáceas e ao tipo biológico dos fanerófitos."
    },
    "id": {
      "source": "Wikipedia (id): Amelanchier ovalis",
      "source_url": "https://id.wikipedia.org/wiki/Amelanchier_ovalis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 28944951,
      "text": "Amelanchier ovalis merupakan spesies tumbuhan dari famili Rosaceae. Beberapa nama alternatifnya adalah snowy mespilus dan dwarf garden serviceberry. Tumbuhan ini berasal dari wilayah sepanjang Eropa, Kaukasus, hingga Afrika barat laut. Buah buninya dapat dimakan, baik saat mentah ataupun matang."
    }
