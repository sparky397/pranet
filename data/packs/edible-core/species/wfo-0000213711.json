  "description": {
    "en": {
      "source": "Wikipedia 英語版「Cytisus scoparius」",
      "source_url": "https://en.wikipedia.org/wiki/Cytisus_scoparius",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1351345770,
      "text": "Cytisus scoparius, the common broom or Scotch broom, is a deciduous leguminous shrub native to western and central Europe. In Great Britain and Ireland, the standard name is broom; this name is also used for other members of the Genisteae tribe, such as French broom or Spanish broom; and the term common broom is sometimes used for clarification. In other English-speaking countries, the most common name is \"Scotch broom\" ; however, it is known as English broom in Australia."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Cytisus scoparius」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Cytisus_scoparius#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1351345770,
        "heading": "Cultivation",
        "text": "Cytisus scoparius is widely cultivated as an ornamental plant, with several cultivars selected for variation in flower colour, including \"Moonlight\" with deep yellow flowers, \"Andreanus\" and \"Firefly\" with dark orange-red flowers, and growth habit, including \"Pendula\" with pendulous branchlets.",
        "truncated": false
      }
    }
