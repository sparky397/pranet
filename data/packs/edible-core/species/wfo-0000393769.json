  "description": {
    "en": {
      "source": "Wikipedia (en): Pistacia terebinthus",
      "source_url": "https://en.wikipedia.org/wiki/Pistacia_terebinthus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1377993122,
      "text": "Pistacia terebinthus, also called the terebinth, is a deciduous shrub species of the genus Pistacia, native to the Mediterranean region from the western regions of Morocco and Portugal to Greece and western and southeastern Turkey. At one time terebinths growing on the eastern shores of the Mediterranean Sea were regarded as a separate species, Pistacia palaestina, but these are now considered to be a synonym of P. terebinthus."
    },
    "es": {
      "source": "Wikipedia (es): Pistacia terebinthus",
      "source_url": "https://es.wikipedia.org/wiki/Pistacia_terebinthus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 175184838,
      "text": "El albotín, cornicabra o terebinto es un arbusto o árbol pequeño de hasta 6 m de alto de la familia de las anacardiáceas, del género Pistacia, nativo del Mediterráneo occidental y que se extiende desde las islas Canarias, Marruecos y la península ibérica, hasta Grecia y el oeste de Turquía."
    },
    "fr": {
      "source": "Wikipedia (fr): Pistachier térébinthe",
      "source_url": "https://fr.wikipedia.org/wiki/Pistachier_t%C3%A9r%C3%A9binthe",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 232097218,
      "text": "Le Pistachier térébinthe ou Térébinthe, est une plante à feuillage caduc de la famille des Anacardiacées poussant dans la garrigue et le maquis, commune dans tout le bassin méditerranéen."
    },
    "pt": {
      "source": "Wikipedia (pt): Terebinto",
      "source_url": "https://pt.wikipedia.org/wiki/Terebinto",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 71487572,
      "text": "Pistacia terebinthus é uma espécie de planta com flor pertencente à família Anacardiaceae."
    }
