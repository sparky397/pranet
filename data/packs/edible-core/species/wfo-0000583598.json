    "ja": {
      "source": "Wikipedia (ja): マニラエレミ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%9E%E3%83%8B%E3%83%A9%E3%82%A8%E3%83%AC%E3%83%9F",
