  "description": {
    "en": {
      "source": "Wikipedia (en): Achyranthes aspera",
      "source_url": "https://en.wikipedia.org/wiki/Achyranthes_aspera",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1377277584,
      "text": "Achyranthes aspera is a species of plant in the family Amaranthaceae. It is distributed throughout the tropical world. It can be found in many places growing as an introduced species and a common weed. It is an invasive species in some areas, including many Pacific Islands environments."
    },
    "es": {
      "source": "Wikipedia (es): Achyranthes aspera",
      "source_url": "https://es.wikipedia.org/wiki/Achyranthes_aspera",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 175416495,
      "text": "Achyranthes aspera L. es una especie de plantas herbáceas perteneciente a la familia de las amarantáceas."
    },
    "fr": {
      "source": "Wikipedia (fr): Achyranthes aspera",
      "source_url": "https://fr.wikipedia.org/wiki/Achyranthes_aspera",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 223607541,
      "text": "Achyranthes aspera L. est une espèce de plantes tropicales de la famille des Amaranthaceae et du genre Achyranthes."
    },
    "pt": {
      "source": "Wikipedia (pt): Achyranthes aspera",
      "source_url": "https://pt.wikipedia.org/wiki/Achyranthes_aspera",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 72800273,
      "text": "Achyranthes aspera é uma espécie de planta da família Amaranthaceae. Ela pode ser encontrada em muitos lugares, crescendo como uma espécie introduzida e uma erva daninha comum. É uma espécie invasora em algumas áreas, incluindo muitos ambientes das Ilhas do Pacífico."
    },
    "id": {
      "source": "Wikipedia (id): Jarong",
      "source_url": "https://id.wikipedia.org/wiki/Jarong",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 29670292,
      "text": "Jarong (nama lokal lainnya; jarongan, jarong lalaki, jarong, nyarang, sangko hidung, rai-rai dodinga adalah spesies tumbuhan yang tergolong dari famili Amaranthaceae. Gulma ini tersebar di seluruh wilayah tropis di dunia. Ditemukan di beberapa tempat sebagai spesies pendatang dan semak yang umum. Tumbuhan ini termasuk spesies invasif di beberapa wilayah, seperti dibeberapa lingkungan di Kepulauan Pasifik. h"
    }
  },
  "sections": {
    "uses": {
      "en": {
        "source": "Wikipedia (en): Achyranthes aspera § Traditional medicine",
        "source_url": "https://en.wikipedia.org/wiki/Achyranthes_aspera#Traditional_medicine",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1377277584,
        "heading": "Traditional medicine",
        "text": "In the Caribbean region during the 20th century, A. aspera was used in traditional medicine as a decoction tea of boiled leaves and roots.",
        "truncated": false
      },
      "fr": {
        "source": "Wikipedia (fr): Achyranthes aspera § Utilisation",
        "source_url": "https://fr.wikipedia.org/wiki/Achyranthes_aspera#Utilisation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 223607541,
        "heading": "Utilisation",
        "text": "Au Nord Cameroun, les feuilles sont utilisées dans la confection des sauces. La plante y est consommée par le bétail, avant sa floraison.",
        "truncated": false
      },
      "id": {
        "source": "Wikipedia (id): Jarong § Manfaat",
        "source_url": "https://id.wikipedia.org/wiki/Jarong#Manfaat",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 29670292,
        "heading": "Manfaat",
        "text": "Manfaat dari tanaman ini di antaranya dapat mengatasi demam dan pembengkakan yang terjadi akibat gondongan, Anda dapat menggunakan akar tanaman Jarong. Khasiat Jarong dalam meredakan demam dan pembengkakan yang terjadi akibat gondongan dimungkinkan karena sifat antiinflamasi yang dimiliki oleh tanaman ini.\nSelain sifat tersebut, Jarong juga memiliki efek farmakologis lain yang juga berguna dalam mengatasi keluhan gondongan. Misalnya, tanaman Jarong dapat memperkuat otot dan urat yang kaku akibat serangan penyakit gondongan.",
        "truncated": false
      }
    }
  },
