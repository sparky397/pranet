  "description": {
    "en": {
      "source": "Wikipedia (en): Bauhinia variegata",
      "source_url": "https://en.wikipedia.org/wiki/Bauhinia_variegata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1372199366,
      "text": "Bauhinia variegata is a species of flowering plant in the legume family, Fabaceae. It is native to an area from China through Southeast Asia to the Indian subcontinent. Common names include orchid tree and mountain ebony."
    },
    "es": {
      "source": "Wikipedia (es): Bauhinia variegata",
      "source_url": "https://es.wikipedia.org/wiki/Bauhinia_variegata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 172811461,
      "text": "Bauhinia variegata, llamado vulgarmente árbol de las orquídeas, o árbol orquídea, es un árbol de la familia de las fabáceas, originario del sur y sureste de Asia, desde China meridional, Birmania, India, Nepal, Pakistán y Sri Lanka.También está presente en América Central de forma naturalizada."
    },
    "fr": {
      "source": "Wikipedia (fr): Bauhinia variegata",
      "source_url": "https://fr.wikipedia.org/wiki/Bauhinia_variegata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 234724942,
      "text": "Bauhinia variegata, l'Arbre à fleurs d'orchidées, est une espèce de plantes à fleurs de la famille des Fabaceae. C'est un arbre originaire d'Inde, Chine et de Birmanie."
    },
    "pt": {
      "source": "Wikipedia (pt): Casco-de-vaca-lilás",
      "source_url": "https://pt.wikipedia.org/wiki/Casco-de-vaca-lil%C3%A1s",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 71442615,
      "text": "Casco-de-vaca-lilás ou unha-de-vaca-lilás. Árvore encontrada e muito bem adaptada na maior parte do Brasil."
    }
  },
  "sections": {
    "cultivation": {
      "pt": {
        "source": "Wikipedia (pt): Casco-de-vaca-lilás § Cultivo",
        "source_url": "https://pt.wikipedia.org/wiki/Casco-de-vaca-lil%C3%A1s#Cultivo",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 71442615,
        "heading": "Cultivo",
        "text": "Pode ser cultivada em quase qualquer tipo de solo, preferindo solos aerados ricos em material orgânico, e que retenham uma boa quantidade de umidade, apesar de crescer relativamente bem em solos argilosos com poucos nutrientes.\nQuando cultivada a sol pleno, ela tem seu crescimento acelerado, tolerando a meia-sombra tendo no mínimo algumas horas de sol.\nPor não ter raízes agressivas, ela geralmente é utilizada em calçadas, tendo destaque na arborização-urbana.\nSua adubação geralmente não é necessária quando plantada diretamente no chão. Entretanto, a adubação pode sim acelerar o crescimento e melhorar a saúde da planta.",
        "truncated": false
      }
    }
  },
