  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「マルバツユクサ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%9E%E3%83%AB%E3%83%90%E3%83%84%E3%83%A6%E3%82%AF%E3%82%B5",
      "license": "CC BY-SA 4.0",
