  "description": {
    "en": {
      "source": "Wikipedia (en): Dioscorea trifida",
      "source_url": "https://en.wikipedia.org/wiki/Dioscorea_trifida",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1349393732,
      "text": "Dioscorea trifida is a species of flowering plant in the family Dioscoreaceae. It is a species of yam. It is native to the Caribbean and Central and South America. Its many common names include Indian yam, cush-cush, yampi and yampee. It is called mapuey in Venezuela, inhame in Brazil, tabena and ñame in Colombia, sacha papa in Peru, and ñampi in Costa Rica."
    },
    "es": {
      "source": "Wikipedia (es): Dioscorea trifida",
      "source_url": "https://es.wikipedia.org/wiki/Dioscorea_trifida",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 175740527,
      "text": "La Dioscorea trifida es un tubérculo del género Dioscorea originario del Caribe, Centroamérica tropical y América del Sur. Se le conoce por una variedad de nombres comunes, entre ellos mapuey, yampí, ñame blanco, ñame baboso, papañame, papa de aire o sachapapa."
    },
    "fr": {
      "source": "Wikipedia (fr): Dioscorea trifida",
      "source_url": "https://fr.wikipedia.org/wiki/Dioscorea_trifida",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 211134830,
      "text": "Dioscorea trifida, l’igname cousse-couche, est une espèce de plantes à fleurs monocotylédones de la famille des Dioscoreaceae, originaire d'Amérique centrale et d'Amérique du Sud."
    }
  },
