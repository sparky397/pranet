  "description": {
    "en": {
      "source": "Wikipedia 英語版「Cyperus articulatus」",
      "source_url": "https://en.wikipedia.org/wiki/Cyperus_articulatus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-12",
      "revision": 1322219725,
      "text": "Cyperus articulatus is an aromatic species of sedge known by the common names jointed flatsedge and priprioca. It has also been known as Guinea rush or adrue. It grows as a perennial herb. It grows in water or near it in rivers, streams, lakes, and swamps with a hyperhydrate or possibly tenagophyte growth pattern. It is widespread across tropical and subtropical regions in Africa, southern Asia, northern Australia, the southeastern United States, the West Indies, and Latin America. While it is closely related to highly invasive sedges such as purple nut sedge, priprioca is less prolific and competitive than its relative."
    }
  },
