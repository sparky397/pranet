  "description": {
    "ja": {
      "source": "Wikipedia (ja): クロツグ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AF%E3%83%AD%E3%83%84%E3%82%B0",
      "license": "CC BY-SA 4.0",
