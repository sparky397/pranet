  "description": {
    "en": {
      "source": "Wikipedia (en): Cassia javanica",
      "source_url": "https://en.wikipedia.org/wiki/Cassia_javanica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1362821828,
      "text": "Cassia javanica, also known as Java cassia, pink shower, apple blossom tree, rainbow shower tree, and Palawan cherry, is a species of tree in the family Fabaceae. Its origin is in Southeast Asia, but it has been extensively grown in tropical areas worldwide as a garden tree owing to its beautiful crimson and pink flower bunches."
    },
    "es": {
      "source": "Wikipedia (es): Cassia javanica",
      "source_url": "https://es.wikipedia.org/wiki/Cassia_javanica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171582513,
      "text": "La casia de Java es un árbol perteneciente a la familia de la fabáceas. Es un árbol caducifolio nativo del sudeste asiático. donde llega a alcanzar 24 m de alto. Los especímenes cultivados suelen medir la mitad de esa altura y tener una copa ancha y aplanada por la parte superior."
    },
    "fr": {
      "source": "Wikipedia (fr): Casse de Java",
      "source_url": "https://fr.wikipedia.org/wiki/Casse_de_Java",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 224828547,
      "text": "Le casse de Java est une espèce de plantes à fleurs de la famille des Fabaceae. C'est un arbre originaire d'Asie du Sud-Est."
    },
    "pt": {
      "source": "Wikipedia (pt): Cássia-javanesa",
      "source_url": "https://pt.wikipedia.org/wiki/C%C3%A1ssia-javanesa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 55169589,
      "text": "A cássia-javanesa é uma árvore da família das fabáceas, sub-família Caesalpinioideae."
    },
    "id": {
      "source": "Wikipedia (id): Trengguli wanggang",
      "source_url": "https://id.wikipedia.org/wiki/Trengguli_wanggang",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 30063495,
      "text": "Trengguli wanggang atau bobondelan adalah sejenis pohon kecil anggota suku Fabaceae, anak suku Caesalpinioideae. Tumbuhan ini asal-usulnya dari Asia Tenggara, tetapi karena bunganya yang cantik kini ia ditanam secara meluas di pelbagai wilayah tropika. Dalam bahasa Inggris, bobondelan dikenal sebagai Java Cassia, Pink Shower, Apple Blossom Tree atau  Rainbow Shower Tree."
    }
  },
