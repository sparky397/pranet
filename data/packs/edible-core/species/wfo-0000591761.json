  "description": {
    "en": {
      "source": "Wikipedia (en): Ceanothus americanus",
      "source_url": "https://en.wikipedia.org/wiki/Ceanothus_americanus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1354288933,
      "text": "Ceanothus americanus is a species of Ceanothus shrub native to North America. Common names include New Jersey tea, Jersey tea ceanothus, variations of red root, mountain sweet, and wild snowball. New Jersey tea was a name coined during the American Revolution, because its leaves were used as a substitute for imported tea."
    },
    "es": {
      "source": "Wikipedia (es): Ceanothus americanus",
      "source_url": "https://es.wikipedia.org/wiki/Ceanothus_americanus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 175211895,
      "text": "Ceanothus americanus es una especie de arbusto nativo de Norteamérica, en Estados Unidos y Canadá. El nombre de té de New Jersey fue acuñado durante la revolución americana, a causa de que sus hojas eran el sustituto de té importado."
    },
    "fr": {
      "source": "Wikipedia (fr): Ceanothus americanus",
      "source_url": "https://fr.wikipedia.org/wiki/Ceanothus_americanus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 238747224,
      "text": "Ceanothus americanus, le Céanothe d'Amérique, est une espèce de plantes à fleurs dicotylédones de la famille des Rhamnaceae. C'est un arbuste indigène d'Amérique du Nord."
    }
  },
