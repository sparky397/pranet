  "description": {
    "en": {
      "source": "Wikipedia (en): Caryota obtusa",
      "source_url": "https://en.wikipedia.org/wiki/Caryota_obtusa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1324245063,
      "text": "Caryota obtusa is a species of flowering plant in the palm family Arecaceae. It is native to India, Laos and Thailand. The palm is commonly called giant fishtail palm or Thai giant caryota. It can reach 20 meters or more in height and is thus considered a tree. It is monocarpic meaning it flowers once, then dies. Its inflorescence can reach 6 meters or more in length."
    },
    "es": {
      "source": "Wikipedia (es): Caryota obtusa",
      "source_url": "https://es.wikipedia.org/wiki/Caryota_obtusa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171483244,
      "text": "Caryota obtusa Griff. es una especie perteneciente a la familia de las palmeras (Arecaceae)."
    },
    "id": {
      "source": "Wikipedia (id): Pinang serai",
      "source_url": "https://id.wikipedia.org/wiki/Pinang_serai",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 30060746,
      "text": "Caryota obtusa adalah spesies tumbuhan berbunga dalam keluarga palem dari India, Laos dan Thailand. Telapak tangan ini biasa disebut palem buntut ikan raksasa atau pinang serai. Tingginya bisa mencapai 20 meter atau lebih dan karenanya dianggap sebagai pohon. Tanaman ini bersifat monokarpik yang berarti berbunga satu kali, kemudian mati. Perbungaannya bisa mencapai panjang 6 meter atau lebih."
    }
  },
