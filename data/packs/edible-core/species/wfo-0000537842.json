  "description": {
    "en": {
      "source": "Wikipedia (en): Annona montana",
      "source_url": "https://en.wikipedia.org/wiki/Annona_montana",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1346249796,
      "text": "Annona montana, the mountain soursop, is a tree and its edible fruit in the Annonaceae family native to Central America, the Amazon, and islands in the Caribbean. It has fibrous fruits. A. montana may be used as a rootstock for cultivated Annonas."
    },
    "es": {
      "source": "Wikipedia (es): Annona montana",
      "source_url": "https://es.wikipedia.org/wiki/Annona_montana",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 170224893,
      "text": "El guanábano de loma, guanábano cimarrón o guanábana de montaña  es una especie de árbol perteneciente a la familia de las anonáceas. Es nativa de América tropical, desde Costa Rica hasta el sur de Brasil."
    },
    "id": {
      "source": "Wikipedia (id): Sirsak gunung",
      "source_url": "https://id.wikipedia.org/wiki/Sirsak_gunung",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29939246,
      "text": "Annona montana, sirsak gunung, adalah pohon dan buahnya yang dapat dimakan dalam famili Annonaceae yang berasal dari Amerika Tengah, Amazon, dan pulau-pulau di Karibia."
    }
  },
