  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ゲットウ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%B2%E3%83%83%E3%83%88%E3%82%A6",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 109568717,
      "text": "ゲットウ は、ショウガ科ハナミョウガ属（アルピニア属） の常緑性多年草。沖縄の地方名で、サンニン、サニンなどともよばれる。"
    },
    "en": {
      "source": "Wikipedia 英語版「Alpinia zerumbet」",
      "source_url": "https://en.wikipedia.org/wiki/Alpinia_zerumbet",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1373017401,
      "text": "Alpinia zerumbet, commonly known as shell ginger among other names, is a perennial species of ginger native to East Asia. The plants can grow up to 2.5 to 3 meters tall and bear colorful funnel-shaped flowers. They are grown as ornamentals and their leaves are used in cuisine and traditional medicine."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Alpinia zerumbet」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Alpinia_zerumbet#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1373017401,
        "heading": "Cultivation",
        "text": "Alpinia zerumbet is best grown in rich medium-wet, to wet well drained soils in full sun to part shade. Afternoon shade in hot summer climates, is recommended. Indoors, the plant must have bright light and humid conditions. Flowering rarely occurs before the second year.",
        "truncated": false
      }
    }
