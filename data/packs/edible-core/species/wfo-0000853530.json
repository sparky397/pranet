  "description": {
    "en": {
      "source": "Wikipedia (en): Bambusa tulda",
      "source_url": "https://en.wikipedia.org/wiki/Bambusa_tulda",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1306005814,
      "text": "Bambusa tulda, or Indian timber bamboo, is considered to be one of the most useful of bamboo species. It is native to the Indian subcontinent, Indochina, Tibet, and Yunnan, and naturalized in Iraq, Puerto Rico, and parts of South America."
    },
    "fr": {
      "source": "Wikipedia (fr): Bambusa tulda",
      "source_url": "https://fr.wikipedia.org/wiki/Bambusa_tulda",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 207920828,
      "text": "Bambusa tulda, le bambou de l'Inde, est une espèce de plantes monocotylédones de la famille des Poaceae (graminées), sous-famille des Bambusoideae, originaire d'Asie."
    }
