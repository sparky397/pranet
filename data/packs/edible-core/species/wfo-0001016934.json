  "sections": {
    "uses": {
      "en": {
        "source": "Wikipedia (en): Rubus phoenicolasius § Uses",
        "source_url": "https://en.wikipedia.org/wiki/Rubus_phoenicolasius#Uses",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1365353607,
        "heading": "Uses",
        "text": "Wineberries grow in the wild in many parts of the United States, primarily the Appalachian Mountains. They are common along the edges of fields and roadsides, and still are used as breeding stock for raspberry cultivars. They are edible, with no poisonous look-a-likes in North America. Other plants that may be mistaken as wineberries include red raspberry, salmonberry, black raspberry, and blackberry, all of which are edible. Sweet and tart with a raspberry-like flavor, wineberries can be eaten raw, or used similarly to raspberries to make pastries, such as pie or other sweet treats.",
        "truncated": false
      }
    }
  },
