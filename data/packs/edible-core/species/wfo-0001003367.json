    "en": {
      "source": "Wikipedia (en): Chaenomeles japonica",
      "source_url": "https://en.wikipedia.org/wiki/Chaenomeles_japonica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1360672478,
      "text": "Chaenomeles japonica, called the Japanese quince, Maule's quince, or \"Japonica\", is a species of flowering quince that is native to Japan."
    },
    "es": {
      "source": "Wikipedia (es): Chaenomeles japonica",
      "source_url": "https://es.wikipedia.org/wiki/Chaenomeles_japonica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 175263583,
      "text": "Chaenomeles japonica es una especie de plantas del género Chaenomeles, familia de las rosáceas. Es nativa del este asiático."
    },
    "fr": {
      "source": "Wikipedia (fr): Cognassier du Japon",
