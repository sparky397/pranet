  "description": {
    "ja": {
      "source": "Wikipedia (ja): オオウイキョウ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AA%E3%82%AA%E3%82%A6%E3%82%A4%E3%82%AD%E3%83%A7%E3%82%A6",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 110039493,
      "text": "オオウイキョウ は、地中海世界に分布するセリ科の多年草。古代ギリシャにおいてはナルテークス（νάρθηξ, nárthēx) と呼ばれていた。"
    },
    "en": {
      "source": "Wikipedia (en): Ferula communis",
      "source_url": "https://en.wikipedia.org/wiki/Ferula_communis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1373503368,
      "text": "Ferula communis, the giant fennel, is a species of flowering plant in the carrot family Apiaceae. It is related to the common fennel, which belongs to the same family."
    },
    "es": {
      "source": "Wikipedia (es): Ferula communis",
      "source_url": "https://es.wikipedia.org/wiki/Ferula_communis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 175406334,
      "text": "La cañaheja es una hierba perenne, de 1-3 m de altura, muy robusta, con grandes inflorescencias abundantemente ramificadas."
    },
    "fr": {
      "source": "Wikipedia (fr): Férule commune",
      "source_url": "https://fr.wikipedia.org/wiki/F%C3%A9rule_commune",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 227178816,
      "text": "La Férule commune est une plante méditerranéenne du genre Ferula et de la famille des apiacées. Son « latex » contient des composés toxiques pour les animaux herbivores.\nElle fleurit en mai-juin, se présentant sous forme d'un arbrisseau aux ombelles spectaculaires par leur taille."
    },
    "pt": {
      "source": "Wikipedia (pt): Ferula communis",
      "source_url": "https://pt.wikipedia.org/wiki/Ferula_communis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 42587613,
      "text": "Ferula communis é uma espécie de planta com flor pertencente à família Apiaceae."
    }
  },
