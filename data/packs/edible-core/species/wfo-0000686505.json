  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「オオウイキョウ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AA%E3%82%AA%E3%82%A6%E3%82%A4%E3%82%AD%E3%83%A7%E3%82%A6",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 110039493,
      "text": "オオウイキョウ は、地中海世界に分布するセリ科の多年草。古代ギリシャにおいてはナルテークス（νάρθηξ, nárthēx) と呼ばれていた。"
    },
    "en": {
      "source": "Wikipedia 英語版「Ferula communis」",
      "source_url": "https://en.wikipedia.org/wiki/Ferula_communis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1373503368,
      "text": "Ferula communis, the giant fennel, is a species of flowering plant in the carrot family Apiaceae. It is related to the common fennel, which belongs to the same family."
    }
  },
  "sections": {
    "toxicity": {
      "ja": {
        "source": "Wikipedia 日本語版「オオウイキョウ」の節「毒性」",
        "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AA%E3%82%AA%E3%82%A6%E3%82%A4%E3%82%AD%E3%83%A7%E3%82%A6#%E6%AF%92%E6%80%A7",
