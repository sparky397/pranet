  "description": {
    "ja": {
      "source": "Wikipedia (ja): イワダレソウ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%A4%E3%83%AF%E3%83%80%E3%83%AC%E3%82%BD%E3%82%A6",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 110374376,
      "text": "イワダレソウ はクマツヅラ科イワダレソウ属の植物。地表を低く這う植物で、よく群落を作る。"
    },
    "en": {
      "source": "Wikipedia (en): Phyla nodiflora",
      "source_url": "https://en.wikipedia.org/wiki/Phyla_nodiflora",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1322816858,
      "text": "Phyla nodiflora, commonly known as lippia, kurapia, turkey tangle frogfruit, capeweed, and frogfruit, is a species of flowering plant in the family Verbenaceae. It can be found in the tropics around the globe. It is often grown as an ornamental plant for ground cover, and is often present in yards or disturbed areas."
    },
    "es": {
      "source": "Wikipedia (es): Phyla nodiflora",
      "source_url": "https://es.wikipedia.org/wiki/Phyla_nodiflora",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 171452748,
      "text": "Phyla nodiflora es una especie de plantas con flores de la familia Verbenaceae. Es una planta cosmopolita que puede encontrar en los trópicos de todo el mundo. A menudo se cultiva como planta ornamental para cubrir el suelo y, a menudo, está presente en patios o áreas perturbadas.[cita requerida]"
    },
    "fr": {
      "source": "Wikipedia (fr): Phyla nodiflora",
      "source_url": "https://fr.wikipedia.org/wiki/Phyla_nodiflora",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 235652223,
      "text": "Phyla nodiflora, Phyla à fleurs nodales, est une espèce de plantes herbacées ornementales de la famille des Verbénacées."
    },
    "id": {
      "source": "Wikipedia (id): Gigi gergaji",
      "source_url": "https://id.wikipedia.org/wiki/Gigi_gergaji",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 29824463,
      "text": "Phyla nodiflora, umumnya dikenal sebagai gigi gergaji, adalah spesies tanaman berbunga dalam famili Verbenaceae. Ini dapat ditemukan di daerah Tropis di seluruh dunia. Ini sering ditanam sebagai tanaman hias penutup tanah, dan sering ada di pekarangan atau daerah yang terganggu."
    }
  },
  "sections": {
    "uses": {
      "ja": {
        "source": "Wikipedia (ja): イワダレソウ § 利用",
        "source_url": "https://ja.wikipedia.org/wiki/%E3%82%A4%E3%83%AF%E3%83%80%E3%83%AC%E3%82%BD%E3%82%A6#%E5%88%A9%E7%94%A8",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 110374376,
        "heading": "利用",
        "text": "近年、このイワダレソウを用いての砂漠の緑化も研究されている。また、より小さいが花が目立つヒメイワダレソウ (Phyla canescens (Kunth) Greene) が園芸用に栽培されている（「リッピア」で流通）。\n丈が伸びにくく、地表を這うように広がることから、空港などのグラウンドカバーに向いている。\n農業害虫による被害を抑える有用な土着天敵が多く生息していることから、落葉果樹の下草として植えられる。\nイワダレソウとヒメイワダレソウを交配して作出されたクラピアという品種があり、グラウンドカバーとして利用されている。本品種は2005年に品種登録申請され、2008年に品種登録されているが、2007年に登録品種名を「Sヒトシ4世」に変更されている。流通名にはクラピアが用いられている。",
        "truncated": false
      },
      "es": {
        "source": "Wikipedia (es): Phyla nodiflora § Usos",
        "source_url": "https://es.wikipedia.org/wiki/Phyla_nodiflora#Usos",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 171452748,
        "heading": "Usos",
        "text": "El aceite esencial de Phyla nodiflora es utilizado para el tratamiento de afecciones estomacales y respiratorias. ​",
        "truncated": false
      }
    }
  },
