  "description": {
    "en": {
      "source": "Wikipedia (en): Areca triandra",
      "source_url": "https://en.wikipedia.org/wiki/Areca_triandra",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1314373383,
      "text": "Areca triandra, the wild areca palm, is a palm which is often used as ornamental plant. It is native to India, Bangladesh, Cambodia, Laos, Burma, Thailand, Vietnam, Malaysia, Indonesia, and the Philippines. It is also reportedly naturalized in Hawaii, Panama, Sri Lanka and southern China. As a wild plant, it commonly occurs in littoral forest in Southeast Asia."
    },
    "es": {
      "source": "Wikipedia (es): Areca triandra",
      "source_url": "https://es.wikipedia.org/wiki/Areca_triandra",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 149098865,
      "text": "La palmera areca silvestre es una palmera originaria de la India y Malasia la cual es utilizada como planta ornamental."
    },
    "fr": {
      "source": "Wikipedia (fr): Areca triandra",
      "source_url": "https://fr.wikipedia.org/wiki/Areca_triandra",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 207914914,
      "text": "Areca triandra est une espèce de palmier du genre Areca originaire d'Inde et de Malaisie. Il est souvent utilisé comme plante ornementale et diffusé dans de nombreuses régions tropicales."
    }
  },
