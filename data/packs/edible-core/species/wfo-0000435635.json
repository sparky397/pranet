  "description": {
    "ja": {
      "source": "Wikipedia (ja): アッケシソウ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%A2%E3%83%83%E3%82%B1%E3%82%B7%E3%82%BD%E3%82%A6",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 109894452,
      "text": "アッケシソウ は、ヒユ科に属する一年生草本。北半球において、汽水域の干潟や湿地（塩性湿地）に生育する。で、ヨーロッパ、アジア、北アメリカなどの寒帯・温帯地域に広範囲に分布する。"
    },
    "en": {
      "source": "Wikipedia (en): Salicornia europaea",
      "source_url": "https://en.wikipedia.org/wiki/Salicornia_europaea",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1322381945,
      "text": "Salicornia europaea, known as marsh samphire, common glasswort or just glasswort, is a halophytic annual dicot flowering plant. Other common names include pickle weed, saltwort, and chicken toe. It is a succulent plant with high water content, accounting for its slightly translucent look. It is found near saline water in Europe and is edible both raw and cooked."
    },
    "es": {
      "source": "Wikipedia (es): Salicornia europaea",
      "source_url": "https://es.wikipedia.org/wiki/Salicornia_europaea",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 173926241,
      "text": "Salicornia europaea  es una especie de planta perenne halófila que crece en zonas periódicamente anegadas por las aguas saladas o salobres de las mareas."
    },
    "fr": {
      "source": "Wikipedia (fr): Salicorne d'Europe",
      "source_url": "https://fr.wikipedia.org/wiki/Salicorne_d'Europe",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 230661577,
      "text": "La Salicorne d'Europe est une espèce de plantes à fleurs du genre Salicornia et de la famille des Chenopodiaceae selon la classification classique, ou des Amaranthaceae selon la classification phylogénétique."
    },
    "pt": {
      "source": "Wikipedia (pt): Salicornia europaea",
      "source_url": "https://pt.wikipedia.org/wiki/Salicornia_europaea",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 65261192,
      "text": "Salicornia europaea é uma espécie de planta com flor pertencente à família das amarantáceas. É uma planta halófita, usada para consumo humano."
    },
    "id": {
      "source": "Wikipedia (id): Salicornia europaea",
      "source_url": "https://id.wikipedia.org/wiki/Salicornia_europaea",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29875177,
      "text": "Salicornia europaea, yang dikenal sebagai common glasswort atau tepatnya glasswort, adalah sebuah tumbuhan halofit tahunan yang tumbuh di berbagai zona rawa asin intertidal. Abu tumbuhan glasswort dan saltwort dan kelp telah lama dipakai sebagai sumber abu soda untuk pembuatan kaca dan sabun. Introduksi proses LeBlanc untuk produksi industrial dari abu soda melampaui pemakaian sumber tumbuhan pada paruh pertama abad ke-19."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia (en): Salicornia europaea § Cultivation",
        "source_url": "https://en.wikipedia.org/wiki/Salicornia_europaea#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 1322381945,
        "heading": "Cultivation",
        "text": "Salicornia prefers a light, sandy soil (or a well-drained soil) and a sunny position. Samphire can be planted out once the danger of frosts is past. Salicornia is best watered with a saline solution of 1 teaspoon of sea salt in 1 imp pt (0.57 L) of water. Salicornia grow best in 200 mM NaCl.\nIn the Northern Hemisphere, the harvesting of samphire shoots takes place from June to August. After that time shoots will become woody. Samphire should be treated as a slow-growing cut-and-come-again crop, with a month elapsing between each cut.",
        "truncated": false
      }
    }
  },
