  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「キショウブ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AD%E3%82%B7%E3%83%A7%E3%82%A6%E3%83%96",
