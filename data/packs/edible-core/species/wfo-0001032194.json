  "description": {
    "en": {
      "source": "Wikipedia (en): Solanum umbelliferum",
      "source_url": "https://en.wikipedia.org/wiki/Solanum_umbelliferum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1094752498,
      "text": "Solanum umbelliferum is a species of nightshade known commonly as bluewitch nightshade, or bluewitch. It can be found in chaparral habitat and low-elevation oak woodlands in California and parts of Baja California and Arizona. It is a small perennial herb or subshrub with dark gray-green oval-shaped leaves on hairy green stems that grow to a maximum height of one meter. It has bright purple or blue frilly flowers with thick yellow anthers at the center. The flowers close into spherical buds overnight. It bears small round green fruits which turn purple when ripe and resemble tiny eggplants."
    },
    "es": {
      "source": "Wikipedia (es): Solanum umbelliferum",
      "source_url": "https://es.wikipedia.org/wiki/Solanum_umbelliferum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 135214346,
      "text": "Solanum umbelliferum es un arbusto perenne conocido como bruja azul. Es una especie del género Solanum, el cual incluye a plantas tan conocidas como el tomate, la patata y la berenjena."
    }
