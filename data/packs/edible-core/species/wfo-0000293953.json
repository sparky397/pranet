  "description": {
    "en": {
      "source": "Wikipedia (en): Astrocaryum standleyanum",
      "source_url": "https://en.wikipedia.org/wiki/Astrocaryum_standleyanum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1365354262,
      "text": "Astrocaryum standleyanum, commonly known as the black palm or chunga, is a species of palm native to Central and South America, where its distribution extends from Costa Rica to Ecuador. It is most common in central Panama, even becoming abundant in the tropical forests around the Panama Canal, but in general it is not a common plant."
    },
    "es": {
      "source": "Wikipedia (es): Astrocaryum standleyanum",
      "source_url": "https://es.wikipedia.org/wiki/Astrocaryum_standleyanum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 157146704,
      "text": "La macora, mocora, chunga, güérregue, guérregue o pejibaye de montaña es una palma, que se distribuye desde el sudeste de Costa Rica hasta el noreste de Ecuador; en las tierras bajas del Pacífico, en Colombia, desde el Chocó y Antioquia, hasta Nariño."
    },
    "fr": {
      "source": "Wikipedia (fr): Astrocaryum standleyanum",
      "source_url": "https://fr.wikipedia.org/wiki/Astrocaryum_standleyanum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 207917639,
      "text": "Astrocaryum standleyanum est une espèce de palmiers à feuilles pennées."
    }
