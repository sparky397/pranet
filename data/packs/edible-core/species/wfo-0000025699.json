  "description": {
    "ja": {
      "source": "Wikipedia (ja): シロバナムシヨケギク",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%B7%E3%83%AD%E3%83%90%E3%83%8A%E3%83%A0%E3%82%B7%E3%83%A8%E3%82%B1%E3%82%AE%E3%82%AF",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 110990450,
      "text": "シロバナムシヨケギク は、キク科の多年草である。胚珠の部分に殺虫成分のピレトリンを含むため、除虫菊（ジョチュウギク）の名前でも知られ殺虫剤の原料に使用されてきた。原産地は地中海沿岸であり、セルビアで発見された。"
    },
    "en": {
      "source": "Wikipedia (en): Tanacetum cinerariifolium",
      "source_url": "https://en.wikipedia.org/wiki/Tanacetum_cinerariifolium",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1352115956,
      "text": "Tanacetum cinerariifolium is a species of flowering plant in the aster family, Asteraceae, and formerly part of the genus Pyrethrum, but now placed in the genus Chrysanthemum, or the genus Tanacetum by some biologists. It is called the Dalmatian chrysanthemum or Dalmatian pyrethrum, denoting its origin in western coastal Balkan Peninsula, where it ranges from Dalmatia to Albania. It looks more like the common daisy than other pyrethrums do. Its flowers, typically white with yellow centers, grow from numerous fairly rigid stems. Plants have blue-green leaves and grow to 45 to 100 cm in height."
    },
    "es": {
      "source": "Wikipedia (es): Tanacetum cinerariifolium",
      "source_url": "https://es.wikipedia.org/wiki/Tanacetum_cinerariifolium",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 157139828,
      "text": "El piretro o pelitre de Dalmacia es una planta de hoja perenne de la familia de las asteráceas, nativa de Dalmacia; es parecida a una margarita, con vistosas flores blancas, rosas o rojas."
    },
    "fr": {
      "source": "Wikipedia (fr): Pyrèthre de Dalmatie",
      "source_url": "https://fr.wikipedia.org/wiki/Pyr%C3%A8thre_de_Dalmatie",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 225041638,
      "text": "Le pyrèthre de Dalmatie est une espèce de plantes à fleurs de la famille des Asteraceae (Composées), cultivée pour ses fleurs dont on tire une poudre insecticide."
    },
    "id": {
      "source": "Wikipedia (id): Piretrum",
      "source_url": "https://id.wikipedia.org/wiki/Piretrum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 30060773,
      "text": "Piretrum atau Tanaman Piretrum merupakan tumbuhan sejenis terna yang memiliki bunga. Tanaman ini tumbuh subur di lingkungan yang memiliki iklim dan cuaca serta topografi yang ekstrem/menantang. Sepanjang sejarahnya, Piretrum telah dibudidayakan dan telah tumbuh liar didaerah lintang tinggi mulai dari pegunungan Alphen di Eropa sampai ke dekat Semenanjung Korea di timur. Beberapa waktu ini, Piretrum banyak dibudidayakan di Brazil, Australia, Afrika Timur terutama Kenya dan Meksiko."
    }
  },
