  "description": {
    "en": {
      "source": "Wikipedia (en): Lovoa trichilioides",
      "source_url": "https://en.wikipedia.org/wiki/Lovoa_trichilioides",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1314920235,
      "text": "Lovoa trichilioides, also called African walnut, Congowood, dibetou or tigerwood, is a species of tree in the family Meliaceae found in Central Africa. The timber provides high chatoyance, with an average value above 20 PZC."
    },
    "es": {
      "source": "Wikipedia (es): Lovoa trichilioides",
      "source_url": "https://es.wikipedia.org/wiki/Lovoa_trichilioides",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 157049490,
      "text": "Lovoa trichilioides, llamada comúnmente nuez africana o embero, es una especie arbórea nativa de África perteneciente a la familia Meliaceae. Su madera se relaciona con la caoba americana y otras especies de árboles de madera fina. Es una de las dos principales especies madereras del Congo."
    },
    "fr": {
      "source": "Wikipedia (fr): Lovoa trichilioides",
      "source_url": "https://fr.wikipedia.org/wiki/Lovoa_trichilioides",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 208026677,
      "text": "Lovoa trichilioides, aussi appelé dibétou, est une espèce de plantes du genre Lovoa de la famille des Meliaceae. C'est un grand arbre des forêts tropicales d'Afrique connu pour son bois."
    }
