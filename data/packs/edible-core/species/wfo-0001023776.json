  "description": {
    "ja": {
      "source": "Wikipedia (ja): キダチタバコ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AD%E3%83%80%E3%83%81%E3%82%BF%E3%83%90%E3%82%B3",
      "license": "CC BY-SA 4.0",
