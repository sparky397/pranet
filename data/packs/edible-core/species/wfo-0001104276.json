  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「トンキンカズラ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%88%E3%83%B3%E3%82%AD%E3%83%B3%E3%82%AB%E3%82%BA%E3%83%A9",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 107870674,
      "text": "トンキンカズラ は、キョウチクトウ科の顕花植物。中国からインドシナにかけてが原産地。他の地域でも栽培されており、外来種として野生化している場合もある。"
    },
    "en": {
      "source": "Wikipedia 英語版「Telosma cordata」",
      "source_url": "https://en.wikipedia.org/wiki/Telosma_cordata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1374861501,
      "text": "Telosma cordata is a species of flowering plant in the family Apocynaceae, native to China and Indo-China. It is cultivated elsewhere and may occur wild as an introduced species. Common names include Chinese violet, cowslip creeper, Pakalana vine, Tonkin jasmine and Tonkinese creeper. The plant bears clusters of golden yellow blooms along the vining stems during summer months. Individual blooms emerge successively over a period of weeks emitting a rich, heavy fragrance during the day and night."
    }
