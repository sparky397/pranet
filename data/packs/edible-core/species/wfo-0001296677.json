  "description": {
    "ja": {
      "source": "Wikipedia (ja): ルコウソウ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%AB%E3%82%B3%E3%82%A6%E3%82%BD%E3%82%A6",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 110042149,
      "text": "ルコウソウ は、ヒルガオ科サツマイモ属のつる性多年草である。蔦蘿とも呼ぶ。"
    },
    "en": {
      "source": "Wikipedia (en): Ipomoea quamoclit",
      "source_url": "https://en.wikipedia.org/wiki/Ipomoea_quamoclit",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1370024815,
      "text": "Ipomoea quamoclit, commonly known as cypress vine, cypress vine morning glory, cardinal creeper, cardinal vine, star glory, star of Bethlehem or hummingbird vine, is a species of vine in the family Convolvulaceae native to tropical regions of the Americas and naturalized elsewhere in the tropics."
    },
    "es": {
      "source": "Wikipedia (es): Ipomoea quamoclit",
      "source_url": "https://es.wikipedia.org/wiki/Ipomoea_quamoclit",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 171581920,
      "text": "El cundeamor es una planta trepadora perenne del género Ipomoea perteneciente a la familia de las convolvuláceas."
    },
    "fr": {
      "source": "Wikipedia (fr): Ipomoea quamoclit",
      "source_url": "https://fr.wikipedia.org/wiki/Ipomoea_quamoclit",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 208010663,
      "text": "Ipomoea quamoclit est une espèce de plantes dicotylédones de la famille des Convolvulaceae, originaire d'Amérique du Nord et d'Amérique centrale, du Mexique au Panama."
    },
    "id": {
      "source": "Wikipedia (id): Rincik bumi",
      "source_url": "https://id.wikipedia.org/wiki/Rincik_bumi",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 29873253,
      "text": "Rincik bumi adalah tumbuhan obat yang berasal dari Amerika tropis. Di Jawa, ia tumbuh liar di tanah yang telantar, ataupun tanaman hias yang dirambatkan di pagar. Dikenal dengan nama sangga langit, songgo langit (Melayu); bunga tali, rincik bumi (Sunda); dan katilan."
    }
  },
  "sections": {
    "cultivation": {
      "ja": {
        "source": "Wikipedia (ja): ルコウソウ § 栽培方法",
        "source_url": "https://ja.wikipedia.org/wiki/%E3%83%AB%E3%82%B3%E3%82%A6%E3%82%BD%E3%82%A6#%E6%A0%BD%E5%9F%B9%E6%96%B9%E6%B3%95",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 110042149,
        "heading": "栽培方法",
        "text": "一般的にはアサガオの栽培に準じて行えば失敗は少ない。種の発芽温度は20 -25°C程度なので、十分に温度が保てない場合は十分に気温が上がる季節に蒔くのが良い。短日処理をしていない場合、開花は秋になってからになるので、寒冷地では開花前に霜が降りて枯れてしまうことがある。冬でも20度程度を保てば枯れずに開花する。",
        "truncated": false
      },
      "es": {
        "source": "Wikipedia (es): Ipomoea quamoclit § Cultivo",
        "source_url": "https://es.wikipedia.org/wiki/Ipomoea_quamoclit#Cultivo",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 171581920,
        "heading": "Cultivo",
        "text": "Cultivada como planta ornamental por sus flores, en áreas muy frías para sobrevivir durante el invierno, crece como planta anual. Su propagación se realiza por semillas previamente remojadas en agua para germinar.",
        "truncated": false
      }
    },
    "uses": {
      "fr": {
        "source": "Wikipedia (fr): Ipomoea quamoclit § Utilisation",
        "source_url": "https://fr.wikipedia.org/wiki/Ipomoea_quamoclit#Utilisation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 208010663,
        "heading": "Utilisation",
        "text": "Au jardin, Ipomoea quamoclit est une plante facile à cultiver à partir de semis de graines, comme plante annuelle. Elle préfère des sols moyennement humides et bien drainés, et une exposition en plein soleil. C'est une plante grimpante relativement fragile qui nécessite un support sur lequel elle peut s'étendre.\nElle fournit ainsi une couverture ornementale attrayante pour les tonnelles, les clôtures, les treillages ou autres structures disponibles autour de la maison.\nUn hybride horticole a été obtenu avec Ipomoea coccinea : Ipomoea ×multifida.",
        "truncated": false
      }
    }
  },
