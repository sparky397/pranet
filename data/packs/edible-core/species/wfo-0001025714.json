  "description": {
    "en": {
      "source": "Wikipedia (en): Solanum aculeatissimum",
      "source_url": "https://en.wikipedia.org/wiki/Solanum_aculeatissimum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1151778746,
      "text": "Solanum aculeatissimum, known as Dutch eggplant, and love-apple, is a weedy shrub that bears small, 2–3 cm pale yellow fruit following white flowers with characteristic Solanum yellow stamens."
    },
    "es": {
      "source": "Wikipedia (es): Solanum aculeatissimum",
      "source_url": "https://es.wikipedia.org/wiki/Solanum_aculeatissimum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 133491948,
      "text": "Solanum aculeatissimum, también conocida como la hierba mora india y berenjena holandesa, es una especie de planta fanerógama perteneciente a la familia de las solanáceas."
    }
  },
