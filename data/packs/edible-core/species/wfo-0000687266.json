      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1372948513,
      "text": "Ficus altissima, commonly known as the council tree and lofty fig, is a species of flowering plant, a fig tree in the family Moraceae. It is a large, stately evergreen hemiepiphyte and is native to southeastern Asia."
    },
    "es": {
      "source": "Wikipedia (es): Ficus altissima",
      "source_url": "https://es.wikipedia.org/wiki/Ficus_altissima",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 173945133,
      "text": "Ficus altissima es una especie de planta fanerógama, un árbol de la familia Moraceae. Se trata de un majestuoso gran árbol de hoja perenne que es nativo del sudeste de Asia."
    },
    "id": {
      "source": "Wikipedia (id): Jerakah",
      "source_url": "https://id.wikipedia.org/wiki/Jerakah",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29992864,
      "text": "Jerakah atau ara tinggi adalah spesies tumbuhan berbunga, pohon ara dalam famili Moraceae. Ini adalah hemiepiphyte yang besar dan selalu hijau dan berasal dari Asia Tenggara."
    }
