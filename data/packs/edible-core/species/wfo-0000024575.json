      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1306463757,
      "text": "Sigesbeckia orientalis, commonly known as Indian weed or common St. Paul's wort, is a species of flowering plant in the family Asteraceae. It is a small, upright, sparsely branched shrub with yellow flowers and widespread in Asia, Africa and Australia."
    },
    "fr": {
      "source": "Wikipedia (fr): Sigesbeckia orientalis",
      "source_url": "https://fr.wikipedia.org/wiki/Sigesbeckia_orientalis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 230760066,
      "text": "Sigesbeckia orientalis est une espèce de plantes à fleurs de la grande famille des Asteraceae ou Compositae"
    },
    "id": {
      "source": "Wikipedia (id): Jabung (tumbuhan)",
      "source_url": "https://id.wikipedia.org/wiki/Jabung_(tumbuhan)",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 28106242,
      "text": "Jabung adalah tumbuhan semak (shrub) dan termasuk ke dalam keluarga Asteraceae. Tumbuhan ini yang mempunyai bunga berukuran kecil berwarna kuning. Tumbuhan ini tersebar luas di Asia, Afrika, Madagaskar, Australia dan dapat ditemukan di Indonesia. Salah satu tempat persebarannya di Indonesia adalah Gunung Prau."
    }
