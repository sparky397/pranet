  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ミルスベリヒユ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%9F%E3%83%AB%E3%82%B9%E3%83%99%E3%83%AA%E3%83%92%E3%83%A6",
      "license": "CC BY-SA 4.0",
