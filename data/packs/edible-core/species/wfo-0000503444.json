  "description": {
    "en": {
      "source": "Wikipedia 英語版「Samolus valerandi」",
      "source_url": "https://en.wikipedia.org/wiki/Samolus_valerandi",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-12",
      "revision": 1354941867,
      "text": "Samolus valerandi is a species of semi-aquatic flowering plant in the primrose family, Primulaceae. Common names include seaside brookweed, brookweed, thin-leaf brookweed, water cabbage and water rose."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Samolus valerandi」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Samolus_valerandi#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-12",
        "revision": 1354941867,
        "heading": "Cultivation",
        "text": "The plant can be grown in ponds, bog gardens, and damp areas in the garden. S. valerandi prefers light (sandy), medium (loamy), and heavy (clay) soils, preferably neutral or basic (alkaline) soils. It can tolerate both shade and a bright, sunny position. It requires moist or wet soil and can even grow in water. The plant can tolerate maritime exposure and is self-fertile. S. valerandi is sometimes grown in aquariums, although they seem to last only a limited time when grown fully submersed.\n\n■ Uses\nThe plant's leaves, when cut and agitated in water, produce a lather, for which reason in Palestine it has been used by the local Arab population, in former times, to launder clothes and was called by them sabūn 'arab (= Arab soap).",
        "truncated": false
      }
    }
  },
