  "description": {
    "ja": {
      "source": "Wikipedia (ja): ヒメムカシヨモギ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%92%E3%83%A1%E3%83%A0%E3%82%AB%E3%82%B7%E3%83%A8%E3%83%A2%E3%82%AE",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 108286337,
      "text": "ヒメムカシヨモギ は、キク科イズハハコ属の2年草。道端や荒れ地などに生える雑草。"
    },
    "en": {
      "source": "Wikipedia (en): Erigeron canadensis",
      "source_url": "https://en.wikipedia.org/wiki/Erigeron_canadensis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1374950365,
      "text": "Erigeron canadensis is an annual plant native throughout most of North America and Central America. It is also widely naturalized in Eurasia and Australia. Common names include horseweed, Canadian horseweed, Canadian fleabane, coltstail, marestail, and butterweed. It was the first weed to have developed glyphosate resistance, reported in 2001 from Delaware."
    },
    "es": {
      "source": "Wikipedia (es): Conyza canadensis",
      "source_url": "https://es.wikipedia.org/wiki/Conyza_canadensis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 174572986,
      "text": "El erígero del Canadá o hierba carnicera, Conyza canadensis, es una especie de planta con flor, herbácea de la familia Asteraceae, nativa de Norteamérica, aunque hoy se ha extendido por los cinco continentes."
    },
    "fr": {
      "source": "Wikipedia (fr): Conyza canadensis",
      "source_url": "https://fr.wikipedia.org/wiki/Conyza_canadensis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 229967399,
      "text": "La Vergerette du Canada, Vergerolle du Canada ou encore Érigéron du Canada est une espèce de plante herbacée annuelle rudérale de la famille des Asteraceae."
    },
    "pt": {
      "source": "Wikipedia (pt): Conyza canadensis",
      "source_url": "https://pt.wikipedia.org/wiki/Conyza_canadensis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 64352224,
      "text": "Conyza canadensis é uma espécie de planta com flor pertencente à família Asteraceae."
    }
  },
