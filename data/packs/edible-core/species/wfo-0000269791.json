  "description": {
    "en": {
      "source": "Wikipedia (en): Phoenix paludosa",
      "source_url": "https://en.wikipedia.org/wiki/Phoenix_paludosa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1337693432,
      "text": "Phoenix paludosa, also called the mangrove date palm, is a species of flowering plant in the palm family, indigenous to coastal regions of India, Bangladesh, Myanmar, Thailand, Cambodia, Sumatra, Vietnam and peninsular Malaysia. They are also known as sea dates. The trees grow in clusters, to 5 m (16 ft) high, usually forming dense thickets. The leaves are 2 to 3 m long and recurved. Similar to Nypa leaves, but smaller and placed towards the plant's top."
    },
    "es": {
      "source": "Wikipedia (es): Phoenix paludosa",
      "source_url": "https://es.wikipedia.org/wiki/Phoenix_paludosa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 148007373,
      "text": "Phoenix paludosa es una especie de planta fanerógama perteneciente a la familia Arecaceae."
    },
    "id": {
      "source": "Wikipedia (id): Korma rawa",
      "source_url": "https://id.wikipedia.org/wiki/Korma_rawa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 26377499,
      "text": "Kurma rawa adalah jenis kurma yang tumbuh di wilayah mangrove saja. Jenis ini belum banyak diperhatikan di Indonesia. Di Indonesia, kurma rawa hanya tumbuh di Aceh Timur. Namun, di luar Indonesia, ia tumbuh dari Delta Sungai Gangga di India, Kepulauan Andaman, Siam, dan Semenanjung Malaya."
    }
  },
