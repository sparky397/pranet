  "description": {
    "en": {
      "source": "Wikipedia 英語版「Phoenix paludosa」",
      "source_url": "https://en.wikipedia.org/wiki/Phoenix_paludosa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-12",
      "revision": 1337693432,
      "text": "Phoenix paludosa, also called the mangrove date palm, is a species of flowering plant in the palm family, indigenous to coastal regions of India, Bangladesh, Myanmar, Thailand, Cambodia, Sumatra, Vietnam and peninsular Malaysia. They are also known as sea dates. The trees grow in clusters, to 5 m (16 ft) high, usually forming dense thickets. The leaves are 2 to 3 m long and recurved. Similar to Nypa leaves, but smaller and placed towards the plant's top."
    }
