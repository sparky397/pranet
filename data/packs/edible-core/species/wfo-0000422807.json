  "description": {
    "ja": {
      "source": "Wikipedia (ja): セイヨウカンボク",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%BB%E3%82%A4%E3%83%A8%E3%82%A6%E3%82%AB%E3%83%B3%E3%83%9C%E3%82%AF",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 110307647,
      "text": "セイヨウカンボク は、ガマズミ科ガマズミ属の落葉低木。別名ヨウシュカンボク（洋種肝木）。ヨーロッパに広く分布し、花や実を観賞するために庭木として栽培されるほか、ウクライナやロシアでは文化的にも重要な樹木である。"
    },
    "en": {
      "source": "Wikipedia (en): Viburnum opulus",
      "source_url": "https://en.wikipedia.org/wiki/Viburnum_opulus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1377340883,
      "text": "Viburnum opulus, commonly known as the guelder-rose, or guelder rose, is an Old World species of flowering plant in the family Viburnaceae."
    },
    "es": {
      "source": "Wikipedia (es): Viburnum opulus",
      "source_url": "https://es.wikipedia.org/wiki/Viburnum_opulus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 172048982,
      "text": "Viburnum opulus es una especie de arbusto perteneciente a la familia Adoxaceae."
    },
    "fr": {
      "source": "Wikipedia (fr): Viorne obier",
      "source_url": "https://fr.wikipedia.org/wiki/Viorne_obier",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 238754440,
      "text": "La Viorne obier (Viburnum opulus, autrefois aussi dit Bois à quenouille, est un arbuste à feuilles caduques et palmées, appartenant à la famille des Adoxacées."
    },
    "pt": {
      "source": "Wikipedia (pt): Viburnum opulus",
      "source_url": "https://pt.wikipedia.org/wiki/Viburnum_opulus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 68991204,
      "text": "Virbunum opulus é uma espécie do gênero botânico Viburnum pertencente a família das Adoxaceae."
    },
    "id": {
      "source": "Wikipedia (id): Viburnum opulus",
      "source_url": "https://id.wikipedia.org/wiki/Viburnum_opulus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29317840,
      "text": "Viburnum opulus atau yang juga dikenal dengan sebutan European cranberrybush atau guelder-rose adalah salah satu spesies tumbuhan berbentuk perdu dari famili Adoxaceae. Tumbuhan ini berasal dari bioma beriklim sedang dengan rentang sebaran mulai dari Eropa, Siberia, Turki, hingga Aljazair utara. Nama ilmiah Viburnum opulus pertama kali dipublikasikan oleh botanis Carolus Linnaeus dalam Species Plantarum tahun 1753."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia (en): Viburnum opulus § Cultivation",
        "source_url": "https://en.wikipedia.org/wiki/Viburnum_opulus#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 1377340883,
        "heading": "Cultivation",
        "text": "Viburnum opulus is grown as an ornamental plant for its flowers and berries, growing best on moist, moderately alkaline soils, though tolerating most soil types well. Several cultivars have been selected, including 'Roseum', in which all the flowers are only of the larger sterile type, with globular flower heads.\nThe shrub is also cultivated as a component of hedgerows, cover plantings, and as part of other naturalistic plantings in its native regions.\nThe cultivars 'Notcutt's Variety', 'Roseum' and the yellow-fruited 'Xanthocarpum' have gained the Royal Horticultural Society's Award of Garden Merit.",
        "truncated": false
      }
    },
    "toxicity": {
      "fr": {
        "source": "Wikipedia (fr): Viorne obier § Toxicité",
        "source_url": "https://fr.wikipedia.org/wiki/Viorne_obier#Toxicit%C3%A9",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 238754440,
        "heading": "Toxicité",
        "text": "Cette plante contient un alcaloïde, la lycorine. Les fruits cuits seraient consommables, mais crus (et surtout verts), ils provoqueraient des troubles digestifs à faible dose et des troubles neurologiques et cardiaques à forte dose. Chez la souris, la LD50 (dose létale pour 50% des individus) est de 5,4 g de feuilles sèches/kg.\nIl est conseillé de considérer cette plante comme faiblement toxique.",
        "truncated": false
      }
    }
  },
