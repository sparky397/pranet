  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ブッソウゲ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%96%E3%83%83%E3%82%BD%E3%82%A6%E3%82%B2",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 110519783,
      "text": "ブッソウゲ は、アオイ科フヨウ属の低木。扶桑花、仏桑華とも。沖縄では赤花ともいう。"
    },
    "en": {
      "source": "Wikipedia 英語版「Hibiscus × rosa-sinensis」",
      "source_url": "https://en.wikipedia.org/wiki/Hibiscus_%C3%97_rosa-sinensis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1378428895,
      "text": "Hibiscus × rosa-sinensis is a cultigen of tropical hibiscus, a flowering plant in the Hibiscus genus and Hibisceae tribe of the family Malvaceae."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Hibiscus × rosa-sinensis」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Hibiscus_%C3%97_rosa-sinensis#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1378428895,
        "heading": "Cultivation",
        "text": "Hibiscus × rosa-sinensis is widely grown as an ornamental plant throughout the tropics and subtropics. As it does not tolerate temperatures below 10 °C (50 °F), in temperate regions it is best grown under glass. Plants grown in containers may be placed outside during the summer months and moved into shelter during the winter months.\nNumerous cultivars exist, with flower colors ranging from white through yellow and orange to scarlet and shades of pink, with both single and double sets of petals. The cultivar 'Cooperi' has gained the Royal Horticultural Society's Award of Garden Merit.",
        "truncated": false
      }
    }
  },
