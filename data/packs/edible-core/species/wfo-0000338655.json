  "description": {
    "en": {
      "source": "Wikipedia (en): Alpinia officinarum",
      "source_url": "https://en.wikipedia.org/wiki/Alpinia_officinarum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1371842039,
      "text": "Alpinia officinarum, known as lesser galangal, is a plant in the ginger family, cultivated in Southeast Asia. It originated in China, where its name ultimately derives. It can grow 1.5 to 2 m high, with long leaves and reddish-white flowers. The rhizomes, known as galangal, are valued for their sweet spicy flavor and aromatic scent. These are used throughout Asia in curries and perfumes, and were previously used widely in Europe. They are also used as a herbal remedy."
    },
    "es": {
      "source": "Wikipedia (es): Alpinia officinarum",
      "source_url": "https://es.wikipedia.org/wiki/Alpinia_officinarum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 175384524,
      "text": "La galanga o galanga menor es una especie fanerógama de la familia Zingiberaceae."
    },
    "fr": {
      "source": "Wikipedia (fr): Petit galanga",
      "source_url": "https://fr.wikipedia.org/wiki/Petit_galanga",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 229541957,
      "text": "Le petit galanga, galanga camphré ou galanga officinal, est une espèce de plantes à fleurs de la famille des Zingiberaceae. C'est une plante herbacée vivace et rhizomateuse originaire d'Asie tropicale, en particulier du Sud de la Chine et de l'île d'Hainan."
    },
    "pt": {
      "source": "Wikipedia (pt): Alpinia officinarum",
      "source_url": "https://pt.wikipedia.org/wiki/Alpinia_officinarum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 59279075,
      "text": "Alpinia officinarum é o rizoma de uma planta nativa do sul da China."
    },
    "id": {
      "source": "Wikipedia (id): Lengkuas kecil",
      "source_url": "https://id.wikipedia.org/wiki/Lengkuas_kecil",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29962304,
      "text": "Alpinia officinarum, dikenal sebagai lengkuas kecil, merupakan tanaman dalam keluarga jahe, yang dibudidayakan di Asia Tenggara. Ini berasal dari Cina, dari mana namanya berasal. Tingginya bisa 1,5 sampai 2 m, dengan daun panjang dan bunga berwarna putih kemerahan. Rimpangnya, yang dikenal sebagai lengkuas, dihargai karena rasa pedasnya yang manis dan aromanya yang aromatik. Bahan ini digunakan di seluruh Asia dalam kari dan parfum, dan sebelumnya digunakan secara luas di Eropa. Lengkuas kecil juga digunakan sebagai obat herbal."
    }
  },
