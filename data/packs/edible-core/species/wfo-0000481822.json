  "description": {
    "ja": {
      "source": "Wikipedia (ja): ハイマツ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%8F%E3%82%A4%E3%83%9E%E3%83%84",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 111096593,
      "text": "ハイマツ はマツ科マツ属の常緑針葉樹。"
    },
    "en": {
      "source": "Wikipedia (en): Pinus pumila",
      "source_url": "https://en.wikipedia.org/wiki/Pinus_pumila",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1317639956,
      "text": "Pinus pumila, the Siberian dwarf pine, dwarf Siberian pine, dwarf stone pine, Japanese stone pine, or creeping pine, is a tree in the family Pinaceae native to northeastern Asia and the Japanese isles. It shares the common name creeping pine with several other plants."
    },
    "es": {
      "source": "Wikipedia (es): Pinus pumila",
      "source_url": "https://es.wikipedia.org/wiki/Pinus_pumila",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 174816517,
      "text": "Pinus pumila, llamado pino enano siberiano, es una especie de árbol perteneciente al género Pinus, oriunda de las regiones subalpinas del noreste de Asia, incluyendo Siberia, el oeste de Rusia y la isla de Sajalín, noreste de China, península de Corea y Japón. Comparte el nombre común de «pino rastrero» con varias otras plantas."
    },
    "fr": {
      "source": "Wikipedia (fr): Pinus pumila",
      "source_url": "https://fr.wikipedia.org/wiki/Pinus_pumila",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 172878908,
      "text": "Pinus pumila, parfois appelé le Pin nain de Sibérie, est une espèce d'arbres appartenant au genre Pinus et à la famille des Pinaceae."
    },
    "pt": {
      "source": "Wikipedia (pt): Pinus pumila",
      "source_url": "https://pt.wikipedia.org/wiki/Pinus_pumila",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 62848942,
      "text": "Pinus pumila é uma espécie de pinheiro originária do Velho Mundo, mais precisamente da região da Ásia."
    },
    "id": {
      "source": "Wikipedia (id): Pinus pumila",
      "source_url": "https://id.wikipedia.org/wiki/Pinus_pumila",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 28723172,
      "text": "Pinus pumila, secara umum dikenal sebagai pinus kerdil siberia, pinus siberia kerdil, pinus batu kerdil, pinus batu jepang, atau pinus merayap, adalah spesies pohon dalam famili Pinaceae yang berasal dari Asia timur laut dan kepulauan Jepang. Spesies ini secara umum disebut sebagai pinus merayap bersama dengan\nbeberapa tumbuhan pinus lainnya."
    }
  },
