  "description": {
    "en": {
      "source": "Wikipedia (en): Plantago afra",
      "source_url": "https://en.wikipedia.org/wiki/Plantago_afra",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1351953134,
      "text": "Plantago afra, commonly known as glandular plantain, is a flowering plant in the plantain family Plantaginaceae, and is one of a group of species in the genus Plantago formerly treated by some authors in a separate genus Psyllium. It is native to northern Africa, southern Europe, and southwestern Asia, and is locally naturalised elsewhere, including north to Great Britain. It has been extensively confused with the related species Plantago indica."
    },
    "es": {
      "source": "Wikipedia (es): Plantago psyllium",
      "source_url": "https://es.wikipedia.org/wiki/Plantago_psyllium",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 175393057,
      "text": "La zaragatona (Plantago psyllium), es una especie herbácea natural de la zona occidental del Mediterráneo, sobre todo España y Marruecos, también se la halla en el sur de Asia."
    },
    "fr": {
      "source": "Wikipedia (fr): Plantago afra",
      "source_url": "https://fr.wikipedia.org/wiki/Plantago_afra",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 229271571,
      "text": "Plantago afra est une plante herbacée de la famille des Plantaginaceae, croissant dans les régions sèches du bassin méditerranéen et d'Asie occidentale. Elle est cultivée pour sa graine utilisée pour ses propriétés laxatives ou adoucissantes."
    },
    "pt": {
      "source": "Wikipedia (pt): Plantago afra",
      "source_url": "https://pt.wikipedia.org/wiki/Plantago_afra",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 41788905,
      "text": "Plantago afra é uma espécie de planta com flor pertencente à família Plantaginaceae."
    }
  },
