  "description": {
    "ja": {
      "source": "Wikipedia (ja): ハマビシ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%8F%E3%83%9E%E3%83%93%E3%82%B7",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 106371430,
      "text": "ハマビシ は、南アジアから東欧にかけてみられるハマビシ科の多年草である。砂浜に生える海浜植物であるが、乾燥地帯では内陸にも生育する。リンネの『植物の種』(1753年) で記載された植物の一つである。"
    },
    "en": {
      "source": "Wikipedia (en): Tribulus terrestris",
      "source_url": "https://en.wikipedia.org/wiki/Tribulus_terrestris",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1368267453,
      "text": "Tribulus terrestris is an annual plant in the caltrop family (Zygophyllaceae) widely distributed around the world. It is adapted to thrive in dry climate locations in which few other plants can survive, and is a highly invasive species."
    },
    "es": {
      "source": "Wikipedia (es): Tribulus terrestris",
      "source_url": "https://es.wikipedia.org/wiki/Tribulus_terrestris",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 175003176,
      "text": "Tribulus terrestris, el abrojo, es una especie de planta herbácea del género Tribulus en la familia Zygophyllaceae."
    },
    "fr": {
      "source": "Wikipedia (fr): Tribule terrestre",
      "source_url": "https://fr.wikipedia.org/wiki/Tribule_terrestre",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 230939639,
      "text": "Le Tribule terrestre, également appelé Croix-de-Malte, est une plante appartenant à la famille des Zygophyllacées, dont elle est l'un des rares représentants en Europe. Indigène en Méditerranée, c'est la principale espèce recensée du genre Tribulus, auquel appartient aussi Tribulus cistoides L., espèce antillaise. Certains utilisent l'extrait de cette plante pour une stimulation de la production de testostérone. Le fruit porte des piquants suffisamment solides pour crever un pneu de vélo."
    },
    "pt": {
      "source": "Wikipedia (pt): Tribulus terrestris",
      "source_url": "https://pt.wikipedia.org/wiki/Tribulus_terrestris",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 67949890,
      "text": "Tribulus terrestris, da família Zygophyllaceae, é uma erva daninha nativa de regiões quentes, temperadas e tropicais do Velho Mundo, como o sul da Europa e sul da Ásia, além de ao longo da África e da Austrália. Na Europa, foi utilizada como estimulante sexual — para aumentar o impulso e o desempenho — e para tratamento da impotência durante vários séculos."
    },
    "id": {
      "source": "Wikipedia (id): Rujak polo",
      "source_url": "https://id.wikipedia.org/wiki/Rujak_polo",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29675487,
      "text": "Rujak polo adalah tanaman tahunan berduri yang tersebar secara luas di seluruh dunia."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia (en): Tribulus terrestris § Cultivation",
        "source_url": "https://en.wikipedia.org/wiki/Tribulus_terrestris#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 1368267453,
        "heading": "Cultivation",
        "text": "The plant is widely naturalized in the Americas and also in Australia south of its native range. In some states in the United States, it is considered a noxious weed and an invasive species. It is a \"declared plant\" in South Australia: its transportation and sale are prohibited, and landowners may be required to control it.",
        "truncated": false
      },
      "es": {
        "source": "Wikipedia (es): Tribulus terrestris § Cultivo",
        "source_url": "https://es.wikipedia.org/wiki/Tribulus_terrestris#Cultivo",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 175003176,
        "heading": "Cultivo",
        "text": "Se siembra en semillero para evitar que las heladas tardías lo perjudiquen. Las semillas se cubren con una fina capa de tierra arenosa. El medio debe mantenerse húmedo hasta que la planta crece. Una vez ha crecido soporta la escasez de agua.",
        "truncated": false
      }
    },
    "toxicity": {
      "en": {
        "source": "Wikipedia (en): Tribulus terrestris § Toxicity",
        "source_url": "https://en.wikipedia.org/wiki/Tribulus_terrestris#Toxicity",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 1368267453,
        "heading": "Toxicity",
        "text": "Toxic compounds in the plant are known to cause liver damage when ingested at harmful dosages. When ingested, phylloerythrin accumulates in the blood as a byproduct of chlorophyll degradation; however, adverse reactions have not been confirmed in humans. In sheep, consumption of T. terrestris causes tribulosis, also known as 'geeldikkop', which is a type of photodermatitis. Two alkaloids that seem to cause limb paresis (staggers) in sheep that eat T. terrestris are the beta-carboline alkaloids harman (harmane) and norharman (norharmane). The alkaloid content of dried foliage is about 44 mg/kg.",
        "truncated": false
      }
    }
  },
