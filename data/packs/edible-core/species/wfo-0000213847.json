  "description": {
    "en": {
      "source": "Wikipedia (en): Lupinus polyphyllus",
      "source_url": "https://en.wikipedia.org/wiki/Lupinus_polyphyllus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1346416199,
      "text": "Lupinus polyphyllus, the large-leaved lupine, big-leaved lupine, many-leaved lupine, blue-pod lupine, or, primarily in cultivation, garden lupin, is a species of lupine (lupin) native to western North America from southern Alaska and British Columbia and western Wyoming, and south to Utah and California. It commonly grows along streams and creeks, preferring moist habitats."
    },
    "es": {
      "source": "Wikipedia (es): Lupinus polyphyllus",
      "source_url": "https://es.wikipedia.org/wiki/Lupinus_polyphyllus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171164087,
      "text": "Lupinus polyphyllus es una planta ornamental que ha escapado frecuentemente al cultivo convirtiéndose en silvestre. Originaria del Noroeste de América se puede hallar desde el sur de Alaska hasta el oeste de Quebec y el sur de Utah, posteriormente fue llevada a Europa debido a su atractivo. Es frecuente encontrarla en la Patagonia, donde fue introducida por sus primeros pobladores blancos, en su mayoría europeos, que la trajeron como ornamento para sus jardines."
    },
    "fr": {
      "source": "Wikipedia (fr): Lupinus polyphyllus",
      "source_url": "https://fr.wikipedia.org/wiki/Lupinus_polyphyllus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 220742718,
      "text": "Lupinus polyphyllus, le Lupin des jardins ou Lupin à folioles nombreuses, est une espèce de plantes à fleurs originaire de l’ouest de l’Amérique du Nord."
    },
    "id": {
      "source": "Wikipedia (id): Lupinus polyphyllus",
      "source_url": "https://id.wikipedia.org/wiki/Lupinus_polyphyllus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 28105600,
      "text": "Lupinus polyphyllus atau turmus banyak daun atau turmus berdaun lebar adalah spesies turmus yang tumbuh di Amerika Utara, Alaska, dan Kolombia."
    }
  },
