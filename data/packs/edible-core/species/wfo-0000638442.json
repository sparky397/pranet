  "description": {
    "en": {
      "source": "Wikipedia (en): Daucus carota",
      "source_url": "https://en.wikipedia.org/wiki/Daucus_carota",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1375087850,
      "text": "Daucus carota, whose common names include wild carrot, European wild carrot, bird's nest, bishop's lace, carrot flower, and Queen Anne's lace, is a flowering plant in the family Apiaceae. It is native to temperate regions of Afro-Eurasia with a number of regional subspecies, and is naturalised widely elsewhere. Carrots cultivated as a food crop are cultivars of the domesticated subspecies Daucus carota subsp. sativus."
    },
    "es": {
      "source": "Wikipedia (es): Daucus carota",
      "source_url": "https://es.wikipedia.org/wiki/Daucus_carota",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 175697073,
      "text": "La zanahoria silvestre o carrota es una especie de planta herbácea de la familia Apiaceae. Es la forma silvestre de la zanahoria."
    },
    "fr": {
      "source": "Wikipedia (fr): Daucus carota",
      "source_url": "https://fr.wikipedia.org/wiki/Daucus_carota",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 236774151,
      "text": "Daucus carota, en français Carotte sauvage, Carotte commune, Daucus carotte ou simplement Carotte, est une espèce de plantes à fleurs dicotylédones de la famille des Apiaceae, originaire des régions tempérées de l'Ancien monde."
    },
    "pt": {
      "source": "Wikipedia (pt): Daucus carota",
      "source_url": "https://pt.wikipedia.org/wiki/Daucus_carota",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 63663186,
      "text": "A cenoura-brava é uma espécie de planta angiospérmica da família Apiaceae, nativa da Europa, Ásia e Norte de África.\nA subespécie sativus é um cultivar das regiões temperadas de todo o mundo."
    },
    "id": {
      "source": "Wikipedia (id): Daucus carota",
      "source_url": "https://id.wikipedia.org/wiki/Daucus_carota",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29941459,
      "text": "Daucus carota adalah tumbuhan berbunga di dalam famili Apiaceae. Tanaman ini berasal dari kawasan beriklim sedang di Eropa dan Asia barat daya, dan dinaturalisasikan ke Amerika Utara dan Australia."
    }
  },
  "sections": {
    "toxicity": {
      "en": {
        "source": "Wikipedia (en): Daucus carota § Toxicity",
        "source_url": "https://en.wikipedia.org/wiki/Daucus_carota#Toxicity",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 1375087850,
        "heading": "Toxicity",
        "text": "Like many other species of Apiaceae, the leaves of the wild carrot may cause phytophotodermatitis; skin contact with the foliage, especially wet foliage, can cause skin irritation in some people, so caution should be used when handling the plant. It may also have a mild effect on horses.\nThe compound falcarinol is naturally found in Daucus carota for protection against fungal diseases. Laboratory tests show the compound is toxic to mice and to the water flea Daphnia magna. Normal consumption of carrots has no toxic effect in humans.",
        "truncated": false
      },
      "es": {
        "source": "Wikipedia (es): Daucus carota § Toxicidad",
        "source_url": "https://es.wikipedia.org/wiki/Daucus_carota#Toxicidad",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 175697073,
        "heading": "Toxicidad",
        "text": "El contacto de la piel con el follaje de D. carota, especialmente el follaje húmedo, puede causar irritación de la piel en algunas personas.​​ También puede tener un efecto leve en los caballos.​\nEl compuesto falcarinol se encuentra de forma natural en el Daucus carota como protección contra las enfermedades fúngicas. Las pruebas de laboratorio demuestran que el compuesto es tóxico para los ratones y la pulga de agua (Daphnia magna).​",
        "truncated": false
      },
      "pt": {
        "source": "Wikipedia (pt): Daucus carota § Toxicidade",
        "source_url": "https://pt.wikipedia.org/wiki/Daucus_carota#Toxicidade",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 63663186,
        "heading": "Toxicidade",
        "text": "O contacto com a folhagem da Daucus carota, pode causar irritação da pele em algumas pessoas.",
        "truncated": false
      }
    },
    "cultivation": {
      "es": {
        "source": "Wikipedia (es): Daucus carota § Cultivo",
        "source_url": "https://es.wikipedia.org/wiki/Daucus_carota#Cultivo",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 175697073,
        "heading": "Cultivo",
        "text": "Esta planta puede utilizarse como planta de compañía para los cultivos. Como la mayoría de los miembros de la familia de las umbelíferas, atrae avispas a sus pequeñas flores en su tierra natal; sin embargo, donde se ha introducido, atrae muy pocas avispas. En el noreste de Wisconsin, cuando se introdujo con arándanos, logró atraer mariposas y avispas.​ También se ha documentado que esta especie aumenta la producción de tomateras cuando se mantiene cerca, y puede proporcionar un microclima de aire más fresco y húmedo para la lechuga, cuando se intercala con ella.​ Sin embargo, los Estados de Iowa, Míchigan y Washington ha sido catalogada como mala hierba nociva,​ y se considera una plaga grave en los pastos. Persiste en el banco de semillas del suelo de dos a cinco años.​",
        "truncated": false
      }
    }
  },
