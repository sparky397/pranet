  "description": {
    "en": {
      "source": "Wikipedia (en): Euphorbia neriifolia",
      "source_url": "https://en.wikipedia.org/wiki/Euphorbia_neriifolia",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1362235033,
      "text": "Euphorbia neriifolia, also known as Indian spurge tree, hedge Euphorbia, Oleander spurge and fleshy spurge, is a species of spurge native to India, which was originally described by Carl Linnaeus in 1753. Leaves from the plant are used in traditional kajal making in West Bengal, India."
    },
    "es": {
      "source": "Wikipedia (es): Euphorbia neriifolia",
      "source_url": "https://es.wikipedia.org/wiki/Euphorbia_neriifolia",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171582136,
      "text": "Euphorbia neriifolia es una especie de planta perteneciente a la familia Euphorbiaceae, conocida comúnmente como lengua de perro, sorosora de Filipinas o tuna francesa. Nativa de India central, Odisha y el sur de la India en el Decán, pero actualmente se encuentra naturalizada en Bengala Occidental, Sri Lanka, Birmania, Tailandia y en toda la región de Malasia, excepto Borneo. También se cultiva como seto y planta ornamental en otras regiones tropicales."
    },
    "id": {
      "source": "Wikipedia (id): Sudu-sudu",
      "source_url": "https://id.wikipedia.org/wiki/Sudu-sudu",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29706070,
      "text": "Euphorbia neriifolia atau sudu-sudu adalah spesies euphorbia, yang awalnya dideskripsikan oleh Carl Linnaeus pada tahun 1753."
    }
