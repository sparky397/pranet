  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「オウコチョウ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AA%E3%82%A6%E3%82%B3%E3%83%81%E3%83%A7%E3%82%A6",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 108036575,
      "text": "オウコチョウ Caesalpinia pulcherrima はジャケツイバラ亜科の植物の1つ。熱帯性の樹木で橙黄色の大きな美しい花をつける。"
    },
    "en": {
      "source": "Wikipedia 英語版「Caesalpinia pulcherrima」",
      "source_url": "https://en.wikipedia.org/wiki/Caesalpinia_pulcherrima",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1359460070,
      "text": "Caesalpinia pulcherrima is a species of flowering plant in the pea family Fabaceae, native to the tropics and subtropics of the Americas. It could be native to Central America, but its exact origin is unknown due to widespread cultivation. Common names for this species include poinciana, peacock flower, red bird of paradise, Mexican bird of paradise, dwarf poinciana, pride of Barbados, flos pavonis, and flamboyant-de-jardin."
    }
  },
