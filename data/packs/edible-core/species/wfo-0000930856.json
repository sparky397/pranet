  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「シダレヤナギ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%B7%E3%83%80%E3%83%AC%E3%83%A4%E3%83%8A%E3%82%AE",
