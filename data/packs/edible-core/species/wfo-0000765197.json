  "description": {
    "ja": {
      "source": "Wikipedia (ja): キキョウラン",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AD%E3%82%AD%E3%83%A7%E3%82%A6%E3%83%A9%E3%83%B3",
