  "description": {
    "en": {
      "source": "Wikipedia (en): Opuntia engelmannii",
      "source_url": "https://en.wikipedia.org/wiki/Opuntia_engelmannii",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1332483993,
      "text": "Opuntia engelmannii is a prickly pear common across the south-central and Southwestern United States and northern Mexico. It goes by a variety of common names, including desert prickly pear, discus prickly pear, Engelmann's prickly pear in the US, and nopal, abrojo, joconostle, and vela de coyote in Mexico."
    },
    "es": {
      "source": "Wikipedia (es): Opuntia engelmannii",
      "source_url": "https://es.wikipedia.org/wiki/Opuntia_engelmannii",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 173944914,
      "text": "Opuntia engelmannii Salm-Dyck ex Engelm. es una especie fanerógama perteneciente a la familia Cactaceae. Es nativa de Norteamérica en México, Arizona, California y Texas."
    },
    "fr": {
      "source": "Wikipedia (fr): Opuntia engelmannii",
      "source_url": "https://fr.wikipedia.org/wiki/Opuntia_engelmannii",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 203079112,
      "text": "Opuntia engelmannii est un cactus de la famille des Cactaceae et du genre Opuntia qui est présent dans le sud-ouest américain et le nord du Mexique. Il fait partie des cactus dont les fruits sont consommés par les Amérindiens de la tribu Tohono O'odham."
    }
