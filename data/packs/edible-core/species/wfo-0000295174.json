  "description": {
    "ja": {
      "source": "Wikipedia (ja): インドジャボク",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%A4%E3%83%B3%E3%83%89%E3%82%B8%E3%83%A3%E3%83%9C%E3%82%AF",
