  "description": {
    "en": {
      "source": "Wikipedia (en): Brahea armata",
      "source_url": "https://en.wikipedia.org/wiki/Brahea_armata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1378624744,
      "text": "Brahea armata, commonly known as the blue fan palm, blue hesper palm, or Mexican blue palm, is a flowering plant in the family Arecaceae, native to Baja California and Sonora, Mexico. It typically grows 35–50 feet tall and 1.5–2 feet wide, with a stout trunk, and rigid silver-blue palmate fronds. As a member of subgenus Erythea, it is distinguished by distinctly armed petioles with recurved teeth."
    },
    "es": {
      "source": "Wikipedia (es): Brahea armata",
      "source_url": "https://es.wikipedia.org/wiki/Brahea_armata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 175088521,
      "text": "Brahea armata es una especie perteneciente a la familia de las palmeras (Arecaceae)."
    },
    "fr": {
      "source": "Wikipedia (fr): Palmier bleu du Mexique",
      "source_url": "https://fr.wikipedia.org/wiki/Palmier_bleu_du_Mexique",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 202827785,
      "text": "Le palmier bleu du Mexique est une espèce de plante de la famille des palmiers. C’est l’espèce du genre Brahea la plus répandue en culture. Elle est représentée dans tous les jardins botaniques du monde, sous les tropiques comme dans les pays tempérés."
    }
  },
  "sections": {
    "cultivation": {
      "es": {
        "source": "Wikipedia (es): Brahea armata § Cultivo",
        "source_url": "https://es.wikipedia.org/wiki/Brahea_armata#Cultivo",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 175088521,
        "heading": "Cultivo",
        "text": "Tiene una apariencia atractiva, especialmente cuando es joven. Es tolerante a la sequía (aunque ocasionalmente se recomienda un riego profundo), puede tolerar tanto sombra parcial o pleno sol, y temperaturas de hasta -10 grados.",
        "truncated": false
      },
      "fr": {
        "source": "Wikipedia (fr): Palmier bleu du Mexique § Culture",
        "source_url": "https://fr.wikipedia.org/wiki/Palmier_bleu_du_Mexique#Culture",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 202827785,
        "heading": "Culture",
        "text": "Leur résistance au froid généralement admise peut aller jusqu'à des températures négatives de -14 °C dans de bonnes conditions de drainage.\nLes jeunes plantes se développent assez lentement les dix premières années puis la croissance s’accélère grandement (comme pour la plupart des palmiers) compte tenu bien sûr de la taille finale de l’espèce.",
        "truncated": false
      }
    }
