  "description": {
    "en": {
      "source": "Wikipedia 英語版「Sium sisarum」",
      "source_url": "https://en.wikipedia.org/wiki/Sium_sisarum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-12",
      "revision": 1340822640,
      "text": "Sium sisarum, commonly known as skirret, is a perennial plant of the family Apiaceae in the same family as carrots and parsnip. Skirret is grown as a root vegetable. The English name skirret is derived from the Middle English 'skirwhit' or 'skirwort', meaning 'white root'. In Scots it is known as crummock and in Irish as sciréad. Its Danish name sukkerrod, Dutch name suikerwortel and German name \"Zuckerwurzel\" translate as 'sugar root'."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Sium sisarum」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Sium_sisarum#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-12",
        "revision": 1340822640,
        "heading": "Cultivation",
        "text": "Skirret grows about 1 m (40 in) high and is very resistant to cold, as well as pests and diseases. It can be grown from seeds, but may also be started from root divisions. The roots are best eaten when the plant is dormant during the winter, as in the spring, the roots become woody and covered with small hairs. Lack of moisture can also make the root more fibrous. The plant prefers sandy and moist soil.",
        "truncated": false
      }
    }
  },
