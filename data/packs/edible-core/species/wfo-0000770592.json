  "description": {
    "en": {
      "source": "Wikipedia (en): Blyxa aubertii",
      "source_url": "https://en.wikipedia.org/wiki/Blyxa_aubertii",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1173695647,
      "text": "Blyxa aubertii, common name bamboo plant, is a plant species widespread across Asia, Europe, Africa and Australia, but known from the Western Hemisphere only from a few collections in the southwestern part of the US State of Louisiana. This is an aquatic plant growing in shallow lakes and ponds."
    },
    "es": {
      "source": "Wikipedia (es): Blyxa aubertii",
