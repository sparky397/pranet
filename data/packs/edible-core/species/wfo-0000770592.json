      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 160126470,
      "text": "Blyxa aubertii es una especie de Liliopsida del género Blyxa, de la familia Hydrocharitaceae, del orden Alismatales."
    }
  },
