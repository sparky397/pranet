  "description": {
    "en": {
      "source": "Wikipedia (en): Schoenoplectus lacustris",
      "source_url": "https://en.wikipedia.org/wiki/Schoenoplectus_lacustris",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1318094352,
      "text": "Schoenoplectus lacustris, the common club-rush, is a species of club-rush that grows in fresh water across Europe, much of Asia, and with a disjunct population in southern Africa."
    },
    "es": {
      "source": "Wikipedia (es): Schoenoplectus lacustris",
      "source_url": "https://es.wikipedia.org/wiki/Schoenoplectus_lacustris",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171581133,
      "text": "El junco de laguna o junco lacustre es una planta de la familia de las ciperáceas."
    },
    "fr": {
      "source": "Wikipedia (fr): Scirpe lacustre",
      "source_url": "https://fr.wikipedia.org/wiki/Scirpe_lacustre",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 206849140,
      "text": "Le Scirpe aigu, appelé aussi Jonc des chaisiers ou Jonc des tonneliers, est une espèce de plante vivace herbacée de la famille des Cyperaceae. Elle croît dans les zones humides et est utilisée comme plante pour lutter contre l'érosion."
    },
    "pt": {
      "source": "Wikipedia (pt): Bunho",
      "source_url": "https://pt.wikipedia.org/wiki/Bunho",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 59188121,
      "text": "O bunho é uma erva vivaz da família das ciperáceas nativa da Europa. Era anteriormente classificado com Scirpus lacustris. Possui espiguetas ovóides e frutos aquênicos."
    }
