        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-12",
        "revision": 1354530232,
        "heading": "Cultivation",
        "text": "Salvia apiana prefers a sunny location, well draining soil, and good air circulation. It easily hybridizes with other Salvia species, particularly Salvia leucophylla and Salvia clevelandii.",
        "truncated": false
      }
    }
