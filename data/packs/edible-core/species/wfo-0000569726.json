  "description": {
    "en": {
      "source": "Wikipedia (en): Boswellia serrata",
      "source_url": "https://en.wikipedia.org/wiki/Boswellia_serrata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1361890774,
      "text": "Boswellia serrata is a plant that produces Indian frankincense. The plant is native to much of India and the Punjab region that extends into Pakistan."
    },
    "es": {
      "source": "Wikipedia (es): Boswellia serrata",
      "source_url": "https://es.wikipedia.org/wiki/Boswellia_serrata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 170924176,
      "text": "El olibano o árbol del incienso de la India es una especie de planta que produce el incienso indio llamado Salai. Se encuentra en Rajasthan y Madhya Pradesh en India. Su aroma se considera inferior al compararlos con las especies B. sacra o B. frereana."
    },
    "fr": {
      "source": "Wikipedia (fr): Boswellia serrata",
      "source_url": "https://fr.wikipedia.org/wiki/Boswellia_serrata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 239027204,
      "text": "Boswellia serrata, aussi appelé encens indien ou Shallaki en médecine ayurvédique, est un arbre de la famille des Burséracées."
    }
  },
