  "description": {
    "en": {
      "source": "Wikipedia (en): Ocimum americanum",
      "source_url": "https://en.wikipedia.org/wiki/Ocimum_americanum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1375011582,
      "text": "Ocimum americanum, known as American basil, lime basil, or hoary basil, is a species of an annual herb in the family Lamiaceae. Despite the misleading name, it is native to Africa, the Indian subcontinent, China, and Southeast Asia. The species is naturalized in Queensland, Christmas Island, and parts of tropical America."
    },
    "es": {
      "source": "Wikipedia (es): Ocimum americanum",
      "source_url": "https://es.wikipedia.org/wiki/Ocimum_americanum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 171581437,
      "text": "La albahaca lima es una especie de planta herbácea anual perteneciente a la familia de las lamiáceas, originaria y ampliamente distribuida en los trópicos del Viejo Mundo; naturalizada en Mesoamérica, Perú, Bolivia, Brasil. Es una planta herbácea anual con flores de color blanco o lavanda. Es usada como planta medicinal."
    },
    "fr": {
      "source": "Wikipedia (fr): Ocimum americanum",
      "source_url": "https://fr.wikipedia.org/wiki/Ocimum_americanum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 235589915,
      "text": "Ocimum americanum L. est une espèce de plantes à fleurs de la famille des Lamiaceae et du genre Ocimum, selon la classification phylogénétique. C'est une plante originaire des régions tropicales et subtropicales de l'Ancien Monde."
    },
    "pt": {
      "source": "Wikipedia (pt): Ocimum americanum",
      "source_url": "https://pt.wikipedia.org/wiki/Ocimum_americanum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 71189727,
      "text": "Alfavaca-do-campo é uma planta anual, odorífica e medicinal que pertence à família das lamiáceas, originária das regiões tropicais e subtropicais do Velho Mundo, cujo flores da cor branca ou lavanda. Originária da Ásia e África, naturalizou-se\npela América tropical, onde é encontrada vegetando espontaneamente. É conhecida popularmente pelos nomes de alfavaca-do-campo, alfavaca-de-vaqueiro, remédio-de-vaqueiro, segurelha, manjericão branco e anão."
    }
  },
  "sections": {
    "uses": {
      "pt": {
        "source": "Wikipedia (pt): Ocimum americanum § Usos",
        "source_url": "https://pt.wikipedia.org/wiki/Ocimum_americanum#Usos",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 71189727,
        "heading": "Usos",
        "text": "Além de ser usada como planta odorífica e medicinal, é usada na culinária.\nEntre os constituintes químicos do óleo essencial de O. americanum, foram identificados monoterpenos, monoterpenos oxigenados, sesquiterpenos, compostos alifáticos e fenilpropanóides. Os constituintes em maior proporção percentual são eugenol, estragol, limoneno, linalol, cinamato de metila e carvona.",
        "truncated": false
      }
    }
  },
