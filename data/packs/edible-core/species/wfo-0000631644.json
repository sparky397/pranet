  "description": {
    "ja": {
      "source": "Wikipedia (ja): ナンヨウソテツ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%8A%E3%83%B3%E3%83%A8%E3%82%A6%E3%82%BD%E3%83%86%E3%83%84",
      "license": "CC BY-SA 4.0",
