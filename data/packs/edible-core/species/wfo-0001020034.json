    "en": {
      "source": "Wikipedia (en): Capsicum cardenasii",
      "source_url": "https://en.wikipedia.org/wiki/Capsicum_cardenasii",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1082168047,
      "text": "Capsicum cardenasii is a plant species in the genus Capsicum and the family Solanaceae. It is a diploid with 2n=2x=24. It is a member within the C. pubescens complex, a group of closely related Capsicum species. It is closely related to C. eximium. It is native to the Andes, and it can be found in Bolivia and Peru. The native name is ulupica."
    },
    "es": {
      "source": "Wikipedia (es): Capsicum cardenasii",
      "source_url": "https://es.wikipedia.org/wiki/Capsicum_cardenasii",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 175008681,
      "text": "Capsicum cardenasii es una variedad de ají cuyo nombre nativo es ulupica es una especie botánica de la familia solanaceae. Crece de forma silvestre únicamente en la región de los valles de Bolivia."
    }
