  "description": {
    "en": {
      "source": "Wikipedia (en): Jasminum dichotomum",
      "source_url": "https://en.wikipedia.org/wiki/Jasminum_dichotomum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1335742347,
      "text": "Jasminium dichotomum, the Gold Coast jasmine, is a species of jasmine, in the family Oleaceae. It is an evergreen climber which grows as a rambling shrub or woody vine. The flowers are quite fragrant and open at night, coloured pink when budding then white; these appear at the leaf axils in cluster. It blooms year round. The leaves are opposite. The fleshy fruit is small."
    },
    "es": {
      "source": "Wikipedia (es): Jasminum dichotomum",
      "source_url": "https://es.wikipedia.org/wiki/Jasminum_dichotomum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171417673,
      "text": "Jasminum dichotomum es una especie botánica de jazmín de la familia de las Oleaceae. Es endémica de África. Fuera de su rango nativo, puede ser maleza."
    },
    "fr": {
      "source": "Wikipedia (fr): Jasminum dichotomum",
      "source_url": "https://fr.wikipedia.org/wiki/Jasminum_dichotomum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 228084697,
      "text": "Jasminum dichotomum  est une espèce de plantes à fleurs de la famille des Oleaceae originaire d'Afrique tropicale."
    }
