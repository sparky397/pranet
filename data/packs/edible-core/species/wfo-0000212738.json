  "description": {
    "en": {
      "source": "Wikipedia 英語版「Vicia ervilia」",
      "source_url": "https://en.wikipedia.org/wiki/Vicia_ervilia",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1368892999,
      "text": "Vicia ervilia, called ervil or bitter vetch, is an ancient legume crop of the Mediterranean region. Besides the English names, other common names include: gavdaneh (Persian), kersannah (Arabic), yero (Spanish), rovi (Greek), burçak (Turkish), and karshinim (Hebrew)."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Vicia ervilia」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Vicia_ervilia#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1368892999,
        "heading": "Cultivation",
        "text": "The nutritional value of the grain for ruminant cattle has guaranteed the species' continued cultivation in Morocco, Spain and Turkey. The crop is easy to cultivate and harvest and can be grown on very shallow, alkaline soils.",
        "truncated": false
      }
    }
  },
