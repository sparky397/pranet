  "description": {
    "en": {
      "source": "Wikipedia (en): Onobrychis viciifolia",
      "source_url": "https://en.wikipedia.org/wiki/Onobrychis_viciifolia",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1360722271,
      "text": "Onobrychis viciifolia, also known as O. sativa or common sainfoin was an important forage legume in temperate regions until the 1950s. During the Green Revolution it was replaced by high yielding alfalfa and clover species. Due to its anthelmintic properties, common sainfoin is a natural alternative to drugs to control nematode parasitism in the guts of small ruminants. This is the main reason why O. viciifolia returned to the scientific agenda in recent years."
    },
    "es": {
      "source": "Wikipedia (es): Onobrychis viciifolia",
      "source_url": "https://es.wikipedia.org/wiki/Onobrychis_viciifolia",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 173277052,
      "text": "Onobrychis viciifolia, comúnmente llamada esparceta o pipirigallo es una especie del género Onobrychis, de la familia de las Fabáceas. Se encuentra naturalizada por toda la región mediterránea en tierras de labor y cunetas de caminos. Es una planta colonizadora en suelos calizos y pedregosos."
    },
    "fr": {
      "source": "Wikipedia (fr): Sainfoin cultivé",
      "source_url": "https://fr.wikipedia.org/wiki/Sainfoin_cultiv%C3%A9",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 232619547,
      "text": "Le sainfoin cultivé, encore appelé esparcette cultivée ou esparcette à feuilles de vesce, est une espèce de plantes à fleurs de la famille des Fabacées."
    },
    "pt": {
      "source": "Wikipedia (pt): Onobrychis viciifolia",
      "source_url": "https://pt.wikipedia.org/wiki/Onobrychis_viciifolia",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 65479889,
      "text": "Onobrychis viciifolia é uma espécie de planta com flor pertencente à família Fabaceae."
    }
