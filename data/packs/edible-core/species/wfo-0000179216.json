  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「チョウマメ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%81%E3%83%A7%E3%82%A6%E3%83%9E%E3%83%A1",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 108498830,
      "text": "チョウマメ は、マメ科クリトリア属（チョウマメ属）の多年生の蔓性（巻きつき性）草本である。一重のほかに八重咲き，白色，橙赤色などの園芸品種がある。"
    },
    "en": {
      "source": "Wikipedia 英語版「Clitoria ternatea」",
      "source_url": "https://en.wikipedia.org/wiki/Clitoria_ternatea",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1373036777,
      "text": "Clitoria ternatea, commonly known as Shankhupushpam , Asian pigeonwings, bluebellvine, blue pea, butterfly pea, cordofan pea, or Darwin pea, is a plant species belonging to the family Fabaceae and native to the Indonesian island of Ternate. In Indian Ayurveda it is commonly known by the name aparajita."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Clitoria ternatea」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Clitoria_ternatea#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1373036777,
        "heading": "Cultivation",
        "text": "C. ternatea does not suffer from any severe pest or disease problems.\n\n■ Pests\nRarely suffers from caterpillars, whiteflies, and spider mites.\n\n■ Diseases\nSuffers from anthracnose and bacterial soft rot. Rarely suffers from fungal root rots.",
        "truncated": false
      }
    }
  },
