  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ビルマネム」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%93%E3%83%AB%E3%83%9E%E3%83%8D%E3%83%A0",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 111221073,
      "text": "ビルマネム はマメ科ジャケツイバラ亜科（旧ネムノキ亜科）の落葉高木。"
    },
    "en": {
      "source": "Wikipedia 英語版「Albizia lebbeck」",
      "source_url": "https://en.wikipedia.org/wiki/Albizia_lebbeck",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1368157939,
      "text": "Albizia lebbeck is a species of plant in the family Fabaceae, native to the Indian subcontinent and Myanmar. It is widely cultivated and naturalised in other tropical and subtropical regions, including Australia. Common names in English include siris, Indian siris, East Indian walnut, Broome raintree, lebbeck, lebbek tree, frywood, koko and woman's tongue tree. The latter name is a play on the sound the seeds make as they rattle inside the pods. Siris is also a common name of the genus Albizia."
    }
  },
