  "description": {
    "en": {
      "source": "Wikipedia (en): Pinus kesiya",
      "source_url": "https://en.wikipedia.org/wiki/Pinus_kesiya",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1375581707,
      "text": "Pinus kesiya is a species of conifer in the family Pinaceae, one of the most widely distributed pines in southeast Asia. Its range extends south and east from the Khasi Hills in the northeast Indian state of Meghalaya, to Burma, northern Thailand, Cambodia, Laos, southernmost China, Vietnam, and the Philippines. It is an important plantation species elsewhere in the world, including in southern Africa and South America."
    },
    "es": {
      "source": "Wikipedia (es): Pinus kesiya",
      "source_url": "https://es.wikipedia.org/wiki/Pinus_kesiya",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 174709067,
      "text": "Pinus kesiya es una especie arbórea perteneciente a la familia de las Pinaceae, uno de los pinos más extendidos por Asia."
    },
    "fr": {
      "source": "Wikipedia (fr): Pinus kesiya",
      "source_url": "https://fr.wikipedia.org/wiki/Pinus_kesiya",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 215750860,
      "text": "Le Pin de Benguet, Pin à trois aiguilles ou Baguio pine en anglais, est une espèce de pin originaire du Sud-Est asiatique .\nLes anglophones le nomment aussi Benguet pine ou kesiya pine ou encore Three-needled Pine. Son nom anglais Khasi Pine vient des Khasi hills en Inde."
    },
    "pt": {
      "source": "Wikipedia (pt): Pinus kesiya",
      "source_url": "https://pt.wikipedia.org/wiki/Pinus_kesiya",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 63761328,
      "text": "Pinus kesiya é uma espécie de pinheiro originária do Velho Mundo, mais precisamente da região da Ásia. É conhecida popularmente como pinheiro ou pinheiro-de-khasia. No Brasil, as espécies de Pinus estão entre as principais espécies destinadas à produção de madeira, papel e resina."
    }
