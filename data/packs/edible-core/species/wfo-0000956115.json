  "description": {
    "en": {
      "source": "Wikipedia (en): Eucalyptus viminalis",
      "source_url": "https://en.wikipedia.org/wiki/Eucalyptus_viminalis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1359216908,
      "text": "Eucalyptus viminalis, commonly known as the manna gum, white gum or ribbon gum, is a species of small to very tall tree that is endemic to south-eastern Australia. It has smooth bark, sometimes with rough bark near the base, lance-shaped to curved adult leaves, flower buds in groups of three or seven, white flowers and cup-shaped or hemispherical fruit."
    },
    "es": {
      "source": "Wikipedia (es): Eucalyptus viminalis",
      "source_url": "https://es.wikipedia.org/wiki/Eucalyptus_viminalis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 173801622,
      "text": "Eucalyptus viminalis es una especie fanerógama perteneciente a la familia de las mirtáceas."
    },
    "fr": {
      "source": "Wikipedia (fr): Eucalyptus viminalis",
      "source_url": "https://fr.wikipedia.org/wiki/Eucalyptus_viminalis",
