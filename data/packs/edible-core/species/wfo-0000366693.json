  "description": {
    "ja": {
      "source": "Wikipedia (ja): バナバ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%90%E3%83%8A%E3%83%90",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 109709661,
      "text": "バナバ はミソハギ科サルスベリ属の落葉高木。和名はオオバナサルスベリ（大花百日紅）。"
    },
    "en": {
      "source": "Wikipedia (en): Lagerstroemia speciosa",
      "source_url": "https://en.wikipedia.org/wiki/Lagerstroemia_speciosa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1376873039,
      "text": "Lagerstroemia speciosa is a species of Lagerstroemia native to tropical South Asia, Southeast Asia, and Melanesia. It is a deciduous tree with bright pink to light purple flowers."
    },
    "es": {
      "source": "Wikipedia (es): Lagerstroemia speciosa",
      "source_url": "https://es.wikipedia.org/wiki/Lagerstroemia_speciosa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 158218084,
      "text": "Lagerstroemia speciosa es una especie del género Lagerstroemia nativa de la zona tropical del sur de Asia."
    },
    "fr": {
      "source": "Wikipedia (fr): Lagerstroemia speciosa",
      "source_url": "https://fr.wikipedia.org/wiki/Lagerstroemia_speciosa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 227130031,
      "text": "Lagerstroemia speciosa est une espèce de plantes à fleurs de la famille des Lythraceae. C'est un arbre originaire d'Asie tropicale : Chine, Inde, Cambodge, Birmanie, Thaïlande, Viêt Nam, Indonésie, Malaisie et Philippines."
    },
    "pt": {
      "source": "Wikipedia (pt): Lagerstroemia speciosa",
      "source_url": "https://pt.wikipedia.org/wiki/Lagerstroemia_speciosa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 69642554,
      "text": "O resedá-gigante é uma planta da família Lythraceae, do gênero Lagerstroemia. A árvore é nativa da região tropical da Índia e é cultivada como planta ornamental nos Estados Unidos."
    },
    "id": {
      "source": "Wikipedia (id): Bungur besar",
      "source_url": "https://id.wikipedia.org/wiki/Bungur_besar",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 29706040,
      "text": "Lagerstroemia speciosa dikenal dengan bungur besar atau bungur pohon adalah spesies pohon yang berasal dari Asia selatan tropis. Ini adalah pohon gugur dengan bunga merah muda cerah hingga ungu muda."
    }
  },
