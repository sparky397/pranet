  "description": {
    "en": {
      "source": "Wikipedia (en): Descurainia sophia",
      "source_url": "https://en.wikipedia.org/wiki/Descurainia_sophia",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1357095793,
      "text": "Descurainia sophia is a species of flowering plant in the cabbage family Brassicaceae. Common names include flixweed, herb-Sophia and tansy mustard. It is an annual plant that reproduces by seeds. It is a dominant weed in dark brown prairie and black prairie soils of southern Alberta. Its stem is erect, branched, and 4–30 in (10–76 cm) high. It was once given to patients with dysentery and called by ancient herbalists Sophia Chirurgorum, \"The Wisdom of Surgeons\". It is the type species of the genus Descurainia and of the rejected genus Sophia Adans."
    },
    "es": {
      "source": "Wikipedia (es): Sisymbrium sophia",
      "source_url": "https://es.wikipedia.org/wiki/Sisymbrium_sophia",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 165851189,
      "text": "Sofía, hierba de la sabiduría, hierba de los cirujanos, hierba de Santa Sofía o ajenjo loco,[cita requerida] diversos nombres comunes de Descurainia sophia, es una planta herbácea perteneciente a la familia Brassicaceae."
    },
    "fr": {
      "source": "Wikipedia (fr): Descurainia sophia",
      "source_url": "https://fr.wikipedia.org/wiki/Descurainia_sophia",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 222386456,
      "text": "Descurainia sophia, l’herbe de sainte Sophie ou sagesse des chirurgiens, est une espèce de plantes à fleurs de la famille des Brassicaceae que l'on rencontre en Eurasie. Elle doit son nom à sainte Sophie."
    },
    "pt": {
      "source": "Wikipedia (pt): Descurainia sophia",
      "source_url": "https://pt.wikipedia.org/wiki/Descurainia_sophia",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 60069460,
      "text": "Descurainia sophia é uma espécie de planta com flor pertencente à família Brassicaceae."
    }
  },
