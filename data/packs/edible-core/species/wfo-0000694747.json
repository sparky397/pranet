  "description": {
    "ja": {
      "source": "Wikipedia (ja): キヤニモモ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AD%E3%83%A4%E3%83%8B%E3%83%A2%E3%83%A2",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 106358778,
      "text": "キヤニモモ はフクギ科フクギ属の常緑樹、熱帯果樹。かつてクロンキスト体系等ではオトギリソウ科フクギ亜科とされていたため、古い図鑑等ではオトギリソウ科と記されることがある。"
    },
    "en": {
      "source": "Wikipedia (en): Garcinia xanthochymus",
      "source_url": "https://en.wikipedia.org/wiki/Garcinia_xanthochymus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1360892147,
      "text": "Garcinia xanthochymus, the false mangosteen, gamboge, yellow mangosteen, Himalayan Garcinia, or sour mangosteen is a species of mangosteen native to India, Nepal, Bangladesh, Indochina, and southern China at elevations of 0 – 1400 meters. Plants are found growing in humid forests of valleys or on hills. It is locally known as defol (ডেফল) in Bengal, tepor tenga in Assam, and heirangoi (হৈরাংগোই) in Manipur."
    },
    "fr": {
      "source": "Wikipedia (fr): Garcinia xanthochymus",
      "source_url": "https://fr.wikipedia.org/wiki/Garcinia_xanthochymus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 212800935,
      "text": "Garcinia xanthochymus est une espèce de plantes à fleurs de la famille des Clusiaceae."
    },
    "id": {
      "source": "Wikipedia (id): Asam kandis",
      "source_url": "https://id.wikipedia.org/wiki/Asam_kandis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 28657363,
      "text": "Asam kandis termasuk golongan pohon yang daunnya selalu hijau (evergreen) dalam arti tidak menggugurkan daunnya di musim gugur. Pohon yang tingginya berkisar antara 15–30 m dan berasal dari India ini masih sekerabat dengan manggis serta asam gelugur."
    }
  },
