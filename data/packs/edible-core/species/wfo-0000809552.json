    "en": {
      "source": "Wikipedia 英語版「Caryota mitis」",
      "source_url": "https://en.wikipedia.org/wiki/Caryota_mitis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1335973032,
      "text": "Caryota mitis, known as the clustering fishtail palm or fishtail palm, is a species of palm native to Tropical Asia from India to Java to southern China, now sparingly naturalized in southern Florida and in parts of Africa and Latin America. The species was originally described from Vietnam in 1790. In Florida, it grows in hummocks and in disturbed wooded areas."
    }
  },
  "sections": {
    "toxicity": {
      "en": {
        "source": "Wikipedia 英語版「Caryota mitis」の節「Toxicity」",
        "source_url": "https://en.wikipedia.org/wiki/Caryota_mitis#Toxicity",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1335973032,
        "heading": "Toxicity",
        "text": "The fruit of C. mitis is saturated with raphides, sharp, needle-shaped crystals of calcium oxalate. The raphides are strong irritants that cause damage and later itching upon contact with skin, and if ingested, the mouth. This is a result of the physical structure of the raphides, and not any chemical reaction.",
        "truncated": false
      }
    }
  },
