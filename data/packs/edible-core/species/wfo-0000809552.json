  "description": {
    "ja": {
      "source": "Wikipedia (ja): コモチクジャクヤシ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%B3%E3%83%A2%E3%83%81%E3%82%AF%E3%82%B8%E3%83%A3%E3%82%AF%E3%83%A4%E3%82%B7",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 108476061,
      "text": "コモチクジャクヤシ は、ヤシ科クジャクヤシ属のヤシ。"
    },
    "en": {
      "source": "Wikipedia (en): Caryota mitis",
      "source_url": "https://en.wikipedia.org/wiki/Caryota_mitis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1335973032,
      "text": "Caryota mitis, known as the clustering fishtail palm or fishtail palm, is a species of palm native to Tropical Asia from India to Java to southern China, now sparingly naturalized in southern Florida and in parts of Africa and Latin America. The species was originally described from Vietnam in 1790. In Florida, it grows in hummocks and in disturbed wooded areas."
    },
    "es": {
      "source": "Wikipedia (es): Caryota mitis",
      "source_url": "https://es.wikipedia.org/wiki/Caryota_mitis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 174624883,
      "text": "Caryota mitis es una palmera originaria del sureste de Asia, posee varios estípites o tallos bastante delgados de hasta 12 m de altura, es una palma sin capitel. Cada tronco muere al florecer, sin embargo, nacen otros nuevos, es de crecimiento bastante rápido. Se ha mostrado sensible a la enfermedad denominada Lethal Yellowing o amarilleo letal, resisten trasplante."
    },
    "fr": {
      "source": "Wikipedia (fr): Caryota mitis",
      "source_url": "https://fr.wikipedia.org/wiki/Caryota_mitis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 216390231,
      "text": "Le Palmier à Queue de Poisson de Birmanie, Caryota mitis, est une espèce de plantes de la famille des Arecaceae (palmiers), du genre Caryota, originaire d'Asie du Sud-Est."
    },
    "id": {
      "source": "Wikipedia (id): Sarai (tumbuhan)",
      "source_url": "https://id.wikipedia.org/wiki/Sarai_(tumbuhan)",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 27200210,
      "text": "Sarai adalah palem yang memiliki bentuk seperti pohon yang bisa berguna sebagai tanaman hias. Di Indonesia, sarai dikenal dengan bermacam-macam nama, seperti andudur, bĕridin, risi (Palemb.), tukas dan rotan t. (Mly.), sarai, sukawung leutik, suwangkung leutik (Sund.), gĕnduru (Jw.), ghanduru (Mad.), bulang talang, b. tĕlang (Kalteng), dan panisi (Bug.)."
    }
  },
  "sections": {
    "toxicity": {
      "en": {
        "source": "Wikipedia (en): Caryota mitis § Toxicity",
        "source_url": "https://en.wikipedia.org/wiki/Caryota_mitis#Toxicity",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 1335973032,
        "heading": "Toxicity",
        "text": "The fruit of C. mitis is saturated with raphides, sharp, needle-shaped crystals of calcium oxalate. The raphides are strong irritants that cause damage and later itching upon contact with skin, and if ingested, the mouth. This is a result of the physical structure of the raphides, and not any chemical reaction.",
        "truncated": false
      }
    }
  },
