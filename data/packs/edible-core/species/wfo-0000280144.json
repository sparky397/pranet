  "description": {
    "en": {
      "source": "Wikipedia (en): Polyscias scutellaria",
      "source_url": "https://en.wikipedia.org/wiki/Polyscias_scutellaria",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1250150867,
      "text": "Polyscias scutellaria, the shield aralia, or plum aralia, is a tropical shrub or small tree reaching 2–6 meters in height. A native of eastern Malesia and southwest Pacific islands, it is commonly grown in gardens."
    },
    "fr": {
      "source": "Wikipedia (fr): Polyscias scutellaria",
      "source_url": "https://fr.wikipedia.org/wiki/Polyscias_scutellaria",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 226292909,
      "text": "Polyscias scutellaria, aussi appelé Bagayou des vieux, est une espèce de plantes à fleurs de la famille des araliacées. C'est un arbuste trouvé en Nouvelle-Calédonie."
    },
    "id": {
      "source": "Wikipedia (id): Mangkokan",
      "source_url": "https://id.wikipedia.org/wiki/Mangkokan",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 28701181,
      "text": "Mangkokan  atau daun mangkokan adalah tumbuhan hias pekarangan dan tanaman obat yang relatif populer di Nusantara. Namanya mengacu pada bentuk daunnya yang melengkung serupa mangkok. Ia di pelbagai daerah juga disebut seperti mamangkokan (Sd.), atau godong mangkokan (Jw.), mangko-mangko (Makassar), daun papeda (Ambon),"
    }
  },
