  "description": {
    "en": {
      "source": "Wikipedia (en): Peucedanum palustre",
      "source_url": "https://en.wikipedia.org/wiki/Peucedanum_palustre",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1360084238,
      "text": "Peucedanum palustre (milk-parsley) is an almost glabrous biennial plant in the family Apiaceae. It is so called in English because of the thin, foetid, milky latex found in its young parts and is native to most of Europe, extending eastwards to Central Asia. Another English common name for the plant is marsh hog's fennel."
    },
    "es": {
      "source": "Wikipedia (es): Peucedanum palustre",
      "source_url": "https://es.wikipedia.org/wiki/Peucedanum_palustre",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171581165,
      "text": "El apio lechal es una especie de planta herbácea perteneciente a la familia de las apiáceas."
    },
    "fr": {
      "source": "Wikipedia (fr): Thysselinum palustre",
      "source_url": "https://fr.wikipedia.org/wiki/Thysselinum_palustre",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 226016887,
      "text": "Thysselinum palustre, le Peucédan des marais ou Persil des marais, est une espèce de plantes à fleurs de la famille des Apiacées. C'est une plante herbacée trouvée d'une zone allant de la majorité de l'Europe jusqu'au centre de l'Asie. Elle est présente en France."
    }
  },
