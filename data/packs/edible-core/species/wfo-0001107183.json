  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ミミモチシダ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%9F%E3%83%9F%E3%83%A2%E3%83%81%E3%82%B7%E3%83%80",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 107303117,
      "text": "ミミモチシダは、熱帯系のシダ植物の一つ。大きな小葉を持つ大柄なシダで、マングローブの湿地に生育する。"
    },
    "en": {
      "source": "Wikipedia 英語版「Acrostichum aureum」",
      "source_url": "https://en.wikipedia.org/wiki/Acrostichum_aureum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1350967201,
      "text": "Acrostichum aureum, the golden leather fern, is a large species of fern that grows in mangrove swamps and other wet locations. Other common names include swamp fern and mangrove fern."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Acrostichum aureum」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Acrostichum_aureum#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1350967201,
        "heading": "Cultivation",
        "text": "Golden leather fern can be grown under high light in garden soil or potting mix, if the substrate is kept constantly wet. Ordinary fresh water (not brackish water) is sufficient for cultivation.",
        "truncated": false
      }
    }
  },
