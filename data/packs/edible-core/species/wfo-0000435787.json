  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ハナシュクシャ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%8F%E3%83%8A%E3%82%B7%E3%83%A5%E3%82%AF%E3%82%B7%E3%83%A3",
