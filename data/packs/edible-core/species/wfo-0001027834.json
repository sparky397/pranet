  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ヤンバルナスビ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%A4%E3%83%B3%E3%83%90%E3%83%AB%E3%83%8A%E3%82%B9%E3%83%93",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 106387476,
      "text": "ヤンバルナスビ Solanum erianthum は、樹木になるナス科の植物。沖縄に自生があり、葉や若枝は毛が多くて灰緑色をしている。"
    },
    "en": {
      "source": "Wikipedia 英語版「Solanum erianthum」",
      "source_url": "https://en.wikipedia.org/wiki/Solanum_erianthum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1322411991,
      "text": "Solanum erianthum is a species of nightshade that is native to southern North America and northern South America. It has been introduced to other parts of the world and has a nearly pantropical distribution. Common names include mullein nightshade, velvet nightshade, and salvadora."
    }
