  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ニガカシュウ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%8B%E3%82%AC%E3%82%AB%E3%82%B7%E3%83%A5%E3%82%A6",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 107028846,
      "text": "ニガカシュウ は、ヤマノイモ科のヤムである。英語では、air potato、air yam、bitter yam、cheeky yam、potato yam、aerial yam、parsnip yam等と呼ばれる。日本国内ではエアーポテト、宇宙芋などの呼称で流通している。"
    },
    "en": {
      "source": "Wikipedia 英語版「Dioscorea bulbifera」",
      "source_url": "https://en.wikipedia.org/wiki/Dioscorea_bulbifera",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1369587382,
      "text": "Dioscorea bulbifera is a species of true yam in the yam family, Dioscoreaceae. It is native to Africa, Asia and northern Australia. It is widely cultivated and has become naturalized in many regions."
    }
  },
  "sections": {
    "toxicity": {
      "ja": {
        "source": "Wikipedia 日本語版「ニガカシュウ」の節「毒性」",
        "source_url": "https://ja.wikipedia.org/wiki/%E3%83%8B%E3%82%AC%E3%82%AB%E3%82%B7%E3%83%A5%E3%82%A6#%E6%AF%92%E6%80%A7",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 107028846,
        "heading": "毒性",
        "text": "フロリダ州で自生しているもののような栽培種以外の種は、毒を含むことがあり、ホルモン避妊で用いられるもの等の様々な合成ステロイドホルモンの主原料となるステロイドのジオスゲニン等が含まれる。このような野生種でも、乾燥したり茹でると食べられると言われることがあるが、実際の毒性についてはよく分かっていない。",
        "truncated": false
      },
      "en": {
        "source": "Wikipedia 英語版「Dioscorea bulbifera」の節「Toxicity」",
        "source_url": "https://en.wikipedia.org/wiki/Dioscorea_bulbifera#Toxicity",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1369587382,
        "heading": "Toxicity",
        "text": "Uncultivated forms, such as those found growing wild in Florida, can be poisonous. These varieties contain the steroid diosgenin, which is a principal material used in the manufacture of a number of synthetic steroidal hormones, such as those used in hormonal contraception.  There have been claims that even the wild forms are rendered edible after drying and boiling, leading to confusion over actual toxicity.",
        "truncated": false
      }
    }
  },
