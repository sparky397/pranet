  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「センジュギク」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%BB%E3%83%B3%E3%82%B8%E3%83%A5%E3%82%AE%E3%82%AF",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 108224682,
      "text": "センジュギク は、キク科コウオウソウ属の一年草で、観賞用に栽培される草花である。"
    },
    "en": {
      "source": "Wikipedia 英語版「Tagetes erecta」",
      "source_url": "https://en.wikipedia.org/wiki/Tagetes_erecta",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1353045377,
      "text": "Tagetes erecta, the Aztec marigold, Mexican marigold, big marigold, cempaxochitl or cempasúchil, is a species of flowering plant in the genus Tagetes native to Mexico and Central America. Despite being native to the Americas, it is often called the African marigold. In Mexico, this plant is found in the wild in the states of México, Michoacán, Puebla, Veracruz and Guerrero."
    }
  },
  "sections": {
    "cultivation": {
      "ja": {
        "source": "Wikipedia 日本語版「センジュギク」の節「栽培」",
        "source_url": "https://ja.wikipedia.org/wiki/%E3%82%BB%E3%83%B3%E3%82%B8%E3%83%A5%E3%82%AE%E3%82%AF#%E6%A0%BD%E5%9F%B9",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 108224682,
        "heading": "栽培",
        "text": "タネがやすい在来種や線虫駆除用種は、3月下旬から4月にかけ、栽培地に直まきし、タネが見え隠れする程度に覆土する。発芽してきたら混み合ったところを間引き、株間が30cmくらいになるようにすればよく育つ。タネが高価な一代交配種は、浅鉢に丁寧に蒔き、2ミリくらい覆土して乾かないように管理し、本葉が出てきたら、花壇に30cm間隔で定植する。\n比較的強健な植物であるが、高温と多湿に弱いので、咲き終わった花殻や混み合った枝はこまめに除去し、梅雨明け後に根本から一節を残して切り戻してやると、また秋になって開花する。",
        "truncated": false
      },
      "en": {
        "source": "Wikipedia 英語版「Tagetes erecta」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Tagetes_erecta#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1353045377,
        "heading": "Cultivation",
        "text": "It is widely cultivated and there are many cultivars used in gardening as an ornamental plant. The cultivar 'Inca Orange' has gained the Royal Horticultural Society's Award of Garden Merit.\nIn Mexico, it is used in the festivities of the Day of the Dead, to decorate altars and tombs; hence the name \"flower of the dead\". However, since antiquity it is also used for food and medicinal purposes.",
        "truncated": false
      }
    }
  },
