  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ヒロハフウリンホオズキ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%92%E3%83%AD%E3%83%8F%E3%83%95%E3%82%A6%E3%83%AA%E3%83%B3%E3%83%9B%E3%82%AA%E3%82%BA%E3%82%AD",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 107757597,
      "text": "ヒロハフウリンホオズキ は、ナス科センナリホオズキ属の一年生草本。帰化植物。ホオズキ形の実がなる雑草の一つ。以前の図鑑ではセンナリホオズキの名で掲載されてきた種。"
    },
    "en": {
      "source": "Wikipedia 英語版「Physalis angulata」",
      "source_url": "https://en.wikipedia.org/wiki/Physalis_angulata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1341807996,
      "text": "Physalis angulata is an erect herbaceous annual plant belonging to the nightshade family Solanaceae. Its leaves are dark green and roughly ovate, often with serrate margins. The flowers are five-sided and pale yellow; the yellow-orange fruits are borne inside a balloon-like calyx. The exact native range is uncertain. The species may be naturally endemic to Australia or the Americas or the native range may encompass both the Americas and Australia. It is now widely distributed and naturalized in tropical and subtropical regions worldwide."
    }
  },
