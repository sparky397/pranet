  "sections": {
    "uses": {
      "en": {
        "source": "Wikipedia (en): Adansonia za § Uses",
        "source_url": "https://en.wikipedia.org/wiki/Adansonia_za#Uses",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1344226314,
        "heading": "Uses",
        "text": "The fruit pulp and roots of seedlings as well as the seeds are edible. Seeds contain 11% oil. Wood may be fed to cattle during droughts and the trunk can be hollowed out to store water. The bark fibre can be use for cloth or rope and the flowers may be used to sooth sore throats.",
        "truncated": false
      },
      "fr": {
        "source": "Wikipedia (fr): Adansonia za § Usages",
        "source_url": "https://fr.wikipedia.org/wiki/Adansonia_za#Usages",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 234276108,
        "heading": "Usages",
        "text": "Sur le plateau Mahafaly, dans le sud-ouest de l'île, une pratique villageoise ancestrale consiste à creuser le tronc du baobab, afin d'en faire une citerne d'eau en prévision de la saison sèche.",
        "truncated": false
      }
    }
