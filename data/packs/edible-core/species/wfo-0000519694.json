  "description": {
    "en": {
      "source": "Wikipedia (en): Adansonia za",
      "source_url": "https://en.wikipedia.org/wiki/Adansonia_za",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1344226314,
      "text": "Adansonia za is a species of baobab in the genus Adansonia of the family Malvaceae. It was originally named in French as anadzahé. Common names in Malagasy include bojy, boringy, bozy, bozybe, ringy, and za, the last of which gives the plant its specific epithet. Eight Adansonia species are recognized, with six endemic to Madagascar. Adansonia za is the most widespread of the Madagascar endemics."
    },
    "es": {
      "source": "Wikipedia (es): Adansonia za",
      "source_url": "https://es.wikipedia.org/wiki/Adansonia_za",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 171302982,
      "text": "Adansonia za es una especie de árbol perteneciente al género Adansonia, a la familia Malvaceae. Es originario de Madagascar."
    },
    "fr": {
      "source": "Wikipedia (fr): Adansonia za",
      "source_url": "https://fr.wikipedia.org/wiki/Adansonia_za",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 234276108,
      "text": "Le baobab za est une espèce d'arbre de la famille des Bombacaceae selon la classification classique, ou de celle des Malvaceae selon la classification phylogénétique."
    },
    "pt": {
      "source": "Wikipedia (pt): Adansonia za",
      "source_url": "https://pt.wikipedia.org/wiki/Adansonia_za",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
