  "description": {
    "en": {
      "source": "Wikipedia (en): Funtumia elastica",
      "source_url": "https://en.wikipedia.org/wiki/Funtumia_elastica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1353667083,
      "text": "Funtumia elastica is a medium-sized African rubber tree with glossy leaves, milky sap, and long woody seedpods. The bark is used in the traditional medicine of tropical Africa. It is economically important in West African countries such as Ghana, where it is commonly known as the ofruntum."
    },
    "fr": {
      "source": "Wikipedia (fr): Funtumia elastica",
      "source_url": "https://fr.wikipedia.org/wiki/Funtumia_elastica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 237934867,
      "text": "Funtumia elastica est une espèce de plantes à fleurs africaines de la famille des Apocynaceae. C'est un arbre à caoutchouc et une plante médicinale dont on utilise l'écorce."
    }
