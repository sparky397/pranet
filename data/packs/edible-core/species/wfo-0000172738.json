  "description": {
    "ja": {
      "source": "Wikipedia (ja): カリン (マメ科)",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AB%E3%83%AA%E3%83%B3_(%E3%83%9E%E3%83%A1%E7%A7%91)",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 106357502,
      "text": "カリン は、マメ科シタン属の広葉樹。別名インドシタン、インドカリン。"
    },
    "en": {
      "source": "Wikipedia (en): Pterocarpus indicus",
      "source_url": "https://en.wikipedia.org/wiki/Pterocarpus_indicus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1365253726,
      "text": "Pterocarpus indicus is a species of Pterocarpus in the family Fabaceae native to southeastern Asia, northern Australasia, and the western Pacific Ocean islands, in Cambodia, southernmost China, East Timor, Indonesia, Malaysia, Papua New Guinea, the Philippines, the Ryukyu Islands, the Solomon Islands, Thailand, and Vietnam."
    },
    "es": {
      "source": "Wikipedia (es): Pterocarpus indicus",
      "source_url": "https://es.wikipedia.org/wiki/Pterocarpus_indicus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 175791853,
      "text": "Pterocarpus indicus es una especie de Pterocarpus nativa del sudeste de Asia, el norte de Australasia, y las islas del océano Pacífico occidental, en Camboya, el extremo sur de China, Timor Oriental, Indonesia, Malasia, Papúa Nueva Guinea, las Filipinas, las Islas Ryukyu, las Islas Salomón Islas, Tailandia y Vietnam."
    },
    "fr": {
      "source": "Wikipedia (fr): Pterocarpus indicus",
      "source_url": "https://fr.wikipedia.org/wiki/Pterocarpus_indicus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 233070791,
      "text": "Pterocarpus indicus est une espèce de plantes à fleurs de la famille des Fabacées. C'est un arbre appelé amboine, mais aussi bois de rose de Birmanie, santal rouge, ou sang-dragon. Son bois est utilisé en coutellerie d'art, notamment sa loupe, pour les manches des couteaux et pour le plaquage au début du XXe siècle, notamment à l'époque art déco."
    },
    "id": {
      "source": "Wikipedia (id): Angsana",
      "source_url": "https://id.wikipedia.org/wiki/Angsana",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29941441,
      "text": "Angsana atau sonokembang adalah sejenis pohon penghasil kayu berkualitas tinggi dari famili Fabaceae. Kayunya keras, kemerah-merahan, dan cukup berat, yang dalam perdagangan dikelompokkan sebagai narra atau rosewood."
    }
  },
