  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「ハナハマサジ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%83%8F%E3%83%8A%E3%83%8F%E3%83%9E%E3%82%B5%E3%82%B8",
