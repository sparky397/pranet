  "description": {
    "en": {
      "source": "Wikipedia (en): Allium cernuum",
      "source_url": "https://en.wikipedia.org/wiki/Allium_cernuum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1345443368,
      "text": "Allium cernuum, known as nodding onion or lady's leek, is a perennial plant in the genus Allium. It grows in open areas in North America."
    },
    "es": {
      "source": "Wikipedia (es): Allium cernuum",
      "source_url": "https://es.wikipedia.org/wiki/Allium_cernuum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 172739727,
      "text": "Allium cernuum es una especie de planta bulbosa del género Allium, perteneciente a la familia de las amarilidáceas, del orden de las Asparagales. Originaria de América del Norte."
    },
    "fr": {
      "source": "Wikipedia (fr): Allium cernuum",
      "source_url": "https://fr.wikipedia.org/wiki/Allium_cernuum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 237651762,
      "text": "Allium cernuum, l’Ail penché, est une espèce de plantes vivaces de la famille des Amaryllidaceae. Elle pousse en Amérique du Nord dans les zones ouvertes."
    },
    "id": {
      "source": "Wikipedia (id): Allium cernuum",
      "source_url": "https://id.wikipedia.org/wiki/Allium_cernuum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 28105417,
      "text": "Allium cernuum adalah spesies tumbuhan yang tergolong ke dalam famili Amaryllidaceae. Spesies ini juga merupakan bagian dari ordo Asparagales. Spesies Allium cernuum sendiri merupakan bagian dari genus bawang Allium. Nama ilmiah dari spesies ini pertama kali diterbitkan oleh Roth."
    }
  },
  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia (en): Allium cernuum § Cultivation",
        "source_url": "https://en.wikipedia.org/wiki/Allium_cernuum#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 1345443368,
        "heading": "Cultivation",
        "text": "It is grown in gardens for its distinctive nodding flowers that are white, pink, or maroon; it is winter hardy in U.S. Department of Agriculture hardiness zones 3–9. In gardens it will often form dense clusters of bulbs over time from offsets of the parent bulb. Plants are healthiest in full sun with well drained soil. In hot climates, they appreciate some shade, especially in the afternoon.",
        "truncated": false
      },
      "fr": {
        "source": "Wikipedia (fr): Allium cernuum § Culture",
        "source_url": "https://fr.wikipedia.org/wiki/Allium_cernuum#Culture",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 237651762,
        "heading": "Culture",
        "text": "Allium cernuum est cultivé dans les jardins pour ses fleurs penchées et distinctes qui sont blanches, roses ou marron. Il est résistant au froid. Dans les jardins, il forme souvent des grappes denses de bulbes qui se décalent du bulbe parent au fil du temps. Cette espèce est adaptée au plein soleil dans un sol bien drainé, mais, dans les climats chauds, elles apprécient un peu d'ombre, surtout l'après-midi.",
        "truncated": false
      }
    }
  },
