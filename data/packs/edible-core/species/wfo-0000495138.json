  "description": {
    "en": {
      "source": "Wikipedia (en): Scoparia dulcis",
      "source_url": "https://en.wikipedia.org/wiki/Scoparia_dulcis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1376744614,
      "text": "Scoparia dulcis is a species of flowering plant in the plantain family. Common names include licorice weed, goatweed, scoparia-weed and sweet-broom in English, tapeiçava, tapixaba, and vassourinha in Portuguese, escobillo in Spanish, and tipychä kuratu in Guarani. It is native to the Neotropics but it can be found throughout the tropical and subtropical world."
    },
    "es": {
      "source": "Wikipedia (es): Scoparia dulcis",
      "source_url": "https://es.wikipedia.org/wiki/Scoparia_dulcis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 174062853,
      "text": "Scoparia dulcis es una especie de planta de la familia Plantaginaceae. Los nombres comunes incluyen escobilla, paraguay y yerbaní. Es nativa del Neotrópico, pero se puede encontrar en todo el mundo tropical y subtropical."
    },
    "id": {
      "source": "Wikipedia (id): Sapu manis",
      "source_url": "https://id.wikipedia.org/wiki/Sapu_manis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 29875795,
      "text": "Sapu manis adalah spesies tumbuhan berbunga yang berasal dari suku plantaginaceae. Tumbuhan ini juga secara lokal dikenal dengan nama grinje menir, grinje jepun, dan jaka tua."
    }
  },
  "sections": {
    "uses": {
      "en": {
        "source": "Wikipedia (en): Scoparia dulcis § Traditional medicine",
        "source_url": "https://en.wikipedia.org/wiki/Scoparia_dulcis#Traditional_medicine",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1376744614,
        "heading": "Traditional medicine",
        "text": "As a traditional medicine, S. dulcis has been used for diabetes in India and hypertension in Taiwan. In Siddha medicine it is used for treatment of kidney stones, but it needs rigorous diet method. It is called  kallurukki (stone melter) in \nMalayalam and Tamil. In Brazil, it has been used for various problems such as hemorrhoids and wounds. S. dulcis was also used in traditional medicine in Trinidad, Puerto Rico, Colombia, Mexico, Venezuela, Guatemala, Surinam, Bolivia, Argentina, and El Salvador.",
        "truncated": false
      },
      "id": {
        "source": "Wikipedia (id): Sapu manis § Manfaat",
        "source_url": "https://id.wikipedia.org/wiki/Sapu_manis#Manfaat",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 29875795,
        "heading": "Manfaat",
        "text": "Seluruh bagian tanaman ini mengandung saponin dan flavonoida, sedangkan\nakarnya mengandung alkaloida. Tanaman ini dipercaya secara tradisional digunakan sebagai pengobatan alternatif pada penyakit diabetes.",
        "truncated": false
      }
    }
  },
