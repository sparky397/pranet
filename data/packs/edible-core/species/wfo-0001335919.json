  "description": {
    "en": {
      "source": "Wikipedia (en): Elwendia persica",
      "source_url": "https://en.wikipedia.org/wiki/Elwendia_persica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1376829369,
      "text": "Elwendia persica is a plant species in the family Apiaceae. It is related to cumin and sometimes called black cumin, or black caraway, and has a smoky, earthy taste. It is often confused with Nigella sativa, by which it is often substituted in cooking."
    },
    "es": {
      "source": "Wikipedia (es): Elwendia persica",
      "source_url": "https://es.wikipedia.org/wiki/Elwendia_persica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171170203,
      "text": "La alcaravea negra, comino negro o semilla negra es una especie de planta perteneciente a la familia Apiaceae."
    },
    "fr": {
      "source": "Wikipedia (fr): Elwendia persica",
      "source_url": "https://fr.wikipedia.org/wiki/Elwendia_persica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 235770873,
      "text": "Elwendia persica est une espèce de plantes à fleurs de la famille des Apiacées. Ses fruits sont utilisés comme épice sous le nom de cumin noir, bien que ce terme s'applique aussi aux graines de la nigelle."
    }
  },
  "sections": {
    "cultivation": {
      "es": {
        "source": "Wikipedia (es): Elwendia persica § Cultivo",
        "source_url": "https://es.wikipedia.org/wiki/Elwendia_persica#Cultivo",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 171170203,
        "heading": "Cultivo",
        "text": "La planta crece en forma silvestre en una amplia región desde el sudeste de Europa oriental hasta Asia meridional. Alcanza unos 60 centímetros de altura y 25 centímetros de ancho, con flores hermafroditas, polinizadas por insectos.\nLa planta da frutos delgados, alargados y acostillados que se cosechan una vez que la planta está muy seca. No se pueden arrancar más de 5 a 8 g de cada planta, lo que contribuye a su alto precio.",
        "truncated": false
      }
    }
