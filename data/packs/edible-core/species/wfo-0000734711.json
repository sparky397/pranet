  "description": {
    "en": {
      "source": "Wikipedia (en): Quillaja saponaria",
      "source_url": "https://en.wikipedia.org/wiki/Quillaja_saponaria",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1368802886,
      "text": "Quillaja saponaria, the soap bark tree or soapbark, is an evergreen tree in the family Quillajaceae, native to warm temperate central Chile. In Chile it occurs from 32 to 40° South Latitude approximately and at up to 2000 m (6500 ft) above sea level. It can grow to 15–20 m (50–65 ft) in height. The tree has thick, dark bark; smooth, leathery, shiny, oval evergreen leaves 3–5 cm long; white star-shaped flowers 15 mm in diameter borne in dense corymbs; and a dry fruit with five follicles each containing 10–20 seeds. The tree has several practical and commercial uses."
    },
    "es": {
      "source": "Wikipedia (es): Quillaja saponaria",
      "source_url": "https://es.wikipedia.org/wiki/Quillaja_saponaria",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 175258671,
      "text": "El Quillay, es un árbol endémico de la Zona Central de Chile. Hay poblaciones que llegan hasta los 20 m de altura. Habita en ambientes secos y suelos pobres."
    },
    "fr": {
      "source": "Wikipedia (fr): Quillaja saponaria",
      "source_url": "https://fr.wikipedia.org/wiki/Quillaja_saponaria",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 225116914,
      "text": "Quillaja saponaria est une espèce de plantes à fleurs de la famille des Rosacées. Certaines études récentes le classent dans la famille des Quillajacées. C'est un arbre à feuilles persistantes provenant d'Amérique du Sud."
    },
    "pt": {
      "source": "Wikipedia (pt): Quilaia",
      "source_url": "https://pt.wikipedia.org/wiki/Quilaia",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 70858917,
      "text": "A quilaia é uma árvore perenifólia originária do Chile, cuja casca do tronco é rica em saponinas."
    }
  },
