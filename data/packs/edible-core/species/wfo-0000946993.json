      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1369857298,
      "text": "Dyera costulata, the jelutong, is a species of tree in the family Apocynaceae. It grows to approximately 60 metres (200 ft) tall with diameters of 2 metres, or even to 80 m (260 ft) tall with diameters to 3 m (10 ft), and boles clear and straight for 30 m (90 ft). It grows in Malaysia, Borneo, Sumatra and southern Thailand. Its natural distribution is scattered locales in low-elevation tropical evergreen forest."
    },
    "es": {
      "source": "Wikipedia (es): Dyera costulata",
      "source_url": "https://es.wikipedia.org/wiki/Dyera_costulata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 166844675,
      "text": "Dyera costulata, syn. D. laxiflora es una especie arbórea de la familia Apocynaceae. Se comercializa con el nombre de jelutong."
    },
    "fr": {
      "source": "Wikipedia (fr): Dyera costulata",
