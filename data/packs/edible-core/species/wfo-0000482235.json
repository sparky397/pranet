  "description": {
    "en": {
      "source": "Wikipedia (en): Caribbean pine",
      "source_url": "https://en.wikipedia.org/wiki/Caribbean_pine",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1377204544,
      "text": "The Caribbean pine is a species of conifer in the family Pinaceae, a hard pine species native to Central America, southeastern Mexico, and the northern West Indies. It belongs to subsection Australes in subgenus Pinus. It inhabits tropical and subtropical coniferous forests such as Bahamian pineyards, in both lowland savannas and montane forests."
    },
    "es": {
      "source": "Wikipedia (es): Pinus caribaea",
      "source_url": "https://es.wikipedia.org/wiki/Pinus_caribaea",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 174825363,
      "text": "Pinus caribaea, el pino macho, es una especie de pino nativo de México, Cuba, Bahamas, Belice, Guatemala, El Salvador ,Honduras, Nicaragua, Panamá e Islas Turcas y Caicos."
    },
    "fr": {
      "source": "Wikipedia (fr): Pinus caribaea",
      "source_url": "https://fr.wikipedia.org/wiki/Pinus_caribaea",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 237639272,
      "text": "Le pin caraïbe, Pinus caribaea une espèce de conifères de la famille des Pinaceae."
    },
    "pt": {
      "source": "Wikipedia (pt): Pinus caribaea",
      "source_url": "https://pt.wikipedia.org/wiki/Pinus_caribaea",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 73050763,
      "text": "Pinus caribaea é uma espécie de pinheiro originária do Novo Mundo. Faz parte do grupo de espécies de pinheiros com área de distribuição na América Central, Caraíbas, México, sul do Arizona e Novo México."
    }
  },
  "sections": {
    "uses": {
      "en": {
        "source": "Wikipedia (en): Caribbean pine § Uses",
