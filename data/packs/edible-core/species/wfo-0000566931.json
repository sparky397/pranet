  "description": {
    "en": {
      "source": "Wikipedia (en): Blitum virgatum",
      "source_url": "https://en.wikipedia.org/wiki/Blitum_virgatum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1306215149,
      "text": "Blitum virgatum, is a species of flowering plant in the amaranth family known by the common name leafy goosefoot. It is native to Eurasia. It can be found on other continents as an introduced species, growing as a minor weed in disturbed habitats and cultivated land."
    },
    "es": {
      "source": "Wikipedia (es): Blitum virgatum",
      "source_url": "https://es.wikipedia.org/wiki/Blitum_virgatum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 174925597,
      "text": "La bledomera es una especie de planta herbácea perteneciente a la familia Amaranthaceae."
    },
    "fr": {
      "source": "Wikipedia (fr): Blitum virgatum",
      "source_url": "https://fr.wikipedia.org/wiki/Blitum_virgatum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 211660612,
      "text": "L'Épinard-fraise en baguette, Chénopode en baguette ou Blette en baguette est une espèce de plantes annuelles de la famille des Amaranthacées."
    },
    "id": {
      "source": "Wikipedia (id): Blitum virgatum",
      "source_url": "https://id.wikipedia.org/wiki/Blitum_virgatum",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29276779,
      "text": "Blitum virgatum, adalah spesies tumbuhan berbunga dalam suku bayam-bayaman yang dikenal dengan nama umum leafy goosefoot. Tumbuhan ini merupakan tanaman asli Eurasia. Tanaman ini dapat ditemukan di benua lain sebagai spesies introduksi, tumbuh sebagai gulma kecil di habitat yang terganggu dan lahan budidaya."
    }
