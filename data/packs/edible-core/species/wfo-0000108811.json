  "description": {
    "en": {
      "source": "Wikipedia (en): Eclipta prostrata",
      "source_url": "https://en.wikipedia.org/wiki/Eclipta_prostrata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1372174822,
      "text": "Eclipta prostrata, the false daisy or tattoo plant, is a species of plant in the family Asteraceae. It is widespread across much of the world."
    },
    "es": {
      "source": "Wikipedia (es): Eclipta prostrata",
      "source_url": "https://es.wikipedia.org/wiki/Eclipta_prostrata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 133514026,
      "text": "Eclipta prostrata es una especie de planta fanerógama de la familia Asteraceae. Es una de las Diez Flores Sagradas de Kerala."
    },
    "fr": {
      "source": "Wikipedia (fr): Eclipta prostrata",
      "source_url": "https://fr.wikipedia.org/wiki/Eclipta_prostrata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 214020286,
      "text": "Eclipta prostrata, l’Éclipte blanche, est une espèce de plantes à fleurs de la famille des Asteraceae et du genre Eclipta, originaire des Amériques mais naturalisée dans le monde entier. C'est une herbacée à larges feuilles plates et à petites fleurs blanches. Elle a beaucoup d'usages médicinaux en Asie notamment."
    },
    "pt": {
      "source": "Wikipedia (pt): Eclipta prostrata",
      "source_url": "https://pt.wikipedia.org/wiki/Eclipta_prostrata",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 40460161,
      "text": "Eclipta prostrata é uma espécie de planta com flor pertencente à família Asteraceae."
    },
    "id": {
      "source": "Wikipedia (id): Urang-aring",
      "source_url": "https://id.wikipedia.org/wiki/Urang-aring",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29410235,
      "text": "Urang-aring adalah sejenis tumbuhan, kebanyakan ditemukan liar sebagai gulma, anggota suku Asteraceae. Terna ini terkenal oleh kegunaannya sebagai penyubur rambut. Di samping itu, urang-aring juga memiliki khasiat sebagai tumbuhan obat. Beberapa nama-nama lainnya, di antaranya orang-aring (Jw.); te-lenteyan (Md.); daun tinta ; daun sipat, keremak jantan (Mly.); dan false daisy (Ingg.)."
    }
  },
