  "description": {
    "en": {
      "source": "Wikipedia (en): Calamus ornatus",
      "source_url": "https://en.wikipedia.org/wiki/Calamus_ornatus",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1299092604,
      "text": "Calamus ornatus is a species of rattan palm native to peninsular Thailand, west and central Malaysia and the Philippines. It grows as a liana in wet tropical habitats."
    },
    "id": {
      "source": "Wikipedia (id): Rotan susu",
      "source_url": "https://id.wikipedia.org/wiki/Rotan_susu",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 27735117,
      "text": "Calamus ornatus adalah salah satu spesies tumbuhan berbatang keras dari famili Arecaceae. Spesies ini memiliki pola hidup memanjat dan menjuntai (liana). Tumbuhan ini berasal dari bioma beriklim tropis basah yang tersebar mulai dari Semenanjung Thailand hingga kawasan Malesia bagian barat dan tengah. Di Indonesia tumbuhan ini dikenal dengan nama rotan susu. Nama ilmah Calamus ornatus diperkenalkan oleh Carl Ludwig Blume pada tahun 1830."
    }
