  "description": {
    "en": {
      "source": "Wikipedia (en): Genipa americana",
      "source_url": "https://en.wikipedia.org/wiki/Genipa_americana",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1362115869,
      "text": "Genipa americana is a species of trees in the family Rubiaceae. It is native to the tropical forests of North and South America, as well as the Caribbean."
    },
    "es": {
      "source": "Wikipedia (es): Genipa americana",
      "source_url": "https://es.wikipedia.org/wiki/Genipa_americana",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 173192234,
      "text": "Genipa americana es una especie del género Genipa, nativa del norte de Sudamérica, Caribe, sur de México y Paraguay."
    },
    "fr": {
      "source": "Wikipedia (fr): Genipa americana",
      "source_url": "https://fr.wikipedia.org/wiki/Genipa_americana",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 237058656,
      "text": "Genipa americana est une espèce de Genipa, qui vit dans les forêts tropicales humides de la partie nord de l'Amérique du Sud, des Antilles et du sud du Mexique. C'est un petit arbre qui atteint une hauteur de 15 m. Les feuilles sont opposées, lancéolées à oblongues, mesurant 20 à 35 cm de long sur 10 à 19 cm de large. Elles sont luisantes et vert foncé. Les fleurs sont blanches, jaunes ou rouges, avec une corolle de 5 à 6 cm de diamètre possédant cinq pétales. Le fruit est une baie comestible à peau épaisse de 5 à 8 cm de diamètre."
    },
    "pt": {
      "source": "Wikipedia (pt): Jenipapeiro",
      "source_url": "https://pt.wikipedia.org/wiki/Jenipapeiro",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 72972528,
      "text": "O jenipapeiro é uma espécie de árvore da família Rubiaceae. É nativa das florestas tropicais da América do Norte e do Sul, bem como do Caribe."
    }
  },
