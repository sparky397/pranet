  "description": {
    "en": {
      "source": "Wikipedia (en): Yucca schidigera",
      "source_url": "https://en.wikipedia.org/wiki/Yucca_schidigera",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1367491495,
      "text": "Yucca schidigera, also known as the Mojave yucca or Spanish dagger, is a perennial plant in the asparagus family Asparagaceae, native to the southwestern United States and northwestern Mexico. It is most common in the Mojave Desert, but also occurs extensively in the Sonoran Desert and west to the Pacific coast of southern California and Baja California."
    },
    "es": {
      "source": "Wikipedia (es): Yucca schidigera",
      "source_url": "https://es.wikipedia.org/wiki/Yucca_schidigera",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 172360822,
      "text": "Yucca schidigera Roezl ex Ortgies es una especie de pequeño árbol perteneciente a la familia Asparagaceae."
    },
    "fr": {
      "source": "Wikipedia (fr): Yucca schidigera",
      "source_url": "https://fr.wikipedia.org/wiki/Yucca_schidigera",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 225144547,
      "text": "Yucca schidigera, aussi connu sous le nom de mojave yucca ou Spanish dagger, est une espèce de plante à fleur de la famille des Agavaceae selon la classification classique de Cronquist (1981) ou des Asparagaceae selon la classification phylogénétique."
    }
