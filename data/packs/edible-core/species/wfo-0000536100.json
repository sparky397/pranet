  "description": {
    "ja": {
      "source": "Wikipedia (ja): セイヨウトウキ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%BB%E3%82%A4%E3%83%A8%E3%82%A6%E3%83%88%E3%82%A6%E3%82%AD",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 106365352,
      "text": "セイヨウトウキ は、セリ科の二年草。別名、ガーデンアンゼリカ。"
    },
    "en": {
      "source": "Wikipedia (en): Angelica archangelica",
      "source_url": "https://en.wikipedia.org/wiki/Angelica_archangelica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1306190612,
      "text": "Angelica archangelica, commonly known as angelica, garden angelica, wild celery, and Norwegian angelica, is a biennial plant from the family Apiaceae, a subspecies of which is cultivated for its sweetly scented edible stems and roots. Like several other species in Apiaceae, its appearance is similar to several poisonous species, and should not be consumed unless it has been identified with absolute certainty. Synonyms include Archangelica officinalis Hoffm. and Angelica officinalis Moench."
    },
    "es": {
      "source": "Wikipedia (es): Angelica archangelica",
      "source_url": "https://es.wikipedia.org/wiki/Angelica_archangelica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 172737679,
      "text": "La angélica, es una planta denominada así por ser creencia popular que es un regalo del arcángel Gabriel debido a sus propiedades medicinales. Se denomina también como \"hierba del Espíritu Santo\"."
    },
    "fr": {
      "source": "Wikipedia (fr): Angélique officinale",
      "source_url": "https://fr.wikipedia.org/wiki/Ang%C3%A9lique_officinale",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 240271195,
      "text": "L’angélique officinale, l’angélique vraie ou l’archangélique est une espèce de plantes à fleurs de la famille des Apiacées, utilisée comme plante condimentaire et médicinale pour ses pétioles, tiges et graines très aromatiques, et pour sa racine en phytothérapie."
    },
    "pt": {
      "source": "Wikipedia (pt): Angelica archangelica",
      "source_url": "https://pt.wikipedia.org/wiki/Angelica_archangelica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 69130042,
      "text": "Angelica archangelica, popularmente conhecida por angélica, é uma planta com propriedades medicinais pertencente à família das Apiaceae (Umbelíferas)."
    },
    "id": {
      "source": "Wikipedia (id): Angelica archangelica",
      "source_url": "https://id.wikipedia.org/wiki/Angelica_archangelica",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29344692,
      "text": "Angelica archangelica adalah tanaman biennal atau yang berbunga dan menyelesaikan siklus hidupnya dalam dua tahun. Pada tahun pertama, daun akan tumbuh subur dan dilanjutkan pertumbuhan bunga di tahun ke dua. Tanaman dapat mati setelah bijinya matang. untuk memperbanyak tanaman ini, dapat dilakukan dengan menanam biji yang telah matang atau memotong akar sebelum tanamannya mati."
    }
  },
  "sections": {
    "cultivation": {
      "fr": {
        "source": "Wikipedia (fr): Angélique officinale § Culture",
        "source_url": "https://fr.wikipedia.org/wiki/Ang%C3%A9lique_officinale#Culture",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 240271195,
        "heading": "Culture",
        "text": "L'angélique apprécie un sol frais, voire humide, légèrement acide.\nSa zone de rusticité se situe entre 4 et 8.\nElle se multiplie par semis, de juillet à septembre.\nLa récolte se fait la seconde année pour les pétioles et tiges coupés avant la floraison, et la troisième année pour les graines, lesquelles perdent rapidement leur pouvoir germinatif et doivent être semées peu de temps après leur récolte.",
        "truncated": false
      }
    }
  },
