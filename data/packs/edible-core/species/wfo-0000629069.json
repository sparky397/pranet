  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「クロダネカボチャ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AF%E3%83%AD%E3%83%80%E3%83%8D%E3%82%AB%E3%83%9C%E3%83%81%E3%83%A3",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 110711236,
      "text": "クロダネカボチャ は、ウリ科カボチャ属に属するカボチャの1種。アメリカ大陸原産。"
    },
    "en": {
      "source": "Wikipedia 英語版「Cucurbita ficifolia」",
      "source_url": "https://en.wikipedia.org/wiki/Cucurbita_ficifolia",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1374527739,
      "text": "Cucurbita ficifolia is a species of squash, grown for its edible seeds, fruit, and greens native to the Americas. It has common names including black seed squash, chilacayote, cidra, fig-leaf gourd, and Malabar gourd. This species is grown widely from Argentina and Chile to Mexico. It is also cultivated in regions of the world including India, Japan, Korea, China, the Philippines, Ethiopia, Kenya, Tanzania, and Angola."
    }
  },
  "sections": {
    "cultivation": {
      "ja": {
        "source": "Wikipedia 日本語版「クロダネカボチャ」の節「栽培」",
        "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AF%E3%83%AD%E3%83%80%E3%83%8D%E3%82%AB%E3%83%9C%E3%83%81%E3%83%A3#%E6%A0%BD%E5%9F%B9",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 110711236,
        "heading": "栽培",
        "text": "クロダネカボチャは、標高2,000mまでの温暖な高地で生育する。より耐性のない他のウリ科の植物を接ぎ木する台木として使用されることも多い。クロダネカボチャは、種蒔きや取り木で殖やすことができる。巻きひげは土に固定して根に成長させることができ、一度切った新しい個体を別の場所に移して殖やすこともできる。霜への耐性はそれほどないため、そのリスクが過ぎてから植えられることが多い。しかし定着した個体であれば、一晩の短い霜には耐えうる。\n\nクロダネカボチャの祖先も他の一部のウリ科の祖先と同様に、更新世以降の大型動物（メガファウナ）の大量絶滅と、突然変異による性質の変化と人間による食料としての注目、栽培の開始という歴史を辿っている。詳細はウリ科#特徴を参照。",
        "truncated": false
      },
      "en": {
        "source": "Wikipedia 英語版「Cucurbita ficifolia」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Cucurbita_ficifolia#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1374527739,
        "heading": "Cultivation",
        "text": "The fig-leaved gourd grows in temperate highlands at elevations up to 2,000 metres (6,600 ft). It is often used as a grafting rootstock for other less resistant cucurbits. C. ficifolia can be propagated through planting seeds and by layering. Nodes can grow roots, and can propagate new plants once cut. It is not resistant to severe frosts.",
        "truncated": false
      }
    }
  },
