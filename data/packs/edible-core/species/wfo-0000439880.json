  "description": {
    "ja": {
      "source": "Wikipedia (ja): オオツメクサ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AA%E3%82%AA%E3%83%84%E3%83%A1%E3%82%AF%E3%82%B5",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 106351416,
      "text": "オオツメクサ は、ヨーロッパ原産のナデシコ科オオツメクサ属の植物である。イギリスのモンゴメリーシャーの州花として知られる。カナダ西部では農業における雑草と見なされている。日本には、明治時代に渡来した。畑地や荒れ地、河川敷、休耕田に生える。"
    },
    "en": {
      "source": "Wikipedia (en): Spergula arvensis",
      "source_url": "https://en.wikipedia.org/wiki/Spergula_arvensis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1306466181,
      "text": "Spergula arvensis, the corn spurry, stickwort, starwort or spurrey, is a species of plant in the genus Spergula. It is an annual plant which is native to Europe, Macaronesia, Siberia, northwestern India, northwestern Africa, and the highlands of eastern tropical Africa."
    },
    "es": {
      "source": "Wikipedia (es): Spergula arvensis",
      "source_url": "https://es.wikipedia.org/wiki/Spergula_arvensis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 174108535,
      "text": "Spergula arvensis, llamada comúnmente esparcilla, es una especie de la familia de las cariofiláceas"
    },
    "fr": {
      "source": "Wikipedia (fr): Spergula arvensis",
      "source_url": "https://fr.wikipedia.org/wiki/Spergula_arvensis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 208157009,
      "text": "Spergula arvensis, la Spergule des champs, Spargoute des champs, Espargoutte des champs, Spargelle, est une espèce de plantes herbacées du genre Spergula et de la famille des Caryophyllacées."
    },
    "pt": {
      "source": "Wikipedia (pt): Spergula arvensis",
      "source_url": "https://pt.wikipedia.org/wiki/Spergula_arvensis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 69100230,
      "text": "Spergula arvensis, comummente conhecida como espérgula, é uma espécie de planta com flor pertencente à família Caryophyllaceae."
    }
  },
