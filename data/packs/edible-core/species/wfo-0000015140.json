  "description": {
    "en": {
      "source": "Wikipedia (en): Lactuca serriola",
      "source_url": "https://en.wikipedia.org/wiki/Lactuca_serriola",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1374798991,
      "text": "Lactuca serriola, also called prickly lettuce, milk thistle, compass plant, and scarole, is an annual or biennial plant in the tribe Cichorieae within the family Asteraceae. It has a slightly fetid odor and is commonly considered a weed of orchards, roadsides and field crops. It is the closest wild relative of cultivated lettuce."
    },
    "es": {
      "source": "Wikipedia (es): Lactuca serriola",
      "source_url": "https://es.wikipedia.org/wiki/Lactuca_serriola",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 171581616,
      "text": "La escarola o lechuguilla es una especie perteneciente a la familia Asteraceae. Es el pariente silvestre más cercano de la lechuga cultivada."
    },
    "fr": {
      "source": "Wikipedia (fr): Laitue scariole",
      "source_url": "https://fr.wikipedia.org/wiki/Laitue_scariole",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 233170539,
      "text": "La laitue scariole, ou laitue sauvage, sans doute ancêtre de la laitue cultivée, est une espèce de plante à fleurs de la famille des Astéracées, appartenant au genre Lactuca."
    },
    "pt": {
      "source": "Wikipedia (pt): Lactuca serriola",
      "source_url": "https://pt.wikipedia.org/wiki/Lactuca_serriola",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 64610140,
      "text": "Lactuca serriola é uma espécie pertencente à família Asteraceae. A espécie tem distribuição natural na região circum-mediterrânica e em grande parte da Europa, mas encontra-se naturalizada em quase todas as regiões de clima temperado."
    }
  },
  "sections": {
    "toxicity": {
      "en": {
        "source": "Wikipedia (en): Lactuca serriola § Toxicity",
        "source_url": "https://en.wikipedia.org/wiki/Lactuca_serriola#Toxicity",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1374798991,
        "heading": "Toxicity",
        "text": "It can cause pulmonary emphysema in cattle feeding exclusively on the plant.",
        "truncated": false
      }
    },
    "uses": {
      "en": {
        "source": "Wikipedia (en): Lactuca serriola § Uses",
        "source_url": "https://en.wikipedia.org/wiki/Lactuca_serriola#Uses",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1374798991,
        "heading": "Uses",
        "text": "Lactuca serriola can be eaten as a salad, although it has something of a bitter taste. Young leaves can be eaten raw or cooked. Older leaves can be steamed. While unsubstantial, its roots have been used as a coffee substitute.\nIts presence in some ancient deposits has been linked more to its soporific properties which might suggest ritual use. The Ancient Greeks also believed its pungent juice to be a remedy against eye ulcers and Pythagoreans called the lettuce eunuch because it caused urination and relaxed sexual desire. Following its accidental introduction to North America, the Navajo began to use the plant as a ceremonial emetic. In the island of Crete in Greece the leaves and the tender shoots of a variety called maroula (μαρούλα) or agriomaroulo (αγριομάρουλο) are eaten boiled. It is used by a growing number of Jews and Samaritans as the Maror (bitter herb) on Passover (or Pesach in Hebrew).\nLactuca serriola contains lactucarium, which is the milky sap (white latex) that flows through the stem of the plant. It is used as a medicinal herb when air-dried. Although the standard definition of lactucarium requires its production from Lactuca virosa, it was recognized that smaller quantities of lactucarium could be produced in a similar way from Lactuca sativa and Lactuca canadensis var. elongata, and even that lettuce-opium obtained from Lactuca serriola or Lactuca quercina was of superior quality.",
        "truncated": false
      },
      "fr": {
        "source": "Wikipedia (fr): Laitue scariole § Utilisation",
        "source_url": "https://fr.wikipedia.org/wiki/Laitue_scariole#Utilisation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 233170539,
        "heading": "Utilisation",
        "text": "Si les jeunes pousses sont comestibles, il n'en va pas de même pour la plante adulte, d'odeur fétide, à la tige raide et aux feuilles épineuses, renfermant un latex blanchâtre.\nDans les pays anglo-saxons on l'appelle souvent « compass plant » (plante-boussole), car les feuilles de la tige principale sont disposées perpendiculairement à la lumière du soleil, avec une tendance à pointer vers le nord et le sud.\nComme la laitue vireuse, la laitue scariole a été utilisée comme substitut à l'opium. On se servait du latex séché, fumé ou bu en tisane - très amère !",
        "truncated": false
      }
    }
  },
