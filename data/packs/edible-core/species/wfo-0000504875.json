  "sections": {
    "cultivation": {
      "en": {
        "source": "Wikipedia 英語版「Sandoricum koetjape」の節「Cultivation」",
        "source_url": "https://en.wikipedia.org/wiki/Sandoricum_koetjape#Cultivation",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1370472091,
        "heading": "Cultivation",
        "text": "Sandoricum koetjape is a tree of humid tropical regions that grows from sea level to an elevation of 3,000 feet (910 m). It grows better in deep and organic grounds, and with rainfall distributed throughout the year, although it also tolerates long, dry periods.\nThe distance of planting from each other is 20 to 25 feet (6.1 to 7.6 m). It requires fertilization two times a year so it can grow better. Normally, seed trees produce fruit after 5 or 7 years of age, though some cultivars need only 3 or 4.\nThe santol is a very productive tree. A mature tree can produce between 18,000 and 24,000 fruits per year. In Puerto Rico it produces in the months of August and September.",
        "truncated": false
      }
    }
  },
