  "description": {
    "en": {
      "source": "Wikipedia (en): Alchemilla arvensis",
      "source_url": "https://en.wikipedia.org/wiki/Alchemilla_arvensis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 1368416528,
      "text": "Alchemilla arvensis, known as parsley-piert, is a sprawling, downy plant common all over the British Isles where it grows on arable fields and bare wastelands, particularly in dry sites. The short-stalked leaves have three segments each lobed at the tip. It flowers from April to September. The tiny green flower has four sepals and no petals; stipules form a leaf-like cup, enclosing the flower."
    },
    "es": {
      "source": "Wikipedia (es): Alchemilla arvensis",
      "source_url": "https://es.wikipedia.org/wiki/Alchemilla_arvensis",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-17",
      "revision": 171666259,
      "text": "Alchemilla arvensis Scop. es una especie de planta fanerógama de la familia de las rosáceas."
    },
    "pt": {
