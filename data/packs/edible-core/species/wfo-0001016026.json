  "sections": {
    "uses": {
      "en": {
        "source": "Wikipedia (en): Alchemilla arvensis § Uses",
        "source_url": "https://en.wikipedia.org/wiki/Alchemilla_arvensis#Uses",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-17",
        "revision": 1368416528,
        "heading": "Uses",
        "text": "The leaves have a slightly acidic flavor and are edible raw.\nThe 17th-century herbalist Nicholas Culpeper, recommended parsley piert for use in salads, although it would be difficult to gather sufficient quantities of such a tiny plant for a reasonable meal. Culpeper also recommends the plant to gentlemen for eating as a winter pickle in addition to the pickled samphire to which they were accustomed.",
        "truncated": false
      }
    }
