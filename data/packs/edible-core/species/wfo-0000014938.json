  "description": {
    "ja": {
      "source": "Wikipedia 日本語版「カッコウアザミ」",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%AB%E3%83%83%E3%82%B3%E3%82%A6%E3%82%A2%E3%82%B6%E3%83%9F",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 106065420,
      "text": "カッコウアザミ はキク科カッコウアザミ属の一年生草本。帰化植物。"
    },
    "en": {
      "source": "Wikipedia 英語版「Ageratum conyzoides」",
      "source_url": "https://en.wikipedia.org/wiki/Ageratum_conyzoides",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-09",
      "revision": 1366367557,
      "text": "Ageratum conyzoides is native to Tropical America, especially Brazil, and is an invasive weed in many other regions. It is an herb that is 0.5–1 m. high, with ovate leaves 2–6 cm long, and flowers are white to mauve."
    }
  },
  "sections": {
    "toxicity": {
      "en": {
        "source": "Wikipedia 英語版「Ageratum conyzoides」の節「Toxicity」",
        "source_url": "https://en.wikipedia.org/wiki/Ageratum_conyzoides#Toxicity",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-09",
        "revision": 1366367557,
        "heading": "Toxicity",
        "text": "Ingesting A. conyzoides can cause liver lesions and tumors. There was a mass poisoning incident in Ethiopia as a result of contamination of grain with A. conyzoides. The plant contains the pyrrolizidine alkaloids lycopsamine and echinatine.",
        "truncated": false
      }
    }
  },
