  "description": {
    "ja": {
      "source": "Wikipedia (ja): スピノサスモモ",
      "source_url": "https://ja.wikipedia.org/wiki/%E3%82%B9%E3%83%94%E3%83%8E%E3%82%B5%E3%82%B9%E3%83%A2%E3%83%A2",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 106590341,
      "text": "スピノサスモモ またはスピノーサスモモは、スモモ属の低木、または小高木である。"
    },
    "en": {
      "source": "Wikipedia (en): Prunus spinosa",
      "source_url": "https://en.wikipedia.org/wiki/Prunus_spinosa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 1377031439,
      "text": "Prunus spinosa, called blackthorn or sloe, is a species of flowering plant in the rose family, Rosaceae. It is native to Europe and West Asia, and has been naturalised in parts of North America."
    },
    "es": {
      "source": "Wikipedia (es): Prunus spinosa",
      "source_url": "https://es.wikipedia.org/wiki/Prunus_spinosa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 171581279,
      "text": "El endrino, es una especie de arbusto de la familia de las rosáceas."
    },
    "fr": {
      "source": "Wikipedia (fr): Prunellier",
      "source_url": "https://fr.wikipedia.org/wiki/Prunellier",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 234699817,
      "text": "Le prunellier ou prunelier est une espèce de plantes à fleurs, de la famille des Rosaceae."
    },
    "pt": {
      "source": "Wikipedia (pt): Prunus spinosa",
      "source_url": "https://pt.wikipedia.org/wiki/Prunus_spinosa",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 70707114,
      "text": "Prunus spinosa, comummente conhecida como abrunheiro-bravo ou abrunheiro, é uma espécie de planta arbustiva, espinhosa, da família das Rosáceas, pertencente ao tipo fisionómico dos fanerófitos, cujos frutos são conhecidos como abrunhos-bravos ou simplesmente abrunhos."
    },
    "id": {
      "source": "Wikipedia (id): Prem duri",
      "source_url": "https://id.wikipedia.org/wiki/Prem_duri",
      "license": "CC BY-SA 4.0",
      "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
      "retrieved": "2026-10-14",
      "revision": 29672679,
      "text": "Prem duri adalah tanaman perdu yang berasal dari Genus prunus. Perdu ini juga dialamikan di Selandia Baru, Tasmania, dan Amerika Utara sebelah timur. Buah sole di Britania Raya dimanfaatkan untuk diolah menjadi gin sloe, sejenis minuman keras, sementara batangnya di Irlandia dimanfaatkan untuk diolah menjadi tongkat penyangga. Buah ini dikenal juga dengan nama blackthorn karena batangnya yang berduri."
    }
  },
  "sections": {
    "cultivation": {
      "fr": {
        "source": "Wikipedia (fr): Prunellier § Agriculture",
        "source_url": "https://fr.wikipedia.org/wiki/Prunellier#Agriculture",
        "license": "CC BY-SA 4.0",
        "license_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "retrieved": "2026-10-14",
        "revision": 234699817,
        "heading": "Agriculture",
        "text": "Le prunellier est un des constituants naturels des haies, car les bovins et ovins n'apprécient pas ses fruits et restent à bonne distance de ses épines.\nSes drageons à croissance rapide en font un arbuste idéal pour la consolidation des terrains en pente. Par sa robustesse et sa résistance au gel, il peut être cultivé dans des terrains difficiles et les jardins sauvages.\nIl peut être utilisé comme porte-greffe naturel pour le prunier, le pêcher et l'abricotier. Au bout de deux à trois ans, on obtient une fructification qui arrive à maturité au début de l'automne. La durée de vie du prunellier est d'environ 50 ans.",
        "truncated": false
      }
    }
  },
